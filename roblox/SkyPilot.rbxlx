<Item class="ModuleScript" referent="RBX00000004"><Properties><string name="Name">FlightPhysics</string><ProtectedString name="Source"><![CDATA[--!strict
-- Порт FlightClient.step / physicsStep из Sky Pilot 1:1.
-- Единицы: 1 stud/s = 1 kt, высота в футах = Y * FT, G = 19 stud/s².
local World = require(script.Parent.World)

local FT = World.FT
local G = 19

local FlightPhysics = {}

-- Ограничения по перегрузке (G) и самолёты с fly-by-wire (защита от перегрузки, как в реальности)
local FBW = { A220 = true, A320 = true, A330 = true, A350 = true, A380 = true, B777 = true, B787 = true, G650 = true, GL7500 = true, F16 = true }
function FlightPhysics.limits(c: any): (number, number, boolean)
	local gMax = c.gMax or (if c.id == "F16" then 9 elseif c.id == "C172" then 3.8 elseif c.length < 130 then 2.6 else 2.5)
	local gMin = c.gMin or (if c.id == "F16" then -3 elseif c.id == "C172" then -1.5 else -1)
	return gMax, gMin, FBW[c.id] == true
end
function FlightPhysics.gearMaxKts(c: any): number
	return c.gearMaxKts or (if c.maxKts > 300 then 270 else 9999)
end
FlightPhysics.FT = FT
FlightPhysics.G = G

export type Input = {
	p: number, r: number, y: number,
	thrUp: boolean?, thrDn: boolean?, brakes: boolean?,
	throttle: number?, -- абсолютная тяга (слайдер, автопилот)
}

export type Event = { type: string, text: string, good: boolean?, fpm: number?, grade: string?, airport: string? }

export type Flight = {
	cfg: any, mode: string,
	pos: Vector3, att: CFrame,
	speed: number, throttle: number, flaps: number, gear: boolean,
	brakes: boolean, reverse: boolean, spoilers: boolean,
	inP: number, inR: number, inY: number,
	vyExtra: number, lastVelY: number, vel: Vector3,
	wind: Vector3?, -- снос ветром (stud/с, задаёт клиент); на земле не действует
	onGround: boolean, airTime: number, crashed: boolean, crashReason: string?,
	gload: number, damage: number, buffet: number, flapStress: number, gearStress: number, flapsDamaged: boolean, gearStuck: boolean,
	events: { Event }, dbg: { [string]: number },
}

local function clamp(v: number, a: number, b: number): number
	return math.min(b, math.max(a, v))
end
FlightPhysics.clamp = clamp

function FlightPhysics.new(cfg: any, spawnCF: CFrame, air: boolean): Flight
	local speed = air and math.floor(cfg.maxKts * 0.6) or 0
	return {
		cfg = cfg, mode = air and "air" or "runway",
		pos = spawnCF.Position, att = spawnCF.Rotation,
		speed = speed, throttle = air and 0.7 or 0, flaps = 0, gear = (cfg.fixedGear == true) or not air,
		brakes = false, reverse = false, spoilers = false,
		inP = 0, inR = 0, inY = 0,
		vyExtra = 0, lastVelY = 0, vel = spawnCF.LookVector * speed,
		onGround = not air, airTime = 0, crashed = false, crashReason = nil,
		gload = 1, damage = 0, buffet = 0, flapStress = 0, gearStress = 0, flapsDamaged = false, gearStuck = false,
		events = {}, dbg = { agl = 0, lift = 1, eff = 1, stall = cfg.stallKts, thrust = 0, drag = 0, accel = 0, thrustMul = 1 },
	}
end

local function crash(f: Flight, reason: string)
	f.crashed = true
	f.crashReason = reason
	table.insert(f.events, { type = "crash", text = reason })
end

local function stepOnce(f: Flight, input: Input, dt: number)
	if f.crashed then
		return
	end
	dt = clamp(dt, 1 / 240, 1 / 20)
	local c = f.cfg
	local sm = math.min(1, dt * 6)
	f.inP += (clamp(input.p, -1, 1) - f.inP) * sm
	f.inR += (clamp(input.r, -1, 1) - f.inR) * sm
	f.inY += (clamp(input.y, -1, 1) - f.inY) * sm
	if input.throttle ~= nil then
		f.throttle = clamp(input.throttle, 0, 1)
	end
	if input.thrUp then
		f.throttle = math.min(1, f.throttle + dt * 0.45)
	end
	if input.thrDn then
		f.throttle = math.max(0, f.throttle - dt * 0.45)
	end
	f.brakes = input.brakes == true

	local pos = f.pos
	local gy = World.groundAt(pos.X, pos.Z)
	local agl = if gy == -math.huge then math.huge else pos.Y - c.gearHeight - gy
	local nowGround = agl <= 0.6
	local att = f.att
	local look = att.LookVector
	local right = att.RightVector
	local up = att.UpVector

	if pos.Y < -400 then
		return crash(f, "Самолёт упал за край мира")
	end

	if nowGround and not f.onGround then
		local fpm = math.floor(-f.lastVelY * 60 * FT)
		local bankDeg = math.deg(math.asin(clamp(-right.Y, -1, 1)))
		local pitchDeg = math.deg(math.asin(clamp(look.Y, -1, 1)))
		if not f.gear then
			return crash(f, "Посадка без шасси!")
		end
		if fpm > c.maxTouchdownFpm then
			return crash(f, string.format("Слишком жёсткая посадка: %d fpm (лимит %d)", fpm, c.maxTouchdownFpm))
		end
		if math.abs(bankDeg) > 20 or pitchDeg < -8 or up.Y < 0 then
			return crash(f, string.format("Удар крылом о землю (крен %d°, тангаж %d°)", math.round(bankDeg), math.round(pitchDeg)))
		end
		-- удар хвостом: нос задран выше предела — повреждение (как в жизни), посадка считается жёсткой
		local tailStrike = pitchDeg > c.maxRotate + 2
		if tailStrike then
			f.damage = math.min(0.95, f.damage + 0.35)
			table.insert(f.events, { type = "warn", text = string.format("Удар хвостом о полосу: тангаж %d° (предел %d°) — повреждение", math.round(pitchDeg), c.maxRotate) })
		end
		if f.speed > 15 and f.airTime > 1 then
			local grade = if tailStrike then "hard" elseif fpm < 250 then "perfect" elseif fpm < 600 then "good" else "hard"
			local label = if grade == "perfect" then "Идеальная посадка!" elseif grade == "good" then "Хорошая посадка" else "Жёсткая посадка"
			table.insert(f.events, {
				type = "landing", text = string.format("%s  %d fpm", label, math.max(fpm, 0)),
				good = fpm < 600 and not tailStrike, fpm = math.max(fpm, 0), grade = grade, airport = World.runwayAt(pos.X, pos.Z, 20),
			})
		end
	end
	if not nowGround and f.onGround and f.speed > 20 then
		table.insert(f.events, { type = "takeoff", text = string.format("Отрыв на %d kt", math.round(f.speed)) })
	end
	f.onGround = nowGround
	f.airTime = if nowGround then 0 else f.airTime + dt
	if not nowGround then
		f.reverse = false
	end

	local stall = c.stallKts * (1 - 0.07 * f.flaps)
	local lift = clamp((f.speed - 0.6 * stall) / (0.4 * stall), 0, 1)
	local eff = clamp(f.speed / (stall * 1.1), 0.15, 1)
	local ceil = c.ceilingFt / FT
	local thrustMul = clamp((ceil - pos.Y) / (0.15 * ceil), 0.05, 1)
	local thrust = c.thrust * f.throttle * thrustMul
	if f.reverse then
		thrust = -c.thrust * 0.45 * f.throttle
	end
	local retractGear = f.gear and not c.fixedGear
	local dragK = c.thrust / (c.maxKts * c.maxKts)
	local dragMul = 1 + 0.12 * f.flaps + (if retractGear then 0.15 else 0)
	local vr = c.vrKts * (1 - 0.04 * f.flaps)
	local extra = (0.3 * f.flaps + (if retractGear then 0.4 else 0)) * (f.speed / c.vrKts) ^ 2
	-- эффект земли: ниже половины размаха индуктивное сопротивление и просадка меньше
	local ge = if f.onGround or agl == math.huge then 0 else clamp(1 - agl / (c.span * 0.5), 0, 1)
	local induced = if f.onGround then 0 else 1.2 * (c.stallKts / math.max(f.speed, 30)) ^ 2 * lift * (1 - 0.5 * ge)
	-- интерцепторы: сопротивление растёт с квадратом скорости (в воздухе и на пробеге)
	local spoilerDrag = if f.spoilers then math.min(c.thrust * 0.6, c.thrust * 0.35 * (f.speed / c.vrKts) ^ 2) else 0
	local drag = dragK * dragMul * f.speed * f.speed + extra + induced + spoilerDrag
	local accel = thrust - drag - G * look.Y
	if f.onGround and f.speed > 0 then
		accel -= 0.6
		if f.brakes then
			accel -= c.brakeDecel * (if f.spoilers then 1.25 else 1)
		end
	end
	f.speed = math.max(0, f.speed + accel * dt)

	if f.onGround then
		local heading = math.atan2(-look.X, -look.Z)
		local pitch = math.asin(clamp(look.Y, -1, 1))
		local steer = clamp(f.inY + f.inR, -1, 1)
		local steerRate = c.groundSteer * clamp(f.speed / 12, 0, 1) / (1 + f.speed / 40)
		heading -= steer * steerRate * dt
		if f.speed >= vr and f.inP > 0.05 then
			pitch = clamp(pitch + c.pitchRate * 0.6 * f.inP * dt, 0, math.rad(c.maxRotate))
		else
			pitch = math.max(0, pitch - pitch * math.min(1, dt * 1.5))
		end
		att = CFrame.Angles(0, heading, 0) * CFrame.Angles(pitch, 0, 0)
	else
		-- fly-by-wire: компьютер не даёт выйти за предел перегрузки
		local gMaxP, gMinP, fbw = FlightPhysics.limits(c)
		local inP = f.inP
		-- аэродинамический предел: крыло не даст больше (V/Vs)² — дальше срыв потока
		local aeroMax = (f.speed / stall) ^ 2
		local capMax = if fbw then math.min(gMaxP, aeroMax) else aeroMax
		local capMin = if fbw then math.max(gMinP, -0.6 * aeroMax) else -0.6 * aeroMax
		if inP > 0 and f.gload > capMax * 0.85 then
			inP *= clamp((capMax * 0.98 - f.gload) / (capMax * 0.13 + 0.05), 0, 1)
		elseif inP < 0 and f.gload < capMin * 0.85 then
			inP *= clamp((f.gload - capMin * 0.98) / (math.abs(capMin) * 0.13 + 0.05), 0, 1)
		end
		local pr = c.pitchRate * eff * inP
		if lift < 1 then
			pr -= (1 - lift) * 0.9
		end
		local rr = -c.rollRate * eff * f.inR
		local yr = -c.yawRate * eff * f.inY
		att = att * CFrame.Angles(pr * dt, yr * dt, rr * dt)
		local bank = -att.RightVector.Y
		local omega = c.turnBoost * G * bank / math.max(f.speed, 60) * lift
		att = (CFrame.fromAxisAngle(Vector3.yAxis, -omega * dt) * att):Orthonormalize()
	end
	f.att = att
	look = att.LookVector
	up = att.UpVector

	local vel: Vector3
	if f.onGround then
		vel = look * f.speed
		local glue = if (f.inP > 0.05 and agl > 0 and f.speed >= vr) then 0 else -agl * 10
		vel += Vector3.new(0, glue, 0)
		f.vyExtra = 0
	else
		local sinkTarget = (-(1 - lift) * c.stallSink - (1 - math.abs(up.Y)) * 12 * lift) * (1 - 0.4 * ge) - (if f.spoilers then 4 * lift else 0)
		f.vyExtra += (sinkTarget - f.vyExtra) * math.min(1, dt * 1.5)
		vel = look * f.speed + Vector3.new(0, f.vyExtra, 0)
	end

	if f.speed > 20 then
		local dir = if f.onGround then Vector3.new(look.X, 0, look.Z) else vel
		if dir.Magnitude > 0.01 then
			dir = dir.Unit
			local len = c.length * 0.5 + f.speed * dt * 2
			for _, t in { 0.5, 0.75, 1 } do
				local p = pos + dir * (len * t)
				if World.hitsObstacle(p) then
					return crash(f, "Столкновение со зданием!")
				end
				if not f.onGround and p.Y < World.groundAt(p.X, p.Z) - 0.5 then
					return crash(f, "Столкновение с землёй / горой!")
				end
			end
		end
	end

	-- перегрузка: (ускорение + g) в проекции на «пол» самолёта, в единицах g
	if f.onGround or dt <= 0 then
		f.gload += (1 - f.gload) * math.min(1, dt * 5)
	else
		local acc = (vel - f.vel) / dt + Vector3.new(0, G, 0)
		local nz = acc:Dot(up) / G
		f.gload += (clamp(nz, -15, 15) - f.gload) * math.min(1, dt * 8)
	end
	local gMax, gMin = FlightPhysics.limits(c)
	if not f.onGround then
		if f.gload > gMax * 1.5 or f.gload < gMin * 1.5 then
			return crash(f, string.format("Разрушение конструкции: перегрузка %.1f G (предел %.1f G)", f.gload, if f.gload > 0 then gMax else gMin))
		end
		if f.gload > gMax then
			f.damage += (f.gload - gMax) / gMax * dt * 1.5
		elseif f.gload < gMin then
			f.damage += (gMin - f.gload) / math.abs(gMin) * dt * 1.5
		end
	end
	if f.speed > c.maxKts * 1.1 then
		f.damage += (f.speed / c.maxKts - 1.1) * dt * 2
	end
	if f.damage >= 1 then
		return crash(f, "Разрушение конструкции: превышены ограничения самолёта")
	end
	-- скоростной напор ломает закрылки и шасси
	if f.flaps > 0 and f.speed > c.flapMaxKts * 1.15 then
		f.flapStress += dt
		if f.flapStress > 2 and not f.flapsDamaged then
			f.flapsDamaged, f.flaps = true, 0
			table.insert(f.events, { type = "warn", text = "Закрылки повреждены скоростным напором — заблокированы" })
		end
	else
		f.flapStress = math.max(0, f.flapStress - dt)
	end
	if f.gear and not c.fixedGear and not f.onGround and f.speed > FlightPhysics.gearMaxKts(c) * 1.15 then
		f.gearStress += dt
		if f.gearStress > 3 and not f.gearStuck then
			f.gearStuck = true
			table.insert(f.events, { type = "warn", text = "Шасси повреждено на скорости — заклинило в выпущенном положении" })
		end
	else
		f.gearStress = math.max(0, f.gearStress - dt)
	end
	-- тряска: у сваливания, при превышении скорости и у предела перегрузки
	local bStall = if f.onGround then 0 else clamp((1.12 - f.speed / stall) / 0.12, 0, 1)
	local bSpeed = clamp((f.speed / c.maxKts - 1) / 0.1, 0, 1)
	local bG = clamp((f.gload - gMax * 0.85) / (gMax * 0.2), 0, 1)
	f.buffet = math.max(bStall, bSpeed, bG)

	f.vel = vel
	f.lastVelY = vel.Y
	-- ветер сносит самолёт в воздухе (воздушная скорость та же, меняется путевая)
	local drift = if f.wind and not f.onGround then f.wind * dt else Vector3.zero
	f.pos = pos + vel * dt + drift
	f.dbg = { agl = agl, lift = lift, eff = eff, stall = stall, thrust = thrust, drag = drag, accel = accel, thrustMul = thrustMul }
end

-- Ветер: направление «откуда дует» (°) и сила (kt) → вектор сноса; боковая составляющая к полосе
function FlightPhysics.windVector(dirDeg: number, kts: number): Vector3
	local d = math.rad(dirDeg)
	return Vector3.new(-math.sin(d), 0, math.cos(d)) * kts
end
function FlightPhysics.crosswind(dirDeg: number, kts: number, runwayHdg: number): number
	return math.abs(kts * math.sin(math.rad(dirDeg - runwayHdg)))
end

-- Действия кнопок (шасси/закрылки/реверс). Возвращает текст подсказки и цвет.
function FlightPhysics.action(f: Flight, a: string): (string?, string?)
	if f.crashed then
		return nil, nil
	end
	local c = f.cfg
	if a == "gear" then
		if f.gearStuck then
			return "Шасси заклинило в выпущенном положении", "amber"
		elseif c.fixedGear then
			return "У этого самолёта шасси не убирается", nil
		elseif f.onGround and f.gear then
			return "Нельзя убрать шасси на земле", "amber"
		end
		f.gear = not f.gear
		return if f.gear then "Шасси выпущено" else "Шасси убрано", nil
	elseif a == "flapDn" or a == "flapUp" then
		if c.noFlaps then
			return "У истребителя нет закрылков", nil
		end
		if f.flapsDamaged then
			return "Закрылки повреждены и заблокированы", "amber"
		end
		f.flaps = clamp(f.flaps + (if a == "flapDn" then 1 else -1), 0, 3)
		return "Закрылки: " .. f.flaps, nil
	elseif a == "rev" then
		if f.onGround then
			f.reverse = not f.reverse
			return if f.reverse then "Реверс включён, добавь тягу" else "Реверс выключен", "amber"
		end
		return "Реверс только на земле", nil
	elseif a == "spoiler" then
		f.spoilers = not f.spoilers
		return if f.spoilers then "Интерцепторы выпущены" else "Интерцепторы убраны", if f.spoilers then "amber" else nil
	elseif a == "idle" then
		f.throttle = 0
	end
	return nil, nil
end

function FlightPhysics.pose(f: Flight): CFrame
	return CFrame.new(f.pos) * f.att
end

-- Шаг не больше 1/60 с: при низком FPS перегрузка и защита fly-by-wire работают так же, как при 60 FPS
function FlightPhysics.step(f: Flight, input: Input, dt: number)
	local n = math.max(1, math.ceil(dt * 60 - 0.01))
	local h = dt / n
	for _ = 1, n do
		if f.crashed then
			break
		end
		stepOnce(f, input, h)
	end
end

return FlightPhysics
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000005"><Properties><string name="Name">Guide</string><ProtectedString name="Source"><![CDATA[--!strict
-- Инструкция по полёту для конкретного самолёта: цифры считаются из его характеристик
-- (те же формулы, что в веб-версии).
local FlightPhysics = require(script.Parent:WaitForChild("FlightPhysics"))

local Guide = {}

local function r5(v: number): number
	return math.floor(v / 5 + 0.5) * 5
end

function Guide.steps(c: any): { { string } }
	local flapsTo = if c.noFlaps then "без закрылков" else "закрылки 1–2 (F)"
	local v2 = r5(c.vrKts * 1.15)
	local flapsUp = r5(c.vrKts + 35)
	local cruiseAlt = math.floor(c.ceilingFt * 0.8 / 1000 + 0.5) * 1000
	local cruiseSpd = r5(c.maxKts * 0.8)
	local stall3 = c.stallKts * (if c.noFlaps then 1 else 0.79)
	local vapp = r5(stall3 * 1.3)
	local climb = if c.maxKts < 200 then "700–900" else "1500–2500"
	local gMax, gMin, fbw = FlightPhysics.limits(c)
	local gearMax = FlightPhysics.gearMaxKts(c)
	local limitText = string.format("Перегрузка от %+.1f до %+.1f G (индикатор G справа). %s Не быстрее %d kt%s%s.", gMax, gMin,
		if fbw
			then "Fly-by-wire не даст превысить предел, но на большой скорости штурвал всё равно тяни плавно."
			else "Защиты нет: резкий рывок штурвала на большой скорости повреждает самолёт, ×1,5 предела — разрушение.",
		c.maxKts,
		if c.noFlaps then "" else string.format(", закрылки — до %d kt", c.flapMaxKts),
		if c.fixedGear or gearMax >= 9999 then "" else string.format(", шасси выпускать до %d kt", gearMax))
	return {
		{ "1. Взлёт", string.format("Отпусти тормоз (пробел), %s, тяга 100%% (Shift). На %d kt плавно тяни на себя (S) до 8–10°, не больше %d°.", flapsTo, c.vrKts, c.maxRotate) },
		{ "2. Набор", string.format("После отрыва — шасси (G). Держи %d kt, вертикальная %s ft/min. Выше %d kt убери закрылки (R).", v2, climb, flapsUp) },
		{ "3. Крейсер", string.format("Эшелон около %s ft, скорость %d kt. Включи навигацию (N) и автопилот (P) — он сам долетит.", tostring(cruiseAlt), cruiseSpd) },
		{ "4. Снижение", "За 30–40 км до аэропорта снижайся 1500–2000 ft/min, уменьши тягу (Ctrl). Слишком быстро — интерцепторы (X). Набери 2000–3000 ft к 12 км." },
		{ "5. Заход", string.format("Скорость захода %d kt, %s, шасси выпущено. Держи ILS «на глиссаде ✓» (вертикальная ~700 ft/min).", vapp, if c.noFlaps then "без закрылков" else string.format("закрылки 3 (не быстрее %d kt)", c.flapMaxKts)) },
		{ "6. Посадка", string.format("Касание мягче 600 ft/min (лучше 250, лимит %d). После касания — тяга 0 (Z), интерцепторы (X), реверс (T), тормоз (B). У земли самолёт «держит» эффект земли — плавно выравнивай.", c.maxTouchdownFpm) },
		{ "7. Пределы", limitText },
	}
end

return Guide
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000006"><Properties><string name="Name">PlaneBuilder</string><ProtectedString name="Source"><![CDATA[--!strict
-- Строит модель самолёта из обычных деталей Roblox по PlaneConfigs.
-- Оси модели: нос -Z, верх +Y, правое крыло +X. Корень (Root) — центр фюзеляжа,
-- он стоит на высоте gearHeight над землёй, когда шасси касается полосы.
local PlaneBuilder = {}

type Ctx = { model: Model, root: BasePart, static: boolean, cfg: any }

local DARK = Color3.fromRGB(28, 32, 40)
local TIRE = Color3.fromRGB(25, 25, 25)
local METAL = Color3.fromRGB(150, 155, 162)

local function basePart(ctx: Ctx, cls: string, name: string, color: Color3, material: Enum.Material?): BasePart
	local p = Instance.new(cls) :: BasePart
	p.Name = name
	p.Color = color
	p.Material = material or Enum.Material.SmoothPlastic
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.CanCollide = false
	p.CanTouch = false
	p.CanQuery = false
	p.CastShadow = true
	p.Anchored = ctx.static
	p.Massless = true
	return p
end

local function attach(ctx: Ctx, p: BasePart, parent: Instance?)
	p.Parent = parent or ctx.model
	if not ctx.static then
		local w = Instance.new("WeldConstraint")
		w.Part0 = ctx.root
		w.Part1 = p
		w.Parent = p
	end
end

local function block(ctx: Ctx, name: string, size: Vector3, cf: CFrame, color: Color3, material: Enum.Material?, parent: Instance?): BasePart
	local p = basePart(ctx, "Part", name, color, material)
	p.Size = size
	p.CFrame = ctx.root.CFrame * cf
	attach(ctx, p, parent)
	return p
end

-- Эллипсоид: шар с SpecialMesh, можно любые полуоси
local function ellipsoid(ctx: Ctx, name: string, semi: Vector3, cf: CFrame, color: Color3, material: Enum.Material?, parent: Instance?): BasePart
	local p = basePart(ctx, "Part", name, color, material)
	p.Size = semi * 2
	local m = Instance.new("SpecialMesh")
	m.MeshType = Enum.MeshType.Sphere
	m.Parent = p
	p.CFrame = ctx.root.CFrame * cf
	attach(ctx, p, parent)
	return p
end

-- Цилиндр вдоль оси Z модели
local function cylZ(ctx: Ctx, name: string, length: number, diameter: number, pos: Vector3, color: Color3, material: Enum.Material?, parent: Instance?): BasePart
	local p = basePart(ctx, "Part", name, color, material)
	p.Shape = Enum.PartType.Cylinder
	p.Size = Vector3.new(length, diameter, diameter)
	p.CFrame = ctx.root.CFrame * CFrame.new(pos) * CFrame.Angles(0, math.pi / 2, 0)
	attach(ctx, p, parent)
	return p
end

-- Цилиндр вдоль оси Y модели (стойки шасси)
local function cylY(ctx: Ctx, name: string, length: number, diameter: number, pos: Vector3, color: Color3, parent: Instance?): BasePart
	local p = basePart(ctx, "Part", name, color, Enum.Material.Metal)
	p.Shape = Enum.PartType.Cylinder
	p.Size = Vector3.new(length, diameter, diameter)
	p.CFrame = ctx.root.CFrame * CFrame.new(pos) * CFrame.Angles(0, 0, math.pi / 2)
	attach(ctx, p, parent)
	return p
end

-- Треугольник из двух клиньев (классический приём для произвольных плоскостей)
local function triangle(ctx: Ctx, name: string, a: Vector3, b: Vector3, c: Vector3, thick: number, color: Color3, parent: Instance?)
	local ab, ac, bc = b - a, c - a, c - b
	local abd, acd, bcd = ab:Dot(ab), ac:Dot(ac), bc:Dot(bc)
	if abd > acd and abd > bcd then
		c, a = a, c
	elseif acd > bcd and acd > abd then
		a, b = b, a
	end
	ab, ac, bc = b - a, c - a, c - b
	local cross = ac:Cross(ab)
	if cross.Magnitude < 1e-6 then
		return
	end
	local rightV = cross.Unit
	local upV = bc:Cross(rightV).Unit
	local backV = bc.Unit
	local height = math.abs(ab:Dot(upV))
	local w1 = basePart(ctx, "WedgePart", name, color)
	w1.Size = Vector3.new(thick, math.max(height, 0.05), math.max(math.abs(ab:Dot(backV)), 0.05))
	w1.CFrame = ctx.root.CFrame * CFrame.fromMatrix((a + b) / 2, rightV, upV, backV)
	attach(ctx, w1, parent)
	local w2 = basePart(ctx, "WedgePart", name, color)
	w2.Size = Vector3.new(thick, math.max(height, 0.05), math.max(math.abs(ac:Dot(backV)), 0.05))
	w2.CFrame = ctx.root.CFrame * CFrame.fromMatrix((a + c) / 2, -rightV, upV, -backV)
	attach(ctx, w2, parent)
end

-- Трапециевидная плоскость: корневая/концевая передние кромки и хорды (хорда идёт в +Z)
local function panel(ctx: Ctx, name: string, rootLE: Vector3, rootChord: number, tipLE: Vector3, tipChord: number, thick: number, color: Color3)
	local rootTE = rootLE + Vector3.new(0, 0, rootChord)
	local tipTE = tipLE + Vector3.new(0, 0, tipChord)
	triangle(ctx, name, rootLE, rootTE, tipTE, thick, color)
	triangle(ctx, name, rootLE, tipTE, tipLE, thick, color)
end

local function light(ctx: Ctx, kind: string, pos: Vector3, color: Color3, size: number)
	local p = block(ctx, "Light", Vector3.one * size, CFrame.new(pos), color, Enum.Material.Neon)
	p.CastShadow = false
	p:SetAttribute("LightKind", kind)
	return p
end

function PlaneBuilder.build(cfg: any, opts: { static: boolean?, seat: boolean?, label: string? }?): Model
	local o = opts or {}
	local model = Instance.new("Model")
	model.Name = cfg.name
	model:SetAttribute("PlaneId", cfg.id)

	local L, D, span, chord = cfg.length, cfg.diameter, cfg.span, cfg.chord
	local col = cfg.colors
	local static = o.static == true

	local root = Instance.new("Part")
	root.Name = "Root"
	root.Size = Vector3.new(D * 0.5, D * 0.5, L * 0.5)
	root.Transparency = 1
	root.CanCollide = false
	root.CanTouch = false
	root.CanQuery = false
	root.Anchored = true
	root.Massless = false
	root.CFrame = CFrame.identity
	root.Parent = model
	model.PrimaryPart = root

	local ctx: Ctx = { model = model, root = root, static = static, cfg = cfg }

	-- ===== фюзеляж
	local Ln = math.max(D * 1.1, L * 0.12)
	local Lt = L * 0.24
	local cylLen = L - Ln - Lt
	local cylMid = -L / 2 + Ln + cylLen / 2
	local glossy = cfg.engines ~= "jet1" and cfg.engines ~= "prop"
	local fus = cylZ(ctx, "Fuselage", cylLen + 0.02, D, Vector3.new(0, 0, cylMid), col.body)
	local nose = ellipsoid(ctx, "Nose", Vector3.new(D / 2, D / 2, Ln), CFrame.new(0, 0, -L / 2 + Ln), col.body)
	local tcone = ellipsoid(ctx, "TailCone", Vector3.new(D / 2, D / 2, Lt), CFrame.new(0, 0, L / 2 - Lt), col.body)
	if glossy then
		-- лаковая краска: лёгкое отражение неба
		for _, part in { fus, nose, tcone } do
			part.Reflectance = 0.07
		end
	end
	if cfg.hump then
		ellipsoid(ctx, "Hump", Vector3.new(D * 0.4, D * 0.45, L * 0.2), CFrame.new(0, D * 0.28, -L / 2 + L * 0.24), col.body)
	end
	-- кабина
	if cfg.canopy then
		local cp = ellipsoid(ctx, "Canopy", Vector3.new(D * 0.3, D * 0.32, L * 0.13), CFrame.new(0, D * 0.42, -L / 2 + L * 0.3), Color3.fromRGB(60, 80, 100), Enum.Material.Glass)
		cp.Transparency = 0.25
	else
		-- остекление кабины: 3 панели на сторону по поверхности носового эллипсоида
		local z0 = -L / 2 + Ln
		for i, f in { 0.8, 0.7, 0.58 } do
			local zc = z0 - Ln * f
			local r = D / 2 * math.sqrt(1 - f * f)
			for _, s in { -1, 1 } do
				local ang = math.rad(18 + (i - 1) * 24)
				local x, y = s * r * math.sin(ang), r * math.cos(ang) * 0.92
				local mk = if cfg.mask then 1.45 else 1
				local pane = block(ctx, "CockpitWindow", Vector3.new(r * 0.42 * mk, 0.08 * D * mk, Ln * 0.11 * mk), CFrame.new(x, y, zc) * CFrame.Angles(math.rad(-38 + i * 8), 0, -s * ang), DARK, Enum.Material.Glass)
				pane.CastShadow = false
				pane.Reflectance = 0.25
			end
		end
	end
	-- иллюминаторы и двери (как у настоящих лайнеров), полоса ливреи
	for _, s in { -1, 1 } do
		if cfg.windows then
			local pitch = math.max(D * 0.11, 1.1)
			local z0 = -L / 2 + Ln * 1.05
			local z1 = L / 2 - Lt * 0.95
			local n = math.min(math.floor((z1 - z0) / pitch), 70)
			local step = (z1 - z0) / math.max(n, 1)
			-- двухпалубный (тип A380): два ряда иллюминаторов по всей длине
			local rows = if cfg.doubleDeck then { -0.02, 0.3 } else { 0.13 }
			local wx = s * math.sqrt(0.25 - 0.0169) * D
			for _, ry in rows do
				local wy = D * ry
				local rx = s * math.sqrt(0.25 - ry * ry) * D
				for i = 0, n do
					local z = z0 + i * step
					if i ~= 1 and i ~= n - 1 then
						local w = block(ctx, "Window", Vector3.new(D * 0.025, D * 0.055, D * 0.04), CFrame.new(rx, wy, z), DARK, Enum.Material.Glass)
						w.CastShadow = false
					end
				end
			end
			for _, z in { z0 + step * 1, z1 - step * 1 } do
				local door = block(ctx, "Door", Vector3.new(D * 0.02, D * 0.2, D * 0.085), CFrame.new(wx * 1.005, D * 0.05, z), Color3.fromRGB(170, 175, 182))
				door.CastShadow = false
			end
		end
		block(ctx, "Cheatline", Vector3.new(D * 0.04, D * 0.05, cylLen), CFrame.new(s * D * 0.49, -D * 0.06, cylMid), col.accent)
		-- «волна» ливреи: полоса фирменного цвета поднимается от брюха к хвосту
		if glossy and L > 50 then
			local zA, zB = cylMid + cylLen * 0.08, L / 2 - Lt * 0.55
			local N = 9
			for i = 0, N - 1 do
				local t0 = i / N
				local tm = (i + 0.5) / N
				local z = zA + (zB - zA) * tm
				local phi = math.rad(-62 + 92 * tm ^ 1.3) -- угол на окружности: снизу вверх
				local rad = D / 2 * (if z > L / 2 - Lt then math.max(0.35, (L / 2 - z) / Lt) ^ 0.6 else 1) + 0.03
				local seg = (zB - zA) / N * 1.08
				local band = block(ctx, "LiverySwoosh", Vector3.new(D * 0.02, D * (0.2 - 0.08 * t0), seg),
					CFrame.new(s * rad * math.cos(phi), rad * math.sin(phi), z) * CFrame.Angles(0, 0, if s == 1 then phi else math.pi - phi),
					if tm < 0.5 then col.accent else col.tail)
				band.CastShadow = false
				band.Reflectance = 0.07
			end
		end
	end
	-- брюхо светло-серое, как у настоящих лайнеров
	if L > 50 then
		local belly = ellipsoid(ctx, "Belly", Vector3.new(D * 0.47, D * 0.22, cylLen * 0.5), CFrame.new(0, -D * 0.3, cylMid), Color3.fromRGB(205, 210, 216))
		belly.CastShadow = false
	end

	-- ===== крыло
	local wy = if cfg.wing == "high" then D * 0.42 elseif cfg.wing == "low" then -D * 0.32 else 0
	local wz = -L / 2 + L * cfg.wingPos
	local taper = if cfg.sweep > 5 then 0.32 else 0.7
	local tipChord = chord * taper
	local half = span / 2
	local rootX = D * 0.35
	local l = half - rootX
	local tanS, tanD = math.tan(math.rad(cfg.sweep)), math.tan(math.rad(cfg.dihedral))
	local wingThick = math.clamp(chord * 0.09, 0.35, 3)
	local rootLEz = wz - chord / 2

	local function wingPoint(s: number, frac: number): (Vector3, number)
		-- передняя кромка и хорда на доле размаха frac (0 = корень, 1 = законцовка)
		local d = l * frac
		return Vector3.new(s * (rootX + d), wy + d * tanD, rootLEz + d * tanS), chord + (tipChord - chord) * frac
	end

	local flapsFolder = Instance.new("Folder")
	flapsFolder.Name = "Flaps"
	flapsFolder.Parent = model
	local gearFolder = Instance.new("Folder")
	gearFolder.Name = "Gear"
	gearFolder.Parent = model

	for _, s in { -1, 1 } do
		local rLE = Vector3.new(s * rootX, wy, rootLEz)
		local tLE, tChord = wingPoint(s, 1)
		local WINGC = if cfg.id == "F16" then col.body else Color3.fromRGB(214, 218, 224)
		panel(ctx, "Wing", rLE, chord, tLE, tChord, wingThick, WINGC)
		-- обтекатели механизации закрылков под задней кромкой
		if L > 80 then
			for _, fr in { 0.22, 0.42, 0.62 } do
				local le, ch = wingPoint(s, fr)
				ellipsoid(ctx, "FlapFairing", Vector3.new(chord * 0.03, chord * 0.045, ch * 0.28), CFrame.new(le.X, le.Y - wingThick * 0.6, le.Z + ch * 0.95), WINGC)
			end
		end
		-- подкосы крыла у лёгкого самолёта
		if cfg.wing == "high" then
			local a0 = Vector3.new(s * D * 0.45, -D * 0.3, wz)
			local tipP = wingPoint(s, 0.55)
			local a1 = Vector3.new(tipP.X, tipP.Y - wingThick * 0.5, wz)
			local mid = (a0 + a1) / 2
			local dir = (a1 - a0).Unit
			local strut = block(ctx, "Strut", Vector3.new((a1 - a0).Magnitude, 0.3, 0.6), CFrame.fromMatrix(mid, dir, Vector3.zAxis:Cross(dir).Unit), col.body)
			strut.CastShadow = false
		end
		-- закрылки на внутренней половине
		if not cfg.noFlaps then
			local fi, ci = wingPoint(s, 0.04)
			local fo, co = wingPoint(s, 0.5)
			local fc = math.min(ci, co) * 0.24
			local pIn = fi + Vector3.new(0, 0, ci - fc)
			local pOut = fo + Vector3.new(0, 0, co - fc)
			local u = ((pOut - pIn) * s).Unit -- всегда в +X, чтобы ось Y шарнира смотрела вверх
			local back = Vector3.zAxis - u * Vector3.zAxis:Dot(u)
			back = back.Unit
			local upV = back:Cross(u)
			local hinge = CFrame.fromMatrix((pIn + pOut) / 2, u, upV, back)
			local flap = basePart(ctx, "Part", "Flap", col.body)
			flap.Size = Vector3.new((pOut - pIn).Magnitude, wingThick * 0.7, fc)
			local c0 = hinge * CFrame.new(0, 0, fc / 2)
			flap.CFrame = root.CFrame * c0
			flap.Parent = flapsFolder
			if not static then
				local w = Instance.new("Weld")
				w.Name = "FlapWeld"
				w.Part0 = root
				w.Part1 = flap
				w.C0 = c0
				w:SetAttribute("Hinge", hinge)
				w:SetAttribute("Chord", fc)
				w.Parent = flap
			end
		end
		-- законцовки
		if cfg.winglets then
			local wlH = math.max(2, span * 0.045)
			local wlLE = tLE + Vector3.new(0, 0, tChord * 0.1)
			panel(ctx, "Winglet", wlLE, tChord * 0.8, wlLE + Vector3.new(s * wlH * 0.15, wlH, wlH * 0.6), tChord * 0.35, wingThick * 0.6, col.tail)
		end
		-- навигационные огни и стробы
		light(ctx, "nav", tLE + Vector3.new(0, 0, tChord * 0.3), if s < 0 then Color3.fromRGB(255, 40, 40) else Color3.fromRGB(40, 255, 90), math.max(0.6, D * 0.08))
		light(ctx, "strobe", tLE + Vector3.new(0, 0, tChord * 0.8), Color3.new(1, 1, 1), math.max(0.5, D * 0.06))
		-- след с законцовок (инверсионный след включает клиент на высоте)
		if not static then
			local a0 = Instance.new("Attachment")
			a0.Name = "TrailA"
			a0.Position = tLE + Vector3.new(0, 0.3, tChord)
			a0.Parent = root
			local a1 = Instance.new("Attachment")
			a1.Name = "TrailB"
			a1.Position = tLE + Vector3.new(0, -0.3, tChord)
			a1.Parent = root
			local tr = Instance.new("Trail")
			tr.Name = "Contrail"
			tr.Attachment0 = a0
			tr.Attachment1 = a1
			tr.Lifetime = 5
			tr.MinLength = 2
			tr.FaceCamera = true
			tr.WidthScale = NumberSequence.new(1, 6)
			tr.Transparency = NumberSequence.new(0.35, 1)
			tr.Color = ColorSequence.new(Color3.new(1, 1, 1))
			tr.LightEmission = 0.2
			tr.Enabled = false
			tr.Parent = root
		end
	end

	-- обтекатель стыка крыла и фюзеляжа
	if cfg.wing == "low" and L > 50 then
		ellipsoid(ctx, "WingFairing", Vector3.new(D * 0.46, D * 0.28, chord * 0.85), CFrame.new(0, -D * 0.28, wz + chord * 0.1), Color3.fromRGB(205, 210, 216))
	end

	-- ===== хвостовое оперение
	local finRoot = math.max(cfg.finHeight * 0.95, L * 0.1)
	local finLE = Vector3.new(0, D * 0.3, L / 2 - finRoot - L * 0.02)
	local finTanS = math.tan(math.rad(cfg.finSweep))
	local finTipLE = finLE + Vector3.new(0, cfg.finHeight, cfg.finHeight * finTanS)
	local finTip = finRoot * 0.5
	local finThick = math.clamp(finRoot * 0.08, 0.3, 2.5)
	-- плоскость киля вертикальная: строим треугольники напрямую
	triangle(ctx, "Fin", finLE, finLE + Vector3.new(0, 0, finRoot), finTipLE + Vector3.new(0, 0, finTip), finThick, col.tail)
	triangle(ctx, "Fin", finLE, finTipLE + Vector3.new(0, 0, finTip), finTipLE, finThick, col.tail)
	light(ctx, "beacon", finTipLE + Vector3.new(0, 0.4, finTip * 0.5), Color3.fromRGB(255, 40, 40), math.max(0.5, D * 0.07))
	-- форкиль и выхлоп ВСУ
	triangle(ctx, "Dorsal", finLE + Vector3.new(0, 0, -finRoot * 0.45), finLE, finLE + Vector3.new(0, cfg.finHeight * 0.18, finRoot * 0.12), finThick * 0.8, col.tail)
	if L > 50 then
		cylZ(ctx, "APU", 0.4, D * 0.09, Vector3.new(0, 0, L / 2 - 0.1), DARK, Enum.Material.Metal)
	end
	light(ctx, "beacon", Vector3.new(0, -D / 2 - 0.2, cylMid), Color3.fromRGB(255, 40, 40), math.max(0.5, D * 0.07))

	local hsRootChord = math.max(cfg.hstabSpan * 0.3, D * 0.6)
	local hsHalf = cfg.hstabSpan / 2
	local hsY, hsLEz, hsRootX
	if cfg.tail == "T" then
		hsY = finTipLE.Y - 0.2
		hsLEz = finTipLE.Z - finTip * 0.1
		hsRootX = 0
		hsRootChord = math.max(finTip * 1.1, hsRootChord * 0.8)
	else
		hsY = D * 0.08
		hsLEz = L / 2 - hsRootChord - L * 0.03
		hsRootX = D * 0.2
	end
	local hsTan = math.tan(math.rad(cfg.finSweep * 0.85))
	for _, s in { -1, 1 } do
		local r = Vector3.new(s * hsRootX, hsY, hsLEz)
		local d = hsHalf - hsRootX
		local t = Vector3.new(s * hsHalf, hsY + d * 0.05, hsLEz + d * hsTan)
		panel(ctx, "HStab", r, hsRootChord, t, hsRootChord * 0.45, math.clamp(hsRootChord * 0.08, 0.25, 2), col.body)
	end

	-- ===== двигатели
	local engines = Instance.new("Folder")
	engines.Name = "Engines"
	engines.Parent = model
	local eD = cfg.engineD or D * 0.4
	local eL = cfg.engineLen or eD * 2

	-- турбовентиляторный двигатель: губа воздухозаборника, вентилятор, кок, мотогондола, сопло и конус
	local function nacelle(pos: Vector3)
		cylZ(ctx, "Nacelle", eL * 0.78, eD, pos + Vector3.new(0, 0, eL * 0.02), col.engine, Enum.Material.SmoothPlastic, engines)
		cylZ(ctx, "Lip", eL * 0.08, eD * 1.02, pos + Vector3.new(0, 0, -eL * 0.4), Color3.fromRGB(225, 228, 232), Enum.Material.Metal, engines)
		-- вентилятор: тёмный диск + вращающийся ротор с 8 лопатками (Weld «FanWeld», крутит Animator)
		cylZ(ctx, "Fan", 0.2, eD * 0.86, pos + Vector3.new(0, 0, -eL * 0.36), Color3.fromRGB(32, 34, 40), Enum.Material.Metal, engines)
		local hub = basePart(ctx, "Part", "FanRotor", Color3.fromRGB(150, 156, 164), Enum.Material.Metal)
		hub.Shape = Enum.PartType.Cylinder
		hub.Size = Vector3.new(0.25, eD * 0.22, eD * 0.22)
		local hc0 = CFrame.new(pos + Vector3.new(0, 0, -eL * 0.385)) * CFrame.Angles(0, math.pi / 2, 0)
		hub.CFrame = ctx.root.CFrame * hc0
		hub.Parent = engines
		if not ctx.static then
			local w = Instance.new("Weld")
			w.Name = "FanWeld"
			w.Part0 = ctx.root
			w.Part1 = hub
			w.C0 = hc0
			w:SetAttribute("Base", hc0)
			w.Parent = hub
		end
		for i = 0, 7 do
			local blade = basePart(ctx, "Part", "FanBlade", Color3.fromRGB(140, 147, 156), Enum.Material.Metal)
			blade.Size = Vector3.new(0.12, eD * 0.3, eD * 0.1)
			blade.CFrame = hub.CFrame * CFrame.Angles(i / 8 * math.pi * 2, 0, 0) * CFrame.new(0, eD * 0.24, 0) * CFrame.Angles(0, 0.55, 0)
			blade.CastShadow = false
			blade.Parent = engines
			if not ctx.static then
				local wc = Instance.new("WeldConstraint")
				wc.Part0 = hub
				wc.Part1 = blade
				wc.Parent = blade
			end
		end
		ellipsoid(ctx, "Spinner", Vector3.new(eD * 0.15, eD * 0.15, eD * 0.2), CFrame.new(pos + Vector3.new(0, 0, -eL * 0.38)), Color3.fromRGB(200, 204, 210), Enum.Material.Metal, engines)
		cylZ(ctx, "Nozzle", eL * 0.2, eD * 0.72, pos + Vector3.new(0, 0, eL * 0.5), Color3.fromRGB(150, 154, 160), Enum.Material.Metal, engines)
		ellipsoid(ctx, "Plug", Vector3.new(eD * 0.22, eD * 0.22, eL * 0.18), CFrame.new(pos + Vector3.new(0, 0, eL * 0.6)), Color3.fromRGB(70, 72, 78), Enum.Material.Metal, engines)
		if cfg.id == "B787" then
			-- «шевроны» на сопле (зубцы против шума), как у Boeing 787
			for i = 0, 11 do
				local a = i / 12 * math.pi * 2
				block(ctx, "Chevron", Vector3.new(eD * 0.09, eD * 0.09, 0.15), CFrame.new(pos + Vector3.new(math.cos(a) * eD * 0.37, math.sin(a) * eD * 0.37, eL * 0.6)) * CFrame.Angles(0, 0, a + math.pi / 4), col.engine, Enum.Material.Metal, engines)
			end
		end
	end

	if cfg.engines == "wing2" or cfg.engines == "wing4" then
		local fracs = if cfg.engines == "wing2" then { 0.3 } else { 0.28, 0.58 }
		for _, s in { -1, 1 } do
			for _, fr in fracs do
				local le, ch = wingPoint(s, fr)
				local pos = Vector3.new(le.X, le.Y - eD * 0.65, le.Z - eL * 0.35)
				nacelle(pos)
				block(ctx, "Pylon", Vector3.new(eD * 0.15, eD * 0.5, math.min(eL * 0.8, ch)), CFrame.new(le.X, le.Y - eD * 0.3, le.Z + ch * 0.15), col.engine, Enum.Material.Metal, engines)
			end
		end
	elseif cfg.engines == "tail2" then
		for _, s in { -1, 1 } do
			local pos = Vector3.new(s * (D / 2 + eD * 0.55), D * 0.18, L / 2 - Lt - eL * 0.2)
			nacelle(pos)
			block(ctx, "Pylon", Vector3.new(eD * 0.6, eD * 0.2, eL * 0.5), CFrame.new(s * (D / 2), D * 0.18, pos.Z), col.engine, Enum.Material.Metal, engines)
		end
	elseif cfg.engines == "jet1" then
		cylZ(ctx, "Nozzle", eL * 0.6, eD, Vector3.new(0, 0, L / 2 - 0.5), DARK, Enum.Material.Metal, engines)
		local ab = cylZ(ctx, "Afterburner", 0.4, eD * 0.75, Vector3.new(0, 0, L / 2 + eL * 0.3 - 0.3), Color3.fromRGB(255, 140, 50), Enum.Material.Neon, engines)
		ab.Transparency = 1
		ab.CastShadow = false
		-- подфюзеляжные гребни и пусковые на законцовках
		for _, s in { -1, 1 } do
			triangle(ctx, "Ventral", Vector3.new(s * D * 0.25, -D * 0.45, L / 2 - L * 0.2), Vector3.new(s * D * 0.25, -D * 0.45, L / 2 - L * 0.08), Vector3.new(s * D * 0.35, -D * 0.85, L / 2 - L * 0.09), 0.25, col.body)
			local tLE2, tC2 = wingPoint(s, 1)
			cylZ(ctx, "Rail", tC2 * 1.6, 0.6, Vector3.new(tLE2.X + s * 0.4, tLE2.Y, tLE2.Z + tC2 * 0.4), Color3.fromRGB(220, 220, 220), Enum.Material.Metal, engines)
		end
		-- воздухозаборник под фюзеляжем
		block(ctx, "Intake", Vector3.new(D * 0.6, D * 0.4, L * 0.12), CFrame.new(0, -D * 0.45, wz - chord * 0.6), DARK, Enum.Material.Metal, engines)
	elseif cfg.engines == "prop" then
		ellipsoid(ctx, "Spinner", Vector3.new(D * 0.16, D * 0.16, D * 0.22), CFrame.new(0, 0, -L / 2 - D * 0.05), Color3.fromRGB(230, 230, 230), Enum.Material.Metal, engines)
		local prop = basePart(ctx, "Part", "Prop", DARK, Enum.Material.Metal)
		prop.Size = Vector3.new(D * 1.15, 0.35, 0.18)
		local pc0 = CFrame.new(0, 0, -L / 2 - D * 0.08)
		prop.CFrame = root.CFrame * pc0
		prop.Parent = engines
		if not static then
			local w = Instance.new("Weld")
			w.Name = "PropWeld"
			w.Part0 = root
			w.Part1 = prop
			w.C0 = pc0
			w:SetAttribute("Base", pc0)
			w.Parent = prop
		end
		local disc = basePart(ctx, "Part", "PropDisc", Color3.fromRGB(200, 200, 200), Enum.Material.Glass)
		disc.Shape = Enum.PartType.Cylinder
		disc.Size = Vector3.new(0.05, D * 1.15, D * 1.15)
		disc.CFrame = root.CFrame * pc0 * CFrame.Angles(0, math.pi / 2, 0)
		disc.Transparency = 1
		disc.CastShadow = false
		attach(ctx, disc, engines)
	end

	-- ===== шасси
	local gearLen = cfg.gearLen
	local wheelR = math.max(0.7, gearLen * 0.32)
	local wheelW = math.max(0.6, wheelR * 0.8)
	local wheelY = -cfg.gearHeight + wheelR
	local mainGear = {}
	local function leg(x: number, z: number, wheels: number, bogie: boolean?)
		local top = -D * 0.35
		cylY(ctx, "Strut", top - wheelY, math.max(0.25, wheelR * 0.35), Vector3.new(x, (top + wheelY) / 2, z), METAL, gearFolder)
		local rows = if bogie then { -wheelR * 1.15, wheelR * 1.15 } else { 0 }
		if bogie then
			block(ctx, "Bogie", Vector3.new(wheelW * 0.5, wheelR * 0.4, wheelR * 3.2), CFrame.new(x, wheelY, z), METAL, Enum.Material.Metal, gearFolder)
		end
		for _, dzz in rows do
			for k = 1, wheels do
				local off = if wheels == 1 then 0 else (k - 1.5) * wheelW * 1.15
				local w = basePart(ctx, "Part", "Wheel", TIRE, Enum.Material.Rubber)
				w.Shape = Enum.PartType.Cylinder
				w.Size = Vector3.new(wheelW, wheelR * 2, wheelR * 2)
				w.CFrame = root.CFrame * CFrame.new(x + off, wheelY, z + dzz)
				attach(ctx, w, gearFolder)
				local hub = basePart(ctx, "Part", "Hub", Color3.fromRGB(190, 192, 196), Enum.Material.Metal)
				hub.Shape = Enum.PartType.Cylinder
				hub.Size = Vector3.new(wheelW * 1.02, wheelR * 1.1, wheelR * 1.1)
				hub.CFrame = w.CFrame
				hub.CastShadow = false
				attach(ctx, hub, gearFolder)
			end
		end
	end
	local big = L > 100
	local noseZ = -L / 2 + math.max(L * 0.12, Ln * 0.9)
	leg(0, noseZ, if big then 2 else 1)
	-- посадочная фара на передней стойке
	local lampPart = block(ctx, "LandingLight", Vector3.one * math.max(0.4, wheelR * 0.4), CFrame.new(0, -D * 0.4 - gearLen * 0.3, noseZ - 0.5), Color3.fromRGB(255, 250, 230), Enum.Material.Neon, gearFolder)
	lampPart.CastShadow = false
	if not static then
		local sl = Instance.new("SpotLight")
		sl.Brightness = 4
		sl.Range = 60
		sl.Angle = 40
		sl.Face = Enum.NormalId.Front
		sl.Parent = lampPart
	end
	local mainZ = wz + chord * 0.25
	local mainX = if cfg.wing == "high" then D * 0.75 else math.max(D * 0.55, span * 0.08)
	for _, s in { -1, 1 } do
		leg(s * mainX, mainZ, if big then 2 else 1, L > 130)
		table.insert(mainGear, Vector3.new(s * mainX, -cfg.gearHeight, mainZ))
		if cfg.id == "B747" then
			leg(s * D * 0.3, mainZ + chord * 0.15, 2, true)
		end
	end
	if not static then
		for i, p in mainGear do
			local a = Instance.new("Attachment")
			a.Name = "MainGear" .. i
			a.Position = p
			a.Parent = root
		end
	end

	-- ===== кресло пилота
	if o.seat and not static then
		local seat = Instance.new("Seat")
		seat.Name = "PilotSeat"
		seat.Size = Vector3.new(2, 0.4, 2)
		seat.Transparency = 1
		seat.CanCollide = false
		seat.CanTouch = false
		seat.Massless = true
		local seatY = if D < 8 then -D * 0.3 else -D * 0.15
		seat.CFrame = root.CFrame * CFrame.new(0, seatY, -L / 2 + Ln * 0.85 + 1.5)
		seat.Parent = model
		local w = Instance.new("WeldConstraint")
		w.Part0 = root
		w.Part1 = seat
		w.Parent = seat
	end

	-- ===== подпись
	if o.label then
		local bb = Instance.new("BillboardGui")
		bb.Name = "Tag"
		bb.Size = UDim2.fromOffset(220, 40)
		bb.StudsOffsetWorldSpace = Vector3.new(0, D + cfg.finHeight + 6, 0)
		bb.MaxDistance = 4000
		bb.AlwaysOnTop = false
		bb.LightInfluence = 0
		local t = Instance.new("TextLabel")
		t.Size = UDim2.fromScale(1, 1)
		t.BackgroundTransparency = 1
		t.Text = o.label
		t.TextColor3 = Color3.fromRGB(228, 238, 255)
		t.TextStrokeTransparency = 0.4
		t.Font = Enum.Font.GothamBold
		t.TextScaled = true
		t.Parent = bb
		bb.Parent = root
	end

	if static then
		for _, d in model:GetDescendants() do
			if d:IsA("BasePart") then
				d.Anchored = true
			end
		end
	end
	return model
end

-- Положение закрылков (0..3) — меняет C0 сварки, работает локально у каждого клиента
function PlaneBuilder.setFlaps(model: Model, flaps: number)
	local f = model:FindFirstChild("Flaps")
	if not f then
		return
	end
	for _, flap in f:GetChildren() do
		local w = flap:FindFirstChild("FlapWeld") :: Weld?
		if w then
			local hinge = w:GetAttribute("Hinge") :: CFrame?
			local fc = w:GetAttribute("Chord") :: number?
			if hinge and fc then
				w.C0 = hinge * CFrame.Angles(math.rad(flaps * 11), 0, 0) * CFrame.new(0, 0, fc / 2)
			end
		end
	end
end

function PlaneBuilder.setGearVisible(model: Model, visible: boolean)
	local g = model:FindFirstChild("Gear")
	if not g then
		return
	end
	for _, p in g:GetChildren() do
		if p:IsA("BasePart") then
			p.LocalTransparencyModifier = if visible then 0 else 1
			local sl = p:FindFirstChildOfClass("SpotLight")
			if sl then
				sl.Enabled = visible
			end
		end
	end
end

return PlaneBuilder
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000007"><Properties><string name="Name">PlaneConfigs</string><ProtectedString name="Source"><![CDATA[--!strict
-- Те же PlaneConfigs, что и в HTML-полигоне Sky Pilot (1 stud/s = 1 kt, 1 stud = 1.69 ft).
local WHITE = Color3.fromHex("f3f5f8")
local GREY = Color3.fromHex("c4c8ce")

export type Config = {
	id: string, name: string, cls: string,
	length: number, diameter: number, span: number, chord: number,
	wing: string, wingPos: number, sweep: number, dihedral: number,
	engines: string, engineD: number?, engineLen: number?,
	tail: string, hstabSpan: number, finHeight: number, finSweep: number,
	gearLen: number, gearHeight: number,
	fixedGear: boolean?, windows: boolean?, winglets: boolean?, hump: boolean?, canopy: boolean?, noFlaps: boolean?, doubleDeck: boolean?, mask: boolean?,
	thrust: number, maxKts: number, stallKts: number, vrKts: number, flapMaxKts: number,
	pitchRate: number, rollRate: number, yawRate: number, turnBoost: number,
	groundSteer: number, brakeDecel: number, stallSink: number, maxRotate: number,
	ceilingFt: number, maxTouchdownFpm: number,
	colors: { body: Color3, accent: Color3, tail: Color3, engine: Color3 },
}

local PLANES: { [string]: any } = {
	C172 = { name = "Cessna 172 Skyhawk", cls = "Лёгкий учебный", length = 29, diameter = 6, span = 39, chord = 5.5, wing = "high", wingPos = 0.38, sweep = 0, dihedral = 2, engines = "prop", tail = "conventional", hstabSpan = 13, finHeight = 8, finSweep = 35, gearLen = 3, fixedGear = true, thrust = 4.6, maxKts = 125, stallKts = 48, vrKts = 55, flapMaxKts = 85, pitchRate = 0.7, rollRate = 1.4, yawRate = 0.45, turnBoost = 2.5, groundSteer = 0.9, brakeDecel = 6, stallSink = 30, maxRotate = 12, ceilingFt = 14000, maxTouchdownFpm = 1100,
