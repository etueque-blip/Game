<Item class="ServerScriptService" referent="RBX00000017"><Properties><string name="Name">ServerScriptService</string></Properties><Item class="Script" referent="RBX0000000D"><Properties><string name="Name">SkyPilotServer</string><ProtectedString name="Source"><![CDATA[--!strict
-- Sky Pilot — сервер: мир, выдача самолётов, посадка пилота, очки, крушения, ИИ-трафик.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local PhysicsService = game:GetService("PhysicsService")
local Debris = game:GetService("Debris")

local Shared = ReplicatedStorage:WaitForChild("SkyPilot")
local World = require(Shared:WaitForChild("World"))
local PlaneConfigs = require(Shared:WaitForChild("PlaneConfigs"))
local PlaneBuilder = require(Shared:WaitForChild("PlaneBuilder"))

local WorldBuilder = require(script:WaitForChild("WorldBuilder"))
local Scores = require(script:WaitForChild("Scores"))
local AITraffic = require(script:WaitForChild("AITraffic"))

local AI_TRAFFIC_COUNT = 5 -- 0 = без ботов
local DAY_LENGTH_MIN = 40 -- полные сутки за 40 минут реального времени; 0 = всегда день

-- ===== группы столкновений: самолёт и пилот не цепляются за землю (столкновения считает физика игры)
local FLYING = "SkyPilotFlying"
local DEBRIS = "SkyPilotDebris"
for _, g in { FLYING, DEBRIS } do
	if not PhysicsService:IsCollisionGroupRegistered(g) then
		PhysicsService:RegisterCollisionGroup(g)
	end
end
PhysicsService:CollisionGroupSetCollidable(FLYING, "Default", false)
PhysicsService:CollisionGroupSetCollidable(FLYING, FLYING, false)
PhysicsService:CollisionGroupSetCollidable(FLYING, DEBRIS, false)
PhysicsService:CollisionGroupSetCollidable(DEBRIS, DEBRIS, false)

-- ===== удалённые события
local remotes = Instance.new("Folder")
remotes.Name = "SkyPilotRemotes"
local function remote(name: string): RemoteEvent
	local r = Instance.new("RemoteEvent")
	r.Name = name
	r.Parent = remotes
	return r
end
local RequestFlight = remote("RequestFlight")
local FlightStarted = remote("FlightStarted")
local ClientReady = remote("ClientReady")
local PlaneState = remote("PlaneState")
local Landing = remote("Landing")
local CrashEvent = remote("Crash")
local EndFlight = remote("EndFlight")
local Notify = remote("Notify")
local RaceFinished = remote("RaceFinished")
local GateParked = remote("GateParked")
local AchievementRemote = remote("Achievement")
remotes.Parent = ReplicatedStorage

WorldBuilder.build()
local planesFolder = workspace:WaitForChild("Planes")

type Active = {
	model: Model, root: BasePart, cfgId: string, mode: string,
	started: number, lastLanding: number, fromAirport: string?, destination: string?, ready: boolean, crashed: boolean,
	conns: { RBXScriptConnection },
}
local active: { [Player]: Active } = {}
local lastRequest: { [Player]: number } = {}
local rng = Random.new()

local function setGroup(inst: Instance, group: string)
	for _, d in inst:GetDescendants() do
		if d:IsA("BasePart") then
			d.CollisionGroup = group
		end
	end
	if inst:IsA("BasePart") then
		inst.CollisionGroup = group
	end
end

local function cleanup(p: Player, destroyModel: boolean)
	local a = active[p]
	if not a then
		return
	end
	active[p] = nil
	for _, c in a.conns do
		c:Disconnect()
	end
	if destroyModel and a.model.Parent then
		a.model:Destroy()
	end
end

local function slotFree(cf: CFrame): boolean
	for _, a in active do
		if a.root.Parent and (a.root.Position - cf.Position).Magnitude < 450 then
			return false
		end
	end
	return true
end

-- режимы: "runway:<id аэропорта>", "air" (заход на полосу A), "race" (перед первым кольцом)
local function runwayId(mode: string): string?
	return mode:match("^runway:(%u)$")
end

local function pickSpawn(cfg: any, mode: string): (CFrame, boolean, string?)
	if mode == "race" then
		local r = World.CityData.rings[1]
		local look = Vector3.new(-math.sin(r[5]), 0, -math.cos(r[5]))
		local pos = Vector3.new(r[1], r[2], r[3]) - look * 1500 + Vector3.new(rng:NextNumber(-40, 40), 0, rng:NextNumber(-40, 40))
		return CFrame.lookAt(pos, pos + look), true, nil
	end
	local id = runwayId(mode)
	if id then
		local ap = World.airportById(id)
		if ap then
			for _, cf in World.runwaySpawns(ap, cfg) do
				if slotFree(cf) then
					return cf, false, ap.id
				end
			end
		end
	end
	-- в воздухе: заход на полосу 36 аэропорта A с небольшим разносом между игроками
	local cf = CFrame.new(rng:NextNumber(-600, 600), 3000 / World.FT + rng:NextNumber(-60, 60), 9000 + rng:NextNumber(0, 1500))
	return cf, true, nil
end

local function ensureCharacter(p: Player): Humanoid?
	local ch = p.Character
	local hum = ch and ch:FindFirstChildOfClass("Humanoid")
	if not hum or hum.Health <= 0 or not (ch :: Model).PrimaryPart then
		p:LoadCharacter()
		ch = p.Character or p.CharacterAdded:Wait()
		hum = (ch :: Model):WaitForChild("Humanoid", 5) :: Humanoid?
		;(ch :: Model):WaitForChild("HumanoidRootPart", 5)
	end
	return hum
end

local function explode(a: Active)
	local model = a.model
	if not model.Parent then
		return
	end
	local root = a.root
	local v = root.AssemblyLinearVelocity * 0.25
	local pos = root.Position
	local ex = Instance.new("Explosion")
	ex.Position = pos
	ex.BlastRadius = 0
	ex.BlastPressure = 0
	ex.DestroyJointRadiusPercent = 0
	ex.Parent = workspace
	local fire = Instance.new("Part")
	fire.Anchored = true
	fire.CanCollide = false
	fire.Transparency = 1
	fire.Size = Vector3.one
	fire.CFrame = CFrame.new(pos.X, math.max(pos.Y, World.groundAt(pos.X, pos.Z) + 1), pos.Z)
	local smoke = Instance.new("Smoke")
	smoke.Size = math.clamp(model:GetExtentsSize().Magnitude * 0.15, 8, 60)
	smoke.RiseVelocity = 12
	smoke.Color = Color3.fromRGB(40, 40, 40)
	smoke.Parent = fire
	local fl = Instance.new("Fire")
	fl.Size = math.clamp(model:GetExtentsSize().Magnitude * 0.08, 5, 30)
	fl.Parent = fire
	fire.Parent = workspace
	Debris:AddItem(fire, 12)
	-- разлёт обломков
	model.Name = "Wreck"
	for _, d in model:GetDescendants() do
		if d:IsA("JointInstance") or d:IsA("WeldConstraint") then
			d:Destroy()
		end
	end
	for _, d in model:GetDescendants() do
		if d:IsA("BasePart") then
			d.Anchored = false
			d.CanCollide = true
			d.CollisionGroup = DEBRIS
			d.Massless = false
			d.AssemblyLinearVelocity = v + Vector3.new(rng:NextNumber(-1, 1), rng:NextNumber(0.3, 1.5), rng:NextNumber(-1, 1)) * rng:NextNumber(20, 80)
			d.AssemblyAngularVelocity = Vector3.new(rng:NextNumber(-3, 3), rng:NextNumber(-3, 3), rng:NextNumber(-3, 3))
		elseif d:IsA("BillboardGui") or d:IsA("Trail") or d:IsA("Seat") then
			d:Destroy()
		end
	end
	Debris:AddItem(model, 10)
end
PhysicsService:CollisionGroupSetCollidable(DEBRIS, "Default", true)

local function startFlight(p: Player, planeId: any, mode: any, destination: any, liveryId: any)
	if type(planeId) ~= "string" or type(mode) ~= "string" then
		return
	end
	local cfg = PlaneConfigs.PLANES[planeId]
	local rid = runwayId(mode)
	if not cfg or not (mode == "air" or mode == "race" or (rid and World.airportById(rid))) then
		return
	end
	if destination ~= nil and (type(destination) ~= "string" or not World.airportById(destination) or destination == rid) then
		destination = nil
	end
	local now = os.clock()
	if lastRequest[p] and now - lastRequest[p] < 1.5 then
		return
	end
	lastRequest[p] = now

	local old = active[p]
	if old then
		cleanup(p, true)
	end
	local hum = ensureCharacter(p)
	if not hum or not p.Parent then
		return
	end
	local character = p.Character :: Model

	local spawnCF, air, ap = pickSpawn(cfg, mode)
	if rid and air then
		Notify:FireClient(p, "Полоса занята — старт в воздухе", "amber")
	end
	local buildCfg = cfg
	if type(liveryId) == "string" then
		for _, lv in (PlaneConfigs :: any).LIVERIES do
			if lv.id == liveryId and lv.colors then
				buildCfg = table.clone(cfg)
				buildCfg.colors = lv.colors
			end
		end
	end
	local model = PlaneBuilder.build(buildCfg, { seat = true, label = p.DisplayName })
	model.Name = p.Name .. "_Plane"
	model:SetAttribute("Owner", p.UserId)
	model:SetAttribute("Gear", air == false or cfg.fixedGear == true)
	model:SetAttribute("Flaps", 0)
	model:SetAttribute("Throttle", if air then 0.7 else 0)
	model:PivotTo(spawnCF)
	local root = model.PrimaryPart :: BasePart
	root.Anchored = true
	setGroup(model, FLYING)
	model.Parent = planesFolder

	local seat = model:FindFirstChild("PilotSeat") :: Seat
	setGroup(character, FLYING)
	seat:Sit(hum)

	local a: Active = {
		model = model, root = root, cfgId = planeId, mode = if air then "air" else mode,
		started = now, lastLanding = 0, fromAirport = ap, destination = destination, ready = false, crashed = false, conns = {},
	}
	active[p] = a
	Scores.flight(p)

	table.insert(a.conns, hum.Died:Connect(function()
		if active[p] == a then
			cleanup(p, true)
		end
	end))
	task.delay(1, function()
		if active[p] ~= a then
			return
		end
		table.insert(a.conns, seat:GetPropertyChangedSignal("Occupant"):Connect(function()
			if seat.Occupant == nil and active[p] == a and not a.crashed then
				cleanup(p, true)
				EndFlight:FireClient(p)
			end
		end))
	end)

	FlightStarted:FireClient(p, model, planeId, a.mode, spawnCF)
end

-- достижения: открыть один раз, начислить награду, сообщить игроку
local Achievements = require(Shared:WaitForChild("Achievements"))
local function award(p: Player, id: string)
	local ach = Achievements.BY_ID[id]
	if ach and Scores.unlock(p, id) then
		Scores.add(p, ach.reward, false)
		Notify:FireClient(p, string.format("🏆 Достижение «%s» · +%d", ach.title, ach.reward), "green")
	end
end
-- то, что видит только клиент (высота, перегрузка, ось полосы, отрыв): принимаем только из белого списка во время полёта
AchievementRemote.OnServerEvent:Connect(function(p, id)
	local a = active[p]
	if type(id) ~= "string" or not a or a.crashed then
		return
	end
	local ach = Achievements.BY_ID[id]
	if not ach or not ach.client then
		return
	end
	if id == "ace" and a.cfgId ~= "F16" then
		return
	end
	award(p, id)
end)

RequestFlight.OnServerEvent:Connect(function(p, planeId, mode, destination, liveryId)
	startFlight(p, planeId, mode, destination, liveryId)
end)

ClientReady.OnServerEvent:Connect(function(p, model)
	local a = active[p]
	if not a or a.ready or model ~= a.model then
		return
	end
	a.ready = true
	a.root.Anchored = false
	pcall(function()
		a.root:SetNetworkOwner(p)
	end)
end)

PlaneState.OnServerEvent:Connect(function(p, gear, flaps, throttle, reverse)
	local a = active[p]
	if not a then
		return
	end
	if type(gear) == "boolean" then
		a.model:SetAttribute("Gear", gear)
	end
	if type(flaps) == "number" then
		a.model:SetAttribute("Flaps", math.clamp(math.floor(flaps), 0, 3))
	end
	if type(throttle) == "number" then
		a.model:SetAttribute("Throttle", math.clamp(throttle, 0, 1))
	end
	if type(reverse) == "boolean" then
		a.model:SetAttribute("Reverse", reverse)
	end
end)

Landing.OnServerEvent:Connect(function(p, fpm)
	local a = active[p]
	if not a or a.crashed or type(fpm) ~= "number" then
		return
	end
	local now = os.clock()
	if now - a.lastLanding < 8 or now - a.started < 5 then
		return
	end
	local pos = a.root.Position
	local apId = World.runwayAt(pos.X, pos.Z, 40)
	if not apId or pos.Y - World.groundAt(pos.X, pos.Z) > 80 then
		Notify:FireClient(p, "Посадка вне полосы — очки не начислены", "amber")
		return
	end
	a.lastLanding = now
	fpm = math.max(0, math.floor(fpm))
	local pts = if fpm < 120 then 400 elseif fpm < 250 then 300 elseif fpm < 600 then 150 else 50
	local msg = string.format("+%d очков за посадку", pts)
	if a.fromAirport and a.fromAirport ~= apId then
		pts += 500
		msg ..= string.format("  ·  +500 за перелёт %s → %s", a.fromAirport, apId)
	end
	-- рейс (карьера): посадка в аэропорту назначения
	if a.destination and a.destination == apId then
		pts += 1000
		local dst = World.airportById(apId)
		msg ..= string.format("  ·  РЕЙС ВЫПОЛНЕН +1000 (%s)", if dst then dst.code else apId)
		a.destination = nil
	end
	local routeDone = a.destination == nil and msg:find("РЕЙС ВЫПОЛНЕН", 1, true) ~= nil
	a.fromAirport = apId
	Scores.add(p, pts, true, fpm)
	Notify:FireClient(p, msg, "green")
	-- достижения за посадку
	if fpm < 250 then
		award(p, "soft")
	end
	if fpm < 80 then
		award(p, "butter")
	end
	if routeDone then
		award(p, "route")
	end
	if Scores.visit(p, apId) >= #World.AIRPORTS then
		award(p, "airports")
	end
	if Scores.get(p).landings >= 10 then
		award(p, "ten")
	end
	local clock = game:GetService("Lighting").ClockTime
	if clock < 5.5 or clock > 19.5 then
		award(p, "night")
	end
	if a.cfgId == "A380" or a.cfgId == "B747" then
		award(p, "heavy")
	end
end)

CrashEvent.OnServerEvent:Connect(function(p, reason)
	local a = active[p]
	if not a or a.crashed then
		return
	end
	a.crashed = true
	local name = p.DisplayName
	if type(reason) == "string" then
		print(string.format("[SkyPilot] %s: крушение — %s", name, reason:sub(1, 120)))
	end
	cleanup(p, false)
	explode(a)
	-- пилот «катапультировался» в терминал
	task.delay(0.3, function()
		if p.Parent and not active[p] then
			p:LoadCharacter()
		end
	end)
end)

-- рейс завершён у гейта: самолёт стоит на стоянке вскоре после посадки
local gateDone: { [Player]: number } = {}
GateParked.OnServerEvent:Connect(function(p, standId)
	local a = active[p]
	if not a or a.crashed or type(standId) ~= "string" then
		return
	end
	local now = os.clock()
	if a.lastLanding == 0 or now - a.lastLanding > 600 or (gateDone[p] and gateDone[p] >= a.lastLanding) then
		return
	end
	local pos = a.root.Position
	for _, list in World.STANDS do
		for _, st in list do
			if st.id == standId and (Vector3.new(pos.X - st.x, 0, pos.Z - st.z)).Magnitude < 70 and a.root.AssemblyLinearVelocity.Magnitude < 8 then
				gateDone[p] = a.lastLanding
				Scores.add(p, 500, false)
				Notify:FireClient(p, string.format("Рейс завершён у гейта %s · +500", standId), "green")
				return
			end
		end
	end
end)

-- гонка через кольца: минимальное правдоподобное время ~60 с даже для истребителя
local lastRace: { [Player]: number } = {}
RaceFinished.OnServerEvent:Connect(function(p, t)
	local a = active[p]
	if not a or type(t) ~= "number" or t < 60 or t > 3600 then
		return
	end
	local now = os.clock()
	if lastRace[p] and now - lastRace[p] < 60 then
		return
	end
	lastRace[p] = now
	Scores.add(p, 1500, false)
	local best = p:GetAttribute("BestRace")
	local msg = string.format("+1500 очков за гонку · %d:%04.1f", math.floor(t / 60), t % 60)
	if type(best) ~= "number" or t < best then
		p:SetAttribute("BestRace", t)
		msg ..= " · новый рекорд!"
	end
	Notify:FireClient(p, msg, "green")
	award(p, "race")
end)

EndFlight.OnServerEvent:Connect(function(p)
	if active[p] then
		cleanup(p, true)
		p:LoadCharacter()
	end
end)

Players.PlayerAdded:Connect(function(p)
	Scores.load(p)
end)
for _, p in Players:GetPlayers() do
	task.spawn(Scores.load, p)
end
Players.PlayerRemoving:Connect(function(p)
	cleanup(p, true)
	lastRequest[p] = nil
	lastRace[p] = nil
	Scores.unload(p)
end)

-- смена дня и ночи (видна всем игрокам, огни полос и самолётов ночью светятся)
if DAY_LENGTH_MIN > 0 then
	local Lighting = game:GetService("Lighting")
	Lighting.ClockTime = 10
	-- ветер: общий для всех игроков, плавно меняется (атрибуты workspace WindDir / WindKts)
	local wind = { dir = math.random(0, 359), kts = math.random(3, 12), tDir = 0, tKts = 0, nextAt = 0 }
	wind.tDir, wind.tKts = wind.dir, wind.kts
	task.spawn(function()
		local last = os.clock()
		while true do
			task.wait(1)
			local now = os.clock()
			if now > wind.nextAt then
				wind.tDir = (wind.dir + math.random(-70, 70)) % 360
				wind.tKts = math.floor(math.random() ^ 1.6 * 25)
				wind.nextAt = now + math.random(300, 600)
			end
			local dd = ((wind.tDir - wind.dir + 540) % 360) - 180
			wind.dir = (wind.dir + math.clamp(dd, -0.4, 0.4)) % 360
			wind.kts += math.clamp(wind.tKts - wind.kts, -0.04, 0.04)
			workspace:SetAttribute("WindDir", math.round(wind.dir))
			workspace:SetAttribute("WindKts", math.round(wind.kts * 10) / 10)
			Lighting.ClockTime = (Lighting.ClockTime + (now - last) * 24 / (DAY_LENGTH_MIN * 60)) % 24
			last = now
			WorldBuilder.updateSky(Lighting.ClockTime)
		end
	end)
end

if AI_TRAFFIC_COUNT > 0 then
	AITraffic.start(AI_TRAFFIC_COUNT)
end
]]></ProtectedString></Properties><Item class="ModuleScript" referent="RBX0000000A"><Properties><string name="Name">AITraffic</string><ProtectedString name="Source"><![CDATA[--!strict
-- ИИ-пилоты (боты-«агенты»): летают по маршрутам между аэропортами и городом
-- на той же физике, что и игроки, управляются автопилотом.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("SkyPilot")
local World = require(Shared:WaitForChild("World"))
local PlaneConfigs = require(Shared:WaitForChild("PlaneConfigs"))
local PlaneBuilder = require(Shared:WaitForChild("PlaneBuilder"))
local FlightPhysics = require(Shared:WaitForChild("FlightPhysics"))
local Autopilot = require(Shared:WaitForChild("Autopilot"))

local AITraffic = {}

local COUNT = 5
local TYPES = { "B737", "A220", "A320", "B787", "A330", "A350", "B777", "B747", "A380", "G650", "GL7500", "LEAR75", "C172" }
local WAYPOINTS = {
	Vector3.new(0, 0, -9000), Vector3.new(9000, 0, -14000), Vector3.new(20000, 0, -18000),
	Vector3.new(16000, 0, -6000), Vector3.new(5500, 0, -7500), Vector3.new(-6000, 0, 2000),
	Vector3.new(-2000, 0, 14000), Vector3.new(8000, 0, 9000), Vector3.new(-18000, 0, -2000),
}

type Bot = { model: Model, root: BasePart, flight: FlightPhysics.Flight, wp: number, altFt: number, speed: number, retarget: number }
local bots: { Bot } = {}
local rng = Random.new()

local function spawnBot(): Bot
	local id = TYPES[rng:NextInteger(1, #TYPES)]
	local cfg = PlaneConfigs.PLANES[id]
	local callsign = string.format("SKY%03d", rng:NextInteger(100, 999))
	local model = PlaneBuilder.build(cfg, { label = callsign .. " · ИИ" })
	model.Name = "AI_" .. callsign
	model:SetAttribute("AI", true)
	model:SetAttribute("Gear", false)
	model:SetAttribute("Throttle", 0.7)
	local wp = rng:NextInteger(1, #WAYPOINTS)
	local start = WAYPOINTS[wp] + Vector3.new(rng:NextNumber(-3000, 3000), 0, rng:NextNumber(-3000, 3000))
	-- безопасная высота: выше гор с запасом и ниже потолка
	local altFt = math.min(cfg.ceilingFt * 0.7, rng:NextNumber(4500, 11000))
	local cf = CFrame.new(start.X, altFt / World.FT, start.Z) * CFrame.Angles(0, rng:NextNumber(0, math.pi * 2), 0)
	local f = FlightPhysics.new(cfg, cf, true)
	f.gear = cfg.fixedGear == true
	f.speed = math.min(cfg.maxKts * 0.72, cfg.stallKts * 2.2)
	model:PivotTo(cf)
	model.Parent = workspace:WaitForChild("Planes")
	local root = model.PrimaryPart :: BasePart
	root.Anchored = false
	pcall(function()
		root:SetNetworkOwner(nil)
	end)
	return { model = model, root = root, flight = f, wp = (wp % #WAYPOINTS) + 1, altFt = altFt, speed = f.speed, retarget = 0 }
end

local function stepBot(b: Bot, dt: number)
	local f = b.flight
	local target = WAYPOINTS[b.wp]
	local flat = Vector3.new(f.pos.X, 0, f.pos.Z)
	if (flat - target).Magnitude < 1500 then
		b.wp = (b.wp % #WAYPOINTS) + 1
		b.altFt = math.min(f.cfg.ceilingFt * 0.7, rng:NextNumber(4500, 11000))
	end
	local input = Autopilot.compute(f, { heading = Autopilot.bearingDeg(flat, target), altFt = b.altFt, speed = b.speed, maxBank = 22 })
	FlightPhysics.step(f, input, dt)
	table.clear(f.events)
	if f.crashed then
		return false
	end
	b.root.CFrame = FlightPhysics.pose(f)
	b.root.AssemblyLinearVelocity = f.vel
	b.root.AssemblyAngularVelocity = Vector3.zero
	return true
end

function AITraffic.start(count: number?)
	for _ = 1, count or COUNT do
		table.insert(bots, spawnBot())
	end
	RunService.PreSimulation:Connect(function(dt)
		for i, b in bots do
			local ok = stepBot(b, dt)
			if not ok or not b.model.Parent then
				b.model:Destroy()
				bots[i] = spawnBot()
			end
		end
	end)
end

return AITraffic
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX0000000B"><Properties><string name="Name">Scores</string><ProtectedString name="Source"><![CDATA[--!strict
-- Очки и статистика игрока (leaderstats + DataStore, если включён доступ к API).
local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")

local Scores = {}

local store: DataStore? = nil
pcall(function()
	store = DataStoreService:GetDataStore("SkyPilot_v1")
end)

type Data = { score: number, landings: number, best: number, flights: number, ach: { [string]: boolean }, visited: { [string]: boolean } }
local cache: { [Player]: Data } = {}

local function key(p: Player): string
	return "u_" .. p.UserId
end

local function stat(p: Player, name: string, value: number)
	local ls = p:FindFirstChild("leaderstats")
	local v = ls and ls:FindFirstChild(name) :: IntValue?
	if v then
		v.Value = value
	end
end

function Scores.get(p: Player): Data
	return cache[p] or { score = 0, landings = 0, best = 0, flights = 0, ach = {}, visited = {} }
end

local function refresh(p: Player)
	local d = Scores.get(p)
	stat(p, "Очки", d.score)
	stat(p, "Посадки", d.landings)
	p:SetAttribute("BestFpm", d.best)
	-- открытые достижения — атрибутом (клиент показывает экран и уведомление о новом)
	local ids = {}
	for id in d.ach do
		table.insert(ids, id)
	end
	table.sort(ids)
	p:SetAttribute("Ach", table.concat(ids, ","))
end

function Scores.load(p: Player)
	local ls = Instance.new("Folder")
	ls.Name = "leaderstats"
	for _, n in { "Очки", "Посадки" } do
		local v = Instance.new("IntValue")
		v.Name = n
		v.Parent = ls
	end
	ls.Parent = p
	local data: Data = { score = 0, landings = 0, best = 0, flights = 0, ach = {}, visited = {} }
	if store then
		local ok, res = pcall(function()
			return (store :: DataStore):GetAsync(key(p))
		end)
		if ok and type(res) == "table" then
			data.score = tonumber(res.score) or 0
			data.landings = tonumber(res.landings) or 0
			data.best = tonumber(res.best) or 0
			data.flights = tonumber(res.flights) or 0
			for _, field in { "ach", "visited" } do
				if type(res[field]) == "table" then
					for k, v in res[field] do
						if type(k) == "string" and v == true then
							(data :: any)[field][k] = true
						end
					end
				end
			end
		end
	end
	cache[p] = data
	refresh(p)
end

function Scores.save(p: Player)
	local d = cache[p]
	if not d or not store then
		return
	end
	pcall(function()
		(store :: DataStore):SetAsync(key(p), d)
	end)
end

function Scores.add(p: Player, points: number, landing: boolean, fpm: number?)
	local d = cache[p]
	if not d then
		return
	end
	d.score += points
	if landing then
		d.landings += 1
		if fpm and (d.best == 0 or fpm < d.best) then
			d.best = math.max(1, fpm)
		end
	end
	refresh(p)
end

-- true, если достижение открыто впервые
function Scores.unlock(p: Player, id: string): boolean
	local d = cache[p]
	if not d or d.ach[id] then
		return false
	end
	d.ach[id] = true
	refresh(p)
	return true
end

-- отмечает аэропорт посадки, возвращает число разных аэропортов
function Scores.visit(p: Player, apId: string): number
	local d = cache[p]
	if not d then
		return 0
	end
	d.visited[apId] = true
	local n = 0
	for _ in d.visited do
		n += 1
	end
	return n
end

function Scores.flight(p: Player)
	local d = cache[p]
	if d then
		d.flights += 1
	end
end

function Scores.unload(p: Player)
	Scores.save(p)
	cache[p] = nil
end

task.spawn(function()
	while true do
		task.wait(120)
		for _, p in Players:GetPlayers() do
			Scores.save(p)
		end
	end
end)

game:BindToClose(function()
	for _, p in Players:GetPlayers() do
		Scores.save(p)
	end
end)

return Scores
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX0000000C"><Properties><string name="Name">WorldBuilder</string><ProtectedString name="Source"><![CDATA[--!strict
-- Строит визуальный мир по данным World (сервер, один раз при старте).
local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("SkyPilot")
local World = require(Shared:WaitForChild("World"))
local PlaneConfigs = require(Shared:WaitForChild("PlaneConfigs"))
local PlaneBuilder = require(Shared:WaitForChild("PlaneBuilder"))

local WorldBuilder = {}

local rng = Random.new(77)
local function R(a: number, b: number): number
	return a + (b - a) * rng:NextNumber()
end

local function part(parent: Instance, size: Vector3, cf: CFrame, color: Color3, material: Enum.Material?, collide: boolean?): Part
	local p = Instance.new("Part")
	p.Anchored = true
	p.Size = size
	p.CFrame = cf
	p.Color = color
	p.Material = material or Enum.Material.SmoothPlastic
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.CanCollide = collide == true
	p.CanTouch = false
	p.CanQuery = collide == true
	p.Parent = parent
	return p
end

local function neon(parent: Instance, size: Vector3, cf: CFrame, color: Color3)
	local p = part(parent, size, cf, color, Enum.Material.Neon)
	p.CastShadow = false
	return p
end

-- ссылки для смены цвета неба по времени суток (updateSky)
local skyFx: { atm: Atmosphere?, cc: ColorCorrectionEffect?, clouds: Clouds? } = {}

local function setupLighting()
	Lighting.ClockTime = 14.5
	Lighting.Brightness = 2.5
	Lighting.EnvironmentDiffuseScale = 0.6
	Lighting.EnvironmentSpecularScale = 0.6
	Lighting.OutdoorAmbient = Color3.fromRGB(140, 150, 170)
	Lighting.GlobalShadows = true
	local atm = Instance.new("Atmosphere")
	atm.Density = 0.28
	atm.Offset = 0.15
	atm.Color = Color3.fromRGB(199, 215, 235)
	atm.Decay = Color3.fromRGB(106, 130, 160)
	atm.Glare = 0.3
	atm.Haze = 1.2
	atm.Parent = Lighting
	skyFx.atm = atm
	-- звёздное небо, солнце и луна
	local sky = Instance.new("Sky")
	sky.StarCount = 3000
	sky.CelestialBodiesShown = true
	sky.SunAngularSize = 16
	sky.MoonAngularSize = 10
	sky.Parent = Lighting
	local cc = Instance.new("ColorCorrectionEffect")
	cc.Saturation = 0.08
	cc.Contrast = 0.05
	cc.Parent = Lighting
	skyFx.cc = cc
	local bloom = Instance.new("BloomEffect")
	bloom.Intensity = 0.5
	bloom.Threshold = 1.6
	bloom.Size = 30
	bloom.Parent = Lighting
	local sun = Instance.new("SunRaysEffect")
	sun.Intensity = 0.05
	sun.Parent = Lighting
	local clouds = Instance.new("Clouds")
	clouds.Cover = 0.55
	clouds.Density = 0.6
	clouds.Parent = workspace.Terrain
	skyFx.clouds = clouds
end

local function mix(a: Color3, b: Color3, t: number): Color3
	return a:Lerp(b, math.clamp(t, 0, 1))
end

-- цвет атмосферы, облаков и общий оттенок по времени суток: голубой день, тёплый закат, синяя ночь
function WorldBuilder.updateSky(clock: number)
	local elev = math.sin((clock - 6) / 24 * math.pi * 2)
	local day = math.clamp(elev * 3 + 0.25, 0, 1)
	local dusk = if elev > -0.25 then math.clamp(1 - math.abs(elev) * 4, 0, 1) else 0
	local atm, cc, clouds = skyFx.atm, skyFx.cc, skyFx.clouds
	if atm then
		atm.Color = mix(mix(Color3.fromRGB(28, 36, 64), Color3.fromRGB(199, 215, 235), day), Color3.fromRGB(255, 168, 120), dusk * 0.55)
		atm.Decay = mix(mix(Color3.fromRGB(16, 20, 40), Color3.fromRGB(106, 130, 160), day), Color3.fromRGB(196, 104, 78), dusk * 0.6)
		atm.Glare = 0.3 + dusk * 0.9
		atm.Haze = 1.2 + dusk * 0.8
	end
	if clouds then
		clouds.Color = mix(mix(Color3.fromRGB(60, 66, 88), Color3.new(1, 1, 1), day), Color3.fromRGB(255, 186, 150), dusk * 0.6)
	end
	if cc then
		cc.TintColor = mix(mix(Color3.fromRGB(196, 206, 255), Color3.new(1, 1, 1), day), Color3.fromRGB(255, 222, 196), dusk * 0.7)
	end
end

local function buildGround(folder: Folder)
	local tile = 2048
	local n = math.ceil(World.SIZE * 2 / tile)
	local greens = { Color3.fromRGB(96, 140, 70), Color3.fromRGB(104, 146, 74), Color3.fromRGB(90, 132, 66) }
	for i = 0, n - 1 do
		for j = 0, n - 1 do
			local x = -World.SIZE + tile * (i + 0.5)
			local z = -World.SIZE + tile * (j + 0.5)
			part(folder, Vector3.new(tile, 4, tile), CFrame.new(x, -2, z), greens[(i + j) % 3 + 1], Enum.Material.Grass, true)
		end
	end
end

local function buildMountains(folder: Folder)
	for _, e in World.peaks do
		local p = Instance.new("Part")
		p.Anchored = true
		p.CanCollide = false
		p.CanQuery = false
		p.CanTouch = false
		local sx, sy = math.min(e.a * 2, 2048), math.min(e.b * 2, 2048)
		p.Size = Vector3.new(sx, sy, sx)
		p.CFrame = CFrame.new(e.x, e.cy, e.z)
		p.Material = if e.snow then Enum.Material.Snow else Enum.Material.Rock
		p.Color = if e.snow then Color3.fromRGB(240, 244, 250) else Color3.fromRGB(112, 108, 100)
		local m = Instance.new("SpecialMesh")
		m.MeshType = Enum.MeshType.Sphere
		m.Scale = Vector3.new(e.a * 2 / sx, e.b * 2 / sy, e.a * 2 / sx)
		m.Parent = p
		p.Parent = folder
	end
end

local function textDecal(p: BasePart, face: Enum.NormalId, text: string, color: Color3, bg: Color3?, font: Enum.Font?)
	local sg = Instance.new("SurfaceGui")
	sg.Face = face
	sg.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	sg.PixelsPerStud = 4
	sg.LightInfluence = 0.3
	local t = Instance.new("TextLabel")
	t.Size = UDim2.fromScale(1, 1)
	t.BackgroundTransparency = if bg then 0 else 1
	t.BackgroundColor3 = bg or Color3.new()
	t.Text = text
	t.TextColor3 = color
	t.TextScaled = true
	t.Font = font or Enum.Font.GothamBlack
	t.Parent = sg
	sg.Parent = p
end

local function buildAirport(folder: Folder, ap: any)
	local f = Instance.new("Folder")
	f.Name = "Airport_" .. ap.id
	f.Parent = folder
	local L, W = ap.L, ap.W
	local function cf(lx: number, y: number, lz: number, ry: number?): CFrame
		return World.apCFrame(ap, lx, y, lz) * CFrame.Angles(0, ry or 0, 0)
	end
	local ASPHALT = Color3.fromRGB(48, 50, 54)
	local TAXI = Color3.fromRGB(70, 72, 76)
	local CONCRETE = Color3.fromRGB(165, 165, 160)
	local PAINT = Color3.fromRGB(242, 242, 242)
	local YELLOW = Color3.fromRGB(240, 192, 32)

	part(f, Vector3.new(W, 0.5, L), cf(0, 0.25, 0), ASPHALT, Enum.Material.Asphalt, true)
	-- следы шин в зонах касания
	for _, e in { -1, 1 } do
		local m = part(f, Vector3.new(40, 0.02, 700), cf(0, 0.51, e * (L / 2 - 650)), Color3.fromRGB(20, 20, 20))
		m.Transparency = 0.55
	end
	part(f, Vector3.new(60, 0.48, L), cf(W / 2 + 250, 0.24, 0), TAXI, Enum.Material.Asphalt, true)
	part(f, Vector3.new(1.2, 0.05, L), cf(W / 2 + 250, 0.5, 0), YELLOW)
	for _, s in { -1, 1 } do
		part(f, Vector3.new(3, 0.05, L), cf(s * (W / 2 - 5), 0.52, 0), PAINT)
	end
	for z = -L / 2 + 400, L / 2 - 400, 220 do
		part(f, Vector3.new(2.5, 0.05, 110), cf(0, 0.52, z), PAINT)
	end
	for _, e in { -1, 1 } do
		for i = 1, 6 do
			for _, s in { -1, 1 } do
				part(f, Vector3.new(7, 0.05, 90), cf(s * ((W / 2 - 18) - (i - 1) * 13), 0.52, e * (L / 2 - 60)), PAINT)
			end
		end
		for _, s in { -1, 1 } do
			part(f, Vector3.new(14, 0.05, 180), cf(s * 28, 0.52, e * (L / 2 - 500)), PAINT)
		end
		for k = 0, 2 do
			for _, s in { -1, 1 } do
				part(f, Vector3.new(4, 0.05, 70), cf(s * 22, 0.52, e * (L / 2 - 800 - k * 150)), PAINT)
			end
		end
		-- номер полосы (читается при заходе на посадку)
		local num = part(f, Vector3.new(60, 0.05, 80), cf(0, 0.52, e * (L / 2 - 210), if e > 0 then 0 else math.pi), PAINT)
		num.Transparency = 1
		textDecal(num, Enum.NormalId.Top, if e > 0 then ap.south else ap.north, PAINT)
		-- огни торца, ВПП и PAPI
		for x = -W / 2, W / 2, 20 do
			neon(f, Vector3.new(2, 1, 2), cf(x, 0.5, e * (L / 2 + 2)), Color3.fromRGB(64, 255, 112))
		end
		for k = 1, 10 do
			neon(f, Vector3.new(2, 1.5, 2), cf(0, 0.75, e * (L / 2 + 60 * k)), Color3.fromRGB(255, 243, 208))
		end
		neon(f, Vector3.new(80, 1.5, 2), cf(0, 0.75, e * (L / 2 + 300)), Color3.fromRGB(255, 243, 208))
		local px = -e * (W / 2 + 40)
		for i = 1, 4 do
			neon(f, Vector3.new(4, 3, 4), cf(px - e * (i - 1) * 12, 1.5, e * (L / 2 - 450)), if i <= 2 then Color3.fromRGB(255, 243, 208) else Color3.fromRGB(255, 48, 48))
		end
	end
	for z = -L / 2, L / 2, 125 do
		for _, s in { -1, 1 } do
			neon(f, Vector3.new(1.6, 1.2, 1.6), cf(s * (W / 2 + 3), 0.6, z), Color3.fromRGB(255, 243, 208))
		end
	end
	for _, z in { -L / 2 + 150, 0, L / 2 - 150 } do
		part(f, Vector3.new(220, 0.48, 60), cf(W / 2 + 110, 0.24, z), TAXI, Enum.Material.Asphalt, true)
		part(f, Vector3.new(220, 0.05, 1.2), cf(W / 2 + 110, 0.5, z), YELLOW)
	end
	part(f, Vector3.new(600, 0.49, 2000), cf(W / 2 + 580, 0.245, 0), CONCRETE, Enum.Material.Concrete, true)
	part(f, Vector3.new(600, 0.49, 500), cf(W / 2 + 580, 0.245, -1250), CONCRETE, Enum.Material.Concrete, true)
	for _, p in ap.parked do
		part(f, Vector3.new(160, 0.05, 1.2), cf(W / 2 + 720, 0.51, p[2]), YELLOW)
	end

	-- терминал
	local tx = W / 2 + 950
	local FRAME = Color3.fromRGB(233, 236, 240)
	local GLASS = Color3.fromRGB(34, 56, 79)
	part(f, Vector3.new(140, 8, 900), cf(tx, 4, 0), FRAME, Enum.Material.Concrete, true)
	local g = part(f, Vector3.new(136, 32, 890), cf(tx, 24, 0), GLASS, Enum.Material.Glass, true)
	g.Reflectance = 0.25
	for z = -440, 440, 40 do
		part(f, Vector3.new(141, 32, 1.4), cf(tx, 24, z), FRAME, Enum.Material.Metal)
	end
	part(f, Vector3.new(160, 3, 930), cf(tx + 5, 41.5, 0), Color3.fromRGB(61, 67, 76), Enum.Material.Metal, true)
	local sign = part(f, Vector3.new(2, 30, 500), cf(tx - 74.5, 58, 0), FRAME)
	textDecal(sign, Enum.NormalId.Left, ap.title, Color3.fromRGB(20, 60, 120), FRAME)
	-- телетрапы: ротонда на колонне у терминала, телескопические секции, кабина с окном, гармошка к двери, опора на колёсах
	local JW = Color3.fromRGB(196, 201, 208)
	local JD = Color3.fromRGB(70, 76, 86)
	local JG = Color3.fromRGB(34, 52, 72)
	local function cylX(size: Vector3, c: CFrame, color: Color3, mat: Enum.Material?)
		local p = part(f, size, c, color, mat or Enum.Material.Metal)
		p.Shape = Enum.PartType.Cylinder
		return p
	end
	for _, p in ap.parked do
		local c = PlaneConfigs.PLANES[p[1]]
		if c.windows and c.length >= 100 then
			local doorX = W / 2 + 760 - c.length * 0.12
			local zb = p[2] - c.diameter * 0.5 - 6
			local y = 0.5 + c.gearHeight + c.diameter * 0.1
			local xR = tx - 84
			cylX(Vector3.new(y, 6, 6), cf(xR, y / 2, zb) * CFrame.Angles(0, 0, math.pi / 2), JD)
			cylX(Vector3.new(11, 15, 15), cf(xR, y + 1, zb) * CFrame.Angles(0, 0, math.pi / 2), JW)
			part(f, Vector3.new(14, 8, 8), cf((xR + tx - 70) / 2, y + 1, zb), JW, Enum.Material.Metal)
			local x0, x1 = xR - 7, doorX + 7
			local len = x0 - x1
			for k = 0, 2 do
				local a = x0 - len * k / 3
				local b = x0 - len * (k + 1) / 3 - (if k < 2 then 2 else 0)
				local sz = 9 - k * 0.6
				part(f, Vector3.new(a - b, sz, sz), cf((a + b) / 2, y + 1, zb), JW, Enum.Material.Metal)
				part(f, Vector3.new(a - b - 1, 2, sz + 0.2), cf((a + b) / 2, y + 2, zb), JG, Enum.Material.Glass)
			end
			part(f, Vector3.new(12, 10, 12), cf(doorX + 2, y + 1.5, zb + 2), JW, Enum.Material.Metal)
			part(f, Vector3.new(10, 3, 12.2), cf(doorX + 2, y + 3, zb + 2), JG, Enum.Material.Glass)
			part(f, Vector3.new(9, 8, 3), cf(doorX, y + 1, zb + 9), JD, Enum.Material.Fabric)
			local legX = x1 + len * 0.3
			for _, dz in { -3, 3 } do
				part(f, Vector3.new(1.4, y - 2, 1.4), cf(legX, (y - 2) / 2 + 1.5, zb + dz), JD, Enum.Material.Metal)
			end
			part(f, Vector3.new(3, 1.4, 9), cf(legX, 1.5, zb), JD, Enum.Material.Metal)
			for _, dz in { -4, 4 } do
				cylX(Vector3.new(2, 3, 3), cf(legX, 1.5, zb + dz) * CFrame.Angles(0, math.pi / 2, 0), Color3.fromRGB(24, 24, 26), Enum.Material.Rubber)
			end
		end
	end
	-- служебные машины у самолётов: буксир, багажный тягач с тележками, топливозаправщик
	local YEL = Color3.fromRGB(242, 190, 40)
	local WHEEL = Color3.fromRGB(24, 24, 26)
	local function wheels(x: number, z: number, lenX: number, wid: number)
		for _, dx in { -lenX / 2 + 1.4, lenX / 2 - 1.4 } do
			for _, dz in { -wid / 2, wid / 2 } do
				cylX(Vector3.new(1, 2.4, 2.4), cf(x + dx, 1.2, z + dz) * CFrame.Angles(0, math.pi / 2, 0), WHEEL, Enum.Material.Rubber)
			end
		end
	end
	for _, p in ap.parked do
		local c = PlaneConfigs.PLANES[p[1]]
		local z = p[2]
		local noseX = W / 2 + 760
		-- буксир у носовой стойки
		part(f, Vector3.new(10, 2.6, 6), cf(noseX + 8, 1.8, z), YEL, Enum.Material.SmoothPlastic)
		part(f, Vector3.new(3, 2, 5), cf(noseX + 11, 4, z), Color3.fromRGB(40, 46, 56), Enum.Material.Glass)
		wheels(noseX + 8, z, 10, 6.2)
		if c.windows and c.length >= 100 then
			-- багажный тягач и три тележки у заднего грузового люка
			local bx = noseX - c.length * 0.72
			local bz = z + c.diameter * 0.5 + 10
			part(f, Vector3.new(7, 3, 5), cf(bx, 2, bz), YEL, Enum.Material.SmoothPlastic)
			part(f, Vector3.new(3, 2.5, 5), cf(bx + 1.5, 4.6, bz), Color3.fromRGB(40, 46, 56), Enum.Material.Glass)
			wheels(bx, bz, 7, 5.2)
			for k = 1, 3 do
				local cx = bx - 3 - k * 8
				part(f, Vector3.new(6.5, 0.6, 5), cf(cx, 1.8, bz), Color3.fromRGB(120, 126, 134), Enum.Material.Metal)
				part(f, Vector3.new(5.5, 2.4, 4.2), cf(cx, 3.3, bz), ({ Color3.fromRGB(58, 74, 110), Color3.fromRGB(140, 60, 50), Color3.fromRGB(70, 70, 76) })[k], Enum.Material.Fabric)
				wheels(cx, bz, 6.5, 4.6)
			end
			-- топливозаправщик под крылом
			local fx, fz = noseX - c.length * 0.45, z + c.span * 0.3
			part(f, Vector3.new(6, 5, 7), cf(fx + 11, 3.2, fz), Color3.fromRGB(230, 232, 236), Enum.Material.SmoothPlastic)
			part(f, Vector3.new(2, 2.2, 6.4), cf(fx + 13.6, 4.4, fz), Color3.fromRGB(40, 46, 56), Enum.Material.Glass)
			cylX(Vector3.new(18, 7, 7), cf(fx - 1, 4.6, fz), Color3.fromRGB(236, 238, 240), Enum.Material.Metal)
			part(f, Vector3.new(18, 0.8, 7.2), cf(fx - 1, 3.6, fz), Color3.fromRGB(200, 40, 40), Enum.Material.SmoothPlastic)
			wheels(fx + 4, fz, 26, 6.4)
		end
	end
	-- мачты освещения перрона: ночью лампы светятся (клиент переключает детали «ApronLamp»)
	for _, mz in { -900, -300, 300, 900 } do
		local mx = W / 2 + 300
		part(f, Vector3.new(2.4, 70, 2.4), cf(mx, 35, mz), Color3.fromRGB(150, 156, 164), Enum.Material.Metal)
		part(f, Vector3.new(4, 2, 18), cf(mx + 1, 70, mz), Color3.fromRGB(70, 76, 86), Enum.Material.Metal)
		for _, dz in { -6, 0, 6 } do
			local lamp = part(f, Vector3.new(3, 1.2, 4), cf(mx + 2.5, 69, mz + dz), Color3.fromRGB(255, 238, 200), Enum.Material.SmoothPlastic)
			lamp.Name = "ApronLamp"
			lamp.CastShadow = false
			local sl = Instance.new("SpotLight")
			sl.Face = Enum.NormalId.Bottom
			sl.Angle = 100
			sl.Range = 60
			sl.Brightness = 2.5
			sl.Color = Color3.fromRGB(255, 226, 180)
			sl.Enabled = false
			sl.Parent = lamp
		end
	end
	-- вышка
	local tw = Instance.new("Part")
	tw.Shape = Enum.PartType.Cylinder
	tw.Anchored = true
	tw.Size = Vector3.new(130, 24, 24)
	tw.CFrame = cf(tx + 20, 65, 560) * CFrame.Angles(0, 0, math.pi / 2)
	tw.Color = Color3.fromRGB(223, 226, 230)
	tw.Material = Enum.Material.Concrete
	tw.Parent = f
	local cab = tw:Clone()
	cab.Size = Vector3.new(16, 44, 44)
	cab.CFrame = cf(tx + 20, 138, 560) * CFrame.Angles(0, 0, math.pi / 2)
	cab.Color = GLASS
	cab.Material = Enum.Material.Glass
	cab.Parent = f
	local roofT = tw:Clone()
	roofT.Size = Vector3.new(3, 48, 48)
	roofT.CFrame = cf(tx + 20, 147.5, 560) * CFrame.Angles(0, 0, math.pi / 2)
	roofT.Color = Color3.fromRGB(61, 67, 76)
	roofT.Material = Enum.Material.Metal
	roofT.Parent = f
	neon(f, Vector3.new(3, 3, 3), cf(tx + 20, 152, 560), Color3.fromRGB(255, 48, 48))
	-- ангары с арочной крышей
	for _, z in { -1130, -1370 } do
		local HW = Color3.fromRGB(183, 190, 200)
		part(f, Vector3.new(170, 30, 210), cf(W / 2 + 790, 15, z), HW, Enum.Material.Metal, true)
		local roof = Instance.new("Part")
		roof.Shape = Enum.PartType.Cylinder
		roof.Anchored = true
		roof.Size = Vector3.new(210, 170, 170)
		-- цилиндр вдоль длины ангара (локальная Z), половина торчит над стенами
		roof.CFrame = cf(W / 2 + 790, 30, z) * CFrame.Angles(0, math.pi / 2, 0)
		roof.Color = HW
		roof.Material = Enum.Material.Metal
		roof.Parent = f
		part(f, Vector3.new(1, 28, 180), cf(W / 2 + 704.5, 15, z), Color3.fromRGB(74, 82, 94), Enum.Material.Metal)
	end
	-- стоящие самолёты
	for _, p in ap.parked do
		local c = PlaneConfigs.PLANES[p[1]]
		local lx = W / 2 + 760 - c.length / 2
		local m = PlaneBuilder.build(c, { static = true })
		m:PivotTo(cf(lx, 0.5 + c.gearHeight, p[2], -math.pi / 2))
		m.Parent = f
	end
	-- стоянки: жёлтая осевая, стоп-линия и номер
	for _, st in World.STANDS[ap.id] or {} do
		part(f, Vector3.new(260, 0.05, 1.4), cf(st.lx - 60, 0.51, st.lz), YELLOW)
		part(f, Vector3.new(1.4, 0.05, 40), cf(st.lx + 60, 0.51, st.lz), YELLOW)
		local pad = part(f, Vector3.new(60, 0.05, 30), cf(st.lx - 150, 0.52, st.lz, -math.pi / 2), Color3.fromRGB(40, 42, 48))
		textDecal(pad, Enum.NormalId.Top, st.id, YELLOW, Color3.fromRGB(40, 42, 48))
	end
	-- точка появления персонажа у терминала
	local spawn = Instance.new("SpawnLocation")
	spawn.Name = "Spawn_" .. ap.id
	spawn.Anchored = true
	spawn.Size = Vector3.new(24, 1, 24)
	spawn.CFrame = cf(W / 2 + 840, 1, 0)
	spawn.Material = Enum.Material.Concrete
	spawn.Color = CONCRETE
	spawn.Neutral = true
	spawn.Duration = 0
	spawn.Enabled = ap.id == "A"
	spawn.Parent = f
end

-- Города из CityData: каждая запись — деталь (коробка, цилиндр, шар, эллипсоид, клин)
local function buildCity(folder: Folder)
	local data = World.CityData
	local f = Instance.new("Folder")
	f.Name = "Cities"
	f.Parent = folder
	for i, d in data.props do
		local kind = d[1]
		local p: BasePart
		if kind == "wedge" then
			p = Instance.new("WedgePart")
		else
			local q = Instance.new("Part")
			if kind == "cyl" then
				q.Shape = Enum.PartType.Cylinder
			elseif kind == "ball" then
				q.Shape = Enum.PartType.Ball
			end
			p = q
		end
		local size = Vector3.new(d[5], d[6], d[7])
		if kind == "ell" then
			local cap = Vector3.new(math.min(size.X, 2048), math.min(size.Y, 2048), math.min(size.Z, 2048))
			p.Size = cap
			local m = Instance.new("SpecialMesh")
			m.MeshType = Enum.MeshType.Sphere
			m.Scale = size / cap
			m.Parent = p
		else
			p.Size = size
		end
		p.CFrame = CFrame.new(d[2], d[3], d[4]) * CFrame.Angles(d[8], d[9], d[10])
		p.Color = Color3.fromHex(string.format("%06x", d[11]))
		local ok, mat = pcall(function()
			return (Enum.Material :: any)[d[12]]
		end)
		p.Material = if ok and mat then mat else Enum.Material.SmoothPlastic
		p.Anchored = true
		p.CanCollide = d[13] == 1
		p.CanQuery = d[13] == 1
		p.CanTouch = false
		p.Reflectance = d[14] or 0
		p.Transparency = d[15] or 0
		p.TopSurface = Enum.SurfaceType.Smooth
		p.BottomSurface = Enum.SurfaceType.Smooth
		-- тени — самое дорогое: их не отбрасывают неон, мелочь и весь декор (деревья, разметка, вода)
		local decor = d[13] ~= 1 and math.max(size.X, size.Y, size.Z) < 40
		if decor then
			p.CanQuery = false
		end
		if p.Material == Enum.Material.Neon or math.max(size.X, size.Z) < 2 or decor or p.Material == Enum.Material.LeafyGrass then
			p.CastShadow = false
		end
		p.Parent = f
		if i % 400 == 0 then
			task.wait() -- не подвешиваем сервер на старте
		end
	end
	-- подписи городов: видно издалека, помогают ориентироваться
	for _, l in data.labels do
		local anchor = Instance.new("Part")
		anchor.Anchored = true
		anchor.CanCollide = false
		anchor.CanQuery = false
		anchor.Transparency = 1
		anchor.Size = Vector3.one
		anchor.Position = Vector3.new(l.x, l.y, l.z)
		local bb = Instance.new("BillboardGui")
		bb.Size = UDim2.fromOffset(320, 60)
		bb.MaxDistance = 30000
		bb.LightInfluence = 0
		local t = Instance.new("TextLabel")
		t.Size = UDim2.fromScale(1, 1)
		t.BackgroundTransparency = 1
		t.Font = Enum.Font.GothamBlack
		t.TextScaled = true
		t.Text = l.name
		t.TextColor3 = Color3.fromRGB(255, 255, 255)
		t.TextStrokeTransparency = 0.3
		t.Parent = bb
		bb.Parent = anchor
		anchor.Parent = f
	end
end

local function buildNature(folder: Folder)
	local f = Instance.new("Folder")
	f.Name = "Nature"
	f.Parent = folder
	local avoid = {}
	for _, ap in World.AIRPORTS do
		table.insert(avoid, { ap.cx + (if ap.rot == 1 then 0 else 500), ap.cz - (if ap.rot == 1 then 500 else 0), 3700 })
	end
	for _, c in World.CITIES do
		table.insert(avoid, { c.x, c.z, c.r })
	end
	table.insert(avoid, { 5500, -9800, 3300 }) -- море у Дубая
	for _, lk in World.LAKES do
		if World.terrainH(lk[1], lk[2]) <= 5 then
			local water = Instance.new("Part")
			water.Shape = Enum.PartType.Cylinder
			water.Anchored = true
			water.CanCollide = false
			water.Size = Vector3.new(0.2, lk[3], lk[3])
			water.CFrame = CFrame.new(lk[1], 0.6, lk[2]) * CFrame.Angles(0, 0, math.pi / 2)
			water.Color = Color3.fromRGB(31, 90, 134)
			water.Material = Enum.Material.Glass
			water.Reflectance = 0.35
			water.Parent = f
			local shore = water:Clone()
			shore.Size = Vector3.new(0.1, lk[3] + 80, lk[3] + 80)
			shore.CFrame = CFrame.new(lk[1], 0.52, lk[2]) * CFrame.Angles(0, 0, math.pi / 2)
			shore.Color = Color3.fromRGB(201, 185, 143)
			shore.Material = Enum.Material.Sand
			shore.Reflectance = 0
			shore.Parent = f
			table.insert(avoid, { lk[1], lk[2], lk[3] / 2 + 50 })
		end
	end
	local function free(x: number, z: number, pad: number): boolean
		for _, a in avoid do
			local dx, dz = x - a[1], z - a[2]
			if math.sqrt(dx * dx + dz * dz) <= a[3] + pad then
				return false
			end
		end
		return World.terrainH(x, z) < 1
	end
	-- поля
	local fc = {
		Color3.fromRGB(122, 166, 74), Color3.fromRGB(201, 182, 94), Color3.fromRGB(139, 107, 75),
		Color3.fromRGB(90, 138, 60), Color3.fromRGB(168, 189, 98), Color3.fromRGB(181, 154, 82),
	}
	local placed = 0
	for _ = 1, 900 do
		if placed >= 220 then
			break
		end
		local x, z = R(-22000, 22000), R(-22000, 22000)
		if free(x, z, 700) then
			placed += 1
			local p = part(f, Vector3.new(R(300, 1100), 0.1, R(300, 1100)), CFrame.new(x, 0.05 + (placed % 20) * 0.012, z) * CFrame.Angles(0, R(0, math.pi), 0), fc[rng:NextInteger(1, #fc)], Enum.Material.Grass)
			p.CastShadow = false
		end
	end
	-- лес: ствол + крона
	local leafs = { Color3.fromRGB(47, 90, 42), Color3.fromRGB(59, 107, 48), Color3.fromRGB(39, 77, 38), Color3.fromRGB(70, 115, 58) }
	for _ = 1, 45 do
		local cx, cz = R(-21000, 21000), R(-21000, 21000)
		if free(cx, cz, 900) then
			local n = rng:NextInteger(30, 55)
			local spread = R(250, 600)
			for _ = 1, n do
				local a, d = rng:NextNumber() * math.pi * 2, math.sqrt(rng:NextNumber()) * spread
				local x, z = cx + math.cos(a) * d, cz + math.sin(a) * d
				local h = World.terrainH(x, z)
				if h <= 380 then
					local s = R(0.8, 1.5)
					local trunk = part(f, Vector3.new(1.6 * s, 10 * s, 1.6 * s), CFrame.new(x, h + 5 * s, z), Color3.fromRGB(74, 53, 36), Enum.Material.Wood)
					trunk.CastShadow = false
					local crown = Instance.new("Part")
					crown.Shape = Enum.PartType.Ball
					crown.Anchored = true
					crown.CanCollide = false
					crown.CanQuery = false
					crown.Size = Vector3.one * (14 * s)
					crown.CFrame = CFrame.new(x, h + 15 * s, z)
					crown.Color = leafs[rng:NextInteger(1, #leafs)]
					crown.Material = Enum.Material.LeafyGrass
					crown.CastShadow = false
					crown.Parent = f
				end
			end
		end
	end
end

function WorldBuilder.build()
	setupLighting()
	local folder = Instance.new("Folder")
	folder.Name = "SkyPilotWorld"
	folder.Parent = workspace
	buildGround(folder)
	buildMountains(folder)
	for _, ap in World.AIRPORTS do
		buildAirport(folder, ap)
	end
	buildCity(folder)
	buildNature(folder)
	local planes = Instance.new("Folder")
	planes.Name = "Planes"
	planes.Parent = workspace
	return folder
end

return WorldBuilder
]]></ProtectedString></Properties></Item>
</Item>
</Item>
<Item class="StarterPlayer" referent="RBX00000019"><Properties><string name="Name">StarterPlayer</string><bool name="EnableMouseLockOption">false</bool><float name="CameraMaxZoomDistance">400</float></Properties><Item class="StarterPlayerScripts" referent="RBX00000018"><Properties><string name="Name">StarterPlayerScripts</string></Properties><Item class="LocalScript" referent="RBX00000014"><Properties><string name="Name">SkyPilotClient</string><ProtectedString name="Source"><![CDATA[--!strict
-- Sky Pilot — клиент: локальная физика полёта (как FlightClient), ввод, камера, приборы.
-- Самолёт принадлежит игроку по сети (SetNetworkOwner), поэтому управление без задержки,
-- а другие игроки видят движение через обычную репликацию физики Roblox.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local player = Players.LocalPlayer
local Shared = ReplicatedStorage:WaitForChild("SkyPilot")
local PlaneConfigs = require(Shared:WaitForChild("PlaneConfigs"))
local World = require(Shared:WaitForChild("World"))
local FlightPhysics = require(Shared:WaitForChild("FlightPhysics"))
local Autopilot = require(Shared:WaitForChild("Autopilot"))

local Ui = require(script:WaitForChild("Ui"))
local Controls = require(script:WaitForChild("Controls"))
local CameraRig = require(script:WaitForChild("CameraRig"))
local Animator = require(script:WaitForChild("Animator"))
local Race = require(script:WaitForChild("Race"))
local Radar = require(script:WaitForChild("Radar"))

local remotes = ReplicatedStorage:WaitForChild("SkyPilotRemotes")
local function R(name: string): RemoteEvent
	return remotes:WaitForChild(name) :: RemoteEvent
end
local RequestFlight, FlightStarted, ClientReady = R("RequestFlight"), R("FlightStarted"), R("ClientReady")
local PlaneState, Landing, CrashEvent, EndFlight, Notify = R("PlaneState"), R("Landing"), R("Crash"), R("EndFlight"), R("Notify")
local RaceFinished = R("RaceFinished")
local GateParked = R("GateParked")
local AchievementR = R("Achievement")
-- достижения, которые видит только клиент: отправляем один раз, сервер проверяет и награждает
local achSent: { [string]: boolean } = {}
local function claimAch(id: string)
	if achSent[id] then
		return
	end
	local have = tostring(Players.LocalPlayer:GetAttribute("Ach") or "")
	if string.find("," .. have .. ",", "," .. id .. ",", 1, true) then
		achSent[id] = true
		return
	end
	achSent[id] = true
	AchievementR:FireServer(id)
end

local FT = FlightPhysics.FT
local clamp = FlightPhysics.clamp

-- ===== состояние
local flight: FlightPhysics.Flight? = nil
local model: Model? = nil
local root: BasePart? = nil
local simulating = false
local crashPose: CFrame? = nil
local crashTimer = 0
local lastPlaneId: string? = nil
local lastMode = "runway:A"
local apTarget: Autopilot.Target? = nil
local navIdx = 0 -- 0 = навигация выключена
local parkBrake = false
local gateTarget: any = nil
local callsign = "SKY000"
local atcApproach = false -- разрешение на заход уже выдано
local flightSeq = 0 -- номер текущего полёта: отложенные сообщения старого полёта отбрасываются

local function runwayFor(ap: any, pos: Vector3): string
	-- с какого торца заходим: локальная Z > 0 — с юга (полоса ap.south)
	local dx, dz = pos.X - ap.cx, pos.Z - ap.cz
	local lz = if ap.rot == 1 then dx else dz
	return if lz > 0 then ap.south else ap.north
end -- стоянка, к которой надо зарулить после посадки
local lastDest: string? = nil
local apFollowNav = false
local vsSmooth = 0
local engineSound: Sound? = nil
local sent = { gear = true, flaps = 0, throttle = -1, reverse = false, t = 0 }
local logLines: { string } = {}
local fps = 60

local function addLog(t: string)
	table.insert(logLines, string.format("[%.1fs] %s", os.clock(), t))
	if #logLines > 12 then
		table.remove(logLines, 1)
	end
end

local controlsModule: any = nil
local function setCharacterControls(enabled: boolean)
	if not controlsModule then
		local ok, pm = pcall(function()
			return require(player:WaitForChild("PlayerScripts"):WaitForChild("PlayerModule") :: ModuleScript) :: any
		end)
		if ok and pm then
			controlsModule = pm:GetControls()
		end
	end
	if controlsModule then
		if enabled then
			controlsModule:Enable()
		else
			controlsModule:Disable()
		end
	end
	local ch = player.Character
	local hum = ch and ch:FindFirstChildOfClass("Humanoid")
	if hum then
		hum:SetStateEnabled(Enum.HumanoidStateType.Jumping, enabled)
	end
end

-- ===== UI + ввод + камера
local ui: any
local cameraRig: any
local controls: any

local function onAction(a: string)
	if a == "hangar" then
		ui.showHangar()
		return
	elseif a == "cam" then
		ui.setCamLabel(cameraRig.cycle())
		return
	elseif a == "guide" then
		ui.showGuide(if flight then flight.cfg else PlaneConfigs.PLANES[lastPlaneId or "C172"])
		return
	elseif a == "mouse" then
		controls.mouseYoke = not controls.mouseYoke
		ui.setMouseLabel(controls.mouseYoke)
		ui.toast(if controls.mouseYoke then "Мышь-штурвал: курсор от центра = отклонение штурвала" else "Мышь-штурвал выключен")
		return
	end
	local f = flight
	if not f or f.crashed then
		return
	end
	if a == "park" then
		if f.onGround then
			parkBrake = not parkBrake
			ui.toast(if parkBrake then "Стояночный тормоз включён" else "Стояночный тормоз отключён", if parkBrake then "amber" else "green")
		else
			parkBrake = false
		end
		return
	end
	if a == "nav" then
		navIdx = (navIdx + 1) % (#World.NAV + 1)
		local n = World.NAV[navIdx]
		ui.toast(if n then "Навигация: " .. n.name .. " (P — автопилот поведёт к цели)" else "Навигация выключена")
		if not n then
			ui.setNav(nil)
			apFollowNav = false
		end
		return
	end
	if a == "autopilot" then
		if apTarget then
			apTarget = nil
			ui.toast("Автопилот выключен", "amber")
		elseif f.onGround then
			ui.toast("Автопилот включается только в воздухе", "amber")
		else
			-- безопасная высота: не ниже 3500 ft, чтобы пройти над горами и небоскрёбами
			local n = World.NAV[navIdx]
			apFollowNav = n ~= nil
			local alt = f.pos.Y * FT
			if n then
				alt = math.clamp(alt, 3500, f.cfg.ceilingFt * 0.8)
			end
			apTarget = { heading = World.headingDeg(f.att.LookVector), altFt = alt, speed = math.max(f.speed, f.cfg.stallKts * 1.4) }
			if n then
				ui.toast(string.format("Автопилот ведёт к цели: %s, %d ft", n.name, math.round(alt)), "green")
			else
				ui.toast(string.format("Автопилот: курс %03d°, %d ft, %d kt", math.round((apTarget :: any).heading) % 360, math.round((apTarget :: any).altFt), math.round((apTarget :: any).speed)), "green")
			end
		end
		ui.setAutopilot(apTarget ~= nil)
		return
	end
	local text, color = FlightPhysics.action(f, a)
	if text then
		ui.toast(text, color)
		addLog(text)
	end
end

local lastLivery: string? = nil
local function requestFlight(planeId: string, mode: string, destination: string?, livery: string?)
	lastPlaneId, lastMode, lastDest = planeId, mode, destination
	if livery then
		lastLivery = livery
	end
	ui.showHangar(false)
	ui.hideCrash()
	RequestFlight:FireServer(planeId, mode, destination, lastLivery)
end

ui = Ui.new({
	onPick = requestFlight,
	onAction = onAction,
	onAgain = function()
		if lastPlaneId then
			requestFlight(lastPlaneId, lastMode, lastDest)
		end
	end,
	onToHangar = function()
		ui.showHangar(true)
	end,
	onExit = function()
		if flight then
			EndFlight:FireServer()
			stopFlight()
		end
	end,
})
controls = Controls.new(ui, onAction)
local radar = Radar.new(ui.root, Ui.Colors)
local race = Race.new(function(name, i, n)
	ui.toast(string.format("Кольцо %d/%d · %s", i, n, name), "magenta")
end, function(t)
	ui.toast(string.format("ФИНИШ гонки: %d:%04.1f", math.floor(t / 60), t % 60), "green")
	addLog(string.format("Гонка: %.1f с", t))
	RaceFinished:FireServer(t)
end)
cameraRig = CameraRig.new(ui)

local function stopFlight()
	flight, model, root, simulating, apTarget, crashPose = nil, nil, nil, false, nil, nil
	if engineSound then
		engineSound:Destroy()
		engineSound = nil
	end
	Animator.setLocal(nil)
	race.reset()
	gateTarget = nil
	flightSeq += 1
	radar.setVisible(false)
	ui.setFlying(false)
	ui.setAutopilot(false)
	setCharacterControls(true)
end

FlightStarted.OnClientEvent:Connect(function(m: Model, planeId: string, mode: string, spawnCF: CFrame)
	local cfg = PlaneConfigs.PLANES[planeId]
	if not cfg or not m then
		return
	end
	stopFlight()
	model = m
	root = m:WaitForChild("Root", 5) :: BasePart?
	local f = FlightPhysics.new(cfg, spawnCF, mode == "air")
	flight = f
	simulating = false
	vsSmooth = 0
	sent = { gear = f.gear, flaps = 0, throttle = f.throttle, reverse = false, t = 0 }
	cameraRig.reset(spawnCF.Rotation, cfg)
	Animator.setLocal(m, f.gear, f.flaps, f.throttle)
	ui.setFlying(true, cfg.name)
	radar.setVisible(true)
	race.reset()
	ui.showHangar(false)
	ui.hideCrash()
	ui.setThrottleFill(f.throttle)
	setCharacterControls(false)
	if PlaneConfigs.ENGINE_SOUND_ID ~= "" and root then
		local s = Instance.new("Sound")
		s.SoundId = PlaneConfigs.ENGINE_SOUND_ID
		s.Looped = true
		s.Volume = 0.6
		s.RollOffMaxDistance = 2000
		s.Parent = root
		s:Play()
		engineSound = s
	end
	addLog(string.format("Старт: %s, %s", cfg.name, mode))
	callsign = string.format("SKY%03d", math.random(100, 999))
	atcApproach = false
	flightSeq += 1
	local seq = flightSeq
	do
		local apId = World.runwayAt(spawnCF.Position.X, spawnCF.Position.Z, 20)
		local ap = apId and World.airportById(apId)
		task.delay(4.5, function()
			if seq ~= flightSeq or not flight or flight.crashed then
				return
			end
			if ap then
				local rw = runwayFor(ap, spawnCF.Position + spawnCF.LookVector * -100)
				local wd = tonumber(workspace:GetAttribute("WindDir")) or 0
				local wk = tonumber(workspace:GetAttribute("WindKts")) or 0
				local windTxt = if wk < 2 then "Ветер штиль." else string.format("Ветер %03d°, %d kt, боковой %d kt.", wd, math.round(wk), math.round(FlightPhysics.crosswind(wd, wk, (tonumber(rw) or 36) * 10)))
				ui.atc(string.format("Вышка %s: %s, полоса %s, взлёт разрешён. %s", ap.code, callsign, rw, windTxt))
			else
				ui.atc(string.format("Подход: %s, наблюдаю вас на радаре, %d ft. Курс по навигации.", callsign, math.round(spawnCF.Position.Y * FT)))
			end
		end)
	end
	parkBrake = mode ~= "air"
	-- рейс: навигация сразу на аэропорт назначения
	if lastDest then
		navIdx = World.navIndexForAirport(lastDest)
		local dst = World.airportById(lastDest)
		if dst then
			task.delay(3.2, function()
				if seq ~= flightSeq then
					return
				end
				ui.toast(string.format("Рейс в %s · %s — навигация включена (N)", dst.code, dst.title), "magenta")
			end)
		end
	end
	ui.toast(if lastMode == "race" then "Гонка: впереди голубое кольцо — пролети сквозь него" elseif mode == "air" then "Вы в воздухе на 3000 ft — аэропорт впереди" else string.format("На полосе: отпусти тормоз (пробел), тяга 100%% (Shift), на Vr %d kt тяни на себя (S)", cfg.vrKts), "magenta")
	ClientReady:FireServer(m)
end)

EndFlight.OnClientEvent:Connect(function()
	if flight and not flight.crashed then
		stopFlight()
	end
end)

Notify.OnClientEvent:Connect(function(text: string, color: string?)
	ui.toast(text, color)
	addLog(text)
end)

player.CharacterAdded:Connect(function()
	task.defer(function()
		if not flight then
			setCharacterControls(true)
		end
	end)
end)

-- дым шин при касании
local function tireSmoke(m: Model, cfg: any)
	local r = m.PrimaryPart
	if not r then
		return
	end
	for _, a in r:GetChildren() do
		if a:IsA("Attachment") and a.Name:sub(1, 8) == "MainGear" then
			local pe = a:FindFirstChild("Smoke") :: ParticleEmitter?
			if not pe then
				local e = Instance.new("ParticleEmitter")
				e.Name = "Smoke"
				e.Rate = 0
				e.Lifetime = NumberRange.new(1.2, 2)
				e.Speed = NumberRange.new(2, 6)
				e.SpreadAngle = Vector2.new(60, 60)
				e.Size = NumberSequence.new(cfg.diameter * 0.3, cfg.diameter * 1.4)
				e.Transparency = NumberSequence.new(0.3, 1)
				e.Color = ColorSequence.new(Color3.fromRGB(220, 220, 220))
				e.LockedToPart = false
				e.Parent = a
				pe = e
			end
			(pe :: ParticleEmitter):Emit(14)
		end
	end
end

local function handleEvents(f: FlightPhysics.Flight)
	for _, ev in f.events do
		if ev.type == "landing" then
			addLog(ev.text)
			-- карточка «отчёт о посадке» (очки за касание — как на сервере; бонусы за перелёт/рейс приходят уведомлением)
			do
				local ap = ev.airport and World.airportById(ev.airport)
				local offM: number? = nil
				if ap then
					local dx, dz = f.pos.X - ap.cx, f.pos.Z - ap.cz
					offM = math.abs(if ap.rot == 1 then -dz else dx) * World.METERS_PER_STUD
				end
				local fpmV = ev.fpm or 0
				if offM and offM < 2 then
					claimAch("center")
				end
				ui.landingReport({
					grade = ev.grade or "hard", fpm = fpmV, kts = f.speed, g = f.gload, offM = offM,
					pts = if ap then (if fpmV < 120 then 400 elseif fpmV < 250 then 300 elseif fpmV < 600 then 150 else 50) else 0,
					where = if ap then ap.code .. " · полоса" else "вне аэропорта", damaged = f.damage > 0.3,
				})
			end
			Landing:FireServer(ev.fpm)
			if ev.airport then
				local ap = World.airportById(ev.airport)
				if ap then
					ui.atc(string.format("Вышка %s: %s, посадка в %s. Освободите полосу.", ap.code, callsign, os.date("%H:%M")))
				end
			end
			-- после посадки в аэропорту назначения — рулим к свободной стоянке
			if lastDest and ev.airport == lastDest and not gateTarget then
				local list = World.STANDS[lastDest]
				if list and #list > 0 then
					gateTarget = list[math.random(1, #list)]
					task.delay(3, function()
						if gateTarget then
							ui.toast("Зарули на стоянку " .. gateTarget.id .. " и остановись", "magenta")
						end
					end)
				end
			end
			if model then
				tireSmoke(model, f.cfg)
			end
		elseif ev.type == "warn" then
			ui.toast(ev.text, "amber")
			addLog(ev.text)
		elseif ev.type == "takeoff" then
			claimAch("first_flight")
			ui.atc(string.format("%s, взлёт в %s. Набирайте 3000 ft, курс по навигации.", callsign, os.date("%H:%M")))
			addLog(ev.text)
		elseif ev.type == "crash" then
			ui.toast("💥 " .. ev.text, "red")
			addLog("КРУШЕНИЕ: " .. ev.text)
			crashPose = FlightPhysics.pose(f)
			crashTimer = 1.8
			apTarget = nil
			ui.setFlying(false)
			radar.setVisible(false)
			race.reset()
			CrashEvent:FireServer(ev.text)
			if engineSound then
				engineSound:Destroy()
				engineSound = nil
			end
		end
	end
	table.clear(f.events)
end

local function syncState(f: FlightPhysics.Flight)
	local now = os.clock()
	local changed = f.gear ~= sent.gear or f.flaps ~= sent.flaps or f.reverse ~= sent.reverse
	local thrChanged = math.abs(f.throttle - sent.throttle) > 0.04 and now - sent.t > 0.25
	if changed or thrChanged then
		sent.gear, sent.flaps, sent.reverse, sent.throttle, sent.t = f.gear, f.flaps, f.reverse, f.throttle, now
		PlaneState:FireServer(f.gear, f.flaps, f.throttle, f.reverse)
	end
	Animator.setLocal(model, f.gear, f.flaps, f.throttle)
end

-- ===== физика: каждый шаг перед симуляцией Roblox
RunService.PreSimulation:Connect(function(dt)
	local f = flight
	if not f or f.crashed or not model or not root then
		return
	end
	if not simulating then
		-- ждём, пока сервер отдаст нам самолёт (снимет Anchored и назначит владельца)
		if root.Anchored then
			return
		end
		simulating = true
	end
	local input, manual = controls.read()
	if parkBrake then
		if f.onGround then
			input.brakes = true
		else
			parkBrake = false
		end
	end
	if apTarget then
		if manual then
			apTarget = nil
			ui.setAutopilot(false)
			ui.toast("Автопилот отключён штурвалом", "amber")
		else
			local n = World.NAV[navIdx]
			if apFollowNav and n then
				local t = apTarget :: Autopilot.Target
				t.heading = Autopilot.bearingDeg(f.pos, Vector3.new(n.x, 0, n.z))
				-- над целью: переходим в удержание курса, чтобы не кружить
				if (Vector3.new(f.pos.X - n.x, 0, f.pos.Z - n.z)).Magnitude < 1200 then
					apFollowNav = false
					ui.toast("Цель достигнута: " .. n.name, "green")
				end
			end
			local ap = Autopilot.compute(f, apTarget)
			ap.brakes = input.brakes
			input = ap
		end
	end
	local prevPos = f.pos
	-- ветер с сервера + порывы (каждый клиент считает порывы сам)
	do
		local wd = tonumber(workspace:GetAttribute("WindDir")) or 0
		local wk = tonumber(workspace:GetAttribute("WindKts")) or 0
		local t = os.clock()
		local gust = 1 + 0.25 * math.sin(t * 0.9) * math.sin(t * 0.37 + 1)
		f.wind = FlightPhysics.windVector(wd, wk * gust)
	end
	FlightPhysics.step(f, input, dt)
	if not f.crashed then
		race.step(prevPos, f.pos, os.clock())
	end
	handleEvents(f)
	if f.crashed then
		return
	end
	root.CFrame = FlightPhysics.pose(f)
	root.AssemblyLinearVelocity = f.vel
	root.AssemblyAngularVelocity = Vector3.zero
	syncState(f)
end)

-- ===== приборы
local function fmt(n: number): string
	local s = tostring(math.round(math.abs(n)))
	local out = s:reverse():gsub("(%d%d%d)", "%1 "):reverse():gsub("^ ", "")
	return (if n < 0 then "−" else "") .. out
end

local function updateHud(f: FlightPhysics.Flight, dt: number, now: number)
	local c = f.cfg
	if f.pos.Y * FT > 35000 then
		claimAch("high")
	end
	if c.id == "F16" and f.gload >= 8 and f.damage < 0.05 then
		claimAch("ace")
	end
	local att = f.att
	local look, right, up = att.LookVector, att.RightVector, att.UpVector
	local agl = (f.dbg.agl or 0) * FT
	vsSmooth += (f.vel.Y * 60 * FT - vsSmooth) * math.min(1, dt * 6)
	local vs = math.round(vsSmooth / 10) * 10
	local hdg = World.headingDeg(look)
	ui.setCells({
		spd = { tostring(math.round(f.speed)) },
		alt = { fmt(f.pos.Y * FT), if agl < 2500 then "над землёй " .. fmt(math.max(0, agl)) else "ft" },
		vs = { (if vs > 0 then "+" else "") .. fmt(vs) },
		hdg = { string.format("%03d", math.round(hdg) % 360) },
		thr = { if f.reverse then "REV" else tostring(math.round(f.throttle * 100)), nil :: any, if f.reverse then "amber" else "green" },
		flaps = { if c.noFlaps then "—" else tostring(f.flaps), if f.gear then "шасси ▼" else "шасси ▲", "green", if f.gear then "green" else "dim" },
	})
	ui.setThrottleFill(f.throttle)
	local pitchDeg = math.deg(math.asin(clamp(look.Y, -1, 1)))
	local bankDeg = math.deg(math.atan2(-right.Y, up.Y))
	ui.setAdi(pitchDeg, bankDeg)
	ui.setHeading(hdg)
	ui.setWeather(f.pos.Y * FT)

	-- навигация (во время гонки — на следующее кольцо), радар, таймер гонки
	-- разрешение на заход: рейс, до аэропорта назначения меньше 6 км
	if lastDest and not atcApproach and not f.onGround then
		local dst = World.airportById(lastDest)
		if dst and Vector3.new(f.pos.X - dst.cx, 0, f.pos.Z - dst.cz).Magnitude * World.METERS_PER_STUD < 6000 then
			atcApproach = true
			ui.atc(string.format("Вышка %s: %s, заход на полосу %s разрешён. Шасси, закрылки.", dst.code, callsign, runwayFor(dst, f.pos)))
		end
	end
	local ringPos, ringName = race.target()
	if gateTarget then
		local gp = Vector3.new(gateTarget.x, 0, gateTarget.z)
		local d = Vector3.new(f.pos.X, 0, f.pos.Z) - gp
		if f.onGround and f.speed < 3 and d.Magnitude < 45 then
			GateParked:FireServer(gateTarget.id)
			ui.atc(string.format("Земля: %s, стоянка %s, двигатели выключить. До связи!", callsign, gateTarget.id))
			gateTarget = nil
		else
			ringPos, ringName = Vector3.new(gp.X, 0, gp.Z), "стоянка " .. gateTarget.id
		end
	end
	if not ringPos and lastMode == "race" then
		ringPos, ringName = race.firstRing(), "Старт гонки"
	end
	ui.setBanner(if parkBrake then (if UserInputService.GamepadEnabled then "Ⓟ  Стояночный тормоз · L3 (нажми левый стик) или пробел" else "Ⓟ  Стояночный тормоз · пробел или нажми, чтобы отключить") else nil)
	radar.update(f.pos, hdg, model, ringPos or race.firstRing())
	ui.setRace(race.status(now))
	-- глиссада к аэропорту назначения
	do
		-- в рейсе — аэропорт назначения, в свободном полёте — первый аэропорт, на чью глиссаду мы попали
		local dst = lastDest and World.airportById(lastDest)
		local dev, lat, rwy
		if not f.onGround then
			if dst then
				dev, lat, rwy = World.glideslope(dst, f.pos)
			elseif lastMode ~= "race" then
				-- выровнены на ось (< 12°) и ближе всех
				local bestD = math.huge
				for _, ap in World.AIRPORTS do
					local d1, l1, r1 = World.glideslope(ap, f.pos)
					local dist = Vector3.new(f.pos.X - ap.cx, 0, f.pos.Z - ap.cz).Magnitude
					if d1 and l1 and math.abs(l1) < 12 and math.abs(d1) < 2500 and dist < bestD then
						bestD, dst, dev, lat, rwy = dist, ap, d1, l1, r1
					end
				end
			end
		end
		if dev and lat then
			local good = math.abs(dev) < 80 and math.abs(lat) < 1.5
			local v = if math.abs(dev) < 80 then "на глиссаде" elseif dev > 0 then string.format("выше %d ft", math.round(dev)) else string.format("ниже %d ft", math.round(-dev))
			local h = if math.abs(lat) < 1.5 then "по оси" elseif lat > 0 then string.format("правее %.0f°", lat) else string.format("левее %.0f°", -lat)
			ui.setIls(string.format("ILS %s %s · %s · %s%s", dst.code, rwy, v, h, if good then " ✓" else ""), good)
		else
			ui.setIls(nil)
		end
	end
	local n = World.NAV[navIdx]
	if ringPos then
		local brg = Autopilot.bearingDeg(f.pos, ringPos)
		local dist = Vector3.new(f.pos.X - ringPos.X, 0, f.pos.Z - ringPos.Z).Magnitude * World.METERS_PER_STUD / 1000
		if gateTarget then
			ui.setNav(string.format("%s · %.2f км · курс %03d°", string.upper(ringName or ""), dist, math.round(brg) % 360), Autopilot.wrap180(brg - hdg))
		else
			ui.setNav(string.format("КОЛЬЦО · %s · %.1f км · высота %d ft", ringName or "", dist, math.round(ringPos.Y * FT)), Autopilot.wrap180(brg - hdg))
		end
	elseif n then
		local brg = Autopilot.bearingDeg(f.pos, Vector3.new(n.x, 0, n.z))
		local dist = Vector3.new(f.pos.X - n.x, 0, f.pos.Z - n.z).Magnitude * World.METERS_PER_STUD / 1000
		ui.setNav(string.format("%s · %.1f км · курс %03d°", n.name, dist, math.round(brg) % 360), Autopilot.wrap180(brg - hdg))
	else
		ui.setNav(nil)
	end

	-- предупреждения
	local w, col = "", Ui.Colors.red
	local stall = f.dbg.stall or c.stallKts
	local dAgl = f.dbg.agl or 0
	local ahead = f.pos + f.vel * 6
	local terrainAhead = not f.onGround and f.vel.Y < -5 and ahead.Y < World.groundAt(ahead.X, ahead.Z) + 60
	local gMax, gMin = FlightPhysics.limits(c)
	ui.setG(f.gload, gMax, gMin, f.damage)
	if not f.onGround and (f.gload > gMax * 0.9 or f.gload < gMin * 0.9) then
		w = string.format("ПЕРЕГРУЗКА %.1f G · ПРЕДЕЛ %.1f", f.gload, if f.gload > 0 then gMax else gMin)
	elseif not f.onGround and f.speed < stall * 1.05 then
		w = "STALL · СВАЛИВАНИЕ"
	elseif not f.onGround and ((dAgl < 400 and f.vel.Y < -25) or terrainAhead) then
		w = "PULL UP · ТЯНИ ВВЕРХ"
	elseif not f.onGround and not f.gear and dAgl < 250 and f.vel.Y < 0 then
		w, col = "ВЫПУСТИ ШАССИ", Ui.Colors.amber
	elseif f.flaps > 0 and f.speed > c.flapMaxKts then
		w, col = "ЗАКРЫЛКИ: ПРЕВЫШЕНИЕ", Ui.Colors.amber
	elseif f.speed > c.maxKts * 1.02 then
		w, col = "ПРЕВЫШЕНИЕ СКОРОСТИ", Ui.Colors.amber
	end
	ui.setWarn(if w ~= "" and (now % 0.6) < 0.42 then w else "", col)

	if engineSound then
		engineSound.PlaybackSpeed = 0.6 + f.throttle * 0.8
	end

	if ui.debugVisible() then
		local d = f.dbg
		ui.setDebug(string.format(
			"<b>ОТЛАДКА · %s</b>\nпоз   x %d  y %.1f  z %d\nAGL   %s stud  земля: %s\nскор  %.1f kt   ускор %.2f kt/с\nтяга  %.2f  сопр %.2f  ×выс %.2f\nподъём %.2f  эфф %.2f  свал %d kt\nтангаж %.1f°  крен %.1f°\nвход  P %.2f  R %.2f  Y %.2f\nvy    %.2f  vyExtra %.2f\nFPS   %d\n<b>ЖУРНАЛ</b>\n%s",
			c.name, math.round(f.pos.X), f.pos.Y, math.round(f.pos.Z),
			if d.agl == math.huge then "∞" else string.format("%.2f", d.agl), tostring(f.onGround),
			f.speed, d.accel or 0, d.thrust or 0, d.drag or 0, d.thrustMul or 1,
			d.lift or 0, d.eff or 0, math.round(d.stall or 0), pitchDeg, bankDeg,
			f.inP, f.inR, f.inY, f.vel.Y, f.vyExtra, math.round(fps),
			table.concat(logLines, "\n", math.max(1, #logLines - 7))
		))
	end
end

-- ===== кадр: камера, приборы, анимация
RunService:BindToRenderStep("SkyPilot", Enum.RenderPriority.Camera.Value + 1, function(dt)
	local now = os.clock()
	fps += ((1 / math.max(dt, 1e-3)) - fps) * 0.05
	ui.tick(dt)
	ui.atcTick(dt)
	Animator.step(dt, now)
	local f = flight
	if f then
		if f.crashed then
			if crashTimer > 0 then
				crashTimer -= dt
				if crashTimer <= 0 then
					ui.showCrash(f.crashReason or "Крушение")
				end
			end
			cameraRig.update(dt, crashPose or FlightPhysics.pose(f), f.cfg, 0, false, true)
		else
			local pose = if root and simulating then root.CFrame else FlightPhysics.pose(f)
			cameraRig.update(dt, pose, f.cfg, f.speed, f.onGround, false, f.buffet)
			updateHud(f, dt, now)
		end
	elseif ui.hangarVisible() then
		cameraRig.idle(now)
	else
		cameraRig.release()
	end
end)

-- ночной город: в сумерках стеклянные башни, терминалы и вышки светятся тёплым светом окон
task.spawn(function()
	local Lighting = game:GetService("Lighting")
	local worldFolder = workspace:WaitForChild("SkyPilotWorld", 60)
	if not worldFolder then
		return
	end
	task.wait(5) -- даём серверу достроить город
	local glass: { { p: BasePart, color: Color3, mat: Enum.Material } } = {}
	local lamps: { BasePart } = {}
	for _, d in worldFolder:GetDescendants() do
		if d:IsA("BasePart") and d.Material == Enum.Material.Glass and d.Size.Y > 20 and d.Transparency < 0.5 then
			table.insert(glass, { p = d, color = d.Color, mat = d.Material })
		elseif d:IsA("BasePart") and d.Name == "ApronLamp" then
			table.insert(lamps, d)
		end
	end
	local WARM = Color3.fromRGB(255, 205, 130)
	local night: boolean? = nil
	while true do
		local t = Lighting.ClockTime
		local isNight = t < 6.3 or t > 18.7
		if isNight ~= night then
			night = isNight
			-- мачты освещения перрона
			for _, l in lamps do
				l.Material = if isNight then Enum.Material.Neon else Enum.Material.SmoothPlastic
				local sl = l:FindFirstChildOfClass("SpotLight")
				if sl then
					sl.Enabled = isNight
				end
			end
			for i, g in glass do
				if g.p.Parent then
					if isNight then
						local c = g.color:Lerp(WARM, 0.45)
						g.p.Material = Enum.Material.Neon
						g.p.Color = Color3.new(c.R * 0.42, c.G * 0.4, c.B * 0.34)
					else
						g.p.Material = g.mat
						g.p.Color = g.color
					end
				end
				if i % 300 == 0 then
					task.wait()
				end
			end
		end
		task.wait(5)
	end
end)

-- после крушения: «В ангар» сбрасывает полёт, «Снова» — новый запрос
local baseToHangar = ui.showHangar
ui.showHangar = function(on: boolean?)
	if on == true and flight and flight.crashed then
		stopFlight()
	end
	baseToHangar(on)
end

ui.showHangar(true)
]]></ProtectedString></Properties><Item class="ModuleScript" referent="RBX0000000E"><Properties><string name="Name">Animator</string><ProtectedString name="Source"><![CDATA[--!strict
-- Локальная анимация всех самолётов (своих, чужих и ИИ): винт, огни, шасси, закрылки,
-- инверсионный след, форсаж. Состояние приходит атрибутами модели от сервера,
-- а для своего самолёта — прямо из локальной физики (без задержки сети).
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("SkyPilot")
local PlaneBuilder = require(Shared:WaitForChild("PlaneBuilder"))
local World = require(Shared:WaitForChild("World"))

local Animator = {}

type Cache = {
	lights: { BasePart }, trails: { Trail }, prop: Weld?, fans: { Weld }, fanAngle: number, propBase: CFrame?, disc: BasePart?, ab: BasePart?,
	angle: number, gear: boolean?, flaps: number?,
}
local caches: { [Model]: Cache } = {}
local localModel: Model? = nil
local localState: { gear: boolean, flaps: number, throttle: number } = { gear = true, flaps = 0, throttle = 0 }

function Animator.setLocal(model: Model?, gear: boolean?, flaps: number?, throttle: number?)
	localModel = model
	if gear ~= nil then
		localState.gear = gear
	end
	if flaps ~= nil then
		localState.flaps = flaps
	end
	if throttle ~= nil then
		localState.throttle = throttle
	end
end

local function cacheFor(m: Model): Cache
	local c = caches[m]
	if c then
		return c
	end
	local lights, trails = {}, {}
	for _, d in m:GetDescendants() do
		if d:IsA("BasePart") and d:GetAttribute("LightKind") then
			table.insert(lights, d)
		elseif d:IsA("Trail") then
			table.insert(trails, d)
		end
	end
	local engines = m:FindFirstChild("Engines")
	local fans: { Weld } = {}
	if engines then
		for _, d in engines:GetDescendants() do
			if d:IsA("Weld") and d.Name == "FanWeld" then
				table.insert(fans, d)
			end
		end
	end
	local propPart = engines and engines:FindFirstChild("Prop")
	local prop = propPart and propPart:FindFirstChild("PropWeld") :: Weld?
	c = {
		lights = lights, trails = trails, prop = prop, fans = fans, fanAngle = 0,
		propBase = prop and prop:GetAttribute("Base") :: CFrame?,
		disc = engines and engines:FindFirstChild("PropDisc") :: BasePart?,
		ab = engines and engines:FindFirstChild("Afterburner") :: BasePart?,
		angle = 0, gear = nil, flaps = nil,
	}
	caches[m] = c
	m.Destroying:Connect(function()
		caches[m] = nil
	end)
	return c
end

function Animator.step(dt: number, now: number)
	local folder = workspace:FindFirstChild("Planes")
	if not folder then
		return
	end
	for _, m in folder:GetChildren() do
		if not m:IsA("Model") or m.Name == "Wreck" then
			continue
		end
		local root = m.PrimaryPart
		if not root then
			continue
		end
		local c = cacheFor(m)
		local gear, flaps, thr
		if m == localModel then
			gear, flaps, thr = localState.gear, localState.flaps, localState.throttle
		else
			gear = m:GetAttribute("Gear") ~= false
			flaps = (m:GetAttribute("Flaps") or 0) :: number
			thr = (m:GetAttribute("Throttle") or 0) :: number
		end
		if c.gear ~= gear then
			c.gear = gear
			PlaneBuilder.setGearVisible(m, gear)
		end
		if c.flaps ~= flaps then
			c.flaps = flaps
			PlaneBuilder.setFlaps(m, flaps)
		end
		-- вентиляторы турбовентиляторных двигателей: быстрее при большей тяге
		if #c.fans > 0 then
			c.fanAngle = (c.fanAngle + dt * (5 + thr * 38)) % (math.pi * 2)
			for _, w in c.fans do
				local base = w:GetAttribute("Base")
				if typeof(base) == "CFrame" then
					w.C0 = base * CFrame.Angles(c.fanAngle, 0, 0)
				end
			end
		end
		-- винт
		if c.prop and c.propBase then
			c.angle = (c.angle + dt * (8 + thr * 70)) % (math.pi * 2)
			c.prop.C0 = c.propBase * CFrame.Angles(0, 0, c.angle)
			if c.disc then
				c.disc.Transparency = 1 - math.min(0.18, thr * 0.25)
			end
		end
		if c.ab then
			c.ab.Transparency = if thr > 0.92 then 0.15 + math.random() * 0.2 else 1
		end
		-- огни: навигация горит, строб / маяк мигают
		for _, l in c.lights do
			local kind = l:GetAttribute("LightKind")
			local on = true
			if kind == "strobe" then
				on = (now % 1.2) < 0.06 or ((now - 0.15) % 1.2) < 0.05
			elseif kind == "beacon" then
				on = (now % 1.0) < 0.12
			end
			l.Transparency = if on then 0 else 0.85
		end
		-- инверсионный след выше 18 000 ft
		local contrail = root.Position.Y * World.FT > 18000 and thr > 0.3
		for _, t in c.trails do
			if t.Enabled ~= contrail then
				t.Enabled = contrail
			end
		end
	end
end

return Animator
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX0000000F"><Properties><string name="Name">CameraRig</string><ProtectedString name="Source"><![CDATA[--!strict
-- Камеры: сзади (плавная), кабина, орбита. Плюс облёт аэропорта в ангаре.
local UserInputService = game:GetService("UserInputService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("SkyPilot")
local World = require(Shared:WaitForChild("World"))

local CameraRig = {}
CameraRig.NAMES = { "сзади", "кабина", "орбита" }

function CameraRig.new(ui: any)
	local self: any = { mode = 1, orbit = { yaw = 0.6, pitch = 0.25, dist = 100 } }
	local cam = workspace.CurrentCamera
	local camRot = CFrame.identity
	local dragging = false
	local lastPos: Vector3? = nil
	local rng = Random.new()

	UserInputService.InputBegan:Connect(function(i, processed)
		if self.mode ~= 3 then
			return
		end
		if i.UserInputType == Enum.UserInputType.MouseButton2 or (i.UserInputType == Enum.UserInputType.Touch and not processed) then
			dragging = true
			lastPos = i.Position
		end
	end)
	UserInputService.InputEnded:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton2 or i.UserInputType == Enum.UserInputType.Touch then
			dragging = false
			lastPos = nil
		end
	end)
	UserInputService.InputChanged:Connect(function(i, processed)
		if self.mode ~= 3 then
			return
		end
		if i.UserInputType == Enum.UserInputType.MouseWheel and not processed then
			self.orbit.dist = math.clamp(self.orbit.dist * (if i.Position.Z < 0 then 1.1 else 0.9), 20, 3000)
		elseif dragging and lastPos and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
			if ui.isTouchingControls() then
				return
			end
			local d = i.Position - lastPos
			lastPos = i.Position
			self.orbit.yaw -= d.X * 0.008
			self.orbit.pitch = math.clamp(self.orbit.pitch + d.Y * 0.006, -0.2, 1.3)
		end
	end)

	function self.cycle(): string
		self.mode = self.mode % 3 + 1
		return CameraRig.NAMES[self.mode]
	end

	function self.reset(att: CFrame, cfg: any)
		camRot = att
		self.orbit.dist = cfg.length * 1.2 + 40
	end

	-- pose — фактическое положение модели (то, что рисуется), cfg — конфиг
	function self.update(dt: number, pose: CFrame, cfg: any, speed: number, onGround: boolean, crashed: boolean, buffet: number?)
		cam.CameraType = Enum.CameraType.Scriptable
		cam.FieldOfView = 66 + math.clamp(speed / cfg.maxKts, 0, 1) * 14
		local base = pose.Position
		local att = pose.Rotation
		if self.mode == 1 or crashed then
			camRot = camRot:Lerp(att, math.min(1, dt * 4))
			local back = cfg.length * 0.8 + 32
			local upOff = cfg.diameter * 1.25 + cfg.length * 0.09 + 6
			local eye = base + camRot * Vector3.new(0, upOff, back)
			local target = base + camRot * Vector3.new(0, upOff * 0.3, -cfg.length * 0.4)
			if buffet and buffet > 0.02 then
				local k = buffet * math.clamp(cfg.length / 60, 0.6, 2)
				eye += Vector3.new(rng:NextNumber(-1, 1), rng:NextNumber(-1, 1), rng:NextNumber(-1, 1)) * k
			end
			if onGround and speed > 30 then
				eye += Vector3.new(0, (rng:NextNumber() - 0.5) * math.min(0.6, speed / 400), 0)
			end
			local gmin = World.groundAt(eye.X, eye.Z)
			if eye.Y < gmin + 3 then
				eye = Vector3.new(eye.X, gmin + 3, eye.Z)
			end
			cam.CFrame = CFrame.lookAt(eye, target, camRot.UpVector)
		elseif self.mode == 2 then
			local eye = pose * Vector3.new(0, cfg.diameter * 0.36, -cfg.length * 0.5 - 1.5)
			cam.CFrame = CFrame.new(eye) * att
			camRot = att
		else
			local o = self.orbit
			local off = Vector3.new(math.sin(o.yaw) * math.cos(o.pitch), math.sin(o.pitch), math.cos(o.yaw) * math.cos(o.pitch)) * o.dist
			cam.CFrame = CFrame.lookAt(base + off, base)
			camRot = att
		end
	end

	-- медленный облёт аэропорта (ангар / ожидание)
	function self.idle(t: number)
		cam.CameraType = Enum.CameraType.Scriptable
		cam.FieldOfView = 66
		local a = t / 14
		local eye = Vector3.new(math.sin(a) * 900 + 650, 90 + math.sin(a * 0.7) * 30, math.cos(a) * 900 + 300)
		cam.CFrame = CFrame.lookAt(eye, Vector3.new(680, 20, 300))
	end

	function self.release()
		cam.CameraType = Enum.CameraType.Custom
		cam.FieldOfView = 70
	end

	return self
end

return CameraRig
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000010"><Properties><string name="Name">Controls</string><ProtectedString name="Source"><![CDATA[--!strict
-- Ввод: клавиатура, геймпад, сенсорный штурвал и мышь-штурвал -> общий ввод физики.
local UserInputService = game:GetService("UserInputService")

local Controls = {}

local ONCE: { [Enum.KeyCode]: string } = {
	[Enum.KeyCode.G] = "gear", [Enum.KeyCode.F] = "flapDn", [Enum.KeyCode.R] = "flapUp",
	[Enum.KeyCode.T] = "rev", [Enum.KeyCode.Z] = "idle", [Enum.KeyCode.V] = "cam",
	[Enum.KeyCode.M] = "hangar", [Enum.KeyCode.P] = "autopilot", [Enum.KeyCode.C] = "mouse", [Enum.KeyCode.N] = "nav", [Enum.KeyCode.Space] = "park", [Enum.KeyCode.I] = "guide", [Enum.KeyCode.X] = "spoiler", [Enum.KeyCode.DPadRight] = "nav",
	-- геймпад
	[Enum.KeyCode.ButtonY] = "gear", [Enum.KeyCode.DPadUp] = "flapUp", [Enum.KeyCode.DPadDown] = "flapDn",
	[Enum.KeyCode.ButtonX] = "rev", [Enum.KeyCode.ButtonA] = "autopilot", [Enum.KeyCode.ButtonSelect] = "cam",
	-- без них с геймпада нельзя было снять стояночный тормоз на старте и выпустить интерцепторы
	[Enum.KeyCode.ButtonL3] = "park", [Enum.KeyCode.DPadLeft] = "spoiler",
}

-- экспонента: точность около центра, полный ход на краю
local function expo(v: number): number
	return v * (0.4 + 0.6 * v * v)
end

local function dz(v: number, d: number): number
	if math.abs(v) < d then
		return 0
	end
	return math.sign(v) * (math.abs(v) - d) / (1 - d)
end

function Controls.new(ui: any, onAction: (string) -> ())
	local self: any = { mouseYoke = false }

	UserInputService.InputBegan:Connect(function(input, processed)
		if processed then
			return
		end
		local a = ONCE[input.KeyCode]
		if a then
			onAction(a)
		end
	end)

	local function key(k: Enum.KeyCode): number
		return if UserInputService:IsKeyDown(k) then 1 else 0
	end

	-- возвращает ввод и признак «пилот сам трогает штурвал» (для отключения автопилота)
	function self.read(): (any, boolean)
		local kp = math.max(key(Enum.KeyCode.S), key(Enum.KeyCode.Down)) - math.max(key(Enum.KeyCode.W), key(Enum.KeyCode.Up))
		local kr = math.max(key(Enum.KeyCode.D), key(Enum.KeyCode.Right)) - math.max(key(Enum.KeyCode.A), key(Enum.KeyCode.Left))
		local ky = key(Enum.KeyCode.E) - key(Enum.KeyCode.Q)
		local thrUp = UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) or UserInputService:IsKeyDown(Enum.KeyCode.RightShift)
		local thrDn = UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) or UserInputService:IsKeyDown(Enum.KeyCode.RightControl)
		local brakes = UserInputService:IsKeyDown(Enum.KeyCode.B)

		local t = ui.touch
		local p = kp + expo(t.y)
		local r = kr + expo(t.x)
		local y = ky + t.rr - t.rl
		brakes = brakes or t.brake

		-- геймпад
		if UserInputService.GamepadEnabled then
			for _, s in UserInputService:GetGamepadState(Enum.UserInputType.Gamepad1) do
				local kc = s.KeyCode
				if kc == Enum.KeyCode.Thumbstick1 then
					p += expo(-dz(s.Position.Y, 0.12))
					r += expo(dz(s.Position.X, 0.12))
				elseif kc == Enum.KeyCode.ButtonR2 and s.Position.Z > 0.25 then
					thrUp = true
				elseif kc == Enum.KeyCode.ButtonL2 and s.Position.Z > 0.25 then
					thrDn = true
				end
			end
			local gp = Enum.UserInputType.Gamepad1
			if UserInputService:IsGamepadButtonDown(gp, Enum.KeyCode.ButtonR1) then
				y += 1
			end
			if UserInputService:IsGamepadButtonDown(gp, Enum.KeyCode.ButtonL1) then
				y -= 1
			end
			if UserInputService:IsGamepadButtonDown(gp, Enum.KeyCode.ButtonB) then
				brakes = true
			end
		end

		-- мышь-штурвал: отклонение курсора от центра экрана
		if self.mouseYoke then
			local cam = workspace.CurrentCamera
			local m = UserInputService:GetMouseLocation()
			local vs = cam.ViewportSize
			local span = math.min(vs.X, vs.Y) * 0.32
			local mx = math.clamp((m.X - vs.X / 2) / span, -1, 1)
			local my = math.clamp((m.Y - vs.Y / 2) / span, -1, 1)
			p += expo(dz(my, 0.05))
			r += expo(dz(mx, 0.05))
		end

		local manual = math.abs(kp) + math.abs(kr) + math.abs(ky) > 0 or math.abs(t.x) + math.abs(t.y) > 0.3
		local input = { p = p, r = r, y = y, thrUp = thrUp, thrDn = thrDn, brakes = brakes, throttle = t.throttle }
		t.throttle = nil -- слайдер передаёт значение один раз за движение
		return input, manual
	end

	return self
end

return Controls
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000011"><Properties><string name="Name">Race</string><ProtectedString name="Source"><![CDATA[--!strict
-- Гонка через кольца: маршрут Skyport → Дубай → Ташкент → Лондон → Skyport.
-- Кольца строятся у каждого игрока локально, поэтому подсветка своя у каждого.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("SkyPilot")
local World = require(Shared:WaitForChild("World"))

local Race = {}

local SEGMENTS = 28
local COLOR_NEXT = Color3.fromRGB(59, 167, 255)
local COLOR_DONE = Color3.fromRGB(77, 255, 149)
local COLOR_IDLE = Color3.fromRGB(235, 240, 255)

type Ring = { cf: CFrame, r: number, name: string, parts: { BasePart } }

function Race.new(onPass: (string, number, number) -> (), onFinish: (number) -> ())
	local self: any = {}
	local rings: { Ring } = {}
	local folder = Instance.new("Folder")
	folder.Name = "SkyPilotRings"
	folder.Parent = workspace

	for _, d in World.CityData.rings do
		local cf = CFrame.new(d[1], d[2], d[3]) * CFrame.Angles(0, d[5], 0)
		local r = d[4]
		local ring: Ring = { cf = cf, r = r, name = d[6], parts = {} }
		local seg = 2 * math.pi * r / SEGMENTS * 1.08
		local thick = math.max(2, r * 0.07)
		for i = 0, SEGMENTS - 1 do
			local t = 2 * math.pi * i / SEGMENTS
			local p = Instance.new("Part")
			p.Anchored = true
			p.CanCollide = false
			p.CanQuery = false
			p.CanTouch = false
			p.CastShadow = false
			p.Material = Enum.Material.Neon
			p.Size = Vector3.new(seg, thick, thick)
			p.CFrame = cf * CFrame.new(r * math.cos(t), r * math.sin(t), 0) * CFrame.Angles(0, 0, t + math.pi / 2)
			p.Parent = folder
			table.insert(ring.parts, p)
		end
		table.insert(rings, ring)
	end

	local nextIdx = 1
	local startT: number? = nil

	local function paint()
		for i, ring in rings do
			local color = if i < nextIdx then COLOR_DONE elseif i == nextIdx then COLOR_NEXT else COLOR_IDLE
			local tr = if i < nextIdx then 0.7 elseif i == nextIdx then 0 else 0.45
			for _, p in ring.parts do
				p.Color = color
				p.Transparency = tr
			end
		end
	end
	paint()

	function self.reset()
		nextIdx = 1
		startT = nil
		paint()
	end

	-- prev/pos — позиция самолёта на прошлом и текущем шаге
	function self.step(prev: Vector3, pos: Vector3, now: number)
		local ring = rings[nextIdx]
		if not ring then
			return
		end
		local a = ring.cf:PointToObjectSpace(prev)
		local b = ring.cf:PointToObjectSpace(pos)
		if (a.Z > 0) == (b.Z > 0) or math.abs(a.Z - b.Z) < 1e-6 then
			return
		end
		local p = a:Lerp(b, a.Z / (a.Z - b.Z))
		if p.X * p.X + p.Y * p.Y > (ring.r * 1.1) ^ 2 then
			return
		end
		if nextIdx == 1 then
			startT = now
		end
		local elapsed = now - (startT or now)
		nextIdx += 1
		paint()
		if nextIdx > #rings then
			onFinish(elapsed)
			startT = nil
			nextIdx = 1
			task.delay(3, paint)
		else
			onPass(ring.name, nextIdx - 1, #rings)
		end
	end

	-- следующее кольцо для навигации (nil, если гонка не начата)
	function self.target(): (Vector3?, string?)
		if not startT then
			return nil, nil
		end
		local ring = rings[nextIdx]
		if not ring then
			return nil, nil
		end
		return ring.cf.Position, ring.name
	end

	function self.firstRing(): Vector3
		return rings[1].cf.Position
	end

	function self.status(now: number): string?
		if not startT then
			return nil
		end
		local t = now - startT
		return string.format("КОЛЬЦА %d/%d · %d:%04.1f", nextIdx - 1, #rings, math.floor(t / 60), t % 60)
	end

	return self
end

return Race
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000012"><Properties><string name="Name">Radar</string><ProtectedString name="Source"><![CDATA[--!strict
-- Радар: курс вверх, радиус 12 000 stud (~6 км). Аэропорты, города, самолёты, следующее кольцо.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("SkyPilot")
local World = require(Shared:WaitForChild("World"))

local Radar = {}

local SIZE = 150
local RANGE = 12000

function Radar.new(parent: Instance, colors: any)
	local self: any = {}
	local frame = Instance.new("CanvasGroup")
	frame.Name = "Radar"
	frame.Size = UDim2.fromOffset(SIZE, SIZE)
	frame.Position = UDim2.fromOffset(0, 128)
	frame.BackgroundColor3 = colors.panel
	frame.BackgroundTransparency = 0.25
	frame.Visible = false
	frame.Parent = parent
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0.5, 0)
	c.Parent = frame
	local st = Instance.new("UIStroke")
	st.Color = colors.line
	st.Transparency = 0.5
	st.Parent = frame
	for _, k in { 0.33, 0.66 } do
		local ring = Instance.new("Frame")
		ring.AnchorPoint = Vector2.new(0.5, 0.5)
		ring.Position = UDim2.fromScale(0.5, 0.5)
		ring.Size = UDim2.fromScale(k, k)
		ring.BackgroundTransparency = 1
		local rc = Instance.new("UICorner")
		rc.CornerRadius = UDim.new(0.5, 0)
		rc.Parent = ring
		local rs = Instance.new("UIStroke")
		rs.Color = colors.line
		rs.Transparency = 0.75
		rs.Parent = ring
		ring.Parent = frame
	end
	local me = Instance.new("TextLabel")
	me.AnchorPoint = Vector2.new(0.5, 0.5)
	me.Position = UDim2.fromScale(0.5, 0.5)
	me.Size = UDim2.fromOffset(16, 16)
	me.BackgroundTransparency = 1
	me.Text = "✈"
	me.Rotation = -90
	me.TextColor3 = colors.amber
	me.TextSize = 16
	me.Font = Enum.Font.GothamBold
	me.ZIndex = 5
	me.Parent = frame

	local function blip(text: string, color: Color3, size: number): TextLabel
		local t = Instance.new("TextLabel")
		t.AnchorPoint = Vector2.new(0.5, 0.5)
		t.Size = UDim2.fromOffset(if #text > 1 then 70 else size, size)
		t.BackgroundTransparency = 1
		t.Text = text
		t.TextColor3 = color
		t.TextSize = size
		t.Font = Enum.Font.GothamBold
		t.TextStrokeTransparency = 0.5
		t.Parent = frame
		return t
	end

	-- аэропорт: буква в кружке (прижимается к краю, если далеко); город: точка и подпись под ней,
	-- только в радиусе — подписи города и его аэропорта не слипаются
	local fixed: { { label: TextLabel, x: number, z: number, edge: boolean, dot: TextLabel?, airport: boolean? } } = {}
	for _, ap in World.AIRPORTS do
		local b = blip(ap.id, Color3.new(1, 1, 1), 12)
		b.Size = UDim2.fromOffset(18, 18)
		b.BackgroundColor3 = colors.magenta
		b.BackgroundTransparency = 0.6
		b.ZIndex = 3
		local bc = Instance.new("UICorner")
		bc.CornerRadius = UDim.new(0.5, 0)
		bc.Parent = b
		local bs = Instance.new("UIStroke")
		bs.Color = Color3.new(1, 1, 1)
		bs.Transparency = 0.5
		bs.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
		bs.Parent = b
		table.insert(fixed, { label = b, x = ap.cx, z = ap.cz, edge = true, airport = true })
	end
	for _, city in World.CITIES do
		local RU = { DUBAI = "Дубай", LONDON = "Лондон", TASHKENT = "Ташкент", ISTANBUL = "Стамбул", RIYADH = "Эр-Рияд", SAMARKAND = "Самарканд" }
		local name = RU[city.name] or city.name
		local t = blip(name, colors.dim, 10)
		t.AnchorPoint = Vector2.new(0.5, -0.35)
		table.insert(fixed, { label = t, x = city.x, z = city.z, edge = false, dot = blip("•", colors.fg, 12) })
	end
	local ringBlip = blip("◎", colors.magenta, 14)
	local planeBlips: { [Instance]: TextLabel } = {}

	local lastClamped = false
	local function place(label: TextLabel, pos: Vector3, x: number, z: number, hdg: number, edge: boolean): boolean
		lastClamped = false
		local east, north = x - pos.X, -(z - pos.Z)
		local h = math.rad(hdg)
		local right = east * math.cos(h) - north * math.sin(h)
		local up = east * math.sin(h) + north * math.cos(h)
		local d = math.sqrt(right * right + up * up)
		local maxR = RANGE * (if #label.Text > 2 then 0.62 else 0.85)
		if d > maxR then
			if not edge then
				label.Visible = false
				return false
			end
			right, up = right / d * maxR, up / d * maxR
			lastClamped = true
		end
		local k = (SIZE / 2) / RANGE
		label.Position = UDim2.fromOffset(SIZE / 2 + right * k, SIZE / 2 - up * k)
		label.Visible = true
		return true
	end

	function self.setVisible(on: boolean)
		frame.Visible = on
	end

	function self.update(pos: Vector3, hdg: number, ownModel: Instance?, ringPos: Vector3?)
		-- ближние аэропорты первыми; далёкие (на краю) не рисуем поверх уже показанных
		table.sort(fixed, function(a, b)
			if (a.airport == true) ~= (b.airport == true) then
				return a.airport == true
			end
			return (a.x - pos.X) ^ 2 + (a.z - pos.Z) ^ 2 < (b.x - pos.X) ^ 2 + (b.z - pos.Z) ^ 2
		end)
		local drawn: { UDim2 } = {}
		for _, f in fixed do
			local shown = place(f.label, pos, f.x, f.z, hdg, f.edge)
			if shown and f.airport then
				local p = f.label.Position
				if lastClamped then
					for _, q in drawn do
						if math.abs(q.X.Offset - p.X.Offset) < 15 and math.abs(q.Y.Offset - p.Y.Offset) < 15 then
							f.label.Visible = false
							shown = false
							break
						end
					end
				end
				if shown then
					table.insert(drawn, p)
				end
			end
			if f.dot then
				if shown then
					place(f.dot, pos, f.x, f.z, hdg, false)
				else
					f.dot.Visible = false
				end
			end
		end
		if ringPos then
			place(ringBlip, pos, ringPos.X, ringPos.Z, hdg, true)
		else
			ringBlip.Visible = false
		end
		local folder = workspace:FindFirstChild("Planes")
		local seen: { [Instance]: boolean } = {}
		if folder then
			for _, m in folder:GetChildren() do
				local root = m:IsA("Model") and m.PrimaryPart
				if root and m ~= ownModel and m.Name ~= "Wreck" then
					seen[m] = true
					local b = planeBlips[m]
					if not b then
						local isPlayer = m:GetAttribute("Owner") ~= nil
						b = blip("•", if isPlayer then colors.green else Color3.fromRGB(255, 230, 120), 18)
						planeBlips[m] = b
					end
					place(b, pos, root.Position.X, root.Position.Z, hdg, false)
				end
			end
		end
		for m, b in planeBlips do
			if not seen[m] then
				b:Destroy()
				planeBlips[m] = nil
			end
		end
	end

	return self
end

return Radar
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000013"><Properties><string name="Name">Ui</string><ProtectedString name="Source"><![CDATA[--!strict
-- Интерфейс Sky Pilot: верхняя панель, приборы, авиагоризонт, ангар, справка,
-- экран крушения и сенсорное управление (штурвал, РУД, кнопки).
local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("SkyPilot")
local PlaneConfigs = require(Shared:WaitForChild("PlaneConfigs"))
local World = require(Shared:WaitForChild("World"))

local C = {
	bg = Color3.fromRGB(5, 8, 15),
	panel = Color3.fromRGB(26, 35, 54),
	panelSolid = Color3.fromRGB(13, 20, 36),
	line = Color3.fromRGB(255, 255, 255),
	fg = Color3.fromRGB(243, 246, 251),
	dim = Color3.fromRGB(154, 167, 187),
	magenta = Color3.fromRGB(59, 167, 255), -- акцент (имя оставлено для совместимости)
	accentTop = Color3.fromRGB(86, 185, 255),
	accentBot = Color3.fromRGB(29, 111, 224),
	gold = Color3.fromRGB(244, 193, 82),
	green = Color3.fromRGB(92, 240, 162),
	amber = Color3.fromRGB(255, 191, 60),
	red = Color3.fromRGB(255, 77, 94),
	dark = Color3.fromRGB(26, 2, 22),
}
local FONT = Enum.Font.GothamBold
local FONT_BODY = Enum.Font.Gotham
local FONT_NUM = Enum.Font.RobotoMono
local FONT_TITLE = Enum.Font.GothamBlack

local Ui = {}
Ui.Colors = C

local function new(cls: string, props: { [string]: any }, parent: Instance?): any
	local o = Instance.new(cls)
	for k, v in props do
		(o :: any)[k] = v
	end
	if parent then
		o.Parent = parent
	end
	return o
end

local function corner(parent: Instance, r: number)
	new("UICorner", { CornerRadius = UDim.new(0, r) }, parent)
end
local function stroke(parent: Instance, color: Color3?, transp: number?)
	new("UIStroke", { Color = color or C.line, Transparency = transp or 0.86, Thickness = 1, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }, parent)
end
local function glass(parent: Instance, props: { [string]: any }): Frame
	local f = new("Frame", props, parent)
	f.BackgroundColor3 = C.panel
	f.BackgroundTransparency = 0.22
	f.BorderSizePixel = 0
	corner(f, 12)
	stroke(f)
	new("UIGradient", { Rotation = 90, Color = ColorSequence.new(Color3.new(1, 1, 1), Color3.fromRGB(150, 156, 172)) }, f)
	return f
end
local function button(parent: Instance, text: string, props: { [string]: any }?): TextButton
	local b = new("TextButton", {
		Text = text, Font = FONT, TextSize = 15, TextColor3 = C.fg, AutoButtonColor = true,
		BackgroundColor3 = C.panel, BackgroundTransparency = 0.2, BorderSizePixel = 0,
		Size = UDim2.fromOffset(0, 40), AutomaticSize = Enum.AutomaticSize.X,
	}, parent)
	new("UIPadding", { PaddingLeft = UDim.new(0, 16), PaddingRight = UDim.new(0, 16) }, b)
	corner(b, 12)
	stroke(b)
	new("UIGradient", { Name = "Sheen", Rotation = 90, Color = ColorSequence.new(Color3.new(1, 1, 1), Color3.fromRGB(150, 156, 172)) }, b)
	if props then
		for k, v in props do
			(b :: any)[k] = v
		end
	end
	return b
end
local function primary(b: TextButton)
	b.BackgroundColor3 = Color3.new(1, 1, 1)
	b.BackgroundTransparency = 0
	b.TextColor3 = Color3.new(1, 1, 1)
	b.Font = FONT_TITLE
	b.TextStrokeTransparency = 0.75
	local g = b:FindFirstChild("Sheen") :: UIGradient?
	if g then
		g.Color = ColorSequence.new(C.accentTop, C.accentBot)
	end
	local s = b:FindFirstChildOfClass("UIStroke")
	if s then
		s.Transparency = 0.7
	end
end

export type Callbacks = {
	onPick: (planeId: string, mode: string, destination: string?, livery: string?) -> (),
	onAction: (name: string) -> (),
	onAgain: () -> (),
	onToHangar: () -> (),
	onExit: () -> (),
}

function Ui.new(cb: Callbacks)
	local self: any = {}
	local player = Players.LocalPlayer
	local gui = new("ScreenGui", { Name = "SkyPilotUI", ResetOnSpawn = false, IgnoreGuiInset = false, ZIndexBehavior = Enum.ZIndexBehavior.Sibling, DisplayOrder = 5 }, player:WaitForChild("PlayerGui"))
	self.gui = gui
	local uiScale = new("UIScale", {}, gui)
	local function rescale()
		local cam = workspace.CurrentCamera
		local v = cam and cam.ViewportSize or Vector2.new(1280, 720)
		uiScale.Scale = math.clamp(math.min(v.X / 1100, v.Y / 680), 0.62, 1.25)
	end
	rescale()
	workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(rescale)
	local root = new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1 }, gui)
	new("UIPadding", { PaddingTop = UDim.new(0, 8), PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 8), PaddingBottom = UDim.new(0, 8) }, root)

	-- ================= верхняя панель
	local top = new("Frame", { Size = UDim2.new(1, 0, 0, 42), Position = UDim2.fromOffset(0, 0), BackgroundTransparency = 1 }, root)
	new("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 6), VerticalAlignment = Enum.VerticalAlignment.Center }, top)
	local bHangar = button(top, "✈ Ангар")
	primary(bHangar)
	local bCam = button(top, "Камера: сзади")
	local bMouse = button(top, "Мышь: выкл")
	local bAP = button(top, "Автопилот")
	local bNav = button(top, "Навигация")
	local bDebug = button(top, "Отладка")
	local bGuide = button(top, "Инструкция")
	local bHelp = button(top, "Клавиши")
