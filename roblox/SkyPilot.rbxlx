<Item class="Workspace" referent="RBX00000015"><Properties><string name="Name">Workspace</string><bool name="StreamingEnabled">false</bool><float name="FallenPartsDestroyHeight">-2000</float></Properties></Item>
<Item class="ReplicatedStorage" referent="RBX00000016"><Properties><string name="Name">ReplicatedStorage</string></Properties><Item class="Folder" referent="RBX00000009"><Properties><string name="Name">SkyPilot</string></Properties><Item class="ModuleScript" referent="RBX00000001"><Properties><string name="Name">Achievements</string><ProtectedString name="Source"><![CDATA[--!strict
-- Достижения: общий список для сервера (проверка, сохранение, награда) и клиента (экран, уведомления).
-- Тот же список — в веб-версии (tools/web_premium.py, ACH_JS).
local Achievements = {}

export type Ach = { id: string, icon: string, title: string, desc: string, reward: number, client: boolean? }

Achievements.LIST: { Ach } = {
	{ id = "first_flight", icon = "✈", title = "Первый полёт", desc = "Оторвись от полосы", reward = 100, client = true },
	{ id = "soft", icon = "🪶", title = "Мягкая посадка", desc = "Сядь мягче 250 ft/min", reward = 200 },
	{ id = "butter", icon = "🧈", title = "Как по маслу", desc = "Сядь мягче 80 ft/min", reward = 500 },
	{ id = "center", icon = "🎯", title = "Точно по оси", desc = "Сядь не дальше 2 м от оси полосы", reward = 300, client = true },
	{ id = "route", icon = "🧳", title = "Рейс выполнен", desc = "Долети до аэропорта назначения в режиме рейсов", reward = 500 },
	{ id = "ten", icon = "🔟", title = "Десять посадок", desc = "Соверши 10 посадок", reward = 500 },
	{ id = "airports", icon = "🌍", title = "Все аэропорты", desc = "Сядь во всех 8 аэропортах", reward = 2000 },
	{ id = "high", icon = "🛰", title = "Стратосфера", desc = "Поднимись выше 35 000 ft", reward = 300, client = true },
	{ id = "night", icon = "🌙", title = "Ночной пилот", desc = "Посади самолёт ночью", reward = 400 },
	{ id = "race", icon = "🏁", title = "Гонщик", desc = "Пройди все кольца гонки", reward = 500 },
	{ id = "ace", icon = "⚡", title = "Ас", desc = "Выдержи 8 G на F-16", reward = 400, client = true },
	{ id = "heavy", icon = "🐘", title = "Тяжеловес", desc = "Посади Airbus A380 или Boeing 747", reward = 300 },
}

Achievements.BY_ID = {} :: { [string]: Ach }
for _, a in Achievements.LIST do
	Achievements.BY_ID[a.id] = a
end

return Achievements
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000002"><Properties><string name="Name">Autopilot</string><ProtectedString name="Source"><![CDATA[--!strict
-- Автопилот: держит курс / высоту / скорость, выдавая обычный ввод штурвала.
-- Им пользуется игрок (клавиша P) и ИИ-трафик на сервере — одна и та же физика.
local World = require(script.Parent.World)
local FlightPhysics = require(script.Parent.FlightPhysics)

local clamp = FlightPhysics.clamp
local FT = World.FT

local Autopilot = {}

export type Target = { heading: number, altFt: number, speed: number, maxBank: number? }

local function wrap180(a: number): number
	return (a + 180) % 360 - 180
end
Autopilot.wrap180 = wrap180

function Autopilot.bearingDeg(from: Vector3, to: Vector3): number
	local d = to - from
	return (math.deg(math.atan2(d.X, -d.Z)) + 360) % 360
end

function Autopilot.compute(f: FlightPhysics.Flight, t: Target): FlightPhysics.Input
	local att = f.att
	local look, right, up = att.LookVector, att.RightVector, att.UpVector
	local hdg = World.headingDeg(look)
	local bankDeg = math.deg(math.atan2(-right.Y, up.Y))
	local pitchDeg = math.deg(math.asin(clamp(look.Y, -1, 1)))

	-- курс -> желаемый крен
	local maxBank = t.maxBank or 25
	local err = wrap180(t.heading - hdg)
	local wantBank = clamp(err * 1.2, -maxBank, maxBank)
	local r = clamp((wantBank - bankDeg) / 18, -1, 1)

	-- высота -> вертикальная скорость -> угол траектории
	local altFt = f.pos.Y * FT
	local wantFpm = clamp((t.altFt - altFt) * 2.5, -1800, 1800)
	local wantVy = wantFpm / 60 / FT
	local gammaDeg = math.deg(math.asin(clamp(wantVy / math.max(f.speed, 40), -0.35, 0.35)))
	local pathDeg = math.deg(math.asin(clamp(f.vel.Y / math.max(f.vel.Magnitude, 1), -1, 1)))
	local p = clamp((gammaDeg - pathDeg) / 4 + (gammaDeg - pitchDeg) / 10, -1, 1)

	-- скорость -> тяга
	-- упреждение: тяга, которая уравновешивает текущее сопротивление и набор высоты
	local c = f.cfg
	local avail = c.thrust * math.max(f.dbg.thrustMul or 1, 0.05)
	local ff = ((f.dbg.drag or 0) + FlightPhysics.G * look.Y) / avail
	local thr = clamp(ff + (t.speed - f.speed) * 0.03, 0, 1)
	return { p = p, r = r, y = 0, throttle = thr }
end

return Autopilot
]]></ProtectedString></Properties></Item>
