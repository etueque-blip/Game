		colors = { body = Color3.fromHex("f3f5f8"), accent = Color3.fromHex("1a7f4b"), tail = Color3.fromHex("0f5a34"), engine = Color3.fromHex("c4c8ce") } },
	A350 = { name = "Airbus A350-900", cls = "Широкофюзеляжный лайнер", length = 247, diameter = 21.5, span = 240, chord = 33, wing = "low", wingPos = 0.47, sweep = 32, dihedral = 6, engines = "wing2", engineD = 12, engineLen = 21, tail = "conventional", hstabSpan = 76, finHeight = 46, finSweep = 40, gearLen = 7.5, windows = true, winglets = true, mask = true, thrust = 5.8, maxKts = 490, stallKts = 128, vrKts = 150, flapMaxKts = 230, pitchRate = 0.34, rollRate = 0.74, yawRate = 0.2, turnBoost = 2, groundSteer = 0.45, brakeDecel = 8, stallSink = 60, maxRotate = 12, ceilingFt = 43000, maxTouchdownFpm = 1200,
		colors = { body = Color3.fromHex("f3f5f8"), accent = Color3.fromHex("5a2d82"), tail = Color3.fromHex("3d1d5c"), engine = Color3.fromHex("c4c8ce") } },
	A380 = { name = "Airbus A380-800", cls = "Двухпалубный гигант", length = 269, diameter = 26, span = 295, chord = 42, wing = "low", wingPos = 0.47, sweep = 33, dihedral = 5.6, engines = "wing4", engineD = 11, engineLen = 20, tail = "conventional", hstabSpan = 100, finHeight = 54, finSweep = 42, gearLen = 8.5, windows = true, winglets = true, doubleDeck = true, thrust = 5.0, maxKts = 490, stallKts = 135, vrKts = 158, flapMaxKts = 230, pitchRate = 0.28, rollRate = 0.6, yawRate = 0.17, turnBoost = 2, groundSteer = 0.4, brakeDecel = 8, stallSink = 68, maxRotate = 11, ceilingFt = 43000, maxTouchdownFpm = 1250,
		colors = { body = Color3.fromHex("f3f5f8"), accent = Color3.fromHex("c8a032"), tail = Color3.fromHex("8c1d2a"), engine = Color3.fromHex("c4c8ce") } },
