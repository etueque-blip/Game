		colors = { body = WHITE, accent = Color3.fromHex("c81e28"), tail = Color3.fromHex("c81e28"), engine = GREY } },
	G650 = { name = "Gulfstream G650", cls = "Бизнес-джет (люкс)", length = 108, diameter = 9.5, span = 108, chord = 13, wing = "low", wingPos = 0.5, sweep = 32, dihedral = 4, engines = "tail2", engineD = 5, engineLen = 13, tail = "T", hstabSpan = 36, finHeight = 20, finSweep = 48, gearLen = 4, windows = true, winglets = true, thrust = 7, maxKts = 500, stallKts = 105, vrKts = 120, flapMaxKts = 210, pitchRate = 0.5, rollRate = 1.1, yawRate = 0.3, turnBoost = 2.2, groundSteer = 0.55, brakeDecel = 8, stallSink = 50, maxRotate = 14, ceilingFt = 51000, maxTouchdownFpm = 1150,
		colors = { body = WHITE, accent = Color3.fromHex("142346"), tail = Color3.fromHex("142346"), engine = GREY } },
	GL7500 = { name = "Bombardier Global 7500", cls = "Бизнес-джет (люкс)", length = 121, diameter = 10, span = 113, chord = 14, wing = "low", wingPos = 0.5, sweep = 33, dihedral = 4, engines = "tail2", engineD = 5.3, engineLen = 14, tail = "T", hstabSpan = 38, finHeight = 21, finSweep = 48, gearLen = 4.2, windows = true, winglets = true, thrust = 6.9, maxKts = 510, stallKts = 108, vrKts = 125, flapMaxKts = 210, pitchRate = 0.48, rollRate = 1.05, yawRate = 0.3, turnBoost = 2.2, groundSteer = 0.55, brakeDecel = 8, stallSink = 50, maxRotate = 14, ceilingFt = 51000, maxTouchdownFpm = 1150,
		colors = { body = WHITE, accent = Color3.fromHex("780a1e"), tail = Color3.fromHex("780a1e"), engine = GREY } },
	B737 = { name = "Boeing 737-800", cls = "Узкофюзеляжный лайнер", length = 141, diameter = 13.5, span = 128, chord = 20, wing = "low", wingPos = 0.47, sweep = 25, dihedral = 6, engines = "wing2", engineD = 7, engineLen = 13, tail = "conventional", hstabSpan = 50, finHeight = 28, finSweep = 38, gearLen = 5, windows = true, winglets = true, thrust = 5.9, maxKts = 470, stallKts = 125, vrKts = 145, flapMaxKts = 230, pitchRate = 0.4, rollRate = 0.9, yawRate = 0.25, turnBoost = 2, groundSteer = 0.5, brakeDecel = 8, stallSink = 55, maxRotate = 12, ceilingFt = 41000, maxTouchdownFpm = 1200,
