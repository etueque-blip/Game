	w_msl = { "ракета", "missile" },
	w_zone = { "ВНЕ ЗОНЫ БОЯ — РАЗВОРАЧИВАЙСЯ!", "OUT OF BOUNDS: TURN BACK!" },
	w_missile = { "⚠ РАКЕТА %s — ЛОВУШКИ И ВИРАЖ!", "⚠ MISSILE %s: FLARES AND BREAK!" },
	w_hp = { "КОРПУС ПОВРЕЖДЁН — НА РЕМОНТ (палуба / своя база)", "HULL DAMAGED: LAND TO REPAIR (carrier / your base)" },
	crash_water = { "Упал в океан!", "Crashed into the ocean!" },
	crash_carrier = { "Врезался в авианосец!", "Hit the carrier!" },
	crash_ground = { "Разбился о землю!", "Crashed into the ground!" },
	f_cap = { "%s: база «%s» захвачена", "%s captured %s" },
	f_neutral = { "База «%s» стала нейтральной", "%s is now neutral" },
	f_streak = { "%s — серия %d сбитий!", "%s is on a %d kill streak!" },
	streak_n = { "🔥 СЕРИЯ %d!", "🔥 %d KILL STREAK!" },
	i_throttle = { "Тяга на 100% (Shift / ползунок) — старт", "Full throttle (Shift / slider) to launch" },
	i_rearm = { "Ремонт и перезарядка… · M — в меню", "Repairing and rearming… · M for menu" },
	i_capture = { "Захват «%s»: %s %d%%", "Capturing %s: %s %d%%" },
	i_capture_low = { "База «%s»: снизься ниже %d ft для захвата", "%s: fly below %d ft to capture" },
	t_air = { "В воздухе! Враги — в красных рамках", "Airborne! Enemies are in red boxes" },
	t_catapult = { "Катапульта: тяга на 100% (Shift / ползунок) — разгонит сама", "Catapult: full throttle (Shift / slider), it launches you" },
	t_runway = { "Полоса базы: тяга на 100% — ускоритель разгонит", "Island runway: full throttle, the booster does the rest" },
	t_go = { "СТАРТ!", "LAUNCH!" },
	t_fired = { "Пуск!", "Fox two!" },
	t_no_msl = { "Ракеты кончились — сядь на палубу или свою базу", "Out of missiles: land on your carrier or base" },
	t_no_lock = { "Нет захвата: держи врага в рамке ~1.5 с", "No lock: keep the enemy in the box ~1.5 s" },
	menu_ground = { "В меню — только на земле (палуба или своя база)", "Menu only on the ground (carrier or your base)" },
	mouse_on = { "Мышь-штурвал включён (C)", "Mouse yoke on (C)" },
	mouse_off = { "Мышь-штурвал выключен", "Mouse yoke off" },
	brake_on = { "Тормоз включён", "Brake on" },
	brake_off = { "Тормоз выключен", "Brake off" },
	cam_1 = { "Камера: сзади", "Camera: chase" },
	cam_2 = { "Камера: кабина", "Camera: cockpit" },
	cam_3 = { "Камера: орбита", "Camera: orbit" },
	tut1 = { "1/4 · Управление: W/S — нос, A/D — крен. Попробуй!", "1/4 · Steer: W/S pitch, A/D roll. Try it!" },
	tut1_t = { "1/4 · Двигай левый стик — самолёт поворачивает", "1/4 · Move the left stick to steer" },
	tut2 = { "2/4 · Наведи круг на красную рамку и стреляй: ЛКМ или Пробел", "2/4 · Put the circle on a red box and shoot: LMB or Space" },
	tut2_t = { "2/4 · Наведи круг на красную рамку и держи ОГОНЬ", "2/4 · Put the circle on a red box and hold FIRE" },
	tut3 = { "3/4 · Держи врага в рамке — когда она покраснеет, жми F (ракета)", "3/4 · Keep the enemy in the box. When it turns red, press F (missile)" },
	tut3_t = { "3/4 · Держи врага в рамке — когда она покраснеет, жми РАКЕТА", "3/4 · Keep the enemy in the box. When it turns red, tap MISSILE" },
	tut4 = { "4/4 · Пролети низко над островом — захватишь базу и получишь монеты", "4/4 · Fly low over an island to capture it and earn coins" },
	tut4_t = { "4/4 · Пролети низко над островом — захватишь базу и получишь монеты", "4/4 · Fly low over an island to capture it and earn coins" },
	tut_done = { "Обучение пройдено! Удачи, пилот!", "Training done! Good luck, pilot!" },
	-- награды
	r_kill = { "Сбит!", "Kill!" },
	r_assist = { "Помощь", "Assist" },
	r_capture = { "Захват базы", "Base captured" },
	r_win = { "Победа", "Victory" },
	r_loss = { "За бой", "Battle reward" },
	r_mvp = { "MVP раунда", "Round MVP" },
	r_landing = { "Посадка на палубу", "Carrier landing" },
	r_streak = { "Серия сбитий", "Kill streak" },
	r_daily = { "Награда за вход", "Daily reward" },
	r_purchase = { "Покупка", "Purchase" },
	r_quest = { "Задание", "Mission" },
	-- сообщения сервера
	n_levelup = { "⬆ НОВЫЙ УРОВЕНЬ %d!", "⬆ LEVEL %d!" },
	n_quest_done = { "✓ ЗАДАНИЕ ВЫПОЛНЕНО!", "✓ MISSION COMPLETE!" },
	n_rearm = { "Ремонт и перезарядка…", "Repairing and rearming…" },
	n_need_level = { "Нужен уровень %d", "You need level %d" },
	n_need_coins = { "Не хватает %d монет", "You need %d more coins" },
	n_bought = { "Куплен %s!", "%s unlocked!" },
	n_bought_paint = { "Раскраска куплена!", "Paint unlocked!" },
	n_vip_thanks = { "Спасибо! VIP включён ★", "Thanks! VIP is active ★" },
}

function Lang.pick(localeId: string?): string
	local l = string.lower(localeId or "")
	local p = string.sub(l, 1, 2)
	if p == "ru" or p == "uk" or p == "be" or p == "kk" or p == "uz" or p == "ky" then
		return "ru"
	end
	return "en"
end

function Lang.t(lang: string, key: string, ...: any): string
	local row = S[key]
	if not row then
		return key
	end
	local s = if lang == "ru" then row[1] else row[2]
	if select("#", ...) > 0 then
		local ok, out = pcall(string.format, s, ...)
		if ok then
			return out
		end
	end
	return s
end

Lang.KEYS = S

return Lang
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000006"><Properties><string name="Name">PlaneBuilder</string><ProtectedString name="Source"><![CDATA[--!strict
-- Строит модель самолёта из обычных деталей Roblox по PlaneConfigs.
-- Оси модели: нос -Z, верх +Y, правое крыло +X. Корень (Root) — центр фюзеляжа,
-- он стоит на высоте gearHeight над землёй, когда шасси касается полосы.
local PlaneBuilder = {}

type Ctx = { model: Model, root: BasePart, static: boolean, cfg: any }

local DARK = Color3.fromRGB(28, 32, 40)
local TIRE = Color3.fromRGB(25, 25, 25)
local METAL = Color3.fromRGB(150, 155, 162)

local function basePart(ctx: Ctx, cls: string, name: string, color: Color3, material: Enum.Material?): BasePart
	local p = Instance.new(cls) :: BasePart
	p.Name = name
	p.Color = color
	p.Material = material or Enum.Material.SmoothPlastic
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.CanCollide = false
	p.CanTouch = false
	p.CanQuery = false
	p.CastShadow = true
	p.Anchored = ctx.static
	p.Massless = true
	return p
end

local function attach(ctx: Ctx, p: BasePart, parent: Instance?)
	p.Parent = parent or ctx.model
	if not ctx.static then
		local w = Instance.new("WeldConstraint")
		w.Part0 = ctx.root
		w.Part1 = p
		w.Parent = p
	end
end

local function block(ctx: Ctx, name: string, size: Vector3, cf: CFrame, color: Color3, material: Enum.Material?, parent: Instance?): BasePart
	local p = basePart(ctx, "Part", name, color, material)
	p.Size = size
	p.CFrame = ctx.root.CFrame * cf
	attach(ctx, p, parent)
	return p
end

-- Эллипсоид: шар с SpecialMesh, можно любые полуоси
local function ellipsoid(ctx: Ctx, name: string, semi: Vector3, cf: CFrame, color: Color3, material: Enum.Material?, parent: Instance?): BasePart
	local p = basePart(ctx, "Part", name, color, material)
	p.Size = semi * 2
	local m = Instance.new("SpecialMesh")
	m.MeshType = Enum.MeshType.Sphere
	m.Parent = p
	p.CFrame = ctx.root.CFrame * cf
	attach(ctx, p, parent)
	return p
end

-- Цилиндр вдоль оси Z модели
local function cylZ(ctx: Ctx, name: string, length: number, diameter: number, pos: Vector3, color: Color3, material: Enum.Material?, parent: Instance?): BasePart
	local p = basePart(ctx, "Part", name, color, material)
	p.Shape = Enum.PartType.Cylinder
	p.Size = Vector3.new(length, diameter, diameter)
	p.CFrame = ctx.root.CFrame * CFrame.new(pos) * CFrame.Angles(0, math.pi / 2, 0)
	attach(ctx, p, parent)
	return p
end

-- Цилиндр вдоль оси Y модели (стойки шасси)
local function cylY(ctx: Ctx, name: string, length: number, diameter: number, pos: Vector3, color: Color3, parent: Instance?): BasePart
	local p = basePart(ctx, "Part", name, color, Enum.Material.Metal)
	p.Shape = Enum.PartType.Cylinder
	p.Size = Vector3.new(length, diameter, diameter)
	p.CFrame = ctx.root.CFrame * CFrame.new(pos) * CFrame.Angles(0, 0, math.pi / 2)
	attach(ctx, p, parent)
	return p
end

-- Треугольник из двух клиньев (классический приём для произвольных плоскостей)
local function triangle(ctx: Ctx, name: string, a: Vector3, b: Vector3, c: Vector3, thick: number, color: Color3, parent: Instance?)
	local ab, ac, bc = b - a, c - a, c - b
	local abd, acd, bcd = ab:Dot(ab), ac:Dot(ac), bc:Dot(bc)
	if abd > acd and abd > bcd then
		c, a = a, c
	elseif acd > bcd and acd > abd then
		a, b = b, a
	end
	ab, ac, bc = b - a, c - a, c - b
	local cross = ac:Cross(ab)
	if cross.Magnitude < 1e-6 then
		return
	end
	local rightV = cross.Unit
	local upV = bc:Cross(rightV).Unit
	local backV = bc.Unit
	local height = math.abs(ab:Dot(upV))
	local w1 = basePart(ctx, "WedgePart", name, color)
	w1.Size = Vector3.new(thick, math.max(height, 0.05), math.max(math.abs(ab:Dot(backV)), 0.05))
	w1.CFrame = ctx.root.CFrame * CFrame.fromMatrix((a + b) / 2, rightV, upV, backV)
	attach(ctx, w1, parent)
	local w2 = basePart(ctx, "WedgePart", name, color)
	w2.Size = Vector3.new(thick, math.max(height, 0.05), math.max(math.abs(ac:Dot(backV)), 0.05))
	w2.CFrame = ctx.root.CFrame * CFrame.fromMatrix((a + c) / 2, -rightV, upV, -backV)
	attach(ctx, w2, parent)
end

-- Трапециевидная плоскость: корневая/концевая передние кромки и хорды (хорда идёт в +Z)
local function panel(ctx: Ctx, name: string, rootLE: Vector3, rootChord: number, tipLE: Vector3, tipChord: number, thick: number, color: Color3)
	local rootTE = rootLE + Vector3.new(0, 0, rootChord)
	local tipTE = tipLE + Vector3.new(0, 0, tipChord)
	triangle(ctx, name, rootLE, rootTE, tipTE, thick, color)
	triangle(ctx, name, rootLE, tipTE, tipLE, thick, color)
end

local function light(ctx: Ctx, kind: string, pos: Vector3, color: Color3, size: number)
	local p = block(ctx, "Light", Vector3.one * size, CFrame.new(pos), color, Enum.Material.Neon)
	p.CastShadow = false
	p:SetAttribute("LightKind", kind)
	return p
end

function PlaneBuilder.build(cfg: any, opts: { static: boolean?, seat: boolean?, label: string? }?): Model
	local o = opts or {}
	local model = Instance.new("Model")
	model.Name = cfg.name
	model:SetAttribute("PlaneId", cfg.id)

	local L, D, span, chord = cfg.length, cfg.diameter, cfg.span, cfg.chord
	local col = cfg.colors
	local static = o.static == true

	local root = Instance.new("Part")
	root.Name = "Root"
	root.Size = Vector3.new(D * 0.5, D * 0.5, L * 0.5)
	root.Transparency = 1
	root.CanCollide = false
	root.CanTouch = false
	root.CanQuery = false
	root.Anchored = true
	root.Massless = false
	root.CFrame = CFrame.identity
	root.Parent = model
	model.PrimaryPart = root

	local ctx: Ctx = { model = model, root = root, static = static, cfg = cfg }

	-- ===== фюзеляж
	local Ln = math.max(D * 1.1, L * 0.12)
	local Lt = L * 0.24
	local cylLen = L - Ln - Lt
	local cylMid = -L / 2 + Ln + cylLen / 2
	local glossy = cfg.engines ~= "jet1" and cfg.engines ~= "prop"
	local fus = cylZ(ctx, "Fuselage", cylLen + 0.02, D, Vector3.new(0, 0, cylMid), col.body)
	local nose = ellipsoid(ctx, "Nose", Vector3.new(D / 2, D / 2, Ln), CFrame.new(0, 0, -L / 2 + Ln), col.body)
	local tcone = ellipsoid(ctx, "TailCone", Vector3.new(D / 2, D / 2, Lt), CFrame.new(0, 0, L / 2 - Lt), col.body)
	if glossy then
		-- лаковая краска: лёгкое отражение неба
		for _, part in { fus, nose, tcone } do
			part.Reflectance = 0.07
		end
	end
	if cfg.hump then
		ellipsoid(ctx, "Hump", Vector3.new(D * 0.4, D * 0.45, L * 0.2), CFrame.new(0, D * 0.28, -L / 2 + L * 0.24), col.body)
	end
	-- кабина
	if cfg.canopy then
		local cp = ellipsoid(ctx, "Canopy", Vector3.new(D * 0.3, D * 0.32, L * 0.13), CFrame.new(0, D * 0.42, -L / 2 + L * 0.3), Color3.fromRGB(60, 80, 100), Enum.Material.Glass)
		cp.Transparency = 0.25
	else
		-- остекление кабины: 3 панели на сторону по поверхности носового эллипсоида
		local z0 = -L / 2 + Ln
		for i, f in { 0.8, 0.7, 0.58 } do
			local zc = z0 - Ln * f
			local r = D / 2 * math.sqrt(1 - f * f)
			for _, s in { -1, 1 } do
				local ang = math.rad(18 + (i - 1) * 24)
				local x, y = s * r * math.sin(ang), r * math.cos(ang) * 0.92
				local mk = if cfg.mask then 1.45 else 1
				local pane = block(ctx, "CockpitWindow", Vector3.new(r * 0.42 * mk, 0.08 * D * mk, Ln * 0.11 * mk), CFrame.new(x, y, zc) * CFrame.Angles(math.rad(-38 + i * 8), 0, -s * ang), DARK, Enum.Material.Glass)
				pane.CastShadow = false
				pane.Reflectance = 0.25
			end
		end
	end
	-- иллюминаторы и двери (как у настоящих лайнеров), полоса ливреи
	for _, s in { -1, 1 } do
		if cfg.windows then
			local pitch = math.max(D * 0.11, 1.1)
			local z0 = -L / 2 + Ln * 1.05
			local z1 = L / 2 - Lt * 0.95
			local n = math.min(math.floor((z1 - z0) / pitch), 70)
			local step = (z1 - z0) / math.max(n, 1)
			-- двухпалубный (тип A380): два ряда иллюминаторов по всей длине
			local rows = if cfg.doubleDeck then { -0.02, 0.3 } else { 0.13 }
			local wx = s * math.sqrt(0.25 - 0.0169) * D
			for _, ry in rows do
				local wy = D * ry
				local rx = s * math.sqrt(0.25 - ry * ry) * D
				for i = 0, n do
					local z = z0 + i * step
					if i ~= 1 and i ~= n - 1 then
						local w = block(ctx, "Window", Vector3.new(D * 0.025, D * 0.055, D * 0.04), CFrame.new(rx, wy, z), DARK, Enum.Material.Glass)
						w.CastShadow = false
					end
				end
			end
			for _, z in { z0 + step * 1, z1 - step * 1 } do
				local door = block(ctx, "Door", Vector3.new(D * 0.02, D * 0.2, D * 0.085), CFrame.new(wx * 1.005, D * 0.05, z), Color3.fromRGB(170, 175, 182))
				door.CastShadow = false
			end
		end
		block(ctx, "Cheatline", Vector3.new(D * 0.04, D * 0.05, cylLen), CFrame.new(s * D * 0.49, -D * 0.06, cylMid), col.accent)
		-- «волна» ливреи: полоса фирменного цвета поднимается от брюха к хвосту
		if glossy and L > 50 then
			local zA, zB = cylMid + cylLen * 0.08, L / 2 - Lt * 0.55
			local N = 9
			for i = 0, N - 1 do
				local t0 = i / N
				local tm = (i + 0.5) / N
				local z = zA + (zB - zA) * tm
				local phi = math.rad(-62 + 92 * tm ^ 1.3) -- угол на окружности: снизу вверх
				local rad = D / 2 * (if z > L / 2 - Lt then math.max(0.35, (L / 2 - z) / Lt) ^ 0.6 else 1) + 0.03
				local seg = (zB - zA) / N * 1.08
				local band = block(ctx, "LiverySwoosh", Vector3.new(D * 0.02, D * (0.2 - 0.08 * t0), seg),
					CFrame.new(s * rad * math.cos(phi), rad * math.sin(phi), z) * CFrame.Angles(0, 0, if s == 1 then phi else math.pi - phi),
					if tm < 0.5 then col.accent else col.tail)
				band.CastShadow = false
				band.Reflectance = 0.07
			end
		end
	end
	-- брюхо светло-серое, как у настоящих лайнеров
	if L > 50 then
		local belly = ellipsoid(ctx, "Belly", Vector3.new(D * 0.47, D * 0.22, cylLen * 0.5), CFrame.new(0, -D * 0.3, cylMid), Color3.fromRGB(205, 210, 216))
		belly.CastShadow = false
	end

	-- ===== крыло
	local wy = if cfg.wing == "high" then D * 0.42 elseif cfg.wing == "low" then -D * 0.32 else 0
	local wz = -L / 2 + L * cfg.wingPos
	local taper = if cfg.sweep > 5 then 0.32 else 0.7
	local tipChord = chord * taper
	local half = span / 2
	local rootX = D * 0.35
	local l = half - rootX
	local tanS, tanD = math.tan(math.rad(cfg.sweep)), math.tan(math.rad(cfg.dihedral))
	local wingThick = math.clamp(chord * 0.09, 0.35, 3)
	local rootLEz = wz - chord / 2

	local function wingPoint(s: number, frac: number): (Vector3, number)
		-- передняя кромка и хорда на доле размаха frac (0 = корень, 1 = законцовка)
		local d = l * frac
		return Vector3.new(s * (rootX + d), wy + d * tanD, rootLEz + d * tanS), chord + (tipChord - chord) * frac
	end

	local flapsFolder = Instance.new("Folder")
	flapsFolder.Name = "Flaps"
	flapsFolder.Parent = model
	-- рули: элероны, руль высоты, руль направления (поворачивает Animator по управлению)
	local controlsFolder = Instance.new("Folder")
	controlsFolder.Name = "Controls"
	controlsFolder.Parent = model
	local function controlSurface(kind: string, pA: Vector3, pB: Vector3, fc: number, thick: number, color: Color3, vertical: boolean?)
		local sgn = if vertical then 1 else (if pB.X >= pA.X then 1 else -1)
		local u = ((pB - pA) * sgn).Unit
		local back = Vector3.zAxis - u * Vector3.zAxis:Dot(u)
		back = back.Unit
		local upV = back:Cross(u)
		local hinge = CFrame.fromMatrix((pA + pB) / 2, u, upV, back)
		local cp = basePart(ctx, "Part", "Control", color)
		cp.Size = Vector3.new((pB - pA).Magnitude, thick, fc)
		local c0 = hinge * CFrame.new(0, 0, fc / 2)
		cp.CFrame = root.CFrame * c0
		cp.CastShadow = false
		cp.Parent = controlsFolder
		if not static then
			local w = Instance.new("Weld")
			w.Name = "ControlWeld"
			w.Part0 = root
			w.Part1 = cp
			w.C0 = c0
			w:SetAttribute("Hinge", hinge)
			w:SetAttribute("Chord", fc)
			w:SetAttribute("Kind", kind)
			w.Parent = cp
		end
	end
	local gearFolder = Instance.new("Folder")
	gearFolder.Name = "Gear"
	gearFolder.Parent = model

	for _, s in { -1, 1 } do
		local rLE = Vector3.new(s * rootX, wy, rootLEz)
		local tLE, tChord = wingPoint(s, 1)
		local WINGC = if cfg.id == "F16" then col.body else Color3.fromRGB(214, 218, 224)
		panel(ctx, "Wing", rLE, chord, tLE, tChord, wingThick, WINGC)
		-- обтекатели механизации закрылков под задней кромкой
		if L > 80 then
			for _, fr in { 0.22, 0.42, 0.62 } do
				local le, ch = wingPoint(s, fr)
				ellipsoid(ctx, "FlapFairing", Vector3.new(chord * 0.03, chord * 0.045, ch * 0.28), CFrame.new(le.X, le.Y - wingThick * 0.6, le.Z + ch * 0.95), WINGC)
			end
		end
		-- подкосы крыла у лёгкого самолёта
		if cfg.wing == "high" then
			local a0 = Vector3.new(s * D * 0.45, -D * 0.3, wz)
			local tipP = wingPoint(s, 0.55)
			local a1 = Vector3.new(tipP.X, tipP.Y - wingThick * 0.5, wz)
			local mid = (a0 + a1) / 2
			local dir = (a1 - a0).Unit
			local strut = block(ctx, "Strut", Vector3.new((a1 - a0).Magnitude, 0.3, 0.6), CFrame.fromMatrix(mid, dir, Vector3.zAxis:Cross(dir).Unit), col.body)
			strut.CastShadow = false
		end
		-- элерон на внешней части крыла
		do
			local ai, cai = wingPoint(s, 0.6)
			local ao, cao = wingPoint(s, 0.92)
			local afc = math.min(cai, cao) * 0.26
			controlSurface(if s > 0 then "ailR" else "ailL", ai + Vector3.new(0, 0, cai - afc), ao + Vector3.new(0, 0, cao - afc), afc, wingThick * 0.6, Color3.fromRGB(214, 218, 224))
		end
		-- закрылки на внутренней половине
		if not cfg.noFlaps then
			local fi, ci = wingPoint(s, 0.04)
			local fo, co = wingPoint(s, 0.5)
			local fc = math.min(ci, co) * 0.24
			local pIn = fi + Vector3.new(0, 0, ci - fc)
			local pOut = fo + Vector3.new(0, 0, co - fc)
			local u = ((pOut - pIn) * s).Unit -- всегда в +X, чтобы ось Y шарнира смотрела вверх
			local back = Vector3.zAxis - u * Vector3.zAxis:Dot(u)
			back = back.Unit
			local upV = back:Cross(u)
			local hinge = CFrame.fromMatrix((pIn + pOut) / 2, u, upV, back)
			local flap = basePart(ctx, "Part", "Flap", col.body)
			flap.Size = Vector3.new((pOut - pIn).Magnitude, wingThick * 0.7, fc)
			local c0 = hinge * CFrame.new(0, 0, fc / 2)
			flap.CFrame = root.CFrame * c0
			flap.Parent = flapsFolder
			if not static then
				local w = Instance.new("Weld")
				w.Name = "FlapWeld"
				w.Part0 = root
				w.Part1 = flap
				w.C0 = c0
				w:SetAttribute("Hinge", hinge)
				w:SetAttribute("Chord", fc)
				w.Parent = flap
			end
		end
		-- законцовки
		if cfg.winglets then
			local wlH = math.max(2, span * 0.045)
			local wlLE = tLE + Vector3.new(0, 0, tChord * 0.1)
			panel(ctx, "Winglet", wlLE, tChord * 0.8, wlLE + Vector3.new(s * wlH * 0.15, wlH, wlH * 0.6), tChord * 0.35, wingThick * 0.6, col.tail)
		end
		-- навигационные огни и стробы
		light(ctx, "nav", tLE + Vector3.new(0, 0, tChord * 0.3), if s < 0 then Color3.fromRGB(255, 40, 40) else Color3.fromRGB(40, 255, 90), math.max(0.6, D * 0.08))
		light(ctx, "strobe", tLE + Vector3.new(0, 0, tChord * 0.8), Color3.new(1, 1, 1), math.max(0.5, D * 0.06))
		-- след с законцовок (инверсионный след включает клиент на высоте)
		if not static then
			local a0 = Instance.new("Attachment")
			a0.Name = "TrailA"
			a0.Position = tLE + Vector3.new(0, 0.3, tChord)
			a0.Parent = root
			local a1 = Instance.new("Attachment")
			a1.Name = "TrailB"
			a1.Position = tLE + Vector3.new(0, -0.3, tChord)
			a1.Parent = root
			local tr = Instance.new("Trail")
			tr.Name = "Contrail"
			tr.Attachment0 = a0
			tr.Attachment1 = a1
			tr.Lifetime = 5
			tr.MinLength = 2
			tr.FaceCamera = true
			tr.WidthScale = NumberSequence.new(1, 6)
			tr.Transparency = NumberSequence.new(0.35, 1)
			tr.Color = ColorSequence.new(Color3.new(1, 1, 1))
			tr.LightEmission = 0.2
			tr.Enabled = false
			tr.Parent = root
		end
	end

	-- обтекатель стыка крыла и фюзеляжа
	if cfg.wing == "low" and L > 50 then
		ellipsoid(ctx, "WingFairing", Vector3.new(D * 0.46, D * 0.28, chord * 0.85), CFrame.new(0, -D * 0.28, wz + chord * 0.1), Color3.fromRGB(205, 210, 216))
	end

	-- ===== хвостовое оперение
	local finRoot = math.max(cfg.finHeight * 0.95, L * 0.1)
	local finLE = Vector3.new(0, D * 0.3, L / 2 - finRoot - L * 0.02)
	local finTanS = math.tan(math.rad(cfg.finSweep))
	local finTipLE = finLE + Vector3.new(0, cfg.finHeight, cfg.finHeight * finTanS)
	local finTip = finRoot * 0.5
	local finThick = math.clamp(finRoot * 0.08, 0.3, 2.5)
	-- плоскость киля вертикальная: строим треугольники напрямую
	triangle(ctx, "Fin", finLE, finLE + Vector3.new(0, 0, finRoot), finTipLE + Vector3.new(0, 0, finTip), finThick, col.tail)
	triangle(ctx, "Fin", finLE, finTipLE + Vector3.new(0, 0, finTip), finTipLE, finThick, col.tail)
	light(ctx, "beacon", finTipLE + Vector3.new(0, 0.4, finTip * 0.5), Color3.fromRGB(255, 40, 40), math.max(0.5, D * 0.07))
	do -- руль направления у задней кромки киля
		local rcB, rcT = finRoot * 0.3, finTip * 0.3
		local rb = finLE + Vector3.new(0, cfg.finHeight * 0.08, finRoot - rcB)
		local rt = finTipLE + Vector3.new(0, -cfg.finHeight * 0.08, finTip - rcT)
		controlSurface("rud", rb, rt, (rcB + rcT) / 2, finThick * 0.7, col.tail, true)
	end
	-- форкиль и выхлоп ВСУ
	triangle(ctx, "Dorsal", finLE + Vector3.new(0, 0, -finRoot * 0.45), finLE, finLE + Vector3.new(0, cfg.finHeight * 0.18, finRoot * 0.12), finThick * 0.8, col.tail)
	if L > 50 then
		cylZ(ctx, "APU", 0.4, D * 0.09, Vector3.new(0, 0, L / 2 - 0.1), DARK, Enum.Material.Metal)
	end
	light(ctx, "beacon", Vector3.new(0, -D / 2 - 0.2, cylMid), Color3.fromRGB(255, 40, 40), math.max(0.5, D * 0.07))

	local hsRootChord = math.max(cfg.hstabSpan * 0.3, D * 0.6)
	local hsHalf = cfg.hstabSpan / 2
	local hsY, hsLEz, hsRootX
	if cfg.tail == "T" then
		hsY = finTipLE.Y - 0.2
		hsLEz = finTipLE.Z - finTip * 0.1
		hsRootX = 0
		hsRootChord = math.max(finTip * 1.1, hsRootChord * 0.8)
	else
		hsY = D * 0.08
		hsLEz = L / 2 - hsRootChord - L * 0.03
		hsRootX = D * 0.2
	end
	local hsTan = math.tan(math.rad(cfg.finSweep * 0.85))
	for _, s in { -1, 1 } do
		local r = Vector3.new(s * hsRootX, hsY, hsLEz)
		local d = hsHalf - hsRootX
		local t = Vector3.new(s * hsHalf, hsY + d * 0.05, hsLEz + d * hsTan)
		panel(ctx, "HStab", r, hsRootChord, t, hsRootChord * 0.45, math.clamp(hsRootChord * 0.08, 0.25, 2), col.body)
		local efcR, efcT = hsRootChord * 0.3, hsRootChord * 0.45 * 0.3
		local ea = r + Vector3.new(s * 0.2, 0, hsRootChord - efcR)
		local eb = t + Vector3.new(-s * 0.5, 0, hsRootChord * 0.45 - efcT)
		controlSurface("elev", ea, eb, (efcR + efcT) / 2, math.clamp(hsRootChord * 0.08, 0.25, 2) * 0.7, col.body)
	end

	-- ===== двигатели
	local engines = Instance.new("Folder")
	engines.Name = "Engines"
	engines.Parent = model
	local eD = cfg.engineD or D * 0.4
	local eL = cfg.engineLen or eD * 2

	-- турбовентиляторный двигатель: губа воздухозаборника, вентилятор, кок, мотогондола, сопло и конус
	local function nacelle(pos: Vector3)
		cylZ(ctx, "Nacelle", eL * 0.78, eD, pos + Vector3.new(0, 0, eL * 0.02), col.engine, Enum.Material.SmoothPlastic, engines)
		cylZ(ctx, "Lip", eL * 0.08, eD * 1.02, pos + Vector3.new(0, 0, -eL * 0.4), Color3.fromRGB(225, 228, 232), Enum.Material.Metal, engines)
		-- вентилятор: тёмный диск + вращающийся ротор с 8 лопатками (Weld «FanWeld», крутит Animator)
		cylZ(ctx, "Fan", 0.2, eD * 0.86, pos + Vector3.new(0, 0, -eL * 0.36), Color3.fromRGB(32, 34, 40), Enum.Material.Metal, engines)
		local hub = basePart(ctx, "Part", "FanRotor", Color3.fromRGB(150, 156, 164), Enum.Material.Metal)
		hub.Shape = Enum.PartType.Cylinder
		hub.Size = Vector3.new(0.25, eD * 0.22, eD * 0.22)
		local hc0 = CFrame.new(pos + Vector3.new(0, 0, -eL * 0.385)) * CFrame.Angles(0, math.pi / 2, 0)
		hub.CFrame = ctx.root.CFrame * hc0
		hub.Parent = engines
		if not ctx.static then
			local w = Instance.new("Weld")
			w.Name = "FanWeld"
			w.Part0 = ctx.root
			w.Part1 = hub
			w.C0 = hc0
			w:SetAttribute("Base", hc0)
			w.Parent = hub
		end
		for i = 0, 7 do
			local blade = basePart(ctx, "Part", "FanBlade", Color3.fromRGB(140, 147, 156), Enum.Material.Metal)
			blade.Size = Vector3.new(0.12, eD * 0.3, eD * 0.1)
			blade.CFrame = hub.CFrame * CFrame.Angles(i / 8 * math.pi * 2, 0, 0) * CFrame.new(0, eD * 0.24, 0) * CFrame.Angles(0, 0.55, 0)
			blade.CastShadow = false
			blade.Parent = engines
			if not ctx.static then
				local wc = Instance.new("WeldConstraint")
				wc.Part0 = hub
				wc.Part1 = blade
				wc.Parent = blade
			end
		end
		ellipsoid(ctx, "Spinner", Vector3.new(eD * 0.15, eD * 0.15, eD * 0.2), CFrame.new(pos + Vector3.new(0, 0, -eL * 0.38)), Color3.fromRGB(200, 204, 210), Enum.Material.Metal, engines)
		cylZ(ctx, "Nozzle", eL * 0.2, eD * 0.72, pos + Vector3.new(0, 0, eL * 0.5), Color3.fromRGB(150, 154, 160), Enum.Material.Metal, engines)
		ellipsoid(ctx, "Plug", Vector3.new(eD * 0.22, eD * 0.22, eL * 0.18), CFrame.new(pos + Vector3.new(0, 0, eL * 0.6)), Color3.fromRGB(70, 72, 78), Enum.Material.Metal, engines)
		if cfg.id == "B787" then
			-- «шевроны» на сопле (зубцы против шума), как у Boeing 787
			for i = 0, 11 do
				local a = i / 12 * math.pi * 2
				block(ctx, "Chevron", Vector3.new(eD * 0.09, eD * 0.09, 0.15), CFrame.new(pos + Vector3.new(math.cos(a) * eD * 0.37, math.sin(a) * eD * 0.37, eL * 0.6)) * CFrame.Angles(0, 0, a + math.pi / 4), col.engine, Enum.Material.Metal, engines)
			end
		end
	end

	if cfg.engines == "wing2" or cfg.engines == "wing4" then
		local fracs = if cfg.engines == "wing2" then { 0.3 } else { 0.28, 0.58 }
		for _, s in { -1, 1 } do
			for _, fr in fracs do
				local le, ch = wingPoint(s, fr)
				local pos = Vector3.new(le.X, le.Y - eD * 0.65, le.Z - eL * 0.35)
				nacelle(pos)
				block(ctx, "Pylon", Vector3.new(eD * 0.15, eD * 0.5, math.min(eL * 0.8, ch)), CFrame.new(le.X, le.Y - eD * 0.3, le.Z + ch * 0.15), col.engine, Enum.Material.Metal, engines)
			end
		end
	elseif cfg.engines == "tail2" then
		for _, s in { -1, 1 } do
			local pos = Vector3.new(s * (D / 2 + eD * 0.55), D * 0.18, L / 2 - Lt - eL * 0.2)
			nacelle(pos)
			block(ctx, "Pylon", Vector3.new(eD * 0.6, eD * 0.2, eL * 0.5), CFrame.new(s * (D / 2), D * 0.18, pos.Z), col.engine, Enum.Material.Metal, engines)
		end
	elseif cfg.engines == "jet1" then
		cylZ(ctx, "Nozzle", eL * 0.6, eD, Vector3.new(0, 0, L / 2 - 0.5), DARK, Enum.Material.Metal, engines)
		local ab = cylZ(ctx, "Afterburner", 0.4, eD * 0.75, Vector3.new(0, 0, L / 2 + eL * 0.3 - 0.3), Color3.fromRGB(255, 140, 50), Enum.Material.Neon, engines)
		ab.Transparency = 1
		ab.CastShadow = false
		-- подфюзеляжные гребни и пусковые на законцовках
		for _, s in { -1, 1 } do
			triangle(ctx, "Ventral", Vector3.new(s * D * 0.25, -D * 0.45, L / 2 - L * 0.2), Vector3.new(s * D * 0.25, -D * 0.45, L / 2 - L * 0.08), Vector3.new(s * D * 0.35, -D * 0.85, L / 2 - L * 0.09), 0.25, col.body)
			local tLE2, tC2 = wingPoint(s, 1)
			cylZ(ctx, "Rail", tC2 * 1.6, 0.6, Vector3.new(tLE2.X + s * 0.4, tLE2.Y, tLE2.Z + tC2 * 0.4), Color3.fromRGB(220, 220, 220), Enum.Material.Metal, engines)
		end
		-- воздухозаборник под фюзеляжем
		block(ctx, "Intake", Vector3.new(D * 0.6, D * 0.4, L * 0.12), CFrame.new(0, -D * 0.45, wz - chord * 0.6), DARK, Enum.Material.Metal, engines)
	elseif cfg.engines == "turboprop2" then
		-- турбовинтовые: гондолы под высоким крылом, шестилопастные винты (вращает Animator), выхлоп сбоку
		for _, s in { -1, 1 } do
			local le = wingPoint(s, 0.3)
			local p = Vector3.new(le.X, le.Y - eD * 0.45, le.Z + eL * 0.1)
			ellipsoid(ctx, "Nacelle", Vector3.new(eD * 0.5, eD * 0.6, eL * 0.55), CFrame.new(p), col.engine, Enum.Material.SmoothPlastic, engines)
			cylZ(ctx, "Exhaust", eD * 0.5, eD * 0.28, p + Vector3.new(s * eD * 0.45, -eD * 0.1, eL * 0.05), DARK, Enum.Material.Metal, engines)
			local pc0 = CFrame.new(p + Vector3.new(0, 0, -eL * 0.55 - 0.25))
			local hub = basePart(ctx, "Part", "Prop", Color3.fromRGB(230, 232, 236), Enum.Material.Metal)
			hub.Size = Vector3.new(eD * 0.6, eD * 0.6, eD * 0.75)
			local hm = Instance.new("SpecialMesh")
			hm.MeshType = Enum.MeshType.Sphere
			hm.Parent = hub
			hub.CFrame = root.CFrame * pc0
			hub.Parent = engines
			if not static then
				local w = Instance.new("Weld")
				w.Name = "PropWeld"
				w.Part0 = root
				w.Part1 = hub
				w.C0 = pc0
				w:SetAttribute("Base", pc0)
				w.Parent = hub
			end
			for i = 0, 5 do
				local a = i / 6 * math.pi * 2
				local bl = basePart(ctx, "Part", "Blade", DARK, Enum.Material.Metal)
				bl.Size = Vector3.new(eD * 0.16, eD * 1.55, 0.2)
				bl.CFrame = hub.CFrame * CFrame.Angles(0, 0, a - math.pi / 2) * CFrame.new(0, eD * 0.82, 0) * CFrame.Angles(0, 0.35, 0)
				bl.Parent = engines
				if not static then
					local wc = Instance.new("WeldConstraint")
					wc.Part0 = hub
					wc.Part1 = bl
					wc.Parent = bl
				end
			end
			local disc = basePart(ctx, "Part", "PropDisc", Color3.fromRGB(200, 200, 200), Enum.Material.Glass)
			disc.Shape = Enum.PartType.Cylinder
			disc.Size = Vector3.new(0.05, eD * 3.3, eD * 3.3)
			disc.CFrame = root.CFrame * pc0 * CFrame.Angles(0, math.pi / 2, 0)
			disc.Transparency = 1
			disc.CastShadow = false
			attach(ctx, disc, engines)
		end
	elseif cfg.engines == "prop" then
		ellipsoid(ctx, "Spinner", Vector3.new(D * 0.16, D * 0.16, D * 0.22), CFrame.new(0, 0, -L / 2 - D * 0.05), Color3.fromRGB(230, 230, 230), Enum.Material.Metal, engines)
		local prop = basePart(ctx, "Part", "Prop", DARK, Enum.Material.Metal)
		prop.Size = Vector3.new(D * 1.15, 0.35, 0.18)
		local pc0 = CFrame.new(0, 0, -L / 2 - D * 0.08)
		prop.CFrame = root.CFrame * pc0
		prop.Parent = engines
		if not static then
			local w = Instance.new("Weld")
			w.Name = "PropWeld"
			w.Part0 = root
			w.Part1 = prop
			w.C0 = pc0
			w:SetAttribute("Base", pc0)
			w.Parent = prop
		end
		local disc = basePart(ctx, "Part", "PropDisc", Color3.fromRGB(200, 200, 200), Enum.Material.Glass)
		disc.Shape = Enum.PartType.Cylinder
		disc.Size = Vector3.new(0.05, D * 1.15, D * 1.15)
		disc.CFrame = root.CFrame * pc0 * CFrame.Angles(0, math.pi / 2, 0)
		disc.Transparency = 1
		disc.CastShadow = false
		attach(ctx, disc, engines)
	end

	-- ===== шасси
	local gearLen = cfg.gearLen
	local wheelR = math.max(0.7, gearLen * 0.32)
	local wheelW = math.max(0.6, wheelR * 0.8)
	local wheelY = -cfg.gearHeight + wheelR
	local mainGear = {}
	local function leg(x: number, z: number, wheels: number, bogie: boolean?)
		local top = -D * 0.35
		cylY(ctx, "Strut", top - wheelY, math.max(0.25, wheelR * 0.35), Vector3.new(x, (top + wheelY) / 2, z), METAL, gearFolder)
		-- у Boeing 777 тележки на шесть колёс (три пары подряд)
		local triple = bogie and cfg.id == "B777"
		local rows = if triple then { -wheelR * 2.3, 0, wheelR * 2.3 } elseif bogie then { -wheelR * 1.15, wheelR * 1.15 } else { 0 }
		if bogie then
			block(ctx, "Bogie", Vector3.new(wheelW * 0.5, wheelR * 0.4, wheelR * (if triple then 5.6 else 3.2)), CFrame.new(x, wheelY, z), METAL, Enum.Material.Metal, gearFolder)
		end
		for _, dzz in rows do
			for k = 1, wheels do
				local off = if wheels == 1 then 0 else (k - 1.5) * wheelW * 1.15
				local w = basePart(ctx, "Part", "Wheel", TIRE, Enum.Material.Rubber)
				w.Shape = Enum.PartType.Cylinder
				w.Size = Vector3.new(wheelW, wheelR * 2, wheelR * 2)
				w.CFrame = root.CFrame * CFrame.new(x + off, wheelY, z + dzz)
				attach(ctx, w, gearFolder)
				local hub = basePart(ctx, "Part", "Hub", Color3.fromRGB(190, 192, 196), Enum.Material.Metal)
				hub.Shape = Enum.PartType.Cylinder
				hub.Size = Vector3.new(wheelW * 1.02, wheelR * 1.1, wheelR * 1.1)
				hub.CFrame = w.CFrame
				hub.CastShadow = false
				attach(ctx, hub, gearFolder)
			end
		end
	end
	local big = L > 100
	local noseZ = -L / 2 + math.max(L * 0.12, Ln * 0.9)
	leg(0, noseZ, if big then 2 else 1)
	-- посадочная фара на передней стойке
	local lampPart = block(ctx, "LandingLight", Vector3.one * math.max(0.4, wheelR * 0.4), CFrame.new(0, -D * 0.4 - gearLen * 0.3, noseZ - 0.5), Color3.fromRGB(255, 250, 230), Enum.Material.Neon, gearFolder)
	lampPart.CastShadow = false
	if not static then
		local sl = Instance.new("SpotLight")
		sl.Brightness = 4
		sl.Range = 60
		sl.Angle = 40
		sl.Face = Enum.NormalId.Front
		sl.Parent = lampPart
	end
	-- посадочные фары у корней крыльев (горят при выпущенном шасси — их включает setGearVisible)
	if cfg.engines ~= "jet1" and cfg.engines ~= "prop" then
		for _, s in { -1, 1 } do
			local le = wingPoint(s, 0.1)
			local wl = block(ctx, "LandingLight", Vector3.one * math.max(0.4, D * 0.05), CFrame.new(le.X, le.Y - wingThick * 0.3, le.Z + 0.3), Color3.fromRGB(255, 250, 230), Enum.Material.Neon, gearFolder)
			wl.CastShadow = false
			if not static then
				local wsl = Instance.new("SpotLight")
				wsl.Brightness = 3
				wsl.Range = 90
				wsl.Angle = 30
				wsl.Face = Enum.NormalId.Front
				wsl.Color = Color3.fromRGB(255, 241, 214)
				wsl.Parent = wl
			end
		end
	end
	local mainZ = wz + chord * 0.25
	local turboprop = cfg.engines == "turboprop2"
	local mainX = if turboprop then D * 0.42 elseif cfg.wing == "high" then D * 0.75 else math.max(D * 0.55, span * 0.08)
	for _, s in { -1, 1 } do
		leg(s * mainX, mainZ, if big then 2 else 1, L > 130 or turboprop)
		if turboprop then
			-- обтекатель ниши основной стойки сбоку фюзеляжа
			ellipsoid(ctx, "Sponson", Vector3.new(D * 0.2, D * 0.17, L * 0.09), CFrame.new(s * D * 0.44, -D * 0.36, mainZ), col.body)
		end
		table.insert(mainGear, Vector3.new(s * mainX, -cfg.gearHeight, mainZ))
		if cfg.id == "B747" then
			leg(s * D * 0.3, mainZ + chord * 0.15, 2, true)
		end
	end
	-- створки шасси: открытые у стоек (в папке шасси), закрытые панели — в папке GearDoorsUp (видны, когда шасси убрано)
	if not cfg.fixedGear and cfg.engines ~= "jet1" and cfg.engines ~= "prop" then
		local doorsUp = Instance.new("Folder")
		doorsUp.Name = "GearDoorsUp"
		doorsUp.Parent = model
		local SEAM = col.body:Lerp(Color3.new(0, 0, 0), 0.12)
		local bayY = if mainX > D * 0.5 then wy - wingThick * 0.6 else -D * 0.46
		for _, s in { -1, 1 } do
			block(ctx, "GearDoor", Vector3.new(0.16, gearLen * 0.6, wheelR * 2.4), CFrame.new(s * (mainX + wheelW * 1.5), bayY - gearLen * 0.32, mainZ), col.body, Enum.Material.SmoothPlastic, gearFolder)
			block(ctx, "GearDoor", Vector3.new(0.12, D * 0.17, wheelR * 2.2), CFrame.new(s * wheelW * 0.9, -D * 0.43, noseZ), col.body, Enum.Material.SmoothPlastic, gearFolder)
			local pnl = block(ctx, "BayPanel", Vector3.new(wheelR * 2.6, 0.12, wheelR * 3.2), CFrame.new(s * mainX, bayY - 0.08, mainZ), SEAM, Enum.Material.SmoothPlastic, doorsUp)
			pnl.CastShadow = false
		end
		local np = block(ctx, "BayPanel", Vector3.new(wheelR * 1.5, 0.1, wheelR * 2.6), CFrame.new(0, -D * 0.485, noseZ), SEAM, Enum.Material.SmoothPlastic, doorsUp)
		np.CastShadow = false
		for _, p in doorsUp:GetChildren() do
			if p:IsA("BasePart") then
				p.Transparency = 1 -- по умолчанию шасси выпущено; при уборке панели показывает setGearVisible
			end
		end
	end
	if not static then
		for i, p in mainGear do
			local a = Instance.new("Attachment")
			a.Name = "MainGear" .. i
			a.Position = p
			a.Parent = root
		end
	end

	-- ===== кресло пилота
	if o.seat and not static then
		local seat = Instance.new("Seat")
		seat.Name = "PilotSeat"
		seat.Size = Vector3.new(2, 0.4, 2)
		seat.Transparency = 1
		seat.CanCollide = false
		seat.CanTouch = false
		seat.Massless = true
		local seatY = if D < 8 then -D * 0.3 else -D * 0.15
		seat.CFrame = root.CFrame * CFrame.new(0, seatY, -L / 2 + Ln * 0.85 + 1.5)
		seat.Parent = model
		local w = Instance.new("WeldConstraint")
		w.Part0 = root
		w.Part1 = seat
		w.Parent = seat
	end

	-- ===== подпись
	if o.label then
		local bb = Instance.new("BillboardGui")
		bb.Name = "Tag"
		bb.Size = UDim2.fromOffset(220, 40)
		bb.StudsOffsetWorldSpace = Vector3.new(0, D + cfg.finHeight + 6, 0)
		bb.MaxDistance = 4000
		bb.AlwaysOnTop = false
		bb.LightInfluence = 0
		local t = Instance.new("TextLabel")
		t.Size = UDim2.fromScale(1, 1)
		t.BackgroundTransparency = 1
		t.Text = o.label
		t.TextColor3 = Color3.fromRGB(228, 238, 255)
		t.TextStrokeTransparency = 0.4
		t.Font = Enum.Font.GothamBold
		t.TextScaled = true
		t.Parent = bb
		bb.Parent = root
	end

	if static then
		for _, d in model:GetDescendants() do
			if d:IsA("BasePart") then
				d.Anchored = true
			end
		end
	end
	return model
end

-- Положение закрылков (0..3) — меняет C0 сварки, работает локально у каждого клиента
-- p: штурвал на себя (+), r: крен вправо (+), y: педаль вправо (+); значения -1..1
function PlaneBuilder.setControls(model: Model, p: number, r: number, y: number)
	local f = model:FindFirstChild("Controls")
	if not f then
		return
	end
	for _, part in f:GetChildren() do
		local w = part:FindFirstChild("ControlWeld") :: Weld?
		if w then
			local hinge = w:GetAttribute("Hinge") :: CFrame?
			local fc = w:GetAttribute("Chord") :: number?
			local kind = w:GetAttribute("Kind")
			if hinge and fc then
				local deg = if kind == "ailR" then -r * 18 elseif kind == "ailL" then r * 18 elseif kind == "elev" then -p * 20 else y * 25
				w.C0 = hinge * CFrame.Angles(math.rad(deg), 0, 0) * CFrame.new(0, 0, fc / 2)
			end
		end
	end
end

function PlaneBuilder.setFlaps(model: Model, flaps: number)
	local f = model:FindFirstChild("Flaps")
	if not f then
		return
	end
	for _, flap in f:GetChildren() do
		local w = flap:FindFirstChild("FlapWeld") :: Weld?
		if w then
			local hinge = w:GetAttribute("Hinge") :: CFrame?
			local fc = w:GetAttribute("Chord") :: number?
			if hinge and fc then
				w.C0 = hinge * CFrame.Angles(math.rad(flaps * 11), 0, 0) * CFrame.new(0, 0, fc / 2)
			end
		end
	end
end

function PlaneBuilder.setGearVisible(model: Model, visible: boolean)
	local du = model:FindFirstChild("GearDoorsUp")
	if du then
		for _, p in du:GetChildren() do
			if p:IsA("BasePart") then
				p.Transparency = if visible then 1 else 0
			end
		end
	end
	local g = model:FindFirstChild("Gear")
	if not g then
		return
	end
	for _, p in g:GetChildren() do
		if p:IsA("BasePart") then
			p.LocalTransparencyModifier = if visible then 0 else 1
			local sl = p:FindFirstChildOfClass("SpotLight")
			if sl then
				sl.Enabled = visible
			end
		end
	end
end

return PlaneBuilder
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000007"><Properties><string name="Name">Progress</string><ProtectedString name="Source"><![CDATA[--!strict
-- Прогресс игрока: цены самолётов, раскраски, уровни, награды, ежедневные награды и задания.
-- Общий для сервера (начисляет) и клиента (показывает). Все цифры можно менять здесь.
local Progress = {}

-- самолёт: цена в монетах и нужный уровень
Progress.JETS = {
	F16 = { cost = 0, level = 1 },
	MIG29 = { cost = 0, level = 1 },
	FA18 = { cost = 600, level = 2 },
	RAFALE = { cost = 1200, level = 4 },
	SU33 = { cost = 2000, level = 6 },
	F35 = { cost = 3500, level = 8 },
} :: { [string]: { cost: number, level: number } }

-- раскраски: корпус и второй цвет; киль всегда цвета команды, чтобы своих было видно
Progress.PAINTS = {
	{ id = "team", cost = 0, level = 1 },
	{ id = "camo", cost = 300, level = 2, body = Color3.fromRGB(96, 110, 82), accent = Color3.fromRGB(70, 80, 60) },
	{ id = "desert", cost = 500, level = 3, body = Color3.fromRGB(196, 174, 128), accent = Color3.fromRGB(150, 128, 90) },
	{ id = "arctic", cost = 700, level = 4, body = Color3.fromRGB(232, 238, 244), accent = Color3.fromRGB(150, 170, 190) },
	{ id = "night", cost = 900, level = 5, body = Color3.fromRGB(34, 38, 46), accent = Color3.fromRGB(20, 22, 28) },
	{ id = "shark", cost = 1500, level = 7, body = Color3.fromRGB(120, 132, 146), accent = Color3.fromRGB(200, 40, 40) },
	{ id = "neon", cost = 2500, level = 10, body = Color3.fromRGB(30, 30, 40), accent = Color3.fromRGB(0, 230, 255) },
	{ id = "gold", cost = 0, level = 1, vip = true, body = Color3.fromRGB(214, 172, 60), accent = Color3.fromRGB(150, 110, 30) },
}
function Progress.paint(id: string): any?
	for _, p in Progress.PAINTS do
		if p.id == id then
			return p
		end
	end
	return nil
end

-- уровень: чтобы дойти до уровня L, нужно 250·(L−1)·L/2 опыта (250, 750, 1500, 2500 …)
function Progress.xpFor(level: number): number
	return 125 * (level - 1) * level
end
function Progress.levelOf(xp: number): (number, number, number)
	local l = 1
	while Progress.xpFor(l + 1) <= xp and l < 100 do
		l += 1
	end
	local base = Progress.xpFor(l)
	return l, xp - base, Progress.xpFor(l + 1) - base
end

-- награды {монеты, опыт}
Progress.REWARD = {
	kill = { 50, 100 },
	assist = { 20, 40 },
	capture = { 40, 80 },
	win = { 150, 250 },
	loss = { 50, 80 },
	mvp = { 100, 100 },
	landing = { 15, 20 }, -- посадка на свою палубу
} :: { [string]: { number } }
-- серия сбитий без смерти → бонус
Progress.STREAK = { [3] = 50, [5] = 100, [8] = 200, [12] = 400 } :: { [number]: number }

-- ежедневная награда за вход (7 дней подряд, потом по кругу)
Progress.DAILY = { 100, 150, 200, 250, 300, 400, 750 }

-- ежедневные задания: каждый день 3 из списка
Progress.QUESTS = {
	{ id = "kills", n = 5, reward = 200 },
	{ id = "caps", n = 2, reward = 200 },
	{ id = "sorties", n = 4, reward = 150 },
	{ id = "msl", n = 3, reward = 200 },
	{ id = "gun", n = 3, reward = 200 },
	{ id = "wins", n = 1, reward = 250 },
	{ id = "deck", n = 2, reward = 150 },
	{ id = "assists", n = 3, reward = 150 },
}
function Progress.quest(id: string): any?
	for _, q in Progress.QUESTS do
		if q.id == id then
			return q
		end
	end
	return nil
end
function Progress.day(): number
	return os.time() // 86400
end
function Progress.week(): number
	return (os.time() + 3 * 86400) // (7 * 86400) -- неделя с понедельника
end
-- одинаковый набор заданий на день для игрока (без случайности, чтобы не «перекручивать»)
function Progress.questsFor(day: number, userId: number): { string }
	local rng = Random.new(day * 7919 + userId % 100003)
	local pool = {}
	for _, q in Progress.QUESTS do
		table.insert(pool, q.id)
	end
	local out = {}
	for _ = 1, 3 do
		local i = rng:NextInteger(1, #pool)
		table.insert(out, pool[i])
		table.remove(pool, i)
	end
	return out
end

return Progress
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000008"><Properties><string name="Name">World</string><ProtectedString name="Source"><![CDATA[--!strict
-- Carrier Strike: карта — океан, два авианосца и пять островов-баз.
-- Это же описание использует физика полёта (groundAt / hitsObstacle / runwayAt),
-- сервер (строит мир по этим данным) и клиент (карта, точки появления).
local World = {}

World.FT = 1.69 -- футов в одном studs (как в Sky Pilot)
World.SEA = 0 -- уровень моря
World.SIZE = 9500 -- половина стороны зоны боя; дальше — предупреждение и урон
World.lastHit = nil :: string?

-- ===== авианосцы
World.DECK_H = 46 -- высота полётной палубы над водой
World.DECK_W = 150
World.DECK_L = 660
export type Carrier = { id: string, team: string, name: string, cf: CFrame }
World.CARRIERS = {
	{ id = "CV_BLUE", team = "Blue", name = "Авианосец «Синих»", cf = CFrame.new(0, 0, 7000) },
	{ id = "CV_RED", team = "Red", name = "Авианосец «Красных»", cf = CFrame.new(0, 0, -7000) * CFrame.Angles(0, math.pi, 0) },
} :: { Carrier }
-- надстройка («остров») по правому борту, в координатах авианосца (нос корабля — -Z)
World.TOWER = { x0 = 52, x1 = 74, z0 = -60, z1 = 40, h = 95 }

function World.carrierOf(team: string): Carrier
	for _, c in World.CARRIERS do
		if c.team == team then
			return c
		end
	end
	return World.CARRIERS[1]
end

-- ===== острова (базы, которые можно захватывать)
export type Island = {
	id: string, name: string, x: number, z: number, r: number, h: number, yaw: number,
	owner: string, hills: { { number } }, -- холм: {вдоль полосы, поперёк полосы, радиус, высота}
}
World.BEACH = 140
World.RUNWAY_LEN = 1100
World.RUNWAY_W = 70
World.ISLANDS = {
	{ id = "A", name = "Альфа", x = -2600, z = 3000, r = 760, h = 26, yaw = 20, owner = "Blue", hills = { { -150, -400, 300, 260 }, { 250, 380, 220, 160 } } },
	{ id = "B", name = "Браво", x = 3000, z = 1600, r = 720, h = 30, yaw = -35, owner = "", hills = { { 100, 400, 280, 300 } } },
	{ id = "C", name = "Центр", x = 0, z = 0, r = 900, h = 34, yaw = 90, owner = "", hills = { { 0, 520, 360, 420 }, { 150, -500, 260, 240 } } },
	{ id = "D", name = "Дельта", x = -3000, z = -1600, r = 720, h = 28, yaw = 145, owner = "", hills = { { -100, -400, 280, 300 } } },
	{ id = "E", name = "Эхо", x = 2600, z = -3000, r = 760, h = 26, yaw = 200, owner = "Red", hills = { { 150, 400, 300, 260 }, { -250, -380, 220, 160 } } },
} :: { Island }
World.CAPTURE_R = 1500 -- радиус зоны захвата
World.CAPTURE_ALT = 700 -- выше этой высоты над островом базу не захватить

function World.islandById(id: string): Island?
	for _, i in World.ISLANDS do
		if i.id == id then
			return i
		end
	end
	return nil
end

-- направление полосы острова (единичный вектор в плоскости XZ)
function World.runwayDir(i: Island): Vector3
	local a = math.rad(i.yaw)
	return Vector3.new(math.sin(a), 0, -math.cos(a))
end

-- центр холма в мировых координатах
function World.hillPos(i: Island, hl: { number }): Vector3
	local dir = World.runwayDir(i)
	local side = Vector3.new(-dir.Z, 0, dir.X)
	return Vector3.new(i.x, i.h, i.z) + dir * hl[1] + side * hl[2]
end

-- ===== высота поверхности; -math.huge = открытое море (садиться некуда)
local function deckLocal(c: Carrier, x: number, z: number): Vector3
	return c.cf:PointToObjectSpace(Vector3.new(x, 0, z))
end

local function islandH(i: Island, x: number, z: number): number
	local dx, dz = x - i.x, z - i.z
	local d = math.sqrt(dx * dx + dz * dz)
	if d > i.r + World.BEACH then
		return -math.huge
	end
	local h = if d <= i.r then i.h else 3
	local dir = World.runwayDir(i)
	local along = dx * dir.X + dz * dir.Z
	local side = -dx * dir.Z + dz * dir.X
	for _, hl in i.hills do
		local hx, hz = (along - hl[1]) / hl[3], (side - hl[2]) / hl[3]
		local e = 1 - (hx * hx + hz * hz)
		if e > 0 then
			h = math.max(h, i.h + hl[4] * math.sqrt(e))
		end
	end
	return h
end

function World.groundAt(x: number, z: number): number
	for _, c in World.CARRIERS do
		local l = deckLocal(c, x, z)
		if math.abs(l.X) <= World.DECK_W / 2 and math.abs(l.Z) <= World.DECK_L / 2 then
			return World.DECK_H
		end
	end
	local best = -math.huge
	for _, i in World.ISLANDS do
		local h = islandH(i, x, z)
		if h > best then
			best = h
		end
	end
	return best
end

-- препятствия: надстройка и борт авианосца, вода
function World.hitsObstacle(p: Vector3): boolean
	for _, c in World.CARRIERS do
		local l = c.cf:PointToObjectSpace(p)
		local t = World.TOWER
		if l.X >= t.x0 and l.X <= t.x1 and l.Z >= t.z0 and l.Z <= t.z1 and l.Y <= World.DECK_H + t.h then
			World.lastHit = "Врезался в надстройку авианосца!"
			return true
		end
		if math.abs(l.X) <= World.DECK_W / 2 + 4 and math.abs(l.Z) <= World.DECK_L / 2 + 4 and l.Y < World.DECK_H - 2 and l.Y > -10 then
			World.lastHit = "Врезался в борт авианосца!"
			return true
		end
	end
	if p.Y < World.SEA + 1.5 and World.groundAt(p.X, p.Z) == -math.huge then
		World.lastHit = "Упал в океан!"
		return true
	end
	World.lastHit = nil
	return false
end

function World.isWater(x: number, z: number): boolean
	return World.groundAt(x, z) == -math.huge
end

-- палуба или полоса под точкой: id авианосца / острова, иначе nil
function World.runwayAt(x: number, z: number, margin: number?): string?
	local m = margin or 0
	for _, c in World.CARRIERS do
		local l = deckLocal(c, x, z)
		if math.abs(l.X) <= World.DECK_W / 2 + m and math.abs(l.Z) <= World.DECK_L / 2 + m then
			return c.id
		end
	end
	for _, i in World.ISLANDS do
		local dir = World.runwayDir(i)
		local rel = Vector3.new(x - i.x, 0, z - i.z)
		local along = rel:Dot(dir)
		local side = rel:Dot(Vector3.new(-dir.Z, 0, dir.X))
		if math.abs(along) <= World.RUNWAY_LEN / 2 + m and math.abs(side) <= World.RUNWAY_W / 2 + m then
			return i.id
		end
	end
	return nil
end

-- ===== точки появления
-- id: "deck:<team>", "air:<team>", "base:<id>"
local DECK_SLOTS = { { -30, 250 }, { 0, 200 }, { -50, 160 }, { 20, 290 } }
function World.spawnCFrame(id: string, cfg: any, slot: number?): (CFrame?, boolean)
	local kind, arg = id:match("^(%a+):(%w+)$")
	local s = slot or 1
	if kind == "deck" and arg then
		local c = World.carrierOf(arg)
		local sl = DECK_SLOTS[(s - 1) % #DECK_SLOTS + 1]
		return c.cf * CFrame.new(sl[1], World.DECK_H + cfg.gearHeight, sl[2]), false
	elseif kind == "air" and arg then
		local c = World.carrierOf(arg)
		local off = (s - 1) % 4
		return c.cf * CFrame.new(-300 + off * 200, 1400 + off * 60, -1800), true
	elseif kind == "base" and arg then
		local i = World.islandById(arg)
		if not i then
			return nil, false
		end
		local dir = World.runwayDir(i)
		local side = Vector3.new(-dir.Z, 0, dir.X)
		local lane = ((s - 1) % 2 - 0.5) * 30
		local start = Vector3.new(i.x, i.h + cfg.gearHeight, i.z) - dir * (World.RUNWAY_LEN / 2 - 80 - ((s - 1) // 2) * 120) + side * lane
		return CFrame.lookAt(start, start + dir), false
	end
	return nil, false
end

function World.headingDeg(look: Vector3): number
	local h = math.deg(math.atan2(look.X, -look.Z))
	return (h + 360) % 360
end

World.TEAM_COLOR = {
	Blue = Color3.fromRGB(92, 200, 255),
	Red = Color3.fromRGB(255, 96, 86),
	[""] = Color3.fromRGB(200, 206, 214),
} :: { [string]: Color3 }
World.TEAM_NAME = { Blue = "Синие", Red = "Красные", [""] = "Нейтральная" } :: { [string]: string }

return World
]]></ProtectedString></Properties></Item>
</Item>
</Item>
<Item class="ServerScriptService" referent="RBX00000015"><Properties><string name="Name">ServerScriptService</string></Properties><Item class="Script" referent="RBX0000000D"><Properties><string name="Name">CarrierStrikeServer</string><ProtectedString name="Source"><![CDATA[--!strict
-- Carrier Strike — сервер: команды, вылеты, бой (пушка и ракеты проверяются здесь),
-- захват островов, очки команд, боты, прогресс (монеты, опыт, самолёты, раскраски),
-- ежедневные награды и задания, серии сбитий, MVP раунда, недельный топ, VIP и покупки.
local Players = game:GetService("Players")
local Teams = game:GetService("Teams")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local PhysicsService = game:GetService("PhysicsService")
local Debris = game:GetService("Debris")
local MarketplaceService = game:GetService("MarketplaceService")
local BadgeService = game:GetService("BadgeService")

local Shared = ReplicatedStorage:WaitForChild("CarrierStrike")
local World = require(Shared:WaitForChild("World"))
local Jets = require(Shared:WaitForChild("Jets"))
local Progress = require(Shared:WaitForChild("Progress"))
local Config = require(Shared:WaitForChild("Config"))
local FlightPhysics = require(Shared:WaitForChild("FlightPhysics"))
local JetModel = require(Shared:WaitForChild("JetModel"))
local WorldBuilder = require(script:WaitForChild("WorldBuilder"))
local Bots = require(script:WaitForChild("Bots"))
local Data = require(script:WaitForChild("Data"))

local rng = Random.new()

-- настоящие 3D-модели (если импортированы в Workspace) → в ReplicatedStorage/CarrierStrike/JetModels
JetModel.collect(Jets.ORDER)

-- ===== группы столкновений: самолёты не цепляются за мир (столкновения считает физика игры)
local FLYING, DEBRIS = "CSFlying", "CSDebris"
for _, g in { FLYING, DEBRIS } do
	if not PhysicsService:IsCollisionGroupRegistered(g) then
		PhysicsService:RegisterCollisionGroup(g)
	end
end
PhysicsService:CollisionGroupSetCollidable(FLYING, "Default", false)
PhysicsService:CollisionGroupSetCollidable(FLYING, FLYING, false)
PhysicsService:CollisionGroupSetCollidable(FLYING, DEBRIS, false)
PhysicsService:CollisionGroupSetCollidable(DEBRIS, DEBRIS, false)
local function setGroup(inst: Instance, group: string)
	for _, d in inst:GetDescendants() do
		if d:IsA("BasePart") then
			d.CollisionGroup = group
		end
	end
end

-- ===== удалённые события
local remotes = Instance.new("Folder")
remotes.Name = "CSRemotes"
local function remote(name: string): RemoteEvent
	local r = Instance.new("RemoteEvent")
	r.Name = name
	r.Parent = remotes
	return r
end
local SpawnR = remote("Spawn") -- клиент → сервер: (jetId, spawnId, paintId)
local StartedR = remote("Started") -- сервер → клиент: (model, jetId, spawnCF, air)
local ReadyR = remote("Ready")
local StateR = remote("State") -- (gear, throttle)
local GunR = remote("Gun") -- (target|nil)
local MissileR = remote("Missile") -- (target)
local FlareR = remote("Flare")
local CrashR = remote("Crash") -- (kind: "water" | "carrier" | "ground")
local RearmR = remote("Rearm")
local LeaveR = remote("Leave")
local KilledR = remote("Killed") -- сервер → клиент: (killerName | "", weapon)
local NotifyR = remote("Notify") -- (key, color, ...)
local FeedR = remote("Feed") -- всем: (kind, data)
local WarnR = remote("Warn") -- цели: ракета летит (missile part)
local HitR = remote("Hit") -- стрелку: попадание (model, kill)
local ProfileR = remote("Profile") -- сервер → клиент: снимок прогресса
local RewardR = remote("Reward") -- сервер → клиент: (coins, xp, key)
local BuyR = remote("Buy") -- клиент → сервер: (kind "jet"|"paint", id)
local DailyR = remote("ClaimDaily")
local TutR = remote("TutorialDone")
local RoundR = remote("RoundEnd") -- всем: (winner, mvp list)
remotes.Parent = ReplicatedStorage

-- ===== мир и команды
WorldBuilder.build()
local planes = Instance.new("Folder")
planes.Name = "Planes"
planes.Parent = workspace
local missilesFolder = Instance.new("Folder")
missilesFolder.Name = "Missiles"
missilesFolder.Parent = workspace

local TEAM: { [string]: Team } = {}
for _, t in { { "Blue", "Blue", BrickColor.new("Bright blue") }, { "Red", "Red", BrickColor.new("Bright red") } } do
	local team = Instance.new("Team")
	team.Name = t[2]
	team.TeamColor = t[3]
	team.AutoAssignable = true
	team:SetAttribute("Side", t[1])
	team.Parent = Teams
	TEAM[t[1]] = team
	-- персонаж появляется на палубе своего авианосца (в бою он сидит в кабине)
	local c = World.carrierOf(t[1])
	local sp = Instance.new("SpawnLocation")
	sp.Name = "Deck_" .. t[1]
	sp.Size = Vector3.new(12, 1, 12)
	sp.CFrame = c.cf * CFrame.new(40, World.DECK_H + 0.5, 120)
	sp.Anchored = true
	sp.Neutral = false
	sp.TeamColor = t[3]
	sp.Transparency = 1
	sp.CanCollide = true
	sp.Duration = 0
	sp.Parent = workspace
	local floor = Instance.new("Part")
	floor.Name = "DeckFloor_" .. t[1]
	floor.Anchored = true
	floor.Transparency = 1
	floor.Size = Vector3.new(World.DECK_W, 1, World.DECK_L)
	floor.CFrame = c.cf * CFrame.new(0, World.DECK_H - 0.5, 0)
	floor.Parent = workspace
end
local function sideOf(p: Player): string
	return if p.Team == TEAM.Red then "Red" else "Blue"
end
local function other(side: string): string
	return if side == "Blue" then "Red" else "Blue"
end

-- состояние матча — атрибуты на ReplicatedStorage.CSMatch (клиент их читает)
local match = Instance.new("Configuration")
match.Name = "CSMatch"
match.Parent = ReplicatedStorage
local tickets = { Blue = Jets.TICKETS, Red = Jets.TICKETS }
local bases: { [string]: { owner: string, cap: number } } = {}
local function publish()
	match:SetAttribute("TicketsBlue", math.max(0, math.floor(tickets.Blue)))
	match:SetAttribute("TicketsRed", math.max(0, math.floor(tickets.Red)))
	for id, b in bases do
		match:SetAttribute("Owner_" .. id, b.owner)
		match:SetAttribute("Cap_" .. id, math.round(b.cap * 100) / 100)
	end
end
local function resetBases()
	for _, i in World.ISLANDS do
		bases[i.id] = { owner = i.owner, cap = if i.owner == "Blue" then 1 elseif i.owner == "Red" then -1 else 0 }
		WorldBuilder.setOwner(i.id, i.owner)
	end
end
resetBases()
publish()

-- =====================================================================
-- ПРОГРЕСС ИГРОКА
-- =====================================================================
local vip: { [Player]: boolean } = {}
local friendBonus: { [Player]: boolean } = {}
type RoundStat = { kills: number, caps: number, assists: number, score: number }
local roundStats: { [Player]: RoundStat } = {}

local function rs(p: Player): RoundStat
	local s = roundStats[p]
	if not s then
		s = { kills = 0, caps = 0, assists = 0, score = 0 }
		roundStats[p] = s
	end
	return s
end

local function badge(p: Player, name: string)
	local id = (Config.BADGES :: any)[name]
	if type(id) == "number" and id > 0 then
		task.spawn(function()
			pcall(function()
				if not BadgeService:UserHasBadgeAsync(p.UserId, id) then
					BadgeService:AwardBadge(p.UserId, id)
				end
			end)
		end)
	end
end

local function todayQuests(p: Player, d: any)
	local day = Progress.day()
	if d.quests.day ~= day then
		d.quests.day = day
		d.quests.list = {}
		for _, id in Progress.questsFor(day, p.UserId) do
			table.insert(d.quests.list, { id = id, p = 0, done = false })
		end
	end
end

local function snapshot(p: Player): any
	local d = Data.get(p)
	if not d then
		return nil
	end
	todayQuests(p, d)
	local day = Progress.day()
	local can = d.daily.last ~= day
	local streak = if d.daily.last == day - 1 or d.daily.last == day then d.daily.streak else 0
	local nextIdx = if can then (streak % #Progress.DAILY) + 1 else ((streak - 1) % #Progress.DAILY) + 1
	local qs = {}
	for _, q in d.quests.list do
		local def = Progress.quest(q.id)
		if def then
			table.insert(qs, { id = q.id, n = def.n, p = math.min(q.p, def.n), done = q.done, reward = def.reward })
		end
	end
	return {
		coins = d.coins, xp = d.xp, owned = d.owned, paints = d.paints, jet = d.jet, paint = d.paint,
		vip = vip[p] == true, tut = d.tut, stats = d.stats,
		daily = { can = can, streak = streak, idx = nextIdx },
		quests = qs, week = if d.week.id == Progress.week() then d.week.kills else 0,
		shop = { vip = Config.VIP_PASS_ID, coins = Config.COIN_PRODUCTS },
	}
end
local function sendProfile(p: Player)
	local s = snapshot(p)
	if s then
		ProfileR:FireClient(p, s)
	end
end

-- начислить монеты и опыт; key — за что (для всплывающей подписи)
local function give(p: Player?, coins: number, xp: number, key: string)
	if not p then
		return
	end
	local d = Data.get(p)
	if not d then
		return
	end
	local mul = (if vip[p] then 2 else 1) * (if friendBonus[p] then 1.2 else 1)
	local c = math.floor(coins * mul + 0.5)
	local before = Progress.levelOf(d.xp)
	d.coins += c
	d.xp += xp
	Data.mark(p)
	RewardR:FireClient(p, c, xp, key)
	local after = Progress.levelOf(d.xp)
	if after > before then
		NotifyR:FireClient(p, "levelup", "amber", after)
		if after >= 10 then
			badge(p, "level10")
		end
	end
	sendProfile(p)
end
local function reward(p: Player?, kind: string)
	local r = Progress.REWARD[kind]
	if r then
		give(p, r[1], r[2], kind)
	end
end

-- продвинуть ежедневное задание
local function quest(p: Player?, id: string, n: number)
	if not p then
		return
	end
	local d = Data.get(p)
	if not d then
		return
	end
	todayQuests(p, d)
	for _, q in d.quests.list do
		if q.id == id and not q.done then
			local def = Progress.quest(id)
			q.p += n
			if def and q.p >= def.n then
				q.done = true
				give(p, def.reward, 100, "quest_" .. id)
				NotifyR:FireClient(p, "quest_done", "green")
			end
			Data.mark(p)
		end
	end
end

local function stat(p: Player?, name: string, n: number)
	local d = p and Data.get(p)
	if d then
		d.stats[name] = (d.stats[name] or 0) + n
		if name == "kills" then
			local wk = Progress.week()
			if d.week.id ~= wk then
				d.week.id = wk
				d.week.kills = 0
			end
			d.week.kills += n
		end
		Data.mark(p :: Player)
	end
end

-- ===== счёт в списке игроков (Tab)
local function leaderstats(p: Player)
	local ls = Instance.new("Folder")
	ls.Name = "leaderstats"
	for _, n in { "Kills", "Level" } do
		local v = Instance.new("IntValue")
		v.Name = n
		v.Parent = ls
	end
	ls.Parent = p
end
local function setLS(p: Player)
	local d = Data.get(p)
	local ls = p:FindFirstChild("leaderstats")
	if d and ls then
		(ls:FindFirstChild("Kills") :: IntValue).Value = (roundStats[p] and roundStats[p].kills) or 0;
		(ls:FindFirstChild("Level") :: IntValue).Value = (Progress.levelOf(d.xp))
	end
end

-- =====================================================================
-- БОЕВЫЕ ЕДИНИЦЫ (игроки и боты)
-- =====================================================================
type Unit = {
	model: Model, root: BasePart, side: string, cfg: any, name: string,
	player: Player?, bot: any?, flight: any?,
	hp: number, maxHp: number, missiles: number, flares: number,
	flareUntil: number, lastShot: number, lastMsl: number, lastRearm: number,
	alive: boolean, ready: boolean, born: number, conns: { RBXScriptConnection },
	dmgBy: { [any]: number }, streak: number, kills: number, airborne: boolean,
}
local units: { [Model]: Unit } = {}
local byPlayer: { [Player]: Unit } = {}

local function setAttrs(u: Unit)
	u.model:SetAttribute("HP", math.max(0, math.ceil(u.hp)))
	u.model:SetAttribute("MaxHP", u.maxHp)
	u.model:SetAttribute("Missiles", u.missiles)
	u.model:SetAttribute("Flares", u.flares)
end

local function vel(u: Unit): Vector3
	if u.flight then
		return u.flight.vel
	end
	return u.root.AssemblyLinearVelocity
end

local function explode(model: Model)
	local root = model.PrimaryPart
	if not root then
		model:Destroy()
		return
	end
	local pos = root.Position
	local v = root.AssemblyLinearVelocity * 0.25
	local ex = Instance.new("Explosion")
	ex.Position = pos
	ex.BlastRadius = 0
	ex.BlastPressure = 0
	ex.DestroyJointRadiusPercent = 0
	ex.Parent = workspace
	local fire = Instance.new("Part")
	fire.Anchored, fire.CanCollide, fire.CanQuery, fire.CanTouch = true, false, false, false
	fire.Transparency = 1
	fire.Size = Vector3.one
	fire.Position = Vector3.new(pos.X, math.max(pos.Y, World.SEA + 1), pos.Z)
	local sm = Instance.new("Smoke")
	sm.Size = 30
	sm.RiseVelocity = 14
	sm.Color = Color3.fromRGB(40, 40, 40)
	sm.Parent = fire
	local fl = Instance.new("Fire")
	fl.Size = 18
	fl.Parent = fire
	fire.Parent = workspace
	Debris:AddItem(fire, 8)
	model.Name = "Wreck"
	for _, d in model:GetDescendants() do
		if d:IsA("JointInstance") or d:IsA("WeldConstraint") or d:IsA("Seat") or d:IsA("BillboardGui") or d:IsA("Trail") then
			d:Destroy()
		end
	end
	for _, d in model:GetDescendants() do
		if d:IsA("BasePart") then
			d.Anchored = false
			d.CanCollide = true
			d.CollisionGroup = DEBRIS
			d.AssemblyLinearVelocity = v + Vector3.new(rng:NextNumber(-1, 1), rng:NextNumber(0.2, 1.4), rng:NextNumber(-1, 1)) * rng:NextNumber(20, 90)
		end
	end
	Debris:AddItem(model, 7)
end

local function removeUnit(u: Unit, blowUp: boolean)
	if not u.alive then
		return
	end
	u.alive = false
	units[u.model] = nil
	if u.player and byPlayer[u.player] == u then
		byPlayer[u.player] = nil
	end
	for _, c in u.conns do
		c:Disconnect()
	end
	if blowUp then
		explode(u.model)
	else
		u.model:Destroy()
	end
	local p = u.player
	if p and p.Parent then
		task.delay(0.2, function()
			if p.Parent and not byPlayer[p] then
				p:LoadCharacter()
			end
		end)
	end
end

local function loseTickets(side: string, n: number)
	tickets[side] -= n
	publish()
end

-- урон; attacker = кто стрелял
local function damage(victim: Unit, dmg: number, attacker: Unit?, weapon: string)
	if not victim.alive or victim.born + 3 > os.clock() then
		return -- 3 с неуязвимости после появления
	end
	victim.hp -= dmg
	if attacker then
		victim.dmgBy[attacker] = (victim.dmgBy[attacker] or 0) + dmg
	end
	setAttrs(victim)
	if attacker and attacker.player then
		HitR:FireClient(attacker.player, victim.model, victim.hp <= 0)
	end
	if victim.hp > 0 then
		return
	end
	FeedR:FireAllClients("kill", { k = if attacker then attacker.name else "", ks = if attacker then attacker.side else "", w = weapon, v = victim.name, vs = victim.side })
	if attacker then
		attacker.kills += 1
		attacker.streak += 1
		local ap = attacker.player
		if ap then
			reward(ap, "kill")
			stat(ap, "kills", 1)
			quest(ap, "kills", 1)
			quest(ap, if weapon == "msl" then "msl" else "gun", 1)
			local r = rs(ap)
			r.kills += 1
			r.score += 100
			setLS(ap)
			badge(ap, "first_kill")
			if attacker.kills == 5 then
				badge(ap, "ace")
			end
			local bonus = Progress.STREAK[attacker.streak]
			if bonus then
				give(ap, bonus, bonus, "streak")
				FeedR:FireAllClients("streak", { n = attacker.streak, k = attacker.name, ks = attacker.side })
			end
		end
	end
	-- помощь: игроки, нанёсшие ≥25 урона, но не добившие
	for who, d in victim.dmgBy do
		local wu = who :: Unit
		if wu ~= attacker and d >= 25 and wu.player then
			reward(wu.player, "assist")
			stat(wu.player, "assists", 1)
			quest(wu.player, "assists", 1)
			local r = rs(wu.player)
			r.assists += 1
			r.score += 40
		end
	end
	stat(victim.player, "deaths", 1)
	loseTickets(victim.side, 3)
	if victim.player then
		KilledR:FireClient(victim.player, if attacker then attacker.name else "", weapon)
	end
	removeUnit(victim, true)
end

-- ===== появление
local function spawnAllowed(side: string, spawnId: string): boolean
	local kind, arg = spawnId:match("^(%a+):(%w+)$")
	if kind == "deck" or kind == "air" then
		return arg == side
	elseif kind == "base" and arg then
		return bases[arg] ~= nil and bases[arg].owner == side
	end
	return false
end

local function slotFor(spawnId: string, cfg: any): (CFrame?, boolean)
	for s = 1, 8 do
		local cf, air = World.spawnCFrame(spawnId, cfg, s)
		if not cf then
			return nil, false
		end
		local free = true
		for _, u in units do
			if (u.root.Position - cf.Position).Magnitude < 45 then
				free = false
				break
			end
		end
		if free then
			return cf, air
		end
	end
	return World.spawnCFrame(spawnId, cfg, 1)
end

local function paintCfg(cfg: any, side: string, paintId: string?): any
	local c = table.clone(cfg)
	c.colors = table.clone(cfg.colors)
	local team = if side == "Blue" then Color3.fromRGB(46, 104, 170) else Color3.fromRGB(170, 52, 46)
	local pt = paintId and Progress.paint(paintId)
	if pt and pt.body then
		c.colors.body = pt.body
		c.colors.accent = pt.accent
	else
		c.colors.accent = team
	end
	c.colors.tail = team -- киль всегда цвета команды
	c.paintId = paintId
	return c
end

local function makeUnit(cfg: any, side: string, name: string, cf: CFrame, seat: boolean, paintId: string?): Unit
	local model = JetModel.build(paintCfg(cfg, side, paintId), { seat = seat, label = name })
	model:SetAttribute("Side", side)
	model:SetAttribute("Pilot", name)
	model:SetAttribute("Gear", true)
	model:SetAttribute("Throttle", 0)
	model:PivotTo(cf)
	local tag = model.PrimaryPart and model.PrimaryPart:FindFirstChild("Tag")
	local lbl = tag and tag:FindFirstChildOfClass("TextLabel")
	if lbl then
		lbl.TextColor3 = World.TEAM_COLOR[side]
	end
	local root = model.PrimaryPart :: BasePart
	root.Anchored = true
	setGroup(model, FLYING)
	local u: Unit = {
		model = model, root = root, side = side, cfg = cfg, name = name,
		hp = cfg.hp, maxHp = cfg.hp, missiles = cfg.missiles, flares = Jets.FLARES,
		flareUntil = 0, lastShot = 0, lastMsl = 0, lastRearm = 0,
		alive = true, ready = false, born = os.clock(), conns = {},
		dmgBy = {}, streak = 0, kills = 0, airborne = false,
	}
	setAttrs(u)
	model.Parent = planes
	units[model] = u
	return u
end

local function ownsJet(p: Player, jetId: string): boolean
	local d = Data.get(p)
	return d ~= nil and d.owned[jetId] == true
end
local function ownsPaint(p: Player, paintId: string): boolean
	local d = Data.get(p)
	local pt = Progress.paint(paintId)
	if not d or not pt then
		return false
	end
	if pt.vip then
		return vip[p] == true
	end
	return d.paints[paintId] == true
end

local lastSpawn: { [Player]: number } = {}
SpawnR.OnServerEvent:Connect(function(p, jetId, spawnId, paintId)
	if type(jetId) ~= "string" or type(spawnId) ~= "string" then
		return
	end
	local cfg = Jets.JETS[jetId]
	local side = sideOf(p)
	if not cfg or not spawnAllowed(side, spawnId) or byPlayer[p] or not ownsJet(p, jetId) then
		return
	end
	local paint = if type(paintId) == "string" and ownsPaint(p, paintId) then paintId else "team"
	local now = os.clock()
	if lastSpawn[p] and now - lastSpawn[p] < 2 then
		return
	end
	lastSpawn[p] = now
	local cf, air = slotFor(spawnId, cfg)
	if not cf then
		return
	end
	local ch = p.Character
	local hum = ch and ch:FindFirstChildOfClass("Humanoid")
	if not hum or hum.Health <= 0 then
		p:LoadCharacter()
		ch = p.Character or p.CharacterAdded:Wait()
		hum = (ch :: Model):WaitForChild("Humanoid", 5) :: Humanoid?
	end
	if not hum or not p.Parent or byPlayer[p] then
		return
	end
	local label = if vip[p] then "★ " .. p.DisplayName else p.DisplayName
	local u = makeUnit(cfg, side, label, cf, true, paint)
	u.player = p
	u.model.Name = p.Name .. "_Jet"
	u.model:SetAttribute("Owner", p.UserId)
	u.model:SetAttribute("Gear", not air)
	byPlayer[p] = u
	for _, d in (ch :: Model):GetDescendants() do
		if d:IsA("BasePart") then
			d.CollisionGroup = FLYING
		end
	end
	local seat = u.model:FindFirstChild("PilotSeat") :: Seat
	seat:Sit(hum)
	table.insert(u.conns, hum.Died:Connect(function()
		removeUnit(u, true)
	end))
	local d = Data.get(p)
	if d then
		d.jet = jetId
		d.paint = paint
	end
	stat(p, "sorties", 1)
	quest(p, "sorties", 1)
	StartedR:FireClient(p, u.model, jetId, cf, air)
end)

ReadyR.OnServerEvent:Connect(function(p, model)
	local u = byPlayer[p]
	if not u or u.ready or model ~= u.model then
		return
	end
	u.ready = true
	u.root.Anchored = false
	pcall(function()
		u.root:SetNetworkOwner(p)
	end)
end)

StateR.OnServerEvent:Connect(function(p, gear, throttle)
	local u = byPlayer[p]
	if u and type(gear) == "boolean" and type(throttle) == "number" then
		u.model:SetAttribute("Gear", gear)
		u.model:SetAttribute("Throttle", math.clamp(throttle, 0, 1))
	end
end)

-- ===== пушка: клиент сообщает о выстреле и (если попал) о цели; сервер проверяет дистанцию, угол и темп
local function inCone(from: Unit, to: Vector3, deg: number, range: number): boolean
	local d = to - from.root.Position
	local dist = d.Magnitude
	if dist > range or dist < 1 then
		return false
	end
	return from.root.CFrame.LookVector:Dot(d / dist) >= math.cos(math.rad(deg))
end

local function shoot(u: Unit, target: Unit?)
	local now = os.clock()
	if now - u.lastShot < Jets.GUN_RATE * 0.8 then
		return
	end
	u.lastShot = now
	u.model:SetAttribute("FiringUntil", workspace:GetServerTimeNow() + 0.2)
	-- запас по углу (помощь прицеливания на телефоне) и по дальности (сетевая задержка)
	if target and target.alive and target.side ~= u.side and inCone(u, target.root.Position, math.max(Jets.GUN_CONE, Jets.GUN_CONE_TOUCH) * 2, Jets.GUN_RANGE * 1.15) then
		damage(target, Jets.GUN_DMG, u, "gun")
	end
end

GunR.OnServerEvent:Connect(function(p, target)
	local u = byPlayer[p]
	if not u or not u.ready then
		return
	end
	local t = if typeof(target) == "Instance" then units[target :: any] else nil
	shoot(u, t)
end)

-- ===== ракеты (летят на сервере)
type Missile = { part: BasePart, owner: Unit, target: Unit, dir: Vector3, t: number, decoy: Vector3?, flareChecked: number }
local missiles: { Missile } = {}

local function launch(u: Unit, target: Unit): boolean
	local now = os.clock()
	if u.missiles <= 0 or now - u.lastMsl < 1 or not target.alive or target.side == u.side then
		return false
	end
	if not inCone(u, target.root.Position, Jets.MSL_CONE * 1.6, Jets.MSL_RANGE * 1.15) then
		return false
	end
	u.lastMsl = now
	u.missiles -= 1
	setAttrs(u)
	local part = Instance.new("Part")
	part.Name = "Missile"
	part.Anchored, part.CanCollide, part.CanQuery, part.CanTouch = true, false, false, false
	part.Size = Vector3.new(0.9, 0.9, 9)
	part.Color = Color3.fromRGB(230, 230, 230)
	part.Material = Enum.Material.Metal
	local start = u.root.CFrame * CFrame.new(0, -3, -u.cfg.length * 0.3)
	part.CFrame = start
	local a0 = Instance.new("Attachment")
	a0.Position = Vector3.new(0, 0.3, 4.5)
	a0.Parent = part
	local a1 = Instance.new("Attachment")
	a1.Position = Vector3.new(0, -0.3, 4.5)
	a1.Parent = part
	local trail = Instance.new("Trail")
	trail.Attachment0, trail.Attachment1 = a0, a1
	trail.Lifetime = 1.6
	trail.WidthScale = NumberSequence.new(3, 9)
	trail.Color = ColorSequence.new(Color3.fromRGB(240, 240, 240))
	trail.Transparency = NumberSequence.new(0.2, 1)
	trail.FaceCamera = true
	trail.Parent = part
	local glow = Instance.new("PointLight")
	glow.Color = Color3.fromRGB(255, 170, 80)
	glow.Range = 20
	glow.Parent = part
	part:SetAttribute("Side", u.side)
	part.Parent = missilesFolder
	table.insert(missiles, { part = part, owner = u, target = target, dir = start.LookVector, t = 0, decoy = nil, flareChecked = 0 })
	if target.player then
		WarnR:FireClient(target.player, part)
	end
	return true
end

MissileR.OnServerEvent:Connect(function(p, target)
	local u = byPlayer[p]
	local t = if typeof(target) == "Instance" then units[target :: any] else nil
	if u and u.ready and t then
		launch(u, t)
	end
end)

local function flare(u: Unit)
	if u.flares <= 0 or os.clock() < u.flareUntil - Jets.FLARE_TIME + 0.6 then
		return
	end
	u.flares -= 1
	u.flareUntil = os.clock() + Jets.FLARE_TIME
	setAttrs(u)
	u.model:SetAttribute("FlareAt", workspace:GetServerTimeNow())
end
FlareR.OnServerEvent:Connect(function(p)
	local u = byPlayer[p]
	if u then
		flare(u)
	end
end)

local function stepMissiles(dt: number)
	for i = #missiles, 1, -1 do
		local m = missiles[i]
		m.t += dt
		local tg = m.target
		local pos = m.part.Position
		local done = m.t > Jets.MSL_LIFE or not tg.alive
		if not done then
			if tg.flareUntil > os.clock() and m.flareChecked ~= tg.flareUntil and not m.decoy then
				m.flareChecked = tg.flareUntil
				if rng:NextNumber() < Jets.FLARE_CHANCE then
					m.decoy = tg.root.Position - tg.root.CFrame.LookVector * 60 + Vector3.new(0, -30, 0)
				end
			end
			local aim = if m.decoy then m.decoy else Bots.lead(pos, tg.root.Position, vel(tg), Jets.MSL_SPEED)
			local want = (aim - pos)
			if want.Magnitude > 1 then
				want = want.Unit
				local ang = math.acos(math.clamp(m.dir:Dot(want), -1, 1))
				local maxA = Jets.MSL_TURN * dt
				if ang > 1e-4 then
					m.dir = m.dir:Lerp(want, math.min(1, maxA / ang)).Unit
				end
			end
			local np = pos + m.dir * Jets.MSL_SPEED * dt
			m.part.CFrame = CFrame.lookAt(np, np + m.dir)
			if not m.decoy and (tg.root.Position - np).Magnitude < 55 then
				damage(tg, Jets.MSL_DMG, m.owner, "msl")
				done = true
			elseif m.decoy and (m.decoy - np).Magnitude < 40 then
				done = true
			elseif np.Y < math.max(World.groundAt(np.X, np.Z), World.SEA) then
				done = true
			end
		end
		if done then
			local ex = Instance.new("Explosion")
			ex.Position = m.part.Position
			ex.BlastRadius = 0
			ex.BlastPressure = 0
			ex.Parent = workspace
			m.part.Transparency = 1
			Debris:AddItem(m.part, 1.7)
			table.remove(missiles, i)
		end
	end
end

-- ===== крушение, перевооружение, выход
CrashR.OnServerEvent:Connect(function(p, kind)
	local u = byPlayer[p]
	if not u then
		return
	end
	local why = if kind == "water" or kind == "carrier" or kind == "ground" then kind else "ground"
	FeedR:FireAllClients("crash", { v = u.name, vs = u.side, why = why })
	stat(p, "deaths", 1)
	loseTickets(u.side, 2)
	removeUnit(u, true)
end)

RearmR.OnServerEvent:Connect(function(p)
	local u = byPlayer[p]
	if not u or not u.ready or os.clock() - u.lastRearm < 2 then
		return
	end
	local pos = u.root.Position
	local where = World.runwayAt(pos.X, pos.Z, 10)
	local onCarrier = where == World.carrierOf(u.side).id
	local mine = onCarrier or (where ~= nil and bases[where] ~= nil and bases[where].owner == u.side)
	if not mine or u.root.AssemblyLinearVelocity.Magnitude > 25 then
		return
	end
	u.lastRearm = os.clock()
	-- посадка на палубу после вылета: награда и задание
	if onCarrier and u.airborne then
		u.airborne = false
		reward(p, "landing")
		quest(p, "deck", 1)
	end
	local before = u.hp + u.missiles + u.flares
	u.hp = math.min(u.maxHp, u.hp + 30)
	u.missiles = u.cfg.missiles
	u.flares = Jets.FLARES
	setAttrs(u)
	if u.hp + u.missiles + u.flares > before then
		NotifyR:FireClient(p, "rearm", "cyan")
	end
end)

LeaveR.OnServerEvent:Connect(function(p)
	local u = byPlayer[p]
	if u then
		removeUnit(u, false)
	end
end)

-- ===== магазин: самолёты и раскраски за монеты
BuyR.OnServerEvent:Connect(function(p, kind, id)
	local d = Data.get(p)
	if not d or type(id) ~= "string" then
		return
	end
	local level = Progress.levelOf(d.xp)
	if kind == "jet" then
		local j = Progress.JETS[id]
		if not j or d.owned[id] then
			return
		end
		if level < j.level then
			NotifyR:FireClient(p, "need_level", "amber", j.level)
		elseif d.coins < j.cost then
			NotifyR:FireClient(p, "need_coins", "amber", j.cost - d.coins)
		else
			d.coins -= j.cost
			d.owned[id] = true
			d.jet = id
			Data.mark(p)
			task.spawn(Data.save, p)
			NotifyR:FireClient(p, "bought", "green", id)
		end
	elseif kind == "paint" then
		local pt = Progress.paint(id)
		if not pt or pt.vip or d.paints[id] then
			return
		end
		if level < pt.level then
			NotifyR:FireClient(p, "need_level", "amber", pt.level)
		elseif d.coins < pt.cost then
			NotifyR:FireClient(p, "need_coins", "amber", pt.cost - d.coins)
		else
			d.coins -= pt.cost
			d.paints[id] = true
			d.paint = id
			Data.mark(p)
			task.spawn(Data.save, p)
			NotifyR:FireClient(p, "bought_paint", "green")
		end
	end
	sendProfile(p)
end)

-- ===== ежедневная награда
DailyR.OnServerEvent:Connect(function(p)
	local d = Data.get(p)
	if not d then
		return
	end
	local day = Progress.day()
	if d.daily.last == day then
		return
	end
	d.daily.streak = if d.daily.last == day - 1 then d.daily.streak + 1 else 1
	d.daily.last = day
	local idx = ((d.daily.streak - 1) % #Progress.DAILY) + 1
	give(p, Progress.DAILY[idx], 50, "daily")
	Data.mark(p)
	task.spawn(Data.save, p)
end)

TutR.OnServerEvent:Connect(function(p)
	local d = Data.get(p)
	if d and not d.tut then
		d.tut = true
		Data.mark(p)
		sendProfile(p)
	end
end)

-- ===== VIP и покупки за Robux
local function checkVip(p: Player)
	if Config.VIP_PASS_ID and Config.VIP_PASS_ID > 0 then
		local ok, has = pcall(function()
			return MarketplaceService:UserOwnsGamePassAsync(p.UserId, Config.VIP_PASS_ID)
		end)
		vip[p] = ok and has == true
	end
end
MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(p, passId, bought)
	if bought and passId == Config.VIP_PASS_ID then
		vip[p] = true
		NotifyR:FireClient(p, "vip_thanks", "amber")
		sendProfile(p)
	end
end)
MarketplaceService.ProcessReceipt = function(info: any)
	local p = Players:GetPlayerByUserId(info.PlayerId)
	local d = p and Data.get(p)
	if not p or not d then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	for _, id in d.purchases do
		if id == info.PurchaseId then
			return Enum.ProductPurchaseDecision.PurchaseGranted
		end
	end
	local coins = 0
	for _, pr in Config.COIN_PRODUCTS do
		if pr.id == info.ProductId then
			coins = pr.coins
		end
	end
	if coins == 0 then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	d.coins += coins
	table.insert(d.purchases, info.PurchaseId)
	while #d.purchases > 50 do
		table.remove(d.purchases, 1)
	end
	if not Data.save(p) then
		-- не сохранилось — откатываем и попросим Roblox повторить позже
		d.coins -= coins
		table.remove(d.purchases)
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	RewardR:FireClient(p, coins, 0, "purchase")
	sendProfile(p)
	return Enum.ProductPurchaseDecision.PurchaseGranted
end

-- ===== вход и выход игроков
local function updateFriends()
	local list = Players:GetPlayers()
	for _, p in list do
		task.spawn(function()
			local has = false
			for _, q in list do
				if q ~= p then
					local ok, f = pcall(function()
						return p:IsFriendsWith(q.UserId)
					end)
					if ok and f then
						has = true
						break
					end
				end
			end
			friendBonus[p] = has
		end)
	end
end

local function onJoin(p: Player)
	leaderstats(p)
	Data.load(p)
	checkVip(p)
	if not p.Parent then
		Data.release(p)
		return
	end
	setLS(p)
	sendProfile(p)
	badge(p, "welcome")
	updateFriends()
end
Players.PlayerAdded:Connect(onJoin)
for _, p in Players:GetPlayers() do
	task.spawn(onJoin, p)
end
Players.PlayerRemoving:Connect(function(p)
	local u = byPlayer[p]
	if u then
		removeUnit(u, false)
	end
	lastSpawn[p] = nil
	roundStats[p] = nil
	vip[p] = nil
	friendBonus[p] = nil
	Data.release(p)
	updateFriends()
end)

-- недельный топ: раз в 2 минуты в атрибут Top (JSON)
task.spawn(function()
	while true do
		local ok, list = pcall(Data.fetchTop)
		if ok then
			match:SetAttribute("Top", Data.encode(list))
		end
		task.wait(120)
	end
end)

-- =====================================================================
-- БОТЫ
-- =====================================================================
local BOT_NAMES = { "Falcon", "Viper", "Ghost", "Maverick", "Cobra", "Typhoon", "Hawk", "Storm", "Blaze", "Raven", "Phantom", "Sabre" }
local botSeq = 0
local function spawnBot(side: string)
	botSeq += 1
	local id = Jets.ORDER[rng:NextInteger(1, #Jets.ORDER)]
	local cfg = Jets.JETS[id]
	local cf = World.spawnCFrame("air:" .. side, cfg, rng:NextInteger(1, 4)) :: CFrame
	cf = cf + Vector3.new(rng:NextNumber(-300, 300), rng:NextNumber(0, 400), rng:NextNumber(-300, 300))
	local paints = { "team", "camo", "desert", "arctic", "night" }
	local u = makeUnit(cfg, side, "[BOT] " .. BOT_NAMES[(botSeq - 1) % #BOT_NAMES + 1], cf, false, paints[rng:NextInteger(1, #paints)])
	u.flight = FlightPhysics.new(cfg, cf, true)
	u.bot = { skill = rng:NextNumber(0.3, 0.9), target = nil :: Unit?, retarget = 0, lastMsl = os.clock() + 6, aimErr = rng:NextNumber(0.5, 1.5) }
	u.ready = true
	u.model:SetAttribute("Gear", false)
	u.model:SetAttribute("Throttle", 0.85)
end

local function playersOn(side: string): number
	local n = 0
	for _, p in Players:GetPlayers() do
		if sideOf(p) == side then
			n += 1
		end
	end
	return n
end

local function botCount(side: string): number
	local n = 0
	for _, u in units do
		if u.bot and u.side == side then
			n += 1
		end
	end
	return n
end

local function nearestEnemy(u: Unit, maxDist: number): Unit?
	local best, bd = nil, maxDist
	for _, o in units do
		if o.alive and o.side ~= u.side and o.ready then
			local d = (o.root.Position - u.root.Position).Magnitude
			if d < bd then
				best, bd = o, d
			end
		end
	end
	return best
end

local function botGoal(u: Unit): Vector3
	local best, bd = nil, math.huge
	for _, i in World.ISLANDS do
		if bases[i.id].owner ~= u.side then
			local d = (Vector3.new(i.x, 0, i.z) - u.root.Position).Magnitude
			if d < bd then
				best, bd = i, d
			end
		end
	end
	if best then
		return Vector3.new(best.x, best.h + 420, best.z)
	end
	local c = World.carrierOf(other(u.side))
	return c.cf.Position + Vector3.new(0, 1500, 0)
end

local function stepBot(u: Unit, dt: number)
	local f = u.flight
	local b = u.bot
	b.retarget -= dt
	if b.retarget <= 0 then
		b.retarget = 1.5
		b.target = nearestEnemy(u, 6500)
	end
	local tg: Unit? = b.target
	if tg and not tg.alive then
		tg = nil
		b.target = nil
	end
	local dir: Vector3
	if tg then
		local aim = Bots.lead(f.pos, tg.root.Position, vel(tg), math.max(f.speed, 300) + 900)
		dir = (aim - f.pos).Unit
		local d = (tg.root.Position - f.pos).Magnitude
		local cosA = f.att.LookVector:Dot(dir)
		if d < Jets.GUN_RANGE * 0.85 and cosA > math.cos(math.rad(Jets.GUN_CONE * b.aimErr)) then
			if rng:NextNumber() < 0.45 * (0.6 + b.skill * 0.6) then
				shoot(u, tg)
			else
				shoot(u, nil)
			end
		end
		if u.missiles > 0 and d < Jets.MSL_RANGE * 0.8 and d > 900 and cosA > math.cos(math.rad(Jets.MSL_CONE * 0.6)) and os.clock() > b.lastMsl then
			if launch(u, tg) then
				b.lastMsl = os.clock() + rng:NextNumber(8, 16)
			end
		end
	else
		dir = (botGoal(u) - f.pos)
		dir = if dir.Magnitude > 1 then dir.Unit else f.att.LookVector
	end
	for _, m in missiles do
		if m.target == u and not m.decoy and (m.part.Position - f.pos).Magnitude < 2500 then
			if rng:NextNumber() < 0.04 + b.skill * 0.04 then
				flare(u)
			end
			dir = (dir + f.att.RightVector * 1.5).Unit
			break
		end
	end
	local input = Bots.steer(f, dir, b.skill)
	FlightPhysics.step(f, input, dt)
	if f.crashed then
		FeedR:FireAllClients("crash", { v = u.name, vs = u.side, why = if f.pos.Y < 5 then "water" else "ground" })
		loseTickets(u.side, 2)
		removeUnit(u, true)
		return
	end
	u.root.CFrame = FlightPhysics.pose(f)
end

-- =====================================================================
-- РАУНД
-- =====================================================================
local capAcc, bleedAcc, botAcc = 0, 0, 0
local roundOver = false

local function endRound(winner: string)
	roundOver = true
	-- MVP: трое лучших игроков раунда
	local list = {}
	for p, s in roundStats do
		if p.Parent then
			table.insert(list, { p = p, s = s })
		end
	end
	table.sort(list, function(a, b)
		return a.s.score > b.s.score
	end)
	local mvp = {}
	for i = 1, math.min(3, #list) do
		local e = list[i]
		table.insert(mvp, { name = e.p.DisplayName, side = sideOf(e.p), kills = e.s.kills, caps = e.s.caps, score = e.s.score, userId = e.p.UserId })
	end
	RoundR:FireAllClients(winner, mvp)
	for _, p in Players:GetPlayers() do
		if sideOf(p) == winner then
			reward(p, "win")
			stat(p, "wins", 1)
			quest(p, "wins", 1)
			badge(p, "first_win")
		else
			reward(p, "loss")
		end
	end
	if list[1] and list[1].s.score > 0 then
		reward(list[1].p, "mvp")
	end
	for _, p in Players:GetPlayers() do
		task.spawn(Data.save, p)
	end
	task.delay(15, function()
		for _, u in units do
			if u.player then
				KilledR:FireClient(u.player, "", "round")
			end
			removeUnit(u, false)
		end
		for _, m in missiles do
			m.part:Destroy()
		end
		table.clear(missiles)
		table.clear(roundStats)
		tickets.Blue, tickets.Red = Jets.TICKETS, Jets.TICKETS
		resetBases()
		publish()
		for _, p in Players:GetPlayers() do
			setLS(p)
		end
		roundOver = false
	end)
end

RunService.Heartbeat:Connect(function(dt)
	dt = math.min(dt, 0.1)
	for _, u in units do
		if u.bot and u.alive then
			local ok, err = pcall(stepBot, u, dt)
			if not ok then
				warn("[CarrierStrike] бот убран из-за ошибки:", err)
				removeUnit(u, false)
			end
		end
	end
	stepMissiles(dt)

	capAcc += dt
	if capAcc >= 0.5 then
		local step = capAcc
		capAcc = 0
		for _, u in units do
			local p = u.root.Position
			if u.alive and p.Y > World.DECK_H + 80 then
				u.airborne = true
			end
			if u.alive and (math.abs(p.X) > World.SIZE or math.abs(p.Z) > World.SIZE) then
				u.born = 0
				damage(u, 6 * step, nil, "zone")
			end
		end
		-- захват баз: самолёты низко над островом
		for _, i in World.ISLANDS do
			local nb, nr = 0, 0
			local inZone: { Unit } = {}
			for _, u in units do
				if u.alive and u.ready then
					local p = u.root.Position
					local dx, dz = p.X - i.x, p.Z - i.z
					if dx * dx + dz * dz < World.CAPTURE_R * World.CAPTURE_R and p.Y < i.h + World.CAPTURE_ALT then
						table.insert(inZone, u)
						if u.side == "Blue" then
							nb += 1
						else
							nr += 1
						end
					end
				end
			end
			local b = bases[i.id]
			if nb ~= nr then
				local was = b.owner
				b.cap = math.clamp(b.cap + (nb - nr) * 0.045 * step / 0.5, -1, 1)
				if b.cap >= 1 then
					b.owner = "Blue"
				elseif b.cap <= -1 then
					b.owner = "Red"
				elseif (b.owner == "Blue" and b.cap <= 0) or (b.owner == "Red" and b.cap >= 0) then
					b.owner = ""
				end
				if b.owner ~= was then
					WorldBuilder.setOwner(i.id, b.owner)
					if b.owner ~= "" then
						FeedR:FireAllClients("cap", { side = b.owner, base = i.id })
						for _, u in inZone do
							if u.player and u.side == b.owner then
								reward(u.player, "capture")
								stat(u.player, "caps", 1)
								quest(u.player, "caps", 1)
								badge(u.player, "first_capture")
								local r = rs(u.player)
								r.caps += 1
								r.score += 75
							end
						end
					else
						FeedR:FireAllClients("neutral", { base = i.id })
					end
				end
			end
		end
		publish()
	end

	bleedAcc += dt
	if bleedAcc >= Jets.BLEED_EVERY and not roundOver then
		bleedAcc = 0
		local nb, nr = 0, 0
		for _, b in bases do
			if b.owner == "Blue" then
				nb += 1
			elseif b.owner == "Red" then
				nr += 1
			end
		end
		if nb > nr then
			loseTickets("Red", nb - nr)
		elseif nr > nb then
			loseTickets("Blue", nr - nb)
		end
	end
	if not roundOver then
		if tickets.Blue <= 0 then
			endRound("Red")
		elseif tickets.Red <= 0 then
			endRound("Blue")
		end
	end

	botAcc += dt
	if botAcc >= 3 and not roundOver then
		botAcc = 0
		for _, side in { "Blue", "Red" } do
			local want = math.max(0, Jets.BOTS_PER_TEAM - playersOn(side))
			local have = botCount(side)
			if have < want then
				spawnBot(side)
			elseif have > want then
				for _, u in units do
					if u.bot and u.side == side then
						removeUnit(u, false)
						break
					end
				end
			end
		end
	end
end)
]]></ProtectedString></Properties><Item class="ModuleScript" referent="RBX0000000A"><Properties><string name="Name">Bots</string><ProtectedString name="Source"><![CDATA[--!strict
-- «Мозг» бота: по положению своего самолёта и цели выдаёт ввод для FlightPhysics
-- (тот же ввод, что у игрока: p — на себя, r — крен вправо, y — педали, throttle).
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local World = require(ReplicatedStorage:WaitForChild("CarrierStrike"):WaitForChild("World"))

local Bots = {}

local function clamp(v: number, a: number, b: number): number
	return math.min(b, math.max(a, v))
end

-- dir — куда хотим лететь (мировой вектор); skill 0..1 — резкость манёвров
function Bots.steer(f: any, dir: Vector3, skill: number): any
	local att: CFrame = f.att
	local pos: Vector3 = f.pos
	-- безопасность: низко над водой/землёй — вверх, слишком высоко — вниз
	local ground = math.max(World.groundAt(pos.X, pos.Z), World.SEA)
	local ahead = pos + att.LookVector * math.max(f.speed, 200) * 2.5
	local groundAhead = math.max(World.groundAt(ahead.X, ahead.Z), World.SEA)
	local floor = math.max(ground, groundAhead) + 380
	-- у воды не пикируем круче ~25°
	if pos.Y < floor + 1500 and dir.Y < -0.42 then
		local flat = Vector3.new(dir.X, 0, dir.Z)
		flat = if flat.Magnitude > 0.01 then flat.Unit else Vector3.new(att.LookVector.X, 0, att.LookVector.Z).Unit
		dir = (flat * 0.9 + Vector3.new(0, -0.42, 0)).Unit
	end
	-- прогноз высоты через 3 с по вертикальной скорости
	local predY = pos.Y + math.min(f.vel.Y, 0) * 3
	if predY < floor then
		local flat = Vector3.new(dir.X, 0, dir.Z)
		flat = if flat.Magnitude > 0.01 then flat.Unit else Vector3.new(att.LookVector.X, 0, att.LookVector.Z).Unit
		dir = (flat + Vector3.new(0, 1.2 + (floor - pos.Y) / 200, 0)).Unit
	elseif pos.Y > 7000 then
		dir = (dir + Vector3.new(0, -0.6, 0)).Unit
	end
	-- граница карты: разворот к центру
	if math.abs(pos.X) > World.SIZE * 0.92 or math.abs(pos.Z) > World.SIZE * 0.92 then
		dir = (Vector3.new(-pos.X, 0, -pos.Z).Unit + Vector3.new(0, 0.1, 0)).Unit
	end

	local ld = att:VectorToObjectSpace(dir)
	-- крен: развернуть «пол» самолёта так, чтобы цель оказалась над головой
	local rollErr = math.atan2(ld.X, math.max(ld.Y, 0.05) + (if ld.Z < 0 then -ld.Z * 0.35 else 0))
	local bank = math.asin(clamp(-att.RightVector.Y, -1, 1))
	-- почти по курсу: выравниваем крыло (без лишнего крена)
	local offAxis = math.acos(clamp(-ld.Z, -1, 1))
	if offAxis < math.rad(8) then
		rollErr = -bank * 0.8 + ld.X * 2
	end
	local r = clamp(rollErr * (1.4 + skill), -1, 1)
	local pitchErr = math.atan2(ld.Y, math.max(-ld.Z, 0.15))
	local p = clamp(pitchErr * (2 + skill * 2), -0.5, 1)
	if ld.Z > 0 then
		p = 1 -- цель сзади: тянем на себя
	end
	-- тяга: ниже сваливания — форсаж, иначе крейсер
	local thr = if f.speed < f.cfg.stallKts * 1.5 then 1 else 0.85
	return { p = p, r = r, y = clamp(ld.X * 2, -1, 1) * 0.3, throttle = thr }
end

-- упреждение: куда целиться, чтобы снаряды/самолёт встретили цель
function Bots.lead(from: Vector3, to: Vector3, tvel: Vector3, speed: number): Vector3
	local t = (to - from).Magnitude / math.max(speed, 1)
	return to + tvel * math.min(t, 3)
end

return Bots
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX0000000B"><Properties><string name="Name">Data</string><ProtectedString name="Source"><![CDATA[--!strict
-- Сохранения игроков (DataStore). Если хранилище недоступно (в Studio не включён доступ к API),
-- игра работает с временным профилем и НЕ перезаписывает настоящие сохранения.
local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local HttpService = game:GetService("HttpService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("CarrierStrike")
local Config = require(Shared:WaitForChild("Config"))
local Progress = require(Shared:WaitForChild("Progress"))

local Data = {}

local store: DataStore? = nil
local top: OrderedDataStore? = nil
local topWeek = -1
pcall(function()
	store = DataStoreService:GetDataStore(Config.DATASTORE)
end)

local function default(): any
	return {
		v = 1,
		coins = 300,
		xp = 0,
		owned = { F16 = true, MIG29 = true },
		paints = { team = true },
		paint = "team",
		jet = "F16",
		daily = { last = 0, streak = 0 },
		quests = { day = 0, list = {} },
		week = { id = 0, kills = 0 },
		stats = { kills = 0, deaths = 0, wins = 0, caps = 0, sorties = 0, assists = 0 },
		purchases = {},
		tut = false,
		lang = "",
	}
end

-- дописать новые поля в старое сохранение
local function reconcile(d: any): any
	local def = default()
	for k, v in def do
		if d[k] == nil then
			d[k] = v
		elseif type(v) == "table" and type(d[k]) == "table" and k ~= "purchases" and k ~= "owned" and k ~= "paints" then
			for k2, v2 in v do
				if d[k][k2] == nil then
					d[k][k2] = v2
				end
			end
		end
	end
	d.owned.F16 = true
	d.owned.MIG29 = true
	d.paints.team = true
	return d
end

type Slot = { data: any, noSave: boolean, dirty: boolean, savedKills: number }
local slots: { [Player]: Slot } = {}
local warned = false

function Data.load(p: Player): any
	local key = "u_" .. p.UserId
	local data: any = nil
	local ok = false
	if store then
		for attempt = 1, 3 do
			local s, res = pcall(function()
				return (store :: DataStore):GetAsync(key)
			end)
			if s then
				ok = true
				data = res
				break
			end
			if not warned then
				warn("[CarrierStrike] DataStore недоступен:", res, "— в Studio включи Game Settings → Security → Enable Studio Access to API Services")
				warned = true
			end
			task.wait(attempt)
		end
	end
	local slot: Slot = {
		data = reconcile(if type(data) == "table" then data else default()),
		noSave = not ok, -- загрузка не удалась: не затираем настоящий профиль пустым
		dirty = false,
		savedKills = -1,
	}
	slots[p] = slot
	return slot.data
end

function Data.get(p: Player): any?
	local s = slots[p]
	return s and s.data
end

function Data.mark(p: Player)
	local s = slots[p]
	if s then
		s.dirty = true
	end
end

function Data.save(p: Player): boolean
	local s = slots[p]
	if not s or s.noSave or not store then
		return false
	end
	local key = "u_" .. p.UserId
	local d = s.data
	local ok = pcall(function()
		(store :: DataStore):UpdateAsync(key, function()
			return d
		end)
	end)
	if ok then
		s.dirty = false
	end
	-- недельный топ сбитий
	local wk = Progress.week()
	if wk ~= topWeek then
		topWeek = wk
		pcall(function()
			top = DataStoreService:GetOrderedDataStore("CS_WeekKills_" .. wk)
		end)
	end
	if ok and top and d.week.id == wk and d.week.kills ~= s.savedKills and d.week.kills > 0 then
		local kills = d.week.kills
		if pcall(function()
			(top :: OrderedDataStore):SetAsync(key, kills)
		end) then
			s.savedKills = kills
		end
	end
	return ok
end

function Data.release(p: Player)
	if slots[p] then
		Data.save(p)
		slots[p] = nil
	end
end

-- топ-10 недели: { {name, kills} }
local nameCache: { [number]: string } = {}
function Data.fetchTop(): { any }
	local out = {}
	local wk = Progress.week()
	local ok, pages = pcall(function()
		return DataStoreService:GetOrderedDataStore("CS_WeekKills_" .. wk):GetSortedAsync(false, 10)
	end)
	if not ok or not pages then
		return out
	end
	for _, e in (pages :: any):GetCurrentPage() do
		local uid = tonumber(string.match(e.key, "%d+")) or 0
		local name = nameCache[uid]
		if not name then
			local s, n = pcall(function()
				return Players:GetNameFromUserIdAsync(uid)
			end)
			name = if s and n then n else "?"
			nameCache[uid] = name
		end
		table.insert(out, { name, e.value })
	end
	return out
end

function Data.encode(t: any): string
	return HttpService:JSONEncode(t)
end

-- автосохранение раз в 90 с и при выключении сервера
task.spawn(function()
	while true do
		task.wait(90)
		for p, s in slots do
			if s.dirty then
				task.spawn(Data.save, p)
			end
		end
	end
end)
game:BindToClose(function()
	local left = 0
	for p in slots do
		left += 1
		task.spawn(function()
			Data.save(p)
			left -= 1
		end)
	end
	local t = os.clock()
	while left > 0 and os.clock() - t < 25 do
		task.wait(0.2)
	end
end)

return Data
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX0000000C"><Properties><string name="Name">WorldBuilder</string><ProtectedString name="Source"><![CDATA[--!strict
-- Строит мир по описанию World: океан, авианосцы, острова с полосами и флагами баз, свет и небо.
-- Всё из обычных деталей — никаких внешних моделей.
local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local World = require(ReplicatedStorage:WaitForChild("CarrierStrike"):WaitForChild("World"))

local WorldBuilder = {}

local function part(parent: Instance, name: string, size: Vector3, cf: CFrame, color: Color3, mat: Enum.Material?, shape: Enum.PartType?): Part
	local p = Instance.new("Part")
	p.Name = name
	p.Anchored = true
	p.CanCollide = false
	p.CanTouch = false
	p.CanQuery = false
	p.CastShadow = size.Magnitude < 2000
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	if shape then
		p.Shape = shape
	end
	p.Size = size
	p.CFrame = cf
	p.Color = color
	p.Material = mat or Enum.Material.SmoothPlastic
	p.Parent = parent
	return p
end

local function ellipsoid(parent: Instance, name: string, size: Vector3, cf: CFrame, color: Color3, mat: Enum.Material?): Part
	local p = part(parent, name, size, cf, color, mat)
	local m = Instance.new("SpecialMesh")
	m.MeshType = Enum.MeshType.Sphere
	m.Parent = p
	return p
end

-- плоский диск (цилиндр лёжа)
local function disc(parent: Instance, name: string, r: number, h: number, pos: Vector3, color: Color3, mat: Enum.Material?): Part
	r = math.min(r, 1024) -- предел размера детали в Roblox — 2048
	return part(parent, name, Vector3.new(h, r * 2, r * 2), CFrame.new(pos) * CFrame.Angles(0, 0, math.pi / 2), color, mat, Enum.PartType.Cylinder)
end

local Terrain = workspace.Terrain

local function ocean(f: Folder)
	-- настоящая вода Roblox (волны, отражения) над всей зоной боя, слоем 4 studs (быстрее грузится на телефонах)
	Terrain.WaterColor = Color3.fromRGB(22, 84, 118)
	Terrain.WaterTransparency = 0.35
	Terrain.WaterReflectance = 0.9
	Terrain.WaterWaveSize = 0.35
	Terrain.WaterWaveSpeed = 10
	local half = World.SIZE + 800
	local chunk = 2048
	local n = 0
	local x = -half
	while x < half do
		local z = -half
		while z < half do
			local sx = math.min(chunk, half - x)
			local sz = math.min(chunk, half - z)
			Terrain:FillBlock(CFrame.new(x + sx / 2, World.SEA - 2, z + sz / 2), Vector3.new(sx, 4, sz), Enum.Material.Water)
			n += 1
			if n % 8 == 0 then
				task.wait()
			end
			z += chunk
		end
		x += chunk
	end
	-- дно под водой и море за краем зоны: одна тёмная деталь (видимый размер растягивает SpecialMesh)
	local span = (World.SIZE + 12000) * 2
	local sea = part(f, "SeaFloor", Vector3.new(2048, 2, 2048), CFrame.new(0, World.SEA - 5, 0), Color3.fromRGB(16, 52, 80), Enum.Material.SmoothPlastic)
	sea.CastShadow = false
	local mesh = Instance.new("SpecialMesh")
	mesh.MeshType = Enum.MeshType.Brick
	mesh.Scale = Vector3.new(span / 2048, 1, span / 2048)
	mesh.Parent = sea
	-- море за краем зоны воды: 4 полосы вокруг (внутри зоны — настоящая вода)
	local function plane(cx: number, cz: number, sx: number, sz: number)
		local pl = part(f, "FarSea", Vector3.new(2048, 2, 2048), CFrame.new(cx, World.SEA - 1.2, cz), Color3.fromRGB(30, 86, 122), Enum.Material.SmoothPlastic)
		pl.CastShadow = false
		pl.Reflectance = 0.1
		local pm = Instance.new("SpecialMesh")
		pm.MeshType = Enum.MeshType.Brick
		pm.Scale = Vector3.new(sx / 2048, 1, sz / 2048)
		pm.Parent = pl
	end
	local outer = span / 2
	local band = outer - half
	plane(0, half + band / 2, outer * 2, band)
	plane(0, -half - band / 2, outer * 2, band)
	plane(half + band / 2, 0, band, half * 2)
	plane(-half - band / 2, 0, band, half * 2)
	-- граница зоны боя: светящиеся буи по периметру
	local s = World.SIZE
	for i = -4, 4 do
		for _, pos in { Vector3.new(i * s / 4, 6, -s), Vector3.new(i * s / 4, 6, s), Vector3.new(-s, 6, i * s / 4), Vector3.new(s, 6, i * s / 4) } do
			part(f, "Buoy", Vector3.new(10, 12, 10), CFrame.new(pos), Color3.fromRGB(255, 170, 40), Enum.Material.Neon, Enum.PartType.Cylinder)
		end
	end
end

local function carrier(f: Folder, c: any)
	local m = Instance.new("Model")
	m.Name = c.id
	local cf: CFrame = c.cf
	local W, L, H = World.DECK_W, World.DECK_L, World.DECK_H
	local hull = Color3.fromRGB(96, 104, 114)
	local deckCol = Color3.fromRGB(58, 62, 68)
	local teamCol = World.TEAM_COLOR[c.team]
	-- корпус: прямоугольная часть + клиновидный нос
	part(m, "Hull", Vector3.new(W * 0.8, H + 10, L * 0.86), cf * CFrame.new(0, (H - 10) / 2, L * 0.07), hull, Enum.Material.Metal)
	local bow = Instance.new("WedgePart")
	bow.Name = "Bow"
	bow.Anchored, bow.CanCollide, bow.CanTouch, bow.CanQuery = true, false, false, false
	bow.Size = Vector3.new(W * 0.8, H + 10, L * 0.14)
	bow.CFrame = cf * CFrame.new(0, (H - 10) / 2, -L / 2 + L * 0.07) * CFrame.Angles(0, math.pi, 0)
	bow.Color = hull
	bow.Material = Enum.Material.Metal
	bow.Parent = m
	-- полётная палуба шире корпуса
	part(m, "Deck", Vector3.new(W, 3, L), cf * CFrame.new(0, H - 1.5, 0), deckCol, Enum.Material.Asphalt)
	-- разметка: осевая и угловая палуба
	for i = 0, 15 do
		part(m, "Mark", Vector3.new(2, 0.2, 18), cf * CFrame.new(-30, H + 0.1, L / 2 - 30 - i * 40), Color3.fromRGB(235, 235, 235), Enum.Material.SmoothPlastic)
	end
	part(m, "AngleLine", Vector3.new(2.5, 0.2, L * 0.55), cf * CFrame.new(-18, H + 0.1, L * 0.18) * CFrame.Angles(0, math.rad(-9), 0), Color3.fromRGB(240, 210, 60))
	part(m, "AngleLine", Vector3.new(2.5, 0.2, L * 0.55), cf * CFrame.new(-62, H + 0.1, L * 0.18) * CFrame.Angles(0, math.rad(-9), 0), Color3.fromRGB(240, 210, 60))
	-- катапульты
	for _, x in { -30, 0 } do
		part(m, "Catapult", Vector3.new(1.5, 0.25, 220), cf * CFrame.new(x, H + 0.12, -L / 2 + 140), Color3.fromRGB(150, 150, 150), Enum.Material.Metal)
	end
	-- аэрофинишёры (тросы) у кормы
	for i = 0, 3 do
		part(m, "Wire", Vector3.new(80, 0.3, 0.6), cf * CFrame.new(-35, H + 0.2, L / 2 - 120 - i * 22) * CFrame.Angles(0, math.rad(-9), 0), Color3.fromRGB(30, 30, 30), Enum.Material.Metal)
	end
	-- надстройка
	local t = World.TOWER
	local tc = cf * CFrame.new((t.x0 + t.x1) / 2, H + t.h * 0.3, (t.z0 + t.z1) / 2)
	part(m, "Tower", Vector3.new(t.x1 - t.x0, t.h * 0.6, t.z1 - t.z0), tc, hull, Enum.Material.Metal)
	part(m, "Bridge", Vector3.new(t.x1 - t.x0 + 4, t.h * 0.18, (t.z1 - t.z0) * 0.7), cf * CFrame.new((t.x0 + t.x1) / 2, H + t.h * 0.69, (t.z0 + t.z1) / 2 - 8), Color3.fromRGB(80, 86, 94), Enum.Material.Metal)
	part(m, "Windows", Vector3.new(t.x1 - t.x0 + 4.4, 4, (t.z1 - t.z0) * 0.7 - 2), cf * CFrame.new((t.x0 + t.x1) / 2, H + t.h * 0.7, (t.z0 + t.z1) / 2 - 8), Color3.fromRGB(30, 40, 52), Enum.Material.Glass)
	part(m, "Mast", Vector3.new(3, t.h * 0.25, 3), cf * CFrame.new((t.x0 + t.x1) / 2, H + t.h * 0.9, (t.z0 + t.z1) / 2), Color3.fromRGB(70, 74, 80), Enum.Material.Metal)
	part(m, "Radar", Vector3.new(18, 6, 1.5), cf * CFrame.new((t.x0 + t.x1) / 2, H + t.h * 0.85, (t.z0 + t.z1) / 2 + 14), Color3.fromRGB(120, 126, 134), Enum.Material.Metal)
	-- полоса цвета команды по борту и огонь на мачте
	part(m, "TeamStripe", Vector3.new(W * 0.8 + 0.6, 4, L * 0.7), cf * CFrame.new(0, H - 8, L * 0.05), teamCol, Enum.Material.SmoothPlastic)
	local beacon = part(m, "Beacon", Vector3.new(4, 4, 4), cf * CFrame.new((t.x0 + t.x1) / 2, H + t.h + 2, (t.z0 + t.z1) / 2), teamCol, Enum.Material.Neon, Enum.PartType.Ball)
	local pl = Instance.new("PointLight")
	pl.Range = 60
	pl.Color = teamCol
	pl.Brightness = 3
	pl.Parent = beacon
	-- кильватерный след
	local wake = part(m, "Wake", Vector3.new(W * 0.9, 0.4, 900), cf * CFrame.new(0, World.SEA + 0.6, L / 2 + 450), Color3.fromRGB(200, 225, 240), Enum.Material.SmoothPlastic)
	wake.Transparency = 0.55
	-- табличка над кораблём
	local bb = Instance.new("BillboardGui")
	bb.Size = UDim2.fromOffset(260, 36)
	bb.StudsOffsetWorldSpace = Vector3.new(0, H + t.h + 30, 0)
	bb.MaxDistance = 30000
	bb.LightInfluence = 0
	bb.AlwaysOnTop = true
	local tl = Instance.new("TextLabel")
	tl.Size = UDim2.fromScale(1, 1)
	tl.BackgroundTransparency = 1
	tl.Text = "⚓ " .. c.name
	tl.TextColor3 = teamCol
	tl.TextStrokeTransparency = 0.3
	tl.Font = Enum.Font.GothamBold
	tl.TextScaled = true
	tl.Parent = bb
	bb.Parent = beacon
	m.Parent = f
end

local function island(f: Folder, i: any): BasePart
	local m = Instance.new("Model")
	m.Name = "Island_" .. i.id
	local sand = Color3.fromRGB(214, 196, 148)
	local grass = Color3.fromRGB(86, 128, 70)
	-- рельеф Roblox: отмель (бирюзовая вода), пляж, плато, холмы со скалами — та же форма, что в World.groundAt
	Terrain:FillCylinder(CFrame.new(i.x, World.SEA - 3.5, i.z), 3, i.r + World.BEACH + 260, Enum.Material.Sand)
	Terrain:FillCylinder(CFrame.new(i.x, World.SEA - 2.5, i.z), 11, i.r + World.BEACH, Enum.Material.Sand)
	Terrain:FillCylinder(CFrame.new(i.x, (i.h - 8) / 2, i.z), i.h + 8, i.r, Enum.Material.Grass)
	for _, hl in i.hills do
		local c = World.hillPos(i, hl)
		local R, Hh = hl[3], hl[4]
		local y = 0
		while y < Hh do
			local rr = R * math.sqrt(math.max(0, 1 - (y / Hh) ^ 2))
			if rr > 6 then
				local mat = if y > Hh * 0.62 then Enum.Material.Rock elseif y > Hh * 0.4 then Enum.Material.LeafyGrass else Enum.Material.Grass
				Terrain:FillCylinder(CFrame.new(c.X, i.h + y + 3, c.Z), 6, rr, mat)
			end
			y += 6
		end
	end
	task.wait()
	-- полоса
	local dir = World.runwayDir(i)
	local rcf = CFrame.lookAt(Vector3.new(i.x, i.h + 0.25, i.z), Vector3.new(i.x, i.h + 0.25, i.z) + dir)
	local rw = part(m, "RunwaySurface", Vector3.new(World.RUNWAY_W, 0.5, World.RUNWAY_LEN), rcf, Color3.fromRGB(48, 50, 54), Enum.Material.Asphalt)
	for k = -10, 10 do
		part(m, "Mark", Vector3.new(1.5, 0.2, 22), rcf * CFrame.new(0, 0.35, k * 50), Color3.fromRGB(235, 235, 235))
	end
	for _, s in { -1, 1 } do
		for k = -3, 3 do
			part(m, "Threshold", Vector3.new(4, 0.2, 40), rcf * CFrame.new(k * 8, 0.35, s * (World.RUNWAY_LEN / 2 - 30)), Color3.fromRGB(235, 235, 235))
		end
	end
	-- ангары и вышка в стороне от полосы
	local side = Vector3.new(-dir.Z, 0, dir.X)
	for k = -1, 1 do
		local hp = Vector3.new(i.x, i.h, i.z) + side * 110 + dir * (k * 120)
		part(m, "Hangar", Vector3.new(70, 26, 60), CFrame.lookAt(hp + Vector3.new(0, 13, 0), hp + Vector3.new(0, 13, 0) + dir), Color3.fromRGB(150, 156, 160), Enum.Material.CorrodedMetal)
	end
	-- флагшток базы: цвет флага = владелец (меняет сервер)
	local fp = Vector3.new(i.x, i.h, i.z) - side * 120
	part(m, "Pole", Vector3.new(2, 60, 2), CFrame.new(fp + Vector3.new(0, 30, 0)), Color3.fromRGB(210, 210, 210), Enum.Material.Metal)
	local flag = part(m, "Flag", Vector3.new(1, 18, 30), CFrame.new(fp + Vector3.new(0, 50, 15)), World.TEAM_COLOR[i.owner], Enum.Material.Neon)
	flag.Name = "Flag"
	-- граница зоны захвата: кольцо светящихся буёв (видно с воздуха)
	local ring = Instance.new("Model")
	ring.Name = "CaptureRing"
	for k = 0, 23 do
		local a = k / 24 * math.pi * 2
		local bp = Vector3.new(i.x + math.cos(a) * World.CAPTURE_R, World.SEA + 4, i.z + math.sin(a) * World.CAPTURE_R)
		part(ring, "RingBuoy", Vector3.new(8, 8, 8), CFrame.new(bp), World.TEAM_COLOR[i.owner], Enum.Material.Neon, Enum.PartType.Ball).CastShadow = false
	end
	ring.Parent = m
	local bb = Instance.new("BillboardGui")
	bb.Name = "Label"
	bb.Size = UDim2.fromOffset(200, 34)
	bb.StudsOffsetWorldSpace = Vector3.new(0, 40, 0)
	bb.MaxDistance = 30000
	bb.AlwaysOnTop = true
	bb.LightInfluence = 0
	local tl = Instance.new("TextLabel")
	tl.Name = "Text"
	tl.Size = UDim2.fromScale(1, 1)
	tl.BackgroundTransparency = 1
	tl.Text = "◆ База " .. i.name
	tl.TextColor3 = World.TEAM_COLOR[i.owner]
	tl.TextStrokeTransparency = 0.3
	tl.Font = Enum.Font.GothamBold
	tl.TextScaled = true
	tl.Parent = bb
	bb.Parent = flag
	m.Parent = f
	return flag
end

-- перекрасить базу под владельца
function WorldBuilder.setOwner(id: string, owner: string)
	local f = workspace:FindFirstChild("CarrierStrikeWorld")
	local m = f and f:FindFirstChild("Island_" .. id)
	if not m then
		return
	end
	local col = World.TEAM_COLOR[owner] or World.TEAM_COLOR[""]
	local flag = m:FindFirstChild("Flag") :: BasePart?
	local ring = m:FindFirstChild("CaptureRing")
	if flag then
		flag.Color = col
		local lbl = flag:FindFirstChild("Label")
		local t = lbl and lbl:FindFirstChild("Text") :: TextLabel?
		if t then
			t.TextColor3 = col
		end
	end
	if ring then
		for _, b in ring:GetChildren() do
			(b :: BasePart).Color = col
		end
	end
end

function WorldBuilder.build()
	local f = Instance.new("Folder")
	f.Name = "CarrierStrikeWorld"
	ocean(f)
	for _, c in World.CARRIERS do
		carrier(f, c)
	end
	for _, i in World.ISLANDS do
		island(f, i)
	end
	f.Parent = workspace

	-- свет: золотой час над морем (как на обложках), лёгкая дымка — острова видно издалека
	Lighting.ClockTime = 17.3
	Lighting.GeographicLatitude = 25
	Lighting.Brightness = 2.6
	Lighting.Ambient = Color3.fromRGB(80, 74, 90)
	Lighting.OutdoorAmbient = Color3.fromRGB(140, 120, 130)
	Lighting.EnvironmentDiffuseScale = 0.7
	Lighting.EnvironmentSpecularScale = 1
	Lighting.GlobalShadows = true
	local sky = Instance.new("Sky")
	sky.SunAngularSize = 18
	sky.Parent = Lighting
	local atm = Instance.new("Atmosphere")
	atm.Density = 0.1
	atm.Offset = 0.05
	atm.Color = Color3.fromRGB(255, 206, 170)
	atm.Decay = Color3.fromRGB(140, 100, 120)
	atm.Glare = 0.6
	atm.Haze = 0.8
	atm.Parent = Lighting
	local rays = Instance.new("SunRaysEffect")
	rays.Intensity = 0.06
	rays.Spread = 0.6
	rays.Parent = Lighting
	local bloom = Instance.new("BloomEffect")
	bloom.Intensity = 0.4
	bloom.Size = 30
	bloom.Threshold = 1.6
	bloom.Parent = Lighting
	local cc = Instance.new("ColorCorrectionEffect")
	cc.Contrast = 0.06
	cc.Saturation = 0.08
	cc.Parent = Lighting
	local clouds = Instance.new("Clouds")
	clouds.Cover = 0.5
	clouds.Density = 0.6
	clouds.Parent = workspace.Terrain
end

return WorldBuilder
]]></ProtectedString></Properties></Item>
</Item>
</Item>
<Item class="StarterPlayer" referent="RBX00000017"><Properties><string name="Name">StarterPlayer</string><bool name="EnableMouseLockOption">false</bool><float name="CameraMaxZoomDistance">400</float></Properties><Item class="StarterPlayerScripts" referent="RBX00000016"><Properties><string name="Name">StarterPlayerScripts</string></Properties><Item class="LocalScript" referent="RBX00000012"><Properties><string name="Name">CarrierStrikeClient</string><ProtectedString name="Source"><![CDATA[--!strict
-- Carrier Strike — клиент: меню (3D-витрина самолёта на палубе), прогресс, быстрый старт, обучение,
-- локальная физика своего самолёта (как в Sky Pilot), катапульта и тросы, пушка/ракеты/ловушки,
-- метки, радар, звуки, награды, итоги раунда, кинокамера для обложек (только в Studio, клавиша K).
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local HttpService = game:GetService("HttpService")
local SocialService = game:GetService("SocialService")
local MarketplaceService = game:GetService("MarketplaceService")

local player = Players.LocalPlayer
local Shared = ReplicatedStorage:WaitForChild("CarrierStrike")
local World = require(Shared:WaitForChild("World"))
local Jets = require(Shared:WaitForChild("Jets"))
local Progress = require(Shared:WaitForChild("Progress"))
local Config = require(Shared:WaitForChild("Config"))
local Lang = require(Shared:WaitForChild("Lang"))
local FlightPhysics = require(Shared:WaitForChild("FlightPhysics"))
local JetModel = require(Shared:WaitForChild("JetModel"))
local R = ReplicatedStorage:WaitForChild("CSRemotes")
local match = ReplicatedStorage:WaitForChild("CSMatch")

local Hud = require(script:WaitForChild("Hud"))
local Controls = require(script:WaitForChild("Controls"))
local CameraRig = require(script:WaitForChild("CameraRig"))
local Animator = require(script:WaitForChild("Animator"))

local function ev(name: string): RemoteEvent
	return R:WaitForChild(name) :: RemoteEvent
end
local SpawnR, StartedR, ReadyR, StateR = ev("Spawn"), ev("Started"), ev("Ready"), ev("State")
local GunR, MissileR, FlareR, CrashR = ev("Gun"), ev("Missile"), ev("Flare"), ev("Crash")
local RearmR, LeaveR, KilledR, NotifyR = ev("Rearm"), ev("Leave"), ev("Killed"), ev("Notify")
local FeedR, WarnR, HitR = ev("Feed"), ev("Warn"), ev("Hit")
local ProfileR, RewardR, BuyR, DailyR, TutR, RoundR = ev("Profile"), ev("Reward"), ev("Buy"), ev("ClaimDaily"), ev("TutorialDone"), ev("RoundEnd")

-- ===== язык: русский для русскоязычных, иначе английский
local lang = Lang.pick(player.LocaleId)
local function L(key: string, ...: any): string
	return Lang.t(lang, key, ...)
end

local ui = Hud.new(L)
local cameraRig = CameraRig.new(ui)

local function mySide(): string
	local t = player.Team
	local s = t and t:GetAttribute("Side")
	return if type(s) == "string" then s else "Blue"
end

-- персонаж в этой игре не ходит: только сидит в кабине
local controlsModule: any = nil
local function setCharacterControls(enabled: boolean)
	if not controlsModule then
		local ok, pm = pcall(function()
			return require(player:WaitForChild("PlayerScripts"):WaitForChild("PlayerModule") :: ModuleScript) :: any
		end)
		if ok and pm then
			controlsModule = pm:GetControls()
		end
	end
	if controlsModule then
		if enabled then
			controlsModule:Enable()
		else
			controlsModule:Disable()
		end
	end
end
task.spawn(setCharacterControls, false)

-- ===== звуки (id в Config.SOUNDS; пусто — без звука)
local sounds: { [string]: Sound } = {}
local function sound(name: string, looped: boolean?, vol: number?): Sound?
	local id = (Config.SOUNDS :: any)[name]
	if type(id) ~= "string" or id == "" then
		return nil
	end
	local s = sounds[name]
	if not s then
		s = Instance.new("Sound")
		s.SoundId = id
		s.Looped = looped == true
		s.Volume = vol or 0.6
		s.Parent = workspace.CurrentCamera
		sounds[name] = s
	end
	return s
end
local function play(name: string, vol: number?)
	local s = sound(name, false, vol)
	if s then
		s.TimePosition = 0
		s:Play()
	end
end

-- ===== состояние
local flight: any = nil
local model: Model? = nil
local root: BasePart? = nil
local cfg: any = nil
local simulating = false
local parkBrake = false
local assist = false -- катапульта / ускоритель взлёта
local crashPose: CFrame? = nil
local deadUntil = 0
local lastSync = 0
local lastShot = 0
local lastRearm = 0
local lock = { target = nil :: Model?, t = 0, beeped = false }
local incoming: { BasePart } = {}
local inMenu = true
local profile: any = nil
local dailyShown = false
local tut = { on = false, step = 0, t = 0, hit = false, msl = false }
local cine = { on = false, shot = 0, t = 0 }

-- ===== витрина в меню: выбранный самолёт стоит на палубе своего авианосца
local preview: Model? = nil
local previewKey = ""
local function paintCfg(c: any, side: string, paintId: string): any
	local out = table.clone(c)
	out.colors = table.clone(c.colors)
	local team = if side == "Blue" then Color3.fromRGB(46, 104, 170) else Color3.fromRGB(170, 52, 46)
	local pt = Progress.paint(paintId)
	if pt and pt.body then
		out.colors.body = pt.body
		out.colors.accent = pt.accent
	else
		out.colors.accent = team
	end
	out.colors.tail = team
	out.paintId = paintId
	return out
end
local previewJet, previewPaint = "F16", "team"
local function buildPreview()
	local key = previewJet .. "|" .. previewPaint .. "|" .. mySide()
	if key == previewKey and preview and preview.Parent then
		return
	end
	previewKey = key
	if preview then
		preview:Destroy()
	end
	local c = Jets.JETS[previewJet]
	if not c then
		return
	end
	local m = JetModel.build(paintCfg(c, mySide(), previewPaint), { static = true })
	local carrier = World.carrierOf(mySide())
	m:PivotTo(carrier.cf * CFrame.new(-30, World.DECK_H + c.gearHeight, 40) * CFrame.Angles(0, math.rad(-25), 0))
	m.Name = "Preview"
	m.Parent = workspace
	preview = m
end
-- карточки ангара: 3D-модели (без земли и меток — static); ждём, пока сервер разложит импортированные модели
JetModel.wait(6)
ui.setJets(Jets.ORDER, Jets.JETS, Progress, function(id: string, paint: string): Model?
	local c = Jets.JETS[id]
	if not c then
		return nil
	end
	return JetModel.build(paintCfg(c, mySide(), paint), { static = true })
end)
ui.on("select", function(jet: string, paint: string)
	previewJet, previewPaint = jet, paint
	if inMenu then
		buildPreview()
	end
end)

-- ===== меню: точки вылета, счёт
local function refreshMenu()
	local side = mySide()
	ui.setTeam(side)
	local list = {
		{ id = "deck:" .. side, title = "⚓ " .. L("sp_deck"), sub = L("sp_deck_sub"), ok = true },
		{ id = "air:" .. side, title = "✈ " .. L("sp_air"), sub = L("sp_air_sub"), ok = true },
	}
	for _, i in World.ISLANDS do
		local owner = match:GetAttribute("Owner_" .. i.id) or i.owner
		local ok = owner == side
		table.insert(list, {
			id = "base:" .. i.id, title = "◆ " .. L("sp_base", L("base_" .. i.id)),
			sub = if ok then L("sp_base_ok") elseif owner == "" then L("sp_base_neutral") else L("sp_base_enemy"), ok = ok,
		})
	end
	ui.setSpawns(list)
	buildPreview()
end

local function refreshMatch()
	local b = match:GetAttribute("TicketsBlue") or 0
	local r = match:GetAttribute("TicketsRed") or 0
	ui.setTickets(b, r)
	local bases = {}
	for _, i in World.ISLANDS do
		local owner = match:GetAttribute("Owner_" .. i.id) or i.owner
		table.insert(bases, { id = i.id, owner = owner, cap = match:GetAttribute("Cap_" .. i.id) or 0 })
	end
	ui.setBases(bases)
end
local lastSpawnRefresh = 0
match.AttributeChanged:Connect(function(name: string)
	refreshMatch()
	if name == "Top" then
		local ok, list = pcall(function()
			return HttpService:JSONDecode(match:GetAttribute("Top") or "[]")
		end)
		ui.setTop(if ok and type(list) == "table" then list else {}, profile and profile.week or 0)
	elseif name:sub(1, 6) == "Owner_" and inMenu and os.clock() - lastSpawnRefresh > 0.5 then
		lastSpawnRefresh = os.clock()
		refreshMenu()
	end
end)
player:GetPropertyChangedSignal("Team"):Connect(refreshMenu)
refreshMatch()
refreshMenu()
ui.setTop({}, 0)

ui.on("launch", function(jetId: string, spawnId: string, paint: string)
	SpawnR:FireServer(jetId, spawnId, paint)
end)
ui.on("quick", function(jetId: string, paint: string)
	SpawnR:FireServer(jetId, "air:" .. mySide(), paint)
end)
ui.on("buy", function(kind: string, id: string)
	BuyR:FireServer(kind, id)
end)
ui.on("daily", function()
	DailyR:FireServer()
end)
ui.on("invite", function()
	local ok, can = pcall(function()
		return SocialService:CanSendGameInviteAsync(player)
	end)
	if ok and can then
		pcall(function()
			SocialService:PromptGameInvite(player)
		end)
	else
		ui.toast(L("invite_fail"), "amber")
	end
end)
ui.on("shop", function(kind: string, id: number)
	if kind == "vip" and id > 0 then
		MarketplaceService:PromptGamePassPurchase(player, id)
	elseif kind == "coins" and id > 0 then
		MarketplaceService:PromptProductPurchase(player, id)
	elseif kind == "vip" then
		ui.toast(L("soon"), "amber")
	end
end)

-- ===== прогресс с сервера
ProfileR.OnClientEvent:Connect(function(p: any)
	profile = p
	ui.setProfile(p)
	ui.setQuickSub(if p.tut then L("play_sub") else L("play_sub_new"))
	if p.daily.can and not dailyShown and inMenu then
		dailyShown = true
		task.delay(1.2, function()
			if inMenu and profile and profile.daily.can then
				ui.showDaily()
			end
		end)
	end
end)
RewardR.OnClientEvent:Connect(function(coins: number, xp: number, key: string)
	local k = if key:sub(1, 6) == "quest_" then "r_quest" else "r_" .. key
	ui.reward(coins, xp, L(k))
	play("reward", 0.5)
end)
NotifyR.OnClientEvent:Connect(function(key: string, colr: string?, ...: any)
	local args = { ... }
	if key == "bought" then
		args = { Jets.JETS[args[1]] and Jets.JETS[args[1]].name or tostring(args[1]) }
	end
	local text = L("n_" .. key, table.unpack(args))
	if key == "levelup" or key == "quest_done" then
		ui.banner(text, Hud.C.gold)
	else
		ui.toast(text, colr)
	end
end)
RoundR.OnClientEvent:Connect(function(winner: string, mvp: { any })
	ui.showRound(winner, mvp, mySide(), 15)
end)

-- ===== начало и конец вылета
local function stopFlight()
	flight, model, root, cfg, simulating, crashPose = nil, nil, nil, nil, false, nil
	assist, parkBrake = false, false
	lock.target, lock.t = nil, 0
	table.clear(incoming)
	Animator.setLocal(nil)
	ui.setFlying(false)
	ui.showMenu(true)
	ui.tutorial(nil)
	inMenu = true
	local eng = sounds.engine
	if eng then
		eng:Stop()
	end
	local mus = sound("music", true, 0.35)
	if mus and not mus.IsPlaying then
		mus:Play()
	end
	refreshMenu()
end

local function die(text: string)
	if flight and not flight.crashed then
		flight.crashed = true
	end
	if flight then
		crashPose = FlightPhysics.pose(flight)
	end
	deadUntil = os.clock() + 4
	ui.showDead(text)
	ui.tutorial(nil)
	task.delay(4, function()
		if os.clock() >= deadUntil - 0.05 then
			ui.showDead(nil)
			stopFlight()
		end
	end)
end

StartedR.OnClientEvent:Connect(function(m: Model, jetId: string, spawnCF: CFrame, air: boolean)
	local c = Jets.JETS[jetId]
	if not c or not m then
		return
	end
	cfg = c
	model = m
	root = m:WaitForChild("Root", 5) :: BasePart?
	local f = FlightPhysics.new(c, spawnCF, air)
	f.hard = false
	if air then
		f.speed = math.min(c.maxKts * 0.6, 430)
		f.vel = spawnCF.LookVector * f.speed
		f.throttle = 0.85
		f.gear = false
	end
	flight = f
	simulating = false
	crashPose = nil
	parkBrake = not air
	assist = false
	inMenu = false
	if preview then
		preview:Destroy()
		preview = nil
		previewKey = ""
	end
	ui.closeModal()
	ui.showMenu(false)
	ui.showDead(nil)
	ui.setFlying(true)
	ui.setThrottleKnob(f.throttle)
	cameraRig.reset(spawnCF.Rotation, c)
	Animator.setLocal(m, f.gear, 0, f.throttle)
	setCharacterControls(false)
	local mus = sounds.music
	if mus then
		mus:Stop()
	end
	local eng = sound("engine", true, 0.45)
	if eng then
		eng:Play()
	end
	if air then
		ui.toast(L("t_air"), "accent")
	elseif World.runwayAt(spawnCF.Position.X, spawnCF.Position.Z, 5) == World.carrierOf(mySide()).id then
		ui.toast(L("t_catapult"), "accent")
	else
		ui.toast(L("t_runway"), "accent")
	end
	-- обучение новичка
	if profile and not profile.tut then
		tut.on, tut.step, tut.t, tut.hit, tut.msl = true, 1, 0, false, false
	end
	ReadyR:FireServer(m)
end)

KilledR.OnClientEvent:Connect(function(killer: string, weapon: string)
	if flight then
		if weapon == "round" then
			die(L("round_new"))
		elseif killer ~= "" then
			die(L("killed_by", killer, L("w_" .. weapon)))
		else
			die(L("killed_" .. weapon))
		end
	end
end)
FeedR.OnClientEvent:Connect(function(kind: string, d: any)
	local C = World.TEAM_COLOR
	if kind == "kill" then
		if d.k ~= "" then
			ui.feed(string.format("%s  [%s]  %s", d.k, L("w_" .. d.w), d.v), C[d.ks] or Hud.C.text)
		else
			ui.feed(string.format("%s  [%s]", d.v, L("w_" .. d.w)), C[d.vs] or Hud.C.text)
		end
	elseif kind == "crash" then
		ui.feed(string.format("%s  [%s]", d.v, L("crash_" .. d.why)), C[d.vs] or Hud.C.text)
	elseif kind == "cap" then
		ui.feed(L("f_cap", L("team_" .. d.side), L("base_" .. d.base)), C[d.side] or Hud.C.text)
		if d.side == mySide() and flight then
			ui.banner(L("f_cap", L("team_" .. d.side), L("base_" .. d.base)), C[d.side])
		end
	elseif kind == "neutral" then
		ui.feed(L("f_neutral", L("base_" .. d.base)), Hud.C.text)
	elseif kind == "streak" then
		ui.feed(L("f_streak", d.k, d.n), Hud.C.gold)
		if model and d.k == model:GetAttribute("Pilot") then
			ui.banner(L("streak_n", d.n), Hud.C.gold)
		end
	end
end)
HitR.OnClientEvent:Connect(function(_m: Model, kill: boolean)
	ui.hit(kill)
	play("hit", 0.5)
	tut.hit = true
end)
WarnR.OnClientEvent:Connect(function(part: BasePart)
	table.insert(incoming, part)
	play("warn", 0.6)
end)

-- ===== цели
local function enemies(): { Model }
	local out = {}
	local folder = workspace:FindFirstChild("Planes")
	if not folder then
		return out
	end
	local side = mySide()
	for _, m in folder:GetChildren() do
		if m:IsA("Model") and m ~= model and m.Name ~= "Wreck" and m.PrimaryPart and m:GetAttribute("Side") ~= side and (m:GetAttribute("HP") or 0) > 0 then
			table.insert(out, m)
		end
	end
	return out
end

local function bestInCone(look: Vector3, from: Vector3, deg: number, range: number): Model?
	local best, bestA = nil, math.cos(math.rad(deg))
	for _, m in enemies() do
		local d = (m.PrimaryPart :: BasePart).Position - from
		local dist = d.Magnitude
		if dist < range and dist > 1 then
			local c = look:Dot(d / dist)
			if c > bestA then
				best, bestA = m, c
			end
		end
	end
	return best
end

-- ===== эффекты: трассеры и ловушки (только у себя на экране)
type Fx = { part: BasePart, vel: Vector3, t: number, life: number, grav: number }
local fx: { Fx } = {}
local fxFolder = Instance.new("Folder")
fxFolder.Name = "LocalFx"
fxFolder.Parent = workspace
local function addFx(size: Vector3, cf: CFrame, color: Color3, vel: Vector3, life: number, grav: number)
	if #fx > 160 then
		return
	end
	local p = Instance.new("Part")
	p.Anchored, p.CanCollide, p.CanQuery, p.CanTouch, p.CastShadow = true, false, false, false, false
	p.Material = Enum.Material.Neon
	p.Color = color
	p.Size = size
	p.CFrame = cf
	p.Parent = fxFolder
	table.insert(fx, { part = p, vel = vel, t = 0, life = life, grav = grav })
end
local function tracer(from: CFrame, speed: number)
	addFx(Vector3.new(0.35, 0.35, 26), from * CFrame.new(0, 0, -20), Color3.fromRGB(255, 214, 120), from.LookVector * (2600 + speed), 0.7, 0)
end
local function flaresFx(cf: CFrame)
	for k = 1, 6 do
		local side = if k % 2 == 0 then 1 else -1
		local v = cf.RightVector * side * (30 + k * 8) - cf.UpVector * 20 - cf.LookVector * 40
		addFx(Vector3.new(2.2, 2.2, 2.2), cf * CFrame.new(0, -2, 10), Color3.fromRGB(255, 236, 170), v, 1.8, 30)
	end
end
local seenFlare: { [Model]: number } = {}
local lastTracer: { [Model]: number } = {}

local function lockNeed(m: Model): number
	local j = Jets.JETS[m:GetAttribute("PlaneId") :: any]
	return Jets.MSL_LOCK * (if j then j.lockMul else 1)
end

-- ===== действия (клавиши, геймпад и сенсорные кнопки — один обработчик)
local controls: any = nil
local function act(a: string)
	local f = flight
	if a == "cam" then
		cameraRig.cycle()
		ui.toast(L("cam_" .. tostring(cameraRig.mode)))
		return
	end
	if a == "cine" then
		if RunService:IsStudio() then
			cine.on = not cine.on
			cine.shot = (cine.shot % 4) + 1
			cine.t = 0
			ui.hideAll(cine.on)
		end
		return
	end
	if not f or f.crashed then
		return
	end
	if a == "missile" then
		if lock.target and lock.t >= lockNeed(lock.target) then
			if ((model and model:GetAttribute("Missiles")) or 0) > 0 then
				MissileR:FireServer(lock.target)
				lock.t = 0
				lock.beeped = false
				tut.msl = true
				play("missile", 0.7)
				ui.toast(L("t_fired"), "amber")
			else
				ui.toast(L("t_no_msl"), "amber")
			end
			return
		end
		ui.toast(L("t_no_lock"), "amber")
	elseif a == "flare" then
		FlareR:FireServer()
	elseif a == "gear" then
		if f.onGround and f.gear then
			ui.toast(L("gear_ground"), "amber")
		else
			FlightPhysics.action(f, "gear")
			ui.toast(if f.gear then L("gear_down") else L("gear_up"))
		end
	elseif a == "mouse" then
		controls.mouseYoke = not controls.mouseYoke
		ui.toast(if controls.mouseYoke then L("mouse_on") else L("mouse_off"))
	elseif a == "brake" then
		ui.touch.brake = not ui.touch.brake
		ui.toast(if ui.touch.brake then L("brake_on") else L("brake_off"))
	elseif a == "idle" then
		FlightPhysics.action(f, "idle")
		ui.setThrottleKnob(0)
	elseif a == "menu" then
		if f.onGround and f.speed < 25 then
			LeaveR:FireServer()
			stopFlight()
		else
			ui.toast(L("menu_ground"), "amber")
		end
	end
end
controls = Controls.new(ui, act)
ui.onAction(function(a: string)
	if a ~= "gun" then
		act(a)
	end
end)

local function crashKind(reason: string?): string
	local r = reason or ""
	if r:find("океан") then
		return "water"
	elseif r:find("авианос") then
		return "carrier"
	end
	return "ground"
end

-- ===== физика: каждый шаг перед симуляцией Roblox
RunService.PreSimulation:Connect(function(dt)
	local f = flight
	local r = root
	if not f or f.crashed or not r or not model then
		return
	end
	if not simulating then
		if r.Anchored then
			return
		end
		simulating = true
	end
	if not model.Parent or model.Name == "Wreck" then
		die(L("destroyed"))
		return
	end
	local input = controls.read()
	if input.throttle then
		ui.setThrottleKnob(input.throttle)
	end
	-- на телефоне самолёт сам выравнивает крен, когда стик отпущен (проще для новичков)
	if ui.isTouch and not ui.touch.active and not f.onGround then
		local bank = math.asin(math.clamp(-f.att.RightVector.Y, -1, 1))
		input.r += math.clamp(-bank * 1.2, -0.6, 0.6)
	end
	if parkBrake then
		input.brakes = true
		if f.throttle >= 0.9 or (input.throttle and input.throttle >= 0.9) then
			parkBrake = false
			assist = true
			ui.toast(L("t_go"), "accent")
		end
	end
	if assist and f.onGround and f.speed >= cfg.vrKts then
		input.p = math.max(input.p, 0.35) -- автоматический отрыв носа
	end
	FlightPhysics.step(f, input, dt)
	if assist then
		if f.onGround then
			f.speed = math.min(f.speed + 110 * dt, cfg.vrKts + 40)
		else
			assist = false
		end
	end
	-- аэрофинишёр: на палубе при малой тяге самолёт быстро тормозит
	if f.onGround and not assist and f.speed > 5 then
		local where = World.runwayAt(f.pos.X, f.pos.Z, 0)
		if where and where:sub(1, 3) == "CV_" and f.throttle < 0.5 then
			f.speed = math.max(0, f.speed - 70 * dt)
		end
	end
	if not f.crashed and f.pos.Y < World.SEA + 1 and World.isWater(f.pos.X, f.pos.Z) then
		f.crashed = true
		f.crashReason = "Упал в океан!"
	end
	if f.crashed then
		local kind = crashKind(f.crashReason)
		CrashR:FireServer(kind)
		die(L("crash_" .. kind))
		return
	end
	r.CFrame = FlightPhysics.pose(f)
	r.AssemblyLinearVelocity = f.vel
	r.AssemblyAngularVelocity = Vector3.zero
	Animator.setLocal(model, f.gear, f.flaps, f.throttle)
	Animator.setInputs(f.inP, f.inR, f.inY)
	local eng = sounds.engine
	if eng then
		eng.PlaybackSpeed = 0.7 + f.throttle * 0.6
	end
	local now = os.clock()
	if now - lastSync > 0.25 then
		lastSync = now
		StateR:FireServer(f.gear, f.throttle)
	end
end)

-- ===== обучение: короткие шаги в первом вылете
local TUT_STEPS = { "tut1", "tut2", "tut3", "tut4" }
local function tutorialTick(dt: number, f: any)
	if not tut.on then
		return
	end
	tut.t += dt
	local s = tut.step
	local nextStep = (s == 1 and (tut.t > 7 or (tut.t > 3 and (math.abs(f.inR) > 0.3 or math.abs(f.inP) > 0.3))))
		or (s == 2 and (tut.hit or tut.t > 22))
		or (s == 3 and (tut.msl or tut.t > 18))
		or (s == 4 and tut.t > 10)
	if nextStep then
		tut.step += 1
		tut.t = 0
		if tut.step > #TUT_STEPS then
			tut.on = false
			ui.tutorial(nil)
			ui.banner(L("tut_done"), Hud.C.green)
			TutR:FireServer()
			return
		end
	end
	local key = TUT_STEPS[tut.step]
	ui.tutorial(L(key .. (if ui.isTouch then "_t" else "")))
end

-- ===== кадр: камера, оружие, приборы
local function fmtDist(d: number): string
	local m = d * 0.515
	return if m >= 1000 then string.format("%.1f km", m / 1000) else string.format("%d m", math.round(m / 10) * 10)
end

local function cinematic(dt: number, cam: Camera)
	cine.t += dt
	local c = World.carrierOf(mySide())
	local folder = workspace:FindFirstChild("Planes")
	local subject: BasePart? = nil
	if model and model.PrimaryPart then
		subject = model.PrimaryPart
	elseif folder then
		for _, m in folder:GetChildren() do
			if m:IsA("Model") and m.PrimaryPart and m.Name ~= "Wreck" then
				subject = m.PrimaryPart
				break
			end
		end
	end
	cam.CameraType = Enum.CameraType.Scriptable
	if cine.shot == 1 and subject then
		-- низко сбоку от самолёта, длинный фокус
		local p = subject.Position
		local cf = subject.CFrame
		cam.FieldOfView = 30
		cam.CFrame = CFrame.lookAt(p + cf.RightVector * 90 + cf.UpVector * 12 - cf.LookVector * 30, p)
	elseif cine.shot == 2 and subject then
		-- сзади-сверху, видно море и остров
		local cf = subject.CFrame
		cam.FieldOfView = 55
		cam.CFrame = CFrame.lookAt(cf.Position - cf.LookVector * 70 + Vector3.new(0, 25, 0), cf.Position + cf.LookVector * 400)
	elseif cine.shot == 3 then
		-- авианосец с воздуха, медленный облёт
		local a = cine.t / 20
		local center = c.cf.Position + Vector3.new(0, World.DECK_H, 0)
		cam.FieldOfView = 40
		cam.CFrame = CFrame.lookAt(center + Vector3.new(math.sin(a) * 900, 320, math.cos(a) * 900), center)
	else
		-- остров «Центр» на закате
		local a = cine.t / 25
		cam.FieldOfView = 45
		cam.CFrame = CFrame.lookAt(Vector3.new(math.sin(a) * 2600, 500, math.cos(a) * 2600), Vector3.new(0, 80, 0))
	end
end

RunService:BindToRenderStep("CarrierStrike", Enum.RenderPriority.Camera.Value + 1, function(dt)
	local now = os.clock()
	Animator.step(dt, now)
	local cam = workspace.CurrentCamera
	local serverNow = workspace:GetServerTimeNow()

	for i = #fx, 1, -1 do
		local e = fx[i]
		e.t += dt
		if e.t >= e.life then
			e.part:Destroy()
			table.remove(fx, i)
		else
			e.vel -= Vector3.new(0, e.grav * dt, 0)
			e.part.CFrame = e.part.CFrame + e.vel * dt
			if e.grav > 0 then
				e.part.Transparency = e.t / e.life
			end
		end
	end
	local folder = workspace:FindFirstChild("Planes")
	if folder then
		for _, m in folder:GetChildren() do
			if m:IsA("Model") and m.PrimaryPart and m.Name ~= "Wreck" then
				local fu = m:GetAttribute("FiringUntil")
				if m ~= model and type(fu) == "number" and fu > serverNow and now - (lastTracer[m] or 0) > 0.09 then
					lastTracer[m] = now
					tracer(m.PrimaryPart.CFrame, m.PrimaryPart.AssemblyLinearVelocity.Magnitude)
				end
				local fa = m:GetAttribute("FlareAt")
				if type(fa) == "number" and seenFlare[m] ~= fa then
					local first = seenFlare[m] == nil
					seenFlare[m] = fa
					if not first or serverNow - fa < 1 then
						flaresFx(m.PrimaryPart.CFrame)
					end
				end
			end
		end
	end

	if cine.on then
		cinematic(dt, cam)
		return
	end

	local f = flight
	if not f then
		-- меню: медленный облёт самолёта на палубе (самолёт смещён вправо от меню)
		local c = World.carrierOf(mySide())
		local target = if preview and preview.PrimaryPart then preview.PrimaryPart.Position else c.cf.Position + Vector3.new(0, World.DECK_H + 10, 0)
		local L0 = (Jets.JETS[previewJet] or Jets.JETS.F16).length
		local a = now / 18
		local r = L0 * 1.5 + 34
		local eye = target + Vector3.new(math.sin(a) * r, 10 + L0 * 0.18 + math.sin(a * 0.7) * 4, math.cos(a) * r)
		local look = CFrame.lookAt(eye, target)
		cam.CameraType = Enum.CameraType.Scriptable
		cam.FieldOfView = 50
		cam.CFrame = CFrame.lookAt(eye, target - look.RightVector * L0 * 0.45)
		return
	end
	if f.crashed then
		cameraRig.update(dt, crashPose or FlightPhysics.pose(f), f.cfg, 0, false, true)
		return
	end
	local pose = if root and simulating then (root :: BasePart).CFrame else FlightPhysics.pose(f)
	cameraRig.update(dt, pose, f.cfg, f.speed, f.onGround, false, f.buffet)
	tutorialTick(dt, f)

	-- пушка (на телефоне конус шире — помощь прицеливания)
	local cone = if ui.isTouch then Jets.GUN_CONE_TOUCH else Jets.GUN_CONE
	if simulating and controls.firing() and now - lastShot >= Jets.GUN_RATE then
		lastShot = now
		local t = bestInCone(f.att.LookVector, f.pos, cone, Jets.GUN_RANGE)
		GunR:FireServer(t)
		tracer(FlightPhysics.pose(f) * CFrame.new(if math.random() < 0.5 then 1.5 else -1.5, 0, -f.cfg.length * 0.5), f.speed)
		play("gun", 0.35)
	end

	-- захват ракетой
	local cand = bestInCone(f.att.LookVector, f.pos, Jets.MSL_CONE, Jets.MSL_RANGE)
	if cand ~= lock.target then
		lock.target = cand
		lock.t = 0
		lock.beeped = false
	elseif cand then
		lock.t += dt
	end
	local lockInfo = nil
	if lock.target and lock.target.PrimaryPart then
		local sp, on = cam:WorldToViewportPoint(lock.target.PrimaryPart.Position)
		if on then
			local need = lockNeed(lock.target)
			local locked = lock.t >= need
			if locked and not lock.beeped then
				lock.beeped = true
				play("lock", 0.5)
			end
			lockInfo = { x = sp.X, y = sp.Y, k = math.clamp(lock.t / need, 0, 1), locked = locked }
		end
	end

	-- метки и радар
	local side = mySide()
	local marks = {}
	local dots = {}
	local myPos = f.pos
	local att = f.att
	local RANGE = 9000
	if folder then
		for _, m in folder:GetChildren() do
			if m:IsA("Model") and m ~= model and m.PrimaryPart and m.Name ~= "Wreck" then
				local p = m.PrimaryPart.Position
				local s = m:GetAttribute("Side")
				local colr = World.TEAM_COLOR[s :: any] or Hud.C.text
				local dist = (p - myPos).Magnitude
				local sp, on = cam:WorldToViewportPoint(p)
				if on and dist < 14000 and #marks < 28 then
					local enemy = s ~= side
					table.insert(marks, { x = sp.X, y = sp.Y, color = colr, size = if enemy then 20 else 12, text = if enemy then fmtDist(dist) else "" })
				end
				local rel = att:VectorToObjectSpace(p - myPos)
				local v = Vector2.new(rel.X, rel.Z) / RANGE
				if v.Magnitude > 1 then
					v = v.Unit
				end
				table.insert(dots, { dx = v.X, dy = v.Y, color = colr, big = false })
			end
		end
	end
	for _, i in World.ISLANDS do
		local rel = att:VectorToObjectSpace(Vector3.new(i.x, myPos.Y, i.z) - myPos)
		local v = Vector2.new(rel.X, rel.Z) / RANGE
		if v.Magnitude > 1 then
			v = v.Unit
		end
		table.insert(dots, { dx = v.X, dy = v.Y, color = World.TEAM_COLOR[(match:GetAttribute("Owner_" .. i.id) or "") :: any] or Hud.C.text, big = true })
	end
	ui.setMarkers(marks)
	ui.setRadar(dots)

	-- предупреждения и подсказки
	local warn: string? = nil
	local nearest = math.huge
	for i = #incoming, 1, -1 do
		local p = incoming[i]
		if not p.Parent or p.Transparency >= 1 then
			table.remove(incoming, i)
		else
			nearest = math.min(nearest, (p.Position - myPos).Magnitude)
		end
	end
	if nearest < 9000 and (now % 0.5) < 0.33 then
		warn = L("w_missile", fmtDist(nearest))
	end
	if math.abs(myPos.X) > World.SIZE or math.abs(myPos.Z) > World.SIZE then
		warn = L("w_zone")
	end
	local hp = (model and model:GetAttribute("HP") or 0) :: number
	local maxHp = (model and model:GetAttribute("MaxHP") or 100) :: number
	if not warn and hp < maxHp * 0.3 then
		warn = L("w_hp")
	end
	local info: string? = nil
	if parkBrake then
		info = L("i_throttle")
	elseif f.onGround and f.speed < 15 then
		local where = World.runwayAt(myPos.X, myPos.Z, 10)
		local mine = where == World.carrierOf(side).id or (where ~= nil and match:GetAttribute("Owner_" .. where) == side)
		if mine then
			info = L("i_rearm")
			if now - lastRearm > 2 then
				lastRearm = now
				RearmR:FireServer()
			end
		end
	else
		for _, i in World.ISLANDS do
			local dx, dz = myPos.X - i.x, myPos.Z - i.z
			if dx * dx + dz * dz < World.CAPTURE_R * World.CAPTURE_R then
				local cap = (match:GetAttribute("Cap_" .. i.id) or 0) :: number
				local pct = math.floor(math.abs(cap) * 100)
				local whose = L("team_" .. (if cap >= 0 then "Blue" else "Red"))
				if myPos.Y < i.h + World.CAPTURE_ALT then
					info = L("i_capture", L("base_" .. i.id), whose, pct)
				else
					info = L("i_capture_low", L("base_" .. i.id), math.floor((i.h + World.CAPTURE_ALT) * World.FT))
				end
			end
		end
	end
	local vs = cam.ViewportSize
	local aim = cam:WorldToViewportPoint(f.pos + f.att.LookVector * 1500)
	ui.update({
		speed = f.speed, alt = (myPos.Y - World.SEA) * World.FT, thr = f.throttle, hp = hp, maxHp = maxHp,
		missiles = model and model:GetAttribute("Missiles") or 0, flares = model and model:GetAttribute("Flares") or 0,
		gear = f.gear, lock = lockInfo, warn = warn, info = info,
		aim = Vector2.new(math.clamp(aim.X, 0, vs.X), math.clamp(aim.Y, 0, vs.Y)),
	})
end)

player.CharacterAdded:Connect(function()
	task.wait(0.5)
	setCharacterControls(false)
end)

-- музыка меню (если задана)
task.defer(function()
	local mus = sound("music", true, 0.35)
	if mus and inMenu then
		mus:Play()
	end
end)

]]></ProtectedString></Properties><Item class="ModuleScript" referent="RBX0000000E"><Properties><string name="Name">Animator</string><ProtectedString name="Source"><![CDATA[--!strict
-- Локальная анимация всех самолётов (своих, чужих и ИИ): винт, огни, шасси, закрылки,
-- инверсионный след, форсаж. Состояние приходит атрибутами модели от сервера,
-- а для своего самолёта — прямо из локальной физики (без задержки сети).
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("CarrierStrike")
local PlaneBuilder = require(Shared:WaitForChild("PlaneBuilder"))
local World = require(Shared:WaitForChild("World"))

local Animator = {}

type Cache = {
	lights: { BasePart }, trails: { Trail }, props: { Weld }, discs: { BasePart }, fans: { Weld }, fanAngle: number, ab: BasePart?,
	angle: number, gear: boolean?, flaps: number?,
}
local caches: { [Model]: Cache } = {}
local localModel: Model? = nil
local localState: { gear: boolean, flaps: number, throttle: number } = { gear = true, flaps = 0, throttle = 0 }

local ctrlIn = { p = 0, r = 0, y = 0 }
function Animator.setInputs(p: number, r: number, y: number)
	ctrlIn.p, ctrlIn.r, ctrlIn.y = p, r, y
end

function Animator.setLocal(model: Model?, gear: boolean?, flaps: number?, throttle: number?)
	localModel = model
	if gear ~= nil then
		localState.gear = gear
	end
	if flaps ~= nil then
		localState.flaps = flaps
	end
	if throttle ~= nil then
		localState.throttle = throttle
	end
end

local function cacheFor(m: Model): Cache
	local c = caches[m]
	if c then
		return c
	end
	local lights, trails = {}, {}
	for _, d in m:GetDescendants() do
		if d:IsA("BasePart") and d:GetAttribute("LightKind") then
			table.insert(lights, d)
		elseif d:IsA("Trail") then
			table.insert(trails, d)
		end
	end
	local engines = m:FindFirstChild("Engines")
	local fans: { Weld } = {}
	if engines then
		for _, d in engines:GetDescendants() do
			if d:IsA("Weld") and d.Name == "FanWeld" then
				table.insert(fans, d)
			end
		end
	end
	-- винты (у Cessna один, у ATR 72 — два) и их «диски» размытия
	local props: { Weld } = {}
	local discs: { BasePart } = {}
	if engines then
		for _, d in engines:GetDescendants() do
			if d:IsA("Weld") and d.Name == "PropWeld" then
				table.insert(props, d)
			elseif d:IsA("BasePart") and d.Name == "PropDisc" then
				table.insert(discs, d)
			end
		end
	end
	c = {
		lights = lights, trails = trails, props = props, discs = discs, fans = fans, fanAngle = 0,
		ab = engines and engines:FindFirstChild("Afterburner") :: BasePart?,
		angle = 0, gear = nil, flaps = nil,
	}
	caches[m] = c
	m.Destroying:Connect(function()
		caches[m] = nil
	end)
	return c
end

function Animator.step(dt: number, now: number)
	local folder = workspace:FindFirstChild("Planes")
	if not folder then
		return
	end
	for _, m in folder:GetChildren() do
		if not m:IsA("Model") or m.Name == "Wreck" then
			continue
		end
		local root = m.PrimaryPart
		if not root then
			continue
		end
		local c = cacheFor(m)
		local gear, flaps, thr
		if m == localModel then
			gear, flaps, thr = localState.gear, localState.flaps, localState.throttle
		else
			gear = m:GetAttribute("Gear") ~= false
			flaps = (m:GetAttribute("Flaps") or 0) :: number
			thr = (m:GetAttribute("Throttle") or 0) :: number
		end
		if c.gear ~= gear then
			c.gear = gear
			PlaneBuilder.setGearVisible(m, gear)
		end
		if c.flaps ~= flaps then
			c.flaps = flaps
			PlaneBuilder.setFlaps(m, flaps)
		end
		if m == localModel then
			PlaneBuilder.setControls(m, ctrlIn.p, ctrlIn.r, ctrlIn.y)
		end
		-- вентиляторы турбовентиляторных двигателей: быстрее при большей тяге
		if #c.fans > 0 then
			c.fanAngle = (c.fanAngle + dt * (5 + thr * 38)) % (math.pi * 2)
			for _, w in c.fans do
				local base = w:GetAttribute("Base")
				if typeof(base) == "CFrame" then
					w.C0 = base * CFrame.Angles(c.fanAngle, 0, 0)
				end
			end
		end
		-- винт
		if #c.props > 0 then
			c.angle = (c.angle + dt * (8 + thr * 70)) % (math.pi * 2)
			for _, w in c.props do
				local base = w:GetAttribute("Base")
				if typeof(base) == "CFrame" then
					w.C0 = base * CFrame.Angles(0, 0, c.angle)
				end
			end
			for _, d in c.discs do
				d.Transparency = 1 - math.min(0.18, thr * 0.25)
			end
		end
		if c.ab then
			c.ab.Transparency = if thr > 0.92 then 0.15 + math.random() * 0.2 else 1
		end
		-- огни: навигация горит, строб / маяк мигают
		for _, l in c.lights do
			local kind = l:GetAttribute("LightKind")
			local on = true
			if kind == "strobe" then
				on = (now % 1.2) < 0.06 or ((now - 0.15) % 1.2) < 0.05
			elseif kind == "beacon" then
				on = (now % 1.0) < 0.12
			end
			l.Transparency = if on then 0 else 0.85
		end
		-- инверсионный след выше 18 000 ft
		-- плюс конденсационные следы с законцовок при большой перегрузке или во влажном воздухе (атрибут Vapor от клиента)
		local contrail = (root.Position.Y * World.FT > 18000 and thr > 0.3) or m:GetAttribute("Vapor") == true
		for _, t in c.trails do
			if t.Enabled ~= contrail then
				t.Enabled = contrail
			end
		end
	end
end

return Animator
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX0000000F"><Properties><string name="Name">CameraRig</string><ProtectedString name="Source"><![CDATA[--!strict
-- Камеры: сзади (плавная), кабина, орбита. Плюс облёт аэропорта в ангаре.
local UserInputService = game:GetService("UserInputService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("CarrierStrike")
local World = require(Shared:WaitForChild("World"))

local CameraRig = {}
CameraRig.NAMES = { "сзади", "кабина", "орбита" }

function CameraRig.new(ui: any)
	local self: any = { mode = 1, orbit = { yaw = 0.6, pitch = 0.25, dist = 100 } }
	local cam = workspace.CurrentCamera
	local camRot = CFrame.identity
	local dragging = false
	local lastPos: Vector3? = nil
	local rng = Random.new()

	UserInputService.InputBegan:Connect(function(i, processed)
		if self.mode ~= 3 then
			return
		end
		if i.UserInputType == Enum.UserInputType.MouseButton2 or (i.UserInputType == Enum.UserInputType.Touch and not processed) then
			dragging = true
			lastPos = i.Position
		end
	end)
	UserInputService.InputEnded:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton2 or i.UserInputType == Enum.UserInputType.Touch then
			dragging = false
			lastPos = nil
		end
	end)
	UserInputService.InputChanged:Connect(function(i, processed)
		if self.mode ~= 3 then
			return
		end
		if i.UserInputType == Enum.UserInputType.MouseWheel and not processed then
			self.orbit.dist = math.clamp(self.orbit.dist * (if i.Position.Z < 0 then 1.1 else 0.9), 20, 3000)
		elseif dragging and lastPos and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
			if ui.isTouchingControls() then
				return
			end
			local d = i.Position - lastPos
			lastPos = i.Position
			self.orbit.yaw -= d.X * 0.008
			self.orbit.pitch = math.clamp(self.orbit.pitch + d.Y * 0.006, -0.2, 1.3)
		end
	end)

	function self.cycle(): string
		self.mode = self.mode % 3 + 1
		return CameraRig.NAMES[self.mode]
	end

	function self.reset(att: CFrame, cfg: any)
		camRot = att
		self.orbit.dist = cfg.length * 1.2 + 40
	end

	-- pose — фактическое положение модели (то, что рисуется), cfg — конфиг
	function self.update(dt: number, pose: CFrame, cfg: any, speed: number, onGround: boolean, crashed: boolean, buffet: number?)
		cam.CameraType = Enum.CameraType.Scriptable
		cam.FieldOfView = 66 + math.clamp(speed / cfg.maxKts, 0, 1) * 14
		local base = pose.Position
		local att = pose.Rotation
		if self.mode == 1 or crashed then
			camRot = camRot:Lerp(att, math.min(1, dt * 4))
			local back = cfg.length * 0.8 + 32
			local upOff = cfg.diameter * 1.25 + cfg.length * 0.09 + 6
			local eye = base + camRot * Vector3.new(0, upOff, back)
			local target = base + camRot * Vector3.new(0, upOff * 0.3, -cfg.length * 0.4)
			if buffet and buffet > 0.02 then
				local k = buffet * math.clamp(cfg.length / 60, 0.6, 2)
				eye += Vector3.new(rng:NextNumber(-1, 1), rng:NextNumber(-1, 1), rng:NextNumber(-1, 1)) * k
			end
			if onGround and speed > 30 then
				eye += Vector3.new(0, (rng:NextNumber() - 0.5) * math.min(0.6, speed / 400), 0)
			end
			local gmin = math.max(World.groundAt(eye.X, eye.Z), World.SEA)
			if eye.Y < gmin + 3 then
				eye = Vector3.new(eye.X, gmin + 3, eye.Z)
			end
			cam.CFrame = CFrame.lookAt(eye, target, camRot.UpVector)
		elseif self.mode == 2 then
			local eye = pose * Vector3.new(0, cfg.diameter * 0.36, -cfg.length * 0.5 - 1.5)
			cam.CFrame = CFrame.new(eye) * att
			camRot = att
		else
			local o = self.orbit
			local off = Vector3.new(math.sin(o.yaw) * math.cos(o.pitch), math.sin(o.pitch), math.cos(o.yaw) * math.cos(o.pitch)) * o.dist
			cam.CFrame = CFrame.lookAt(base + off, base)
			camRot = att
		end
	end

	-- медленный облёт аэропорта (ангар / ожидание)
	function self.idle(t: number)
		cam.CameraType = Enum.CameraType.Scriptable
		cam.FieldOfView = 66
		local a = t / 14
		local eye = Vector3.new(math.sin(a) * 900 + 650, 90 + math.sin(a * 0.7) * 30, math.cos(a) * 900 + 300)
		cam.CFrame = CFrame.lookAt(eye, Vector3.new(680, 20, 300))
	end

	function self.release()
		cam.CameraType = Enum.CameraType.Custom
		cam.FieldOfView = 70
	end

	return self
end

return CameraRig
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000010"><Properties><string name="Name">Controls</string><ProtectedString name="Source"><![CDATA[--!strict
-- Ввод: клавиатура, мышь, геймпад и сенсор → ввод физики + оружие.
local UserInputService = game:GetService("UserInputService")

local Controls = {}

local ONCE: { [Enum.KeyCode]: string } = {
	[Enum.KeyCode.F] = "missile", [Enum.KeyCode.X] = "flare", [Enum.KeyCode.G] = "gear", [Enum.KeyCode.V] = "cam",
	[Enum.KeyCode.C] = "mouse", [Enum.KeyCode.M] = "menu", [Enum.KeyCode.Z] = "idle", [Enum.KeyCode.K] = "cine",
	-- геймпад
	[Enum.KeyCode.ButtonX] = "missile", [Enum.KeyCode.ButtonB] = "flare", [Enum.KeyCode.ButtonY] = "gear",
	[Enum.KeyCode.ButtonSelect] = "cam", [Enum.KeyCode.ButtonStart] = "menu",
}

local function expo(v: number): number
	return v * (0.4 + 0.6 * v * v)
end
local function dz(v: number, d: number): number
	if math.abs(v) < d then
		return 0
	end
	return math.sign(v) * (math.abs(v) - d) / (1 - d)
end

function Controls.new(ui: any, onAction: (string) -> ())
	local self: any = { mouseYoke = false }

	UserInputService.InputBegan:Connect(function(input, processed)
		if processed then
			return
		end
		if input.UserInputType == Enum.UserInputType.MouseButton2 then
			onAction("missile")
			return
		end
		local a = ONCE[input.KeyCode]
		if a then
			onAction(a)
		end
	end)

	local function key(k: Enum.KeyCode): number
		return if UserInputService:IsKeyDown(k) then 1 else 0
	end

	function self.firing(): boolean
		if ui.touch.fire then
			return true
		end
		if UserInputService:IsKeyDown(Enum.KeyCode.Space) then
			return true
		end
		if UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1) and not UserInputService:GetFocusedTextBox() then
			-- клики по меню не считаются выстрелом: меню скрыто во время полёта
			return true
		end
		if UserInputService.GamepadEnabled and UserInputService:IsGamepadButtonDown(Enum.UserInputType.Gamepad1, Enum.KeyCode.ButtonR1) then
			return true
		end
		return false
	end

	function self.read(): any
		local kp = math.max(key(Enum.KeyCode.S), key(Enum.KeyCode.Down)) - math.max(key(Enum.KeyCode.W), key(Enum.KeyCode.Up))
		local kr = math.max(key(Enum.KeyCode.D), key(Enum.KeyCode.Right)) - math.max(key(Enum.KeyCode.A), key(Enum.KeyCode.Left))
		local ky = key(Enum.KeyCode.E) - key(Enum.KeyCode.Q)
		local thrUp = UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) or UserInputService:IsKeyDown(Enum.KeyCode.RightShift)
		local thrDn = UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) or UserInputService:IsKeyDown(Enum.KeyCode.RightControl)
		local brakes = UserInputService:IsKeyDown(Enum.KeyCode.B) or ui.touch.brake

		local t = ui.touch
		local p = kp + expo(t.y)
		local r = kr + expo(t.x)
		local y = ky

		if UserInputService.GamepadEnabled then
			for _, s in UserInputService:GetGamepadState(Enum.UserInputType.Gamepad1) do
				local kc = s.KeyCode
				if kc == Enum.KeyCode.Thumbstick1 then
					p += expo(-dz(s.Position.Y, 0.12))
					r += expo(dz(s.Position.X, 0.12))
				elseif kc == Enum.KeyCode.Thumbstick2 then
					y += dz(s.Position.X, 0.2)
				elseif kc == Enum.KeyCode.ButtonR2 and s.Position.Z > 0.25 then
					thrUp = true
				elseif kc == Enum.KeyCode.ButtonL2 and s.Position.Z > 0.25 then
					thrDn = true
				end
			end
			if UserInputService:IsGamepadButtonDown(Enum.UserInputType.Gamepad1, Enum.KeyCode.ButtonL1) then
				brakes = true
			end
		end

		if self.mouseYoke then
			local cam = workspace.CurrentCamera
			local m = UserInputService:GetMouseLocation()
			local vs = cam.ViewportSize
			local span = math.min(vs.X, vs.Y) * 0.32
			p += expo(dz(math.clamp((m.Y - vs.Y / 2) / span, -1, 1), 0.05))
			r += expo(dz(math.clamp((m.X - vs.X / 2) / span, -1, 1), 0.05))
		end

		local input = { p = p, r = r, y = y, thrUp = thrUp, thrDn = thrDn, brakes = brakes, throttle = t.throttle }
		t.throttle = nil
		return input
	end

	return self
end

return Controls
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000011"><Properties><string name="Name">Hud</string><ProtectedString name="Source"><![CDATA[--!strict
-- Интерфейс: меню (ангар, задания, топ, магазин), ежедневная награда, итоги раунда,
-- приборы, радар, метки, лента, всплывающие награды, обучение, сенсорное управление.
-- Всё масштабируется под экран (телефон / планшет / ПК). Тексты — через L() (русский / английский).
local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")

local Hud = {}

local C = {
	bg = Color3.fromRGB(8, 14, 24),
	panel = Color3.fromRGB(16, 26, 40),
	panel2 = Color3.fromRGB(22, 40, 60),
	line = Color3.fromRGB(46, 72, 100),
	text = Color3.fromRGB(230, 238, 248),
	dim = Color3.fromRGB(140, 160, 184),
	accent = Color3.fromRGB(92, 200, 255),
	cyan = Color3.fromRGB(92, 200, 255),
	amber = Color3.fromRGB(255, 190, 70),
	gold = Color3.fromRGB(255, 206, 84),
	red = Color3.fromRGB(255, 92, 86),
	green = Color3.fromRGB(110, 230, 150),
	Blue = Color3.fromRGB(92, 200, 255),
	Red = Color3.fromRGB(255, 96, 86),
}
Hud.C = C

local function new(cls: string, props: { [string]: any }, parent: Instance?): any
	local o = Instance.new(cls)
	for k, v in props do
		(o :: any)[k] = v
	end
	if parent then
		o.Parent = parent
	end
	return o
end
local function corner(p: Instance, r: number?)
	new("UICorner", { CornerRadius = UDim.new(0, r or 10) }, p)
end
local function stroke(p: Instance, col: Color3?, th: number?): UIStroke
	return new("UIStroke", { Color = col or C.line, Thickness = th or 1, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }, p)
end
local function label(parent: Instance, text: string, size: number, col: Color3?, bold: boolean?, props: { [string]: any }?): TextLabel
	local l = new("TextLabel", {
		BackgroundTransparency = 1, Text = text, TextSize = size, TextColor3 = col or C.text,
		Font = if bold then Enum.Font.GothamBold else Enum.Font.Gotham, TextXAlignment = Enum.TextXAlignment.Left,
		Size = UDim2.new(1, 0, 0, size + 6),
	}, parent)
	for k, v in props or {} do
		(l :: any)[k] = v
	end
	return l
end
local function button(parent: Instance, text: string, size: UDim2, pos: UDim2, col: Color3?, textCol: Color3?): TextButton
	local b = new("TextButton", {
		Size = size, Position = pos, BackgroundColor3 = col or C.panel, BackgroundTransparency = 0.05,
		Text = text, TextColor3 = textCol or C.text, Font = Enum.Font.GothamBold, TextSize = 16, AutoButtonColor = true,
	}, parent)
	corner(b, 10)
	stroke(b, C.line)
	return b
end
local function bar(parent: Instance, size: UDim2, pos: UDim2, col: Color3): Frame
	local bg = new("Frame", { Size = size, Position = pos, BackgroundColor3 = C.panel, BorderSizePixel = 0 }, parent)
	corner(bg, 4)
	local fill = new("Frame", { Name = "Fill", Size = UDim2.fromScale(0, 1), BackgroundColor3 = col, BorderSizePixel = 0 }, bg)
	corner(fill, 4)
	return bg
end
local function setBar(bg: Frame, k: number)
	(bg:FindFirstChild("Fill") :: Frame).Size = UDim2.fromScale(math.clamp(k, 0, 1), 1)
end
local function fmt(n: number): string
	local s = tostring(math.floor(math.abs(n)))
	local out = s:reverse():gsub("(%d%d%d)", "%1 "):reverse():gsub("^ ", "")
	return (if n < 0 then "-" else "") .. out
end
Hud.fmt = fmt

function Hud.new(L: (string, ...any) -> string): any
	local ui: any = {}
	local isTouch = UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled
	ui.isTouch = isTouch
	local pg = Players.LocalPlayer:WaitForChild("PlayerGui")
	local gui = new("ScreenGui", { Name = "CarrierStrikeUI", ResetOnSpawn = false, IgnoreGuiInset = true, ZIndexBehavior = Enum.ZIndexBehavior.Sibling }, pg)

	-- корневая рамка под масштаб: интерфейс рисуется для 1280×720 и сжимается на маленьких экранах
	local root = new("Frame", { Name = "Root", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1) }, gui)
	local scaler = new("UIScale", { Scale = 1 }, root)
	local function rescale()
		local vs = workspace.CurrentCamera.ViewportSize
		local s = math.clamp(math.min(vs.X / 1280, vs.Y / 720), 0.5, 1.25)
		if isTouch then
			s = math.clamp(s * 1.1, 0.5, 1.25)
		end
		scaler.Scale = s
		root.Size = UDim2.fromScale(1 / s, 1 / s)
		ui.scale = s
	end
	ui.scale = 1
	rescale()
	workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(rescale)

	-- ============================================================ МЕНЮ
	local menu = new("Frame", { Name = "Menu", Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1 }, root)
	local shade = new("Frame", { Size = UDim2.fromScale(0.62, 1), BackgroundColor3 = C.bg, BackgroundTransparency = 0.15, BorderSizePixel = 0 }, menu)
	new("UIGradient", { Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(0.6, 0.2), NumberSequenceKeypoint.new(1, 1) }) }, shade)

	local left = new("Frame", { Size = UDim2.new(0, 470, 1, -24), Position = UDim2.fromOffset(18, 12), BackgroundTransparency = 1 }, menu)
	label(left, "CARRIER STRIKE", 34, C.text, true, { Position = UDim2.fromOffset(0, 0), Size = UDim2.new(1, 0, 0, 40) })
	local teamLbl = label(left, "", 15, C.accent, true, { Position = UDim2.fromOffset(2, 40), Size = UDim2.new(1, 0, 0, 20) })

	-- профиль: уровень, опыт, монеты
	local prof = new("Frame", { Size = UDim2.new(1, 0, 0, 52), Position = UDim2.fromOffset(0, 66), BackgroundColor3 = C.panel, BackgroundTransparency = 0.1 }, left)
	corner(prof, 12)
	stroke(prof)
	local lvlBox = new("Frame", { Size = UDim2.fromOffset(40, 40), Position = UDim2.fromOffset(6, 6), BackgroundColor3 = C.accent }, prof)
	corner(lvlBox, 20)
	local lvlL = label(lvlBox, "1", 18, C.bg, true, { Size = UDim2.fromScale(1, 1), TextXAlignment = Enum.TextXAlignment.Center })
	local xpTxt = label(prof, "", 12, C.dim, true, { Position = UDim2.fromOffset(56, 6), Size = UDim2.new(1, -200, 0, 16) })
	local xpBar = bar(prof, UDim2.new(1, -200, 0, 8), UDim2.fromOffset(56, 28), C.accent)
	local coinsL = label(prof, "💰 0", 20, C.gold, true, { Position = UDim2.new(1, -136, 0, 12), Size = UDim2.fromOffset(126, 26), TextXAlignment = Enum.TextXAlignment.Right })

	-- большая кнопка «Играть»
	local quick = button(left, "", UDim2.new(1, 0, 0, 64), UDim2.fromOffset(0, 128), C.accent)
	label(quick, "▶  " .. L("play"), 26, C.bg, true, { Position = UDim2.fromOffset(18, 6), Size = UDim2.new(1, -24, 0, 32) })
	local quickSub = label(quick, L("play_sub"), 13, C.bg, false, { Position = UDim2.fromOffset(20, 38), Size = UDim2.new(1, -24, 0, 16) })

	-- вкладки
	local tabsRow = new("Frame", { Size = UDim2.new(1, 0, 0, 36), Position = UDim2.fromOffset(0, 202), BackgroundTransparency = 1 }, left)
	new("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 6) }, tabsRow)
	local pages: { [string]: ScrollingFrame } = {}
	local tabBtns: { [string]: TextButton } = {}
	local tabDot: { [string]: Frame } = {}
	local function page(name: string): ScrollingFrame
		local sf = new("ScrollingFrame", {
			Size = UDim2.new(1, 0, 1, -248), Position = UDim2.fromOffset(0, 246), BackgroundTransparency = 1, BorderSizePixel = 0,
			ScrollBarThickness = 4, CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y, Visible = false,
		}, left)
		new("UIListLayout", { Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder }, sf)
		new("UIPadding", { PaddingRight = UDim.new(0, 8), PaddingBottom = UDim.new(0, 12) }, sf)
		pages[name] = sf
		return sf
	end
	local curTab = "hangar"
	local function showTab(name: string)
		curTab = name
		for n, pgf in pages do
			pgf.Visible = n == name
		end
		for n, b in tabBtns do
			b.BackgroundColor3 = if n == name then C.panel2 else C.panel
			b.TextColor3 = if n == name then C.accent else C.dim
		end
	end
	for i, n in { "hangar", "missions", "top", "shop" } do
		local b = button(tabsRow, L("tab_" .. n), UDim2.new(0.25, -5, 1, 0), UDim2.new(), C.panel, C.dim)
		b.TextSize = 14
		b.LayoutOrder = i
		tabBtns[n] = b
		local dot = new("Frame", { Size = UDim2.fromOffset(10, 10), Position = UDim2.new(1, -12, 0, 2), BackgroundColor3 = C.red, Visible = false }, b)
		corner(dot, 5)
		tabDot[n] = dot
		b.MouseButton1Click:Connect(function()
			showTab(n)
		end)
	end
	local hangar = page("hangar")
	local missions = page("missions")
	local topPage = page("top")
	local shop = page("shop")
	showTab("hangar")

	local function section(parent: Instance, text: string, order: number)
		label(parent, text, 13, C.dim, true, { LayoutOrder = order, Size = UDim2.new(1, 0, 0, 18) })
	end

	-- ---------- АНГАР: самолёты, раскраски, точка вылета, кнопка «В бой»
	section(hangar, L("sec_jet"), 1)
	local jetGrid = new("Frame", { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, LayoutOrder = 2 }, hangar)
	new("UIGridLayout", { CellSize = UDim2.new(0.5, -5, 0, 112), CellPadding = UDim2.fromOffset(10, 8), SortOrder = Enum.SortOrder.LayoutOrder }, jetGrid)
	section(hangar, L("sec_paint"), 3)
	local paintRow = new("ScrollingFrame", { Size = UDim2.new(1, 0, 0, 74), BackgroundTransparency = 1, BorderSizePixel = 0, ScrollBarThickness = 3, ScrollingDirection = Enum.ScrollingDirection.X, CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.X, LayoutOrder = 4 }, hangar)
	new("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder }, paintRow)
	section(hangar, L("sec_spawn"), 5)
	local spawnList = new("Frame", { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, LayoutOrder = 6 }, hangar)
	new("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder }, spawnList)
	local go = button(hangar, L("launch"), UDim2.new(1, 0, 0, 54), UDim2.new(), C.green, C.bg)
	go.LayoutOrder = 7
	go.TextSize = 22
	label(hangar, if isTouch then L("help_touch") else L("help_pc"), 12, C.dim, false, { LayoutOrder = 8, TextWrapped = true, AutomaticSize = Enum.AutomaticSize.Y, Size = UDim2.new(1, 0, 0, 0) })

	-- карточка выбранного самолёта справа внизу
	local card = new("Frame", { Size = UDim2.fromOffset(330, 196), Position = UDim2.new(1, -348, 1, -214), BackgroundColor3 = C.bg, BackgroundTransparency = 0.15 }, menu)
	corner(card, 14)
	stroke(card)
	local cardName = label(card, "", 22, C.text, true, { Position = UDim2.fromOffset(16, 10), Size = UDim2.new(1, -32, 0, 28), TextXAlignment = Enum.TextXAlignment.Right })
	local cardRole = label(card, "", 13, C.accent, true, { Position = UDim2.fromOffset(16, 38), Size = UDim2.new(1, -32, 0, 18), TextXAlignment = Enum.TextXAlignment.Right })
	local statBars: { Frame } = {}
	for i, n in { "st_speed", "st_agility", "st_armor", "st_missiles" } do
		label(card, L(n), 12, C.dim, true, { Position = UDim2.fromOffset(16, 62 + (i - 1) * 20), Size = UDim2.fromOffset(110, 16) })
		statBars[i] = bar(card, UDim2.new(1, -150, 0, 7), UDim2.fromOffset(134, 67 + (i - 1) * 20), C.accent)
	end
	local cardBuy = button(card, "", UDim2.new(1, -32, 0, 34), UDim2.fromOffset(16, 148), C.gold, C.bg)

	-- пригласить друзей
	local invite = button(menu, "👥 " .. L("invite"), UDim2.fromOffset(220, 40), UDim2.new(1, -238, 0, 14), C.panel, C.text)
	invite.TextSize = 15

	-- ---------- состояние меню
	local jetsOrder: { string } = {}
	local jetsDef: { [string]: any } = {}
	local progDef: any = nil
	local profile: any = nil
	local selJet, selPaint, selSpawn = "F16", "team", ""
	local jetBtns: { [string]: TextButton } = {}
	local paintBtns: { [string]: TextButton } = {}
	local spawnBtns: { [string]: TextButton } = {}
	local cbs: any = {}

	local function level(): number
		if not profile or not progDef then
			return 1
		end
		return (progDef.levelOf(profile.xp))
	end
	local function owned(id: string): boolean
		return profile ~= nil and profile.owned[id] == true
	end
	local function paintOwned(pt: any): boolean
		if not profile then
			return pt.id == "team"
		end
		if pt.vip then
			return profile.vip == true
		end
		return profile.paints[pt.id] == true
	end

	-- 3D-превью в карточках: настоящая модель самолёта в ViewportFrame
	local builder: ((string, string) -> Model?)? = nil
	local views: { [string]: { vp: ViewportFrame, cam: Camera, model: Model?, dist: number, paint: string } } = {}
	local function setView(id: string, paint: string)
		local v = views[id]
		if not v or not builder or v.paint == paint then
			return
		end
		v.paint = paint
		if v.model then
			v.model:Destroy()
		end
		local m = builder(id, paint)
		if not m then
			return
		end
		m:PivotTo(CFrame.identity)
		m.Parent = v.vp
		v.model = m
		local size = m:GetExtentsSize()
		v.dist = math.max(size.X, size.Z) * 0.5 / math.tan(math.rad(v.cam.FieldOfView * 0.5)) * 1.12
	end
	local spin = 0
	RunService.RenderStepped:Connect(function(dt)
		if not menu.Visible or not pages.hangar.Visible then
			return
		end
		spin += dt * 0.6
		for id, v in views do
			local yaw = if id == selJet then spin else 2.4
			v.cam.CFrame = CFrame.fromOrientation(-0.38, yaw, 0) * CFrame.new(0, 0, v.dist)
		end
	end)

	local function refreshCard()
		local j = jetsDef[selJet]
		if not j then
			return
		end
		cardName.Text = j.name
		cardRole.Text = L("role_" .. selJet)
		setBar(statBars[1], (j.maxKts - 600) / 220)
		setBar(statBars[2], (j.rollRate - 2.6) / 1.9)
		setBar(statBars[3], (j.hp - 80) / 60)
		setBar(statBars[4], j.missiles / 6)
		local pj = progDef and progDef.JETS[selJet]
		if owned(selJet) then
			cardBuy.Visible = false
		else
			cardBuy.Visible = true
			if pj and level() < pj.level then
				cardBuy.Text = "🔒 " .. L("need_lvl", pj.level)
				cardBuy.BackgroundColor3 = C.panel2
				cardBuy.TextColor3 = C.dim
			else
				cardBuy.Text = L("buy_for", fmt(pj and pj.cost or 0))
				cardBuy.BackgroundColor3 = C.gold
				cardBuy.TextColor3 = C.bg
			end
		end
	end

	local function paintSel()
		for id, b in jetBtns do
			local s = b:FindFirstChildOfClass("UIStroke") :: UIStroke
			s.Color = if id == selJet then C.accent else C.line
			s.Thickness = if id == selJet then 2 else 1
			b.BackgroundColor3 = if id == selJet then C.panel2 else C.panel
		end
		for id, b in paintBtns do
			local s = b:FindFirstChildOfClass("UIStroke") :: UIStroke
			s.Color = if id == selPaint then C.accent else C.line
			s.Thickness = if id == selPaint then 3 else 1
		end
		for id, b in spawnBtns do
			local s = b:FindFirstChildOfClass("UIStroke") :: UIStroke
			s.Color = if id == selSpawn then C.accent else C.line
			s.Thickness = if id == selSpawn then 2 else 1
			b.BackgroundColor3 = if id == selSpawn then C.panel2 else C.panel
		end
		go.Text = if owned(selJet) then L("launch") else L("launch_locked")
		go.BackgroundColor3 = if owned(selJet) then C.green else C.panel2
		refreshCard()
		for id in views do
			setView(id, if id == selJet then selPaint else "team")
		end
		if cbs.select then
			cbs.select(selJet, selPaint)
		end
	end

	function ui.setJets(order: { string }, jets: { [string]: any }, prog: any, build: ((string, string) -> Model?)?)
		jetsOrder, jetsDef, progDef = order, jets, prog
		builder = build
		for i, id in order do
			local j = jets[id]
			local b = button(jetGrid, "", UDim2.new(), UDim2.new())
			b.LayoutOrder = i
			b.ClipsDescendants = true
			local vp = new("ViewportFrame", {
				Size = UDim2.new(1, -8, 0, 66), Position = UDim2.fromOffset(4, 4), BackgroundTransparency = 1,
				Ambient = Color3.fromRGB(150, 158, 176), LightColor = Color3.fromRGB(255, 236, 214), LightDirection = Vector3.new(-0.5, -1, -0.4),
			}, b)
			local vcam = Instance.new("Camera")
			vcam.FieldOfView = 30
			vcam.Parent = vp
			vp.CurrentCamera = vcam
			views[id] = { vp = vp, cam = vcam, model = nil, dist = 60, paint = "" }
			label(b, j.name, 14, C.text, true, { Position = UDim2.fromOffset(10, 70), Size = UDim2.new(1, -16, 0, 18), TextTruncate = Enum.TextTruncate.AtEnd })
			label(b, "", 12, C.dim, false, { Name = "Sub", Position = UDim2.fromOffset(10, 90), Size = UDim2.new(1, -16, 0, 16), TextTruncate = Enum.TextTruncate.AtEnd })
			b.MouseButton1Click:Connect(function()
				selJet = id
				paintSel()
			end)
			jetBtns[id] = b
		end
		for i, pt in prog.PAINTS do
			local b = new("TextButton", { Size = UDim2.fromOffset(64, 64), BackgroundColor3 = pt.body or C.Blue, Text = "", AutoButtonColor = true, LayoutOrder = i }, paintRow)
			corner(b, 12)
			stroke(b, C.line)
			if pt.accent then
				new("Frame", { Size = UDim2.new(1, 0, 0.3, 0), Position = UDim2.fromScale(0, 0.7), BackgroundColor3 = pt.accent, BorderSizePixel = 0 }, b)
			end
			label(b, "", 11, C.text, true, { Name = "P", Size = UDim2.new(1, 0, 0, 14), Position = UDim2.new(0, 0, 1, -16), TextXAlignment = Enum.TextXAlignment.Center, TextStrokeTransparency = 0.3, ZIndex = 2 })
			b.MouseButton1Click:Connect(function()
				if paintOwned(pt) then
					selPaint = pt.id
					paintSel()
				elseif pt.vip then
					if cbs.shop then
						cbs.shop("vip", 0)
					end
				elseif cbs.buy then
					cbs.buy("paint", pt.id)
				end
			end)
			paintBtns[pt.id] = b
		end
		paintSel()
	end

	local function refreshLists()
		if not profile or not progDef then
			return
		end
		local lvl = level()
		for id, b in jetBtns do
			local sub = b:FindFirstChild("Sub") :: TextLabel
			local pj = progDef.JETS[id]
			if owned(id) then
				sub.Text = "✓ " .. L("role_" .. id)
				sub.TextColor3 = C.green
			elseif pj and lvl < pj.level then
				sub.Text = "🔒 " .. L("need_lvl", pj.level)
				sub.TextColor3 = C.dim
			else
				sub.Text = "💰 " .. fmt(pj and pj.cost or 0)
				sub.TextColor3 = C.gold
			end
		end
		for _, pt in progDef.PAINTS do
			local b = paintBtns[pt.id]
			if b then
				local p = b:FindFirstChild("P") :: TextLabel
				p.Text = if paintOwned(pt) then "" elseif pt.vip then "VIP" elseif lvl < pt.level then "🔒" .. pt.level else fmt(pt.cost)
			end
		end
		if not owned(selJet) and owned(profile.jet) then
			selJet = profile.jet
		end
		paintSel()
	end

	function ui.setProfile(p: any)
		local first = profile == nil
		profile = p
		local lvl, into, need = progDef.levelOf(p.xp)
		lvlL.Text = tostring(lvl)
		xpTxt.Text = L("level_xp", lvl, fmt(into), fmt(need))
		setBar(xpBar, into / math.max(need, 1))
		coinsL.Text = "💰 " .. fmt(p.coins)
		if first then
			if owned(p.jet) then
				selJet = p.jet
			end
			local pt = progDef.paint(p.paint)
			if pt and paintOwned(pt) then
				selPaint = p.paint
			end
		end
		refreshLists()
		ui.renderMissions()
		ui.renderShop()
		tabDot.missions.Visible = p.daily.can
	end

	-- точки вылета: { {id, title, sub, ok} }
	function ui.setSpawns(list: { any })
		local seen = {}
		for i, s in list do
			seen[s.id] = true
			local b = spawnBtns[s.id]
			if not b then
				b = button(spawnList, "", UDim2.new(1, 0, 0, 44), UDim2.new())
				label(b, "", 15, C.text, true, { Name = "T", Position = UDim2.fromOffset(12, 4), Size = UDim2.new(1, -20, 0, 20) })
				label(b, "", 11, C.dim, false, { Name = "S", Position = UDim2.fromOffset(12, 24), Size = UDim2.new(1, -20, 0, 16) })
				local id = s.id
				b.MouseButton1Click:Connect(function()
					if b:GetAttribute("Ok") then
						selSpawn = id
						paintSel()
					end
				end)
				spawnBtns[s.id] = b
			end
			b.LayoutOrder = i
			b:SetAttribute("Ok", s.ok)
			local t = b:FindFirstChild("T") :: TextLabel
			local sub = b:FindFirstChild("S") :: TextLabel
			t.Text = s.title
			sub.Text = s.sub
			b.BackgroundTransparency = if s.ok then 0.05 else 0.6
			t.TextColor3 = if s.ok then C.text else C.dim
		end
		for id, b in spawnBtns do
			if not seen[id] then
				b:Destroy()
				spawnBtns[id] = nil
			end
		end
		local cur = spawnBtns[selSpawn]
		if not cur or not cur:GetAttribute("Ok") then
			selSpawn = list[1] and list[1].id or ""
		end
		paintSel()
	end
	function ui.setTeam(side: string)
		teamLbl.Text = L("team_" .. side)
		teamLbl.TextColor3 = C[side] or C.accent
	end
	function ui.on(name: string, cb: any)
		cbs[name] = cb
	end
	quick.MouseButton1Click:Connect(function()
		if cbs.quick then
			cbs.quick(if owned(selJet) then selJet else "F16", if owned(selJet) then selPaint else "team")
		end
	end)
	go.MouseButton1Click:Connect(function()
		if not owned(selJet) then
			if cbs.buy then
				cbs.buy("jet", selJet)
			end
		elseif cbs.launch and selSpawn ~= "" then
			cbs.launch(selJet, selSpawn, selPaint)
		end
	end)
	cardBuy.MouseButton1Click:Connect(function()
		if cbs.buy then
			cbs.buy("jet", selJet)
		end
	end)
	invite.MouseButton1Click:Connect(function()
		if cbs.invite then
			cbs.invite()
		end
	end)
	function ui.showMenu(v: boolean)
		menu.Visible = v
	end
	function ui.setQuickSub(t: string)
		quickSub.Text = t
	end

	-- ---------- ЗАДАНИЯ
	local dailyBtn: TextButton? = nil
	function ui.renderMissions()
		for _, ch in missions:GetChildren() do
			if ch:IsA("GuiObject") then
				ch:Destroy()
			end
		end
		if not profile then
			return
		end
		section(missions, L("sec_daily"), 1)
		local d = profile.daily
		local row = new("Frame", { Size = UDim2.new(1, 0, 0, 62), BackgroundTransparency = 1, LayoutOrder = 2 }, missions)
		new("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 5) }, row)
		for i, coins in progDef.DAILY do
			local got = (not d.can and i <= d.idx) or (d.can and i < d.idx)
			local today = i == d.idx
			local cell = new("Frame", { Size = UDim2.new(1 / 7, -5, 1, 0), BackgroundColor3 = if today then C.panel2 else C.panel, LayoutOrder = i }, row)
			corner(cell, 8)
			stroke(cell, if today then C.gold else C.line, if today then 2 else 1)
			label(cell, L("day_n", i), 11, C.dim, true, { Size = UDim2.new(1, 0, 0, 16), Position = UDim2.fromOffset(0, 4), TextXAlignment = Enum.TextXAlignment.Center })
			label(cell, if got then "✓" else fmt(coins), 14, if got then C.green else C.gold, true, { Size = UDim2.new(1, 0, 0, 20), Position = UDim2.fromOffset(0, 26), TextXAlignment = Enum.TextXAlignment.Center })
		end
		if d.can then
			local b = button(missions, L("claim_daily", fmt(progDef.DAILY[d.idx])), UDim2.new(1, 0, 0, 44), UDim2.new(), C.gold, C.bg)
			b.LayoutOrder = 3
			b.MouseButton1Click:Connect(function()
				if cbs.daily then
					cbs.daily()
				end
			end)
			dailyBtn = b
		else
			label(missions, L("daily_back"), 12, C.dim, false, { LayoutOrder = 3, TextWrapped = true, Size = UDim2.new(1, 0, 0, 30) })
		end
		section(missions, L("sec_quests"), 4)
		for i, q in profile.quests do
			local f = new("Frame", { Size = UDim2.new(1, 0, 0, 58), BackgroundColor3 = C.panel, LayoutOrder = 4 + i }, missions)
			corner(f, 10)
			stroke(f, if q.done then C.green else C.line)
			label(f, L("q_" .. q.id, q.n), 14, if q.done then C.green else C.text, true, { Position = UDim2.fromOffset(12, 6), Size = UDim2.new(1, -110, 0, 20) })
			label(f, (if q.done then "✓ " else "") .. "💰 " .. fmt(q.reward), 14, C.gold, true, { Position = UDim2.new(1, -100, 0, 6), Size = UDim2.fromOffset(90, 20), TextXAlignment = Enum.TextXAlignment.Right })
			local pb = bar(f, UDim2.new(1, -24, 0, 8), UDim2.fromOffset(12, 36), if q.done then C.green else C.accent)
			setBar(pb, q.p / q.n)
			label(f, string.format("%d / %d", q.p, q.n), 11, C.dim, true, { Position = UDim2.new(1, -80, 0, 30), Size = UDim2.fromOffset(68, 14), TextXAlignment = Enum.TextXAlignment.Right, Visible = false })
		end
		label(missions, L("quests_reset"), 12, C.dim, false, { LayoutOrder = 20, TextWrapped = true, Size = UDim2.new(1, 0, 0, 30) })
		local st = profile.stats
		section(missions, L("sec_stats"), 21)
		label(missions, L("stats_line", st.kills, st.deaths, st.wins, st.caps, st.sorties), 13, C.text, false, { LayoutOrder = 22, TextWrapped = true, Size = UDim2.new(1, 0, 0, 40) })
	end

	-- ---------- ТОП НЕДЕЛИ
	function ui.setTop(list: { any }, myWeek: number)
		for _, ch in topPage:GetChildren() do
			if ch:IsA("GuiObject") then
				ch:Destroy()
			end
		end
		section(topPage, L("sec_top"), 1)
		if #list == 0 then
			label(topPage, L("top_empty"), 13, C.dim, false, { LayoutOrder = 2, TextWrapped = true, Size = UDim2.new(1, 0, 0, 40) })
		end
		local me = Players.LocalPlayer.Name
		for i, e in list do
			local f = new("Frame", { Size = UDim2.new(1, 0, 0, 36), BackgroundColor3 = if e[1] == me then C.panel2 else C.panel, LayoutOrder = 1 + i }, topPage)
			corner(f, 8)
			local medal = if i == 1 then "🥇" elseif i == 2 then "🥈" elseif i == 3 then "🥉" else tostring(i) .. "."
			label(f, medal .. "  " .. tostring(e[1]), 15, C.text, true, { Position = UDim2.fromOffset(12, 7), Size = UDim2.new(1, -120, 0, 22) })
			label(f, fmt(tonumber(e[2]) or 0) .. " ✈", 15, C.gold, true, { Position = UDim2.new(1, -110, 0, 7), Size = UDim2.fromOffset(98, 22), TextXAlignment = Enum.TextXAlignment.Right })
		end
		label(topPage, L("top_mine", myWeek), 13, C.accent, true, { LayoutOrder = 50, Size = UDim2.new(1, 0, 0, 20) })
		label(topPage, L("top_hint"), 12, C.dim, false, { LayoutOrder = 51, TextWrapped = true, Size = UDim2.new(1, 0, 0, 30) })
	end

	-- ---------- МАГАЗИН
	function ui.renderShop()
		for _, ch in shop:GetChildren() do
			if ch:IsA("GuiObject") then
				ch:Destroy()
			end
		end
		if not profile then
			return
		end
		section(shop, L("sec_vip"), 1)
		local v = new("Frame", { Size = UDim2.new(1, 0, 0, 110), BackgroundColor3 = C.panel, LayoutOrder = 2 }, shop)
		corner(v, 12)
		stroke(v, C.gold, 2)
		label(v, "★ VIP", 22, C.gold, true, { Position = UDim2.fromOffset(14, 8), Size = UDim2.new(1, -28, 0, 26) })
		label(v, L("vip_desc"), 13, C.text, false, { Position = UDim2.fromOffset(14, 38), Size = UDim2.new(1, -28, 0, 36), TextWrapped = true })
		local vb = button(v, if profile.vip then L("vip_have") elseif profile.shop.vip > 0 then L("vip_buy") else L("soon"), UDim2.new(1, -28, 0, 28), UDim2.fromOffset(14, 76), if profile.vip then C.panel2 else C.gold, C.bg)
		vb.Active = profile.shop.vip > 0 and not profile.vip
		vb.MouseButton1Click:Connect(function()
			if cbs.shop and profile.shop.vip > 0 and not profile.vip then
				cbs.shop("vip", profile.shop.vip)
			end
		end)
		section(shop, L("sec_coins"), 3)
		for i, pr in profile.shop.coins do
			local b = button(shop, "💰 " .. fmt(pr.coins) .. (if pr.id > 0 then "" else "  ·  " .. L("soon")), UDim2.new(1, 0, 0, 44), UDim2.new(), C.panel, C.gold)
			b.LayoutOrder = 3 + i
			b.MouseButton1Click:Connect(function()
				if cbs.shop and pr.id > 0 then
					cbs.shop("coins", pr.id)
				end
			end)
		end
		label(shop, L("shop_hint"), 12, C.dim, false, { LayoutOrder = 20, TextWrapped = true, Size = UDim2.new(1, 0, 0, 44) })
	end

	-- ============================================================ ОКНА (ежедневная награда, итоги раунда)
	local modal = new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = 0.45, Visible = false, ZIndex = 20 }, root)
	local box = new("Frame", { Size = UDim2.fromOffset(560, 330), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), BackgroundColor3 = C.bg, ZIndex = 21 }, modal)
	corner(box, 16)
	stroke(box, C.accent, 2)
	local function clearBox()
		for _, ch in box:GetChildren() do
			if ch:IsA("GuiObject") then
				ch:Destroy()
			end
		end
	end
	local function zall(f: Instance)
		for _, d in f:GetDescendants() do
			if d:IsA("GuiObject") then
				d.ZIndex = 22
			end
		end
	end
	function ui.closeModal()
		modal.Visible = false
	end

	function ui.showDaily()
		if not profile or not profile.daily.can then
			return
		end
		clearBox()
		modal.Visible = true
		local d = profile.daily
		label(box, "🎁 " .. L("daily_title"), 26, C.gold, true, { Position = UDim2.fromOffset(0, 18), Size = UDim2.new(1, 0, 0, 32), TextXAlignment = Enum.TextXAlignment.Center })
		label(box, L("daily_sub", d.idx), 14, C.dim, false, { Position = UDim2.fromOffset(20, 56), Size = UDim2.new(1, -40, 0, 20), TextXAlignment = Enum.TextXAlignment.Center })
		local row = new("Frame", { Size = UDim2.new(1, -40, 0, 92), Position = UDim2.fromOffset(20, 92), BackgroundTransparency = 1 }, box)
		new("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 6) }, row)
		for i, coins in progDef.DAILY do
			local today = i == d.idx
			local cell = new("Frame", { Size = UDim2.new(1 / 7, -6, 1, 0), BackgroundColor3 = if today then C.panel2 else C.panel, LayoutOrder = i }, row)
			corner(cell, 10)
			stroke(cell, if today then C.gold else C.line, if today then 3 else 1)
			label(cell, L("day_n", i), 12, C.dim, true, { Size = UDim2.new(1, 0, 0, 16), Position = UDim2.fromOffset(0, 8), TextXAlignment = Enum.TextXAlignment.Center })
			label(cell, if i < d.idx then "✓" else (if i == 7 then "🎁" else "💰"), 22, C.gold, true, { Size = UDim2.new(1, 0, 0, 28), Position = UDim2.fromOffset(0, 28), TextXAlignment = Enum.TextXAlignment.Center })
			label(cell, fmt(coins), 13, if i < d.idx then C.green else C.gold, true, { Size = UDim2.new(1, 0, 0, 16), Position = UDim2.fromOffset(0, 64), TextXAlignment = Enum.TextXAlignment.Center })
		end
		local b = button(box, L("claim_daily", fmt(progDef.DAILY[d.idx])), UDim2.new(1, -40, 0, 54), UDim2.fromOffset(20, 210), C.gold, C.bg)
		b.TextSize = 20
		b.MouseButton1Click:Connect(function()
			modal.Visible = false
			if cbs.daily then
				cbs.daily()
			end
		end)
		label(box, L("daily_back"), 12, C.dim, false, { Position = UDim2.fromOffset(20, 276), Size = UDim2.new(1, -40, 0, 36), TextWrapped = true, TextXAlignment = Enum.TextXAlignment.Center })
		zall(box)
	end

	function ui.showRound(winner: string, mvp: { any }, mySide: string, secs: number)
		clearBox()
		modal.Visible = true
		local won = winner == mySide
		label(box, if won then "🏆 " .. L("victory") else L("defeat"), 34, if won then C.gold else C.red, true, { Position = UDim2.fromOffset(0, 16), Size = UDim2.new(1, 0, 0, 40), TextXAlignment = Enum.TextXAlignment.Center })
		label(box, L("winner_is", L("team_" .. winner)), 15, C[winner] or C.text, true, { Position = UDim2.fromOffset(0, 60), Size = UDim2.new(1, 0, 0, 20), TextXAlignment = Enum.TextXAlignment.Center })
		local row = new("Frame", { Size = UDim2.new(1, -40, 0, 150), Position = UDim2.fromOffset(20, 96), BackgroundTransparency = 1 }, box)
		new("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 10), HorizontalAlignment = Enum.HorizontalAlignment.Center }, row)
		if #mvp == 0 then
			label(row, L("no_mvp"), 14, C.dim, false, { Size = UDim2.new(1, 0, 1, 0), TextXAlignment = Enum.TextXAlignment.Center })
		end
		for i, e in mvp do
			local f = new("Frame", { Size = UDim2.new(1 / 3, -10, 1, 0), BackgroundColor3 = C.panel, LayoutOrder = i }, row)
			corner(f, 12)
			stroke(f, if i == 1 then C.gold else C.line, if i == 1 then 2 else 1)
			local img = new("ImageLabel", { Size = UDim2.fromOffset(56, 56), Position = UDim2.new(0.5, -28, 0, 8), BackgroundColor3 = C.panel2, Image = "rbxthumb://type=AvatarHeadShot&id=" .. tostring(e.userId) .. "&w=150&h=150" }, f)
			corner(img, 28)
			label(f, (if i == 1 then "MVP · " else "") .. tostring(e.name), 14, C[e.side] or C.text, true, { Position = UDim2.fromOffset(4, 70), Size = UDim2.new(1, -8, 0, 18), TextXAlignment = Enum.TextXAlignment.Center, TextTruncate = Enum.TextTruncate.AtEnd })
			label(f, L("mvp_line", e.kills, e.caps), 12, C.dim, false, { Position = UDim2.fromOffset(4, 94), Size = UDim2.new(1, -8, 0, 16), TextXAlignment = Enum.TextXAlignment.Center })
			label(f, fmt(e.score), 18, C.gold, true, { Position = UDim2.fromOffset(4, 116), Size = UDim2.new(1, -8, 0, 22), TextXAlignment = Enum.TextXAlignment.Center })
		end
		local cd = label(box, "", 13, C.dim, false, { Position = UDim2.fromOffset(0, 262), Size = UDim2.new(1, 0, 0, 18), TextXAlignment = Enum.TextXAlignment.Center })
		local ok = button(box, "OK", UDim2.fromOffset(160, 36), UDim2.new(0.5, -80, 0, 286), C.panel2, C.text)
		ok.MouseButton1Click:Connect(function()
			modal.Visible = false
		end)
		zall(box)
		task.spawn(function()
			local t = secs
			while t > 0 and cd.Parent do
				cd.Text = L("next_round", t)
				task.wait(1)
				t -= 1
			end
			if cd.Parent then
				modal.Visible = false
			end
		end)
	end

