<Item class="Workspace" referent="RBX00000013"><Properties><string name="Name">Workspace</string><bool name="StreamingEnabled">false</bool><float name="FallenPartsDestroyHeight">-2000</float></Properties></Item>
<Item class="ReplicatedStorage" referent="RBX00000014"><Properties><string name="Name">ReplicatedStorage</string></Properties><Item class="Folder" referent="RBX00000009"><Properties><string name="Name">CarrierStrike</string></Properties><Item class="ModuleScript" referent="RBX00000001"><Properties><string name="Name">Config</string><ProtectedString name="Source"><![CDATA[--!strict
-- Настройки, которые вписываешь сам после публикации игры (см. ГАЙД). 0 или "" = выключено.
return {
	-- название хранилища сохранений; поменяешь — у всех начнётся новый прогресс
	DATASTORE = "CarrierStrike_v1",

	-- Game Pass «VIP»: ×2 монеты, золотая раскраска, значок VIP. Создай пропуск и впиши его ID.
	VIP_PASS_ID = 0,
	-- Developer Products: пакеты монет. Создай продукты и впиши ID.
	COIN_PRODUCTS = {
		{ id = 0, coins = 1000 },
		{ id = 0, coins = 3000 },
		{ id = 0, coins = 10000 },
	},

	-- Значки (Badges): создай в Creator Dashboard и впиши ID
	BADGES = {
		welcome = 0, -- первый вход
		first_kill = 0, -- первое сбитие
		first_capture = 0, -- первый захват базы
		first_win = 0, -- первая победа команды
		ace = 0, -- 5 сбитий за один вылет
		level10 = 0, -- 10 уровень
	},

	-- Звуки: Toolbox → Audio → правой кнопкой → Copy Asset ID → "rbxassetid://ЧИСЛО"
	SOUNDS = {
		engine = "", -- гул двигателя (зациклен)
		gun = "", -- выстрел пушки (короткий)
		missile = "", -- пуск ракеты
		lock = "", -- сигнал захвата цели
		warn = "", -- тревога «ракета»
		hit = "", -- попадание
		reward = "", -- монеты / задание
		music = "", -- музыка в меню (зациклена)
	},
}
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000002"><Properties><string name="Name">FlightPhysics</string><ProtectedString name="Source"><![CDATA[--!strict
-- Физика полёта из Sky Pilot (без изменений, кроме текста столкновения из World.lastHit).
-- Единицы: 1 stud/s = 1 kt, высота в футах = Y * FT, G = 19 stud/s².
local World = require(script.Parent.World)

local FT = World.FT
local G = 19

local FlightPhysics = {}

-- Ограничения по перегрузке (G) и самолёты с fly-by-wire (защита от перегрузки, как в реальности)
local FBW = { A220 = true, A320 = true, A330 = true, A350 = true, A380 = true, B777 = true, B787 = true, G650 = true, GL7500 = true, F16 = true }
function FlightPhysics.limits(c: any): (number, number, boolean)
	local gMax = c.gMax or (if c.id == "F16" then 9 elseif c.id == "C172" then 3.8 elseif c.length < 130 then 2.6 else 2.5)
	local gMin = c.gMin or (if c.id == "F16" then -3 elseif c.id == "C172" then -1.5 else -1)
	return gMax, gMin, FBW[c.id] == true
end
function FlightPhysics.gearMaxKts(c: any): number
	return c.gearMaxKts or (if c.maxKts > 300 then 270 else 9999)
end
FlightPhysics.FT = FT
FlightPhysics.G = G

export type Input = {
	p: number, r: number, y: number,
	thrUp: boolean?, thrDn: boolean?, brakes: boolean?,
	throttle: number?, -- абсолютная тяга (слайдер, автопилот)
}

export type Event = { type: string, text: string, good: boolean?, fpm: number?, grade: string?, airport: string? }

export type Flight = {
	cfg: any, mode: string,
	pos: Vector3, att: CFrame,
	speed: number, throttle: number, flaps: number, gear: boolean,
	brakes: boolean, reverse: boolean, spoilers: boolean,
	inP: number, inR: number, inY: number,
	vyExtra: number, lastVelY: number, vel: Vector3,
	wind: Vector3?, -- снос ветром (stud/с, задаёт клиент); на земле не действует
	onGround: boolean, airTime: number, crashed: boolean, crashReason: string?,
	hard: boolean?, -- «Сложный» уровень: перегрузка G, повреждения и поломки (на обычном — выключено)
	gload: number, damage: number, buffet: number, flapStress: number, gearStress: number, flapsDamaged: boolean, gearStuck: boolean,
	events: { Event }, dbg: { [string]: number },
}

local function clamp(v: number, a: number, b: number): number
	return math.min(b, math.max(a, v))
end
FlightPhysics.clamp = clamp

function FlightPhysics.new(cfg: any, spawnCF: CFrame, air: boolean): Flight
	local speed = air and math.floor(cfg.maxKts * 0.6) or 0
	return {
		cfg = cfg, mode = air and "air" or "runway",
		pos = spawnCF.Position, att = spawnCF.Rotation,
		speed = speed, throttle = air and 0.7 or 0, flaps = 0, gear = (cfg.fixedGear == true) or not air,
		brakes = false, reverse = false, spoilers = false,
		inP = 0, inR = 0, inY = 0,
		vyExtra = 0, lastVelY = 0, vel = spawnCF.LookVector * speed,
		onGround = not air, airTime = 0, crashed = false, crashReason = nil,
		gload = 1, damage = 0, buffet = 0, flapStress = 0, gearStress = 0, flapsDamaged = false, gearStuck = false,
		events = {}, dbg = { agl = 0, lift = 1, eff = 1, stall = cfg.stallKts, thrust = 0, drag = 0, accel = 0, thrustMul = 1 },
	}
end

local function crash(f: Flight, reason: string)
	f.crashed = true
	f.crashReason = reason
	table.insert(f.events, { type = "crash", text = reason })
end

local function stepOnce(f: Flight, input: Input, dt: number)
	if f.crashed then
		return
	end
	dt = clamp(dt, 1 / 240, 1 / 20)
	local c = f.cfg
	local sm = math.min(1, dt * 6)
	f.inP += (clamp(input.p, -1, 1) - f.inP) * sm
	f.inR += (clamp(input.r, -1, 1) - f.inR) * sm
	f.inY += (clamp(input.y, -1, 1) - f.inY) * sm
	if input.throttle ~= nil then
		f.throttle = clamp(input.throttle, 0, 1)
	end
	if input.thrUp then
		f.throttle = math.min(1, f.throttle + dt * 0.45)
	end
	if input.thrDn then
		f.throttle = math.max(0, f.throttle - dt * 0.45)
	end
	f.brakes = input.brakes == true

	local pos = f.pos
	local gy = World.groundAt(pos.X, pos.Z)
	local agl = if gy == -math.huge then math.huge else pos.Y - c.gearHeight - gy
	local nowGround = agl <= 0.6
	local att = f.att
	local look = att.LookVector
	local right = att.RightVector
	local up = att.UpVector

	if pos.Y < -400 then
		return crash(f, "Самолёт упал за край мира")
	end

	if nowGround and not f.onGround then
		local fpm = math.floor(-f.lastVelY * 60 * FT)
		local bankDeg = math.deg(math.asin(clamp(-right.Y, -1, 1)))
		local pitchDeg = math.deg(math.asin(clamp(look.Y, -1, 1)))
		if not f.gear then
			return crash(f, "Посадка без шасси!")
		end
		if fpm > c.maxTouchdownFpm then
			return crash(f, string.format("Слишком жёсткая посадка: %d fpm (лимит %d)", fpm, c.maxTouchdownFpm))
		end
		if math.abs(bankDeg) > 20 or pitchDeg < -8 or up.Y < 0 then
			return crash(f, string.format("Удар крылом о землю (крен %d°, тангаж %d°)", math.round(bankDeg), math.round(pitchDeg)))
		end
		-- удар хвостом: нос задран выше предела — повреждение (как в жизни), посадка считается жёсткой
		local tailStrike = f.hard == true and pitchDeg > c.maxRotate + 2
		if tailStrike then
			f.damage = math.min(0.95, f.damage + 0.35)
			table.insert(f.events, { type = "warn", text = string.format("Удар хвостом о полосу: тангаж %d° (предел %d°) — повреждение", math.round(pitchDeg), c.maxRotate) })
		end
		if f.speed > 15 and f.airTime > 1 then
			local grade = if tailStrike then "hard" elseif fpm < 250 then "perfect" elseif fpm < 600 then "good" else "hard"
			local label = if grade == "perfect" then "Идеальная посадка!" elseif grade == "good" then "Хорошая посадка" else "Жёсткая посадка"
			table.insert(f.events, {
				type = "landing", text = string.format("%s  %d fpm", label, math.max(fpm, 0)),
				good = fpm < 600 and not tailStrike, fpm = math.max(fpm, 0), grade = grade, airport = World.runwayAt(pos.X, pos.Z, 20),
			})
		end
	end
	if not nowGround and f.onGround and f.speed > 20 then
		table.insert(f.events, { type = "takeoff", text = string.format("Отрыв на %d kt", math.round(f.speed)) })
	end
	f.onGround = nowGround
	f.airTime = if nowGround then 0 else f.airTime + dt
	if not nowGround then
		f.reverse = false
	end

	local stall = c.stallKts * (1 - 0.07 * f.flaps)
	local lift = clamp((f.speed - 0.6 * stall) / (0.4 * stall), 0, 1)
	local eff = clamp(f.speed / (stall * 1.1), 0.15, 1)
	local ceil = c.ceilingFt / FT
	local thrustMul = clamp((ceil - pos.Y) / (0.15 * ceil), 0.05, 1)
	-- engOut: доля отказавших двигателей (аварийная тренировка), как в веб-версии
	local alive = 1 - ((f :: any).engOut or 0)
	local thrust = c.thrust * f.throttle * thrustMul * alive
	if f.reverse then
		thrust = -c.thrust * 0.45 * f.throttle * alive
	end
	local retractGear = f.gear and not c.fixedGear
	local dragK = c.thrust / (c.maxKts * c.maxKts)
	local dragMul = 1 + 0.12 * f.flaps + (if retractGear then 0.15 else 0)
	local vr = c.vrKts * (1 - 0.04 * f.flaps)
	local extra = (0.3 * f.flaps + (if retractGear then 0.4 else 0)) * (f.speed / c.vrKts) ^ 2
	-- эффект земли: ниже половины размаха индуктивное сопротивление и просадка меньше
	local ge = if f.onGround or agl == math.huge then 0 else clamp(1 - agl / (c.span * 0.5), 0, 1)
	local induced = if f.onGround then 0 else 1.2 * (c.stallKts / math.max(f.speed, 30)) ^ 2 * lift * (1 - 0.5 * ge)
	-- интерцепторы: сопротивление растёт с квадратом скорости (в воздухе и на пробеге)
	local spoilerDrag = if f.spoilers then math.min(c.thrust * 0.6, c.thrust * 0.35 * (f.speed / c.vrKts) ^ 2) else 0
	local drag = dragK * dragMul * f.speed * f.speed + extra + induced + spoilerDrag
	local accel = thrust - drag - G * look.Y
	if f.onGround and f.speed > 0 then
		accel -= 0.6
		if f.brakes then
			accel -= c.brakeDecel * (if f.spoilers then 1.25 else 1)
		end
	end
	f.speed = math.max(0, f.speed + accel * dt)

	if f.onGround then
		local heading = math.atan2(-look.X, -look.Z)
		local pitch = math.asin(clamp(look.Y, -1, 1))
		local steer = clamp(f.inY + f.inR, -1, 1)
		local steerRate = c.groundSteer * clamp(f.speed / 12, 0, 1) / (1 + f.speed / 40)
		heading -= steer * steerRate * dt
		if f.speed >= vr and f.inP > 0.05 then
			pitch = clamp(pitch + c.pitchRate * 0.6 * f.inP * dt, 0, math.rad(c.maxRotate))
		else
			pitch = math.max(0, pitch - pitch * math.min(1, dt * 1.5))
		end
		att = CFrame.Angles(0, heading, 0) * CFrame.Angles(pitch, 0, 0)
	else
		-- fly-by-wire: компьютер не даёт выйти за предел перегрузки
		local gMaxP, gMinP, fbw = FlightPhysics.limits(c)
		local inP = f.inP
		-- аэродинамический предел: крыло не даст больше (V/Vs)² — дальше срыв потока
		local aeroMax = (f.speed / stall) ^ 2
		local capMax = if fbw then math.min(gMaxP, aeroMax) else aeroMax
		local capMin = if fbw then math.max(gMinP, -0.6 * aeroMax) else -0.6 * aeroMax
		if inP > 0 and f.gload > capMax * 0.85 then
			inP *= clamp((capMax * 0.98 - f.gload) / (capMax * 0.13 + 0.05), 0, 1)
		elseif inP < 0 and f.gload < capMin * 0.85 then
			inP *= clamp((f.gload - capMin * 0.98) / (math.abs(capMin) * 0.13 + 0.05), 0, 1)
		end
		local pr = c.pitchRate * eff * inP
		if lift < 1 then
			pr -= (1 - lift) * 0.9
		end
		local rr = -c.rollRate * eff * f.inR
		local yr = -c.yawRate * eff * f.inY
		att = att * CFrame.Angles(pr * dt, yr * dt, rr * dt)
		local bank = -att.RightVector.Y
		local omega = c.turnBoost * G * bank / math.max(f.speed, 60) * lift
		att = (CFrame.fromAxisAngle(Vector3.yAxis, -omega * dt) * att):Orthonormalize()
	end
	f.att = att
	look = att.LookVector
	up = att.UpVector

	local vel: Vector3
	if f.onGround then
		vel = look * f.speed
		local glue = if (f.inP > 0.05 and agl > 0 and f.speed >= vr) then 0 else -agl * 10
		vel += Vector3.new(0, glue, 0)
		f.vyExtra = 0
	else
		local sinkTarget = (-(1 - lift) * c.stallSink - (1 - math.abs(up.Y)) * 12 * lift) * (1 - 0.4 * ge) - (if f.spoilers then 4 * lift else 0)
		f.vyExtra += (sinkTarget - f.vyExtra) * math.min(1, dt * 1.5)
		vel = look * f.speed + Vector3.new(0, f.vyExtra, 0)
	end

	if f.speed > 20 then
		local dir = if f.onGround then Vector3.new(look.X, 0, look.Z) else vel
		if dir.Magnitude > 0.01 then
			dir = dir.Unit
			local len = c.length * 0.5 + f.speed * dt * 2
			for _, t in { 0.5, 0.75, 1 } do
				local p = pos + dir * (len * t)
				if World.hitsObstacle(p) then
					return crash(f, (World :: any).lastHit or "Столкновение со зданием!")
				end
				if not f.onGround and p.Y < World.groundAt(p.X, p.Z) - 0.5 then
					return crash(f, "Столкновение с землёй / горой!")
				end
			end
		end
	end

	-- перегрузка: (ускорение + g) в проекции на «пол» самолёта, в единицах g
	if f.onGround or dt <= 0 then
		f.gload += (1 - f.gload) * math.min(1, dt * 5)
	else
		local acc = (vel - f.vel) / dt + Vector3.new(0, G, 0)
		local nz = acc:Dot(up) / G
		f.gload += (clamp(nz, -15, 15) - f.gload) * math.min(1, dt * 8)
	end
	local gMax, gMin = FlightPhysics.limits(c)
	if f.hard and not f.onGround then
		if f.gload > gMax * 1.5 or f.gload < gMin * 1.5 then
			return crash(f, string.format("Разрушение конструкции: перегрузка %.1f G (предел %.1f G)", f.gload, if f.gload > 0 then gMax else gMin))
		end
		if f.gload > gMax then
			f.damage += (f.gload - gMax) / gMax * dt * 1.5
		elseif f.gload < gMin then
			f.damage += (gMin - f.gload) / math.abs(gMin) * dt * 1.5
		end
	end
	if f.hard and f.speed > c.maxKts * 1.1 then
		f.damage += (f.speed / c.maxKts - 1.1) * dt * 2
	end
	if f.damage >= 1 then
		return crash(f, "Разрушение конструкции: превышены ограничения самолёта")
	end
	-- скоростной напор ломает закрылки и шасси
	if f.hard and f.flaps > 0 and f.speed > c.flapMaxKts * 1.15 then
		f.flapStress += dt
		if f.flapStress > 2 and not f.flapsDamaged then
			f.flapsDamaged, f.flaps = true, 0
			table.insert(f.events, { type = "warn", text = "Закрылки повреждены скоростным напором — заблокированы" })
		end
	else
		f.flapStress = math.max(0, f.flapStress - dt)
	end
	if f.hard and f.gear and not c.fixedGear and not f.onGround and f.speed > FlightPhysics.gearMaxKts(c) * 1.15 then
		f.gearStress += dt
		if f.gearStress > 3 and not f.gearStuck then
			f.gearStuck = true
			table.insert(f.events, { type = "warn", text = "Шасси повреждено на скорости — заклинило в выпущенном положении" })
		end
	else
		f.gearStress = math.max(0, f.gearStress - dt)
	end
	-- тряска: у сваливания, при превышении скорости и у предела перегрузки
	local bStall = if f.onGround then 0 else clamp((1.12 - f.speed / stall) / 0.12, 0, 1)
	local bSpeed = clamp((f.speed / c.maxKts - 1) / 0.1, 0, 1)
	local bG = if f.hard then clamp((f.gload - gMax * 0.85) / (gMax * 0.2), 0, 1) else 0
	f.buffet = math.max(bStall, bSpeed, bG)

	f.vel = vel
	f.lastVelY = vel.Y
	-- ветер сносит самолёт в воздухе (воздушная скорость та же, меняется путевая)
	local drift = if f.wind and not f.onGround then f.wind * dt else Vector3.zero
	f.pos = pos + vel * dt + drift
	f.dbg = { agl = agl, lift = lift, eff = eff, stall = stall, thrust = thrust, drag = drag, accel = accel, thrustMul = thrustMul }
end

-- Ветер: направление «откуда дует» (°) и сила (kt) → вектор сноса; боковая составляющая к полосе
function FlightPhysics.windVector(dirDeg: number, kts: number): Vector3
	local d = math.rad(dirDeg)
	return Vector3.new(-math.sin(d), 0, math.cos(d)) * kts
end
function FlightPhysics.crosswind(dirDeg: number, kts: number, runwayHdg: number): number
	return math.abs(kts * math.sin(math.rad(dirDeg - runwayHdg)))
end

-- Действия кнопок (шасси/закрылки/реверс). Возвращает текст подсказки и цвет.
function FlightPhysics.action(f: Flight, a: string): (string?, string?)
	if f.crashed then
		return nil, nil
	end
	local c = f.cfg
	if a == "gear" then
		if f.gearStuck then
			return "Шасси заклинило в выпущенном положении", "amber"
		elseif c.fixedGear then
			return "У этого самолёта шасси не убирается", nil
		elseif f.onGround and f.gear then
			return "Нельзя убрать шасси на земле", "amber"
		end
		f.gear = not f.gear
		return if f.gear then "Шасси выпущено" else "Шасси убрано", nil
	elseif a == "flapDn" or a == "flapUp" then
		if c.noFlaps then
			return "У истребителя нет закрылков", nil
		end
		if f.flapsDamaged then
			return "Закрылки повреждены и заблокированы", "amber"
		end
		f.flaps = clamp(f.flaps + (if a == "flapDn" then 1 else -1), 0, 3)
		return "Закрылки: " .. f.flaps, nil
	elseif a == "rev" then
		if f.onGround then
			f.reverse = not f.reverse
			return if f.reverse then "Реверс включён, добавь тягу" else "Реверс выключен", "amber"
		end
		return "Реверс только на земле", nil
	elseif a == "spoiler" then
		f.spoilers = not f.spoilers
		return if f.spoilers then "Интерцепторы выпущены" else "Интерцепторы убраны", if f.spoilers then "amber" else nil
	elseif a == "idle" then
		f.throttle = 0
	end
	return nil, nil
end

function FlightPhysics.pose(f: Flight): CFrame
	return CFrame.new(f.pos) * f.att
end

-- Шаг не больше 1/60 с: при низком FPS перегрузка и защита fly-by-wire работают так же, как при 60 FPS
function FlightPhysics.step(f: Flight, input: Input, dt: number)
	local n = math.max(1, math.ceil(dt * 60 - 0.01))
	local h = dt / n
	for _ = 1, n do
		if f.crashed then
			break
		end
		stepOnce(f, input, h)
	end
end

return FlightPhysics
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000003"><Properties><string name="Name">JetModel</string><ProtectedString name="Source"><![CDATA[--!strict
-- Настоящие 3D-модели самолётов.
-- Импортируй в Studio файлы F16.glb, FA18.glb, SU33.glb, RAFALE.glb, MIG29.glb, F35.glb
-- (Home → Import 3D). Модели появятся в Workspace с этими именами — сервер сам перенесёт их
-- в ReplicatedStorage/CarrierStrike/JetModels и игра будет использовать их вместо простых самолётов.
-- Если модели нет — самолёт собирается из деталей (PlaneBuilder), как раньше.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local PlaneBuilder = require(script.Parent.PlaneBuilder)

local JetModel = {}

local function folder(): Folder
	local shared = script.Parent
	local f = shared:FindFirstChild("JetModels")
	if not f then
		f = Instance.new("Folder")
		f.Name = "JetModels"
		f.Parent = shared
	end
	return f :: Folder
end

-- сервер: забрать импортированные модели из Workspace в общую папку
function JetModel.collect(ids: { string })
	if not RunService:IsServer() then
		return
	end
	local f = folder()
	for _, id in ids do
		if not f:FindFirstChild(id) then
			local m = workspace:FindFirstChild(id)
			if m and (m:IsA("Model") or m:IsA("BasePart")) then
				m.Parent = f
			end
		end
	end
	f:SetAttribute("Ready", true)
end

-- клиент: подождать, пока сервер разложит модели (не дольше timeout)
function JetModel.wait(timeout: number)
	local f = ReplicatedStorage:WaitForChild("CarrierStrike"):FindFirstChild("JetModels")
	local t = os.clock()
	while (not f or not f:GetAttribute("Ready")) and os.clock() - t < timeout do
		task.wait(0.1)
		f = ReplicatedStorage.CarrierStrike:FindFirstChild("JetModels")
	end
end

function JetModel.has(id: string): boolean
	local f = script.Parent:FindFirstChild("JetModels")
	return f ~= nil and f:FindFirstChild(id) ~= nil
end

local function isDetail(p: BasePart): boolean
	-- стекло фонаря и тёмные детали (сопла, шины) не перекрашиваем
	if p.Transparency > 0.05 or p.Material == Enum.Material.Glass then
		return true
	end
	local c = p.Color
	return (c.R + c.G + c.B) / 3 < 0.16
end

-- Собрать самолёт. opts — как у PlaneBuilder.build: { static, seat, label }
function JetModel.build(cfg: any, opts: { static: boolean?, seat: boolean?, label: string? }?): Model
	local f = script.Parent:FindFirstChild("JetModels")
	local src = f and f:FindFirstChild(cfg.id)
	if not src then
		return PlaneBuilder.build(cfg, opts)
	end
	local o = opts or {}
	local static = o.static == true

	local inner: Model
	if src:IsA("Model") then
		inner = src:Clone()
	else
		inner = Instance.new("Model")
		src:Clone().Parent = inner
	end
	local parts: { BasePart } = {}
	for _, d in inner:GetDescendants() do
		if d:IsA("BasePart") then
			table.insert(parts, d)
		elseif d:IsA("LuaSourceContainer") then
			d:Destroy()
		end
	end
	if #parts == 0 then
		inner:Destroy()
		return PlaneBuilder.build(cfg, opts)
	end
	for _, p in parts do
		p.Anchored = true
	end

	-- ориентация: в файлах нос смотрит в −Z. Если модель легла боком (длиннее по X) — повернуть.
	local bcf, size = inner:GetBoundingBox()
	inner.WorldPivot = CFrame.new(bcf.Position)
	local yaw = 0
	if size.X > size.Z * 1.15 then
		yaw = math.pi / 2
	end
	inner:PivotTo(CFrame.Angles(0, yaw, 0))
	local len = if yaw == 0 then size.Z else size.X
	if len > 0.01 then
		inner:ScaleTo(inner:GetScale() * cfg.length / len)
	end
	-- снова по центру
	local bcf2 = inner:GetBoundingBox()
	inner:PivotTo(inner:GetPivot() - bcf2.Position)

	local model = Instance.new("Model")
	model.Name = cfg.name
	model:SetAttribute("PlaneId", cfg.id)
	model:SetAttribute("Imported", true)
	local D, L = cfg.diameter, cfg.length
	local root = Instance.new("Part")
	root.Name = "Root"
	root.Size = Vector3.new(D * 0.5, D * 0.5, L * 0.5)
	root.Transparency = 1
	root.CanCollide, root.CanTouch, root.CanQuery = false, false, false
	root.Anchored = true
	root.CFrame = CFrame.identity
	root.Parent = model
	model.PrimaryPart = root
	inner.Name = "Body"
	inner.Parent = model

	-- раскраска: однотонный цвет корпуса вместо текстуры (кроме стекла и тёмных деталей)
	local col = cfg.colors
	local painted = cfg.paintId ~= nil and cfg.paintId ~= "team" and col and col.body
	for _, p in parts do
		p.CanCollide, p.CanTouch, p.CanQuery = false, false, false
		p.Massless = true
		p.CastShadow = true
		if painted and not isDetail(p) then
			for _, sa in p:GetChildren() do
				if sa:IsA("SurfaceAppearance") then
					sa:Destroy()
				end
			end
			if p:IsA("MeshPart") then
				p.TextureID = ""
			end
			p.Color = col.body
		end
		if not static then
			local w = Instance.new("WeldConstraint")
			w.Part0 = root
			w.Part1 = p
			w.Parent = p
			p.Anchored = false
		end
	end

	-- огни команды на законцовках и форсаж
	local engines = Instance.new("Folder")
	engines.Name = "Engines"
	engines.Parent = model
	local ab = Instance.new("Part")
	ab.Name = "Afterburner"
	ab.Shape = Enum.PartType.Ball
	ab.Size = Vector3.new(D * 0.6, D * 0.6, D * 0.6)
	ab.Material = Enum.Material.Neon
	ab.Color = Color3.fromRGB(255, 150, 60)
	ab.Transparency = 1
	ab.CanCollide, ab.CanTouch, ab.CanQuery, ab.CastShadow = false, false, false, false
	ab.Massless = true
	ab.CFrame = CFrame.new(0, 0, L * 0.52)
	ab.Anchored = static
	ab.Parent = engines
	if not static then
		local w = Instance.new("WeldConstraint")
		w.Part0 = root
		w.Part1 = ab
		w.Parent = ab
	end
	if col and col.tail then
		for _, s in { -1, 1 } do
			local l = Instance.new("Part")
			l.Name = "TeamLight"
			l.Shape = Enum.PartType.Ball
			l.Size = Vector3.new(1.4, 1.4, 1.4)
			l.Material = Enum.Material.Neon
			l.Color = col.tail
			l.CanCollide, l.CanTouch, l.CanQuery, l.CastShadow = false, false, false, false
			l.Massless = true
			l.CFrame = CFrame.new(s * cfg.span * 0.48, 0, L * 0.12)
			l.Anchored = static
			l.Parent = model
			if not static then
				local w = Instance.new("WeldConstraint")
				w.Part0 = root
				w.Part1 = l
				w.Parent = l
			end
		end
	end

	-- кресло пилота и подпись — как у PlaneBuilder
	if o.seat and not static then
		local seat = Instance.new("Seat")
		seat.Name = "PilotSeat"
		seat.Size = Vector3.new(2, 0.4, 2)
		seat.Transparency = 1
		seat.CanCollide, seat.CanTouch = false, false
		seat.Massless = true
		seat.CFrame = CFrame.new(0, -D * 0.3, -L * 0.28)
		seat.Parent = model
		local w = Instance.new("WeldConstraint")
		w.Part0 = root
		w.Part1 = seat
		w.Parent = seat
	end
	if o.label then
		local bb = Instance.new("BillboardGui")
		bb.Name = "Tag"
		bb.Size = UDim2.fromOffset(220, 40)
		bb.StudsOffsetWorldSpace = Vector3.new(0, D + cfg.finHeight + 6, 0)
		bb.MaxDistance = 4000
		bb.LightInfluence = 0
		local t = Instance.new("TextLabel")
		t.Size = UDim2.fromScale(1, 1)
		t.BackgroundTransparency = 1
		t.Text = o.label
		t.TextColor3 = Color3.fromRGB(228, 238, 255)
		t.TextStrokeTransparency = 0.4
		t.Font = Enum.Font.GothamBold
		t.TextScaled = true
		t.Parent = bb
		bb.Parent = root
	end
	return model
end

return JetModel
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000004"><Properties><string name="Name">Jets</string><ProtectedString name="Source"><![CDATA[--!strict
-- Палубные истребители и параметры оружия.
-- Формат самолёта — как PlaneConfigs из Sky Pilot (1 stud/s = 1 kt), плюс боевые поля:
-- hp (прочность), missiles (ракет на вылет), lockMul (насколько дольше по нему захват).
local B = { body = Color3.fromHex("8e98a3"), accent = Color3.fromHex("6b737d"), tail = Color3.fromHex("78808a"), engine = Color3.fromHex("3c3c41") }

local function jet(t: { [string]: any }): any
	local base = {
		cls = "Истребитель", diameter = 5.5, wing = "mid", wingPos = 0.6, sweep = 40, dihedral = 0,
		engines = "jet1", engineD = 4, tail = "conventional", hstabSpan = 20, finHeight = 12, finSweep = 45,
		gearLen = 2.5, canopy = true, noFlaps = true, flapMaxKts = 9999, yawRate = 0.5, turnBoost = 6,
		groundSteer = 0.6, brakeDecel = 10, stallSink = 40, maxRotate = 15, ceilingFt = 50000, maxTouchdownFpm = 1500,
		gMax = 9, gMin = -3, lockMul = 1, colors = B,
	}
	for k, v in t do
		base[k] = v
	end
	base.gearHeight = base.diameter * 0.5 + base.gearLen
	return base
end

local JETS: { [string]: any } = {
	F16 = jet({ name = "F-16C Fighting Falcon", role = "Манёвренный, быстрый", length = 54, span = 35, chord = 14, thrust = 22, maxKts = 800, stallKts = 115, vrKts = 140, pitchRate = 1.5, rollRate = 4, hp = 100, missiles = 4 }),
	FA18 = jet({ name = "F/A-18E Super Hornet", role = "Прочный, 6 ракет", length = 60, diameter = 6, span = 44, chord = 16, sweep = 30, thrust = 19, maxKts = 700, stallKts = 105, vrKts = 130, pitchRate = 1.6, rollRate = 3.2, hp = 125, missiles = 6, hstabSpan = 22, finHeight = 11,
		colors = { body = Color3.fromHex("7d8792"), accent = Color3.fromHex("5d6670"), tail = Color3.fromHex("6a737d"), engine = Color3.fromHex("33363b") } }),
	SU33 = jet({ name = "Су-33", role = "Тяжёлый, дальний", length = 72, diameter = 6.5, span = 48, chord = 18, sweep = 42, thrust = 21, maxKts = 760, stallKts = 112, vrKts = 138, pitchRate = 1.35, rollRate = 3, hp = 135, missiles = 6, hstabSpan = 26, finHeight = 14,
		colors = { body = Color3.fromHex("a9b6c2"), accent = Color3.fromHex("6c8296"), tail = Color3.fromHex("8a9cad"), engine = Color3.fromHex("3a3d42") } }),
	RAFALE = jet({ name = "Rafale M", role = "Самый вёрткий", length = 50, span = 36, chord = 18, sweep = 50, thrust = 22, maxKts = 740, stallKts = 108, vrKts = 132, pitchRate = 1.75, rollRate = 4.3, hp = 95, missiles = 4, hstabSpan = 10, finHeight = 12,
		colors = { body = Color3.fromHex("9aa1a8"), accent = Color3.fromHex("70777e"), tail = Color3.fromHex("848b92"), engine = Color3.fromHex("3a3a3e") } }),
	MIG29 = jet({ name = "МиГ-29К", role = "Быстрый набор", length = 57, diameter = 6, span = 40, chord = 16, thrust = 23.5, maxKts = 780, stallKts = 116, vrKts = 140, pitchRate = 1.5, rollRate = 3.6, hp = 105, missiles = 4, hstabSpan = 22,
		colors = { body = Color3.fromHex("8f9ea8"), accent = Color3.fromHex("5f7280"), tail = Color3.fromHex("77878f"), engine = Color3.fromHex("38393d") } }),
	F35 = jet({ name = "F-35C Lightning II", role = "Малозаметный: захват дольше", length = 52, diameter = 6, span = 43, chord = 17, sweep = 34, thrust = 20, maxKts = 680, stallKts = 110, vrKts = 135, pitchRate = 1.45, rollRate = 3.4, hp = 110, missiles = 4, lockMul = 1.8, hstabSpan = 20,
		colors = { body = Color3.fromHex("6e747a"), accent = Color3.fromHex("575c61"), tail = Color3.fromHex("63686d"), engine = Color3.fromHex("2f3134") } }),
}
for id, c in JETS do
	c.id = id
end

return {
	JETS = JETS,
	ORDER = { "F16", "FA18", "SU33", "RAFALE", "MIG29", "F35" },
	-- оружие
	GUN_RANGE = 2400, -- studs
	GUN_CONE = 3.2, -- градусов: попадание, если цель в этом конусе по курсу
	GUN_CONE_TOUCH = 5.5, -- на телефоне конус шире (помощь прицеливания)
	GUN_DMG = 6,
	GUN_RATE = 0.09, -- секунд между выстрелами
	MSL_RANGE = 7000,
	MSL_CONE = 24, -- градусов для захвата
	MSL_LOCK = 1.4, -- секунд держать цель для захвата
	MSL_SPEED = 1300,
	MSL_TURN = 2.4, -- рад/с
	MSL_DMG = 70,
	MSL_LIFE = 9,
	FLARES = 10,
	FLARE_TIME = 1.6,
	FLARE_CHANCE = 0.7, -- шанс увести ракету
	-- матч
	TICKETS = 250,
	BOTS_PER_TEAM = 4, -- боты добавляются, пока в команде мало живых игроков; 0 = без ботов
	BLEED_EVERY = 6, -- раз в N секунд команда с меньшим числом баз теряет очки
}
]]></ProtectedString></Properties></Item>
