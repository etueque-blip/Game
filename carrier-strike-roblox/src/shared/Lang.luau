function Lang.pick(localeId: string?): string
	local l = string.lower(localeId or "")
	local p = string.sub(l, 1, 2)
	if p == "ru" or p == "uk" or p == "be" or p == "kk" or p == "uz" or p == "ky" then
		return "ru"
	end
	return "en"
end

function Lang.t(lang: string, key: string, ...: any): string
	local row = S[key]
	if not row then
		return key
	end
	local s = if lang == "ru" then row[1] else row[2]
	if select("#", ...) > 0 then
		local ok, out = pcall(string.format, s, ...)
		if ok then
			return out
		end
	end
	return s
end

Lang.KEYS = S

return Lang
